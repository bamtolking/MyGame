{
  "name": "SlimeHeist",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 16,
        "CharacterJumpPower": 50,
        "CameraMaxZoomDistance": 120
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false,
        "MaxPlayers": 8
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false,
        "Gravity": 196.2
      },
      "Map": {
        "$path": "build/MapPreview.rbxm"
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "Brightness": 2.5,
        "ClockTime": 14.5,
        "GlobalShadows": true,
        "Ambient": [
          0.45,
          0.45,
          0.5
        ],
        "OutdoorAmbient": [
          0.55,
          0.55,
          0.6
        ]
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "TextChatService": {
      "$properties": {
        "ChatVersion": "TextChatService"
      }
    }
  }
}
