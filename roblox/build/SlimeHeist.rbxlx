  <Item class="ReplicatedFirst" referent="2">
    <Properties>
      <string name="Name">ReplicatedFirst</string>
    </Properties>
    <Item class="LocalScript" referent="3">
      <Properties>
        <string name="Name">Loading</string>
        <string name="Source"><![CDATA[--!strict
-- 로딩 화면(ReplicatedFirst에서 가장 먼저 실행).
-- 기본 로딩 화면을 지우고, 통통 튀는 슬라임 + 제목 + 진행 막대 + 팁을 보여 줍니다.
-- 클라이언트 준비가 끝나면(플레이어 속성 ClientReady) 부드럽게 사라집니다.

local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

ReplicatedFirst:RemoveDefaultLoadingScreen()

local player = Players.LocalPlayer
local korean = string.sub(string.lower(player.LocaleId or ""), 1, 2) == "ko"

local TIPS = if korean
	then {
		"💡 같은 슬라임 3마리를 합치면 ★ 슬라임이 돼요!",
		"💡 도둑은 F(🔨)로 때리면 슬라임을 떨어뜨려요.",
		"💡 매시 정각엔 슬라임 대폭주! 행운 ×5!",
		"💡 날씨가 바뀌면 슬라임이 황금·무지개로 변해요.",
		"💡 ⭐ 즐겨찾기 슬라임은 도둑맞지 않아요.",
	}
	else {
		"💡 Merge 3 same slimes into a ★ slime!",
		"💡 BONK thieves with F (🔨) to make them drop slimes.",
		"💡 Every hour: SLIME FRENZY with x5 luck!",
		"💡 Weather can turn slimes Gold or Rainbow.",
		"💡 Your ⭐ favorite slime can't be stolen.",
	}

local function tween(inst: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?)
	TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function corner(parent: Instance, scale: number?, px: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = if scale then UDim.new(scale, 0) else UDim.new(0, px or 12)
	c.Parent = parent
end

local function stroke(parent: Instance, thickness: number, color: Color3, contextual: boolean?)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness
	s.Color = color
	s.ApplyStrokeMode = if contextual then Enum.ApplyStrokeMode.Contextual else Enum.ApplyStrokeMode.Border
	s.Parent = parent
end

local gui = Instance.new("ScreenGui")
gui.Name = "LoadingScreen"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 1000

local group = Instance.new("CanvasGroup")
group.Size = UDim2.fromScale(1, 1)
group.BackgroundColor3 = Color3.fromRGB(60, 30, 120)
group.Parent = gui
local bg = Instance.new("UIGradient")
bg.Color = ColorSequence.new(Color3.fromRGB(120, 70, 255), Color3.fromRGB(255, 90, 170))
bg.Rotation = 35
bg.Parent = group

-- 떠다니는 방울
local bubbles = {}
for i = 1, 14 do
	local b = Instance.new("Frame")
	local size = math.random(20, 70)
	b.Size = UDim2.fromOffset(size, size)
	b.Position = UDim2.fromScale(math.random(), math.random())
	b.BackgroundColor3 = Color3.new(1, 1, 1)
	b.BackgroundTransparency = 0.85
	b.Parent = group
	corner(b, 0.5)
	bubbles[i] = { frame = b, speed = 0.02 + math.random() * 0.05, x = math.random() }
end

local title = Instance.new("TextLabel")
title.AnchorPoint = Vector2.new(0.5, 0.5)
title.Position = UDim2.fromScale(0.5, 0.3)
title.Size = UDim2.new(0.8, 0, 0.14, 0)
title.BackgroundTransparency = 1
title.Font = Enum.Font.FredokaOne
title.TextScaled = true
title.Text = if korean then "슬라임 하이스트!" else "SLIME HEIST!"
title.TextColor3 = Color3.fromRGB(255, 230, 90)
title.Parent = group
stroke(title, 6, Color3.fromRGB(70, 20, 110), true)
local titleSize = Instance.new("UISizeConstraint")
titleSize.MaxSize = Vector2.new(760, 120)
titleSize.Parent = title

-- 슬라임(프레임으로 그림)
local slime = Instance.new("Frame")
slime.AnchorPoint = Vector2.new(0.5, 1)
slime.Position = UDim2.fromScale(0.5, 0.64)
slime.Size = UDim2.fromOffset(140, 104)
slime.BackgroundColor3 = Color3.fromRGB(130, 222, 120)
slime.Parent = group
corner(slime, 0.5)
stroke(slime, 5, Color3.fromRGB(40, 90, 50))
local shine = Instance.new("Frame")
shine.Size = UDim2.fromOffset(34, 18)
shine.Position = UDim2.fromOffset(28, 16)
shine.BackgroundColor3 = Color3.new(1, 1, 1)
shine.BackgroundTransparency = 0.35
shine.Rotation = -20
shine.Parent = slime
corner(shine, 0.5)
for _, x in { 0.36, 0.64 } do
	local eye = Instance.new("Frame")
	eye.AnchorPoint = Vector2.new(0.5, 0.5)
	eye.Position = UDim2.fromScale(x, 0.5)
	eye.Size = UDim2.fromOffset(18, 26)
	eye.BackgroundColor3 = Color3.fromRGB(25, 22, 30)
	eye.Parent = slime
	corner(eye, 0.5)
	local glint = Instance.new("Frame")
	glint.Size = UDim2.fromOffset(7, 7)
	glint.Position = UDim2.fromOffset(3, 4)
	glint.BackgroundColor3 = Color3.new(1, 1, 1)
	glint.Parent = eye
	corner(glint, 0.5)
end
local shadow = Instance.new("Frame")
shadow.AnchorPoint = Vector2.new(0.5, 0.5)
shadow.Position = UDim2.fromScale(0.5, 0.645)
shadow.Size = UDim2.fromOffset(130, 18)
shadow.BackgroundColor3 = Color3.new(0, 0, 0)
shadow.BackgroundTransparency = 0.7
shadow.ZIndex = 0
shadow.Parent = group
corner(shadow, 0.5)

-- 진행 막대
local barBg = Instance.new("Frame")
barBg.AnchorPoint = Vector2.new(0.5, 0.5)
barBg.Position = UDim2.fromScale(0.5, 0.76)
barBg.Size = UDim2.new(0.5, 0, 0, 22)
barBg.BackgroundColor3 = Color3.fromRGB(30, 15, 60)
barBg.Parent = group
corner(barBg, 0.5)
stroke(barBg, 3, Color3.fromRGB(255, 255, 255))
local barSize = Instance.new("UISizeConstraint")
barSize.MaxSize = Vector2.new(460, 22)
barSize.Parent = barBg
local fill = Instance.new("Frame")
fill.Size = UDim2.fromScale(0, 1)
fill.BackgroundColor3 = Color3.fromRGB(120, 255, 140)
fill.Parent = barBg
corner(fill, 0.5)

local tip = Instance.new("TextLabel")
tip.AnchorPoint = Vector2.new(0.5, 0.5)
tip.Position = UDim2.fromScale(0.5, 0.85)
tip.Size = UDim2.new(0.8, 0, 0, 30)
tip.BackgroundTransparency = 1
tip.Font = Enum.Font.GothamBold
tip.TextScaled = true
tip.TextColor3 = Color3.new(1, 1, 1)
tip.Text = TIPS[math.random(1, #TIPS)]
tip.Parent = group
local tipSize = Instance.new("UISizeConstraint")
tipSize.MaxSize = Vector2.new(700, 30)
tipSize.Parent = tip

gui.Parent = player:WaitForChild("PlayerGui")

local started = os.clock()
local progress = 0
local conn = RunService.RenderStepped:Connect(function(dt)
	local t = os.clock() - started
	-- 통통: 높이는 |sin|, 착지 순간 납작해짐
	local phase = (t * 1.6) % 1
	local h = math.sin(phase * math.pi)
	local squash = if phase < 0.12 or phase > 0.88 then 0.82 else 1 + h * 0.08
	slime.Size = UDim2.fromOffset(140 / squash ^ 0.5, 104 * squash)
	slime.Position = UDim2.new(0.5, 0, 0.64, -h * 70)
	shadow.Size = UDim2.fromOffset(130 * (1 - h * 0.4), 18 * (1 - h * 0.3))
	title.Rotation = math.sin(t * 2) * 2
	for _, b in bubbles do
		local y = (b.frame.Position.Y.Scale - b.speed * dt)
		if y < -0.1 then
			y = 1.1
		end
		b.frame.Position = UDim2.fromScale(b.x + math.sin(t + b.speed * 50) * 0.01, y)
	end
	-- 준비될 때까지 90%까지 천천히
	progress += (0.9 - progress) * dt * 0.8
	fill.Size = UDim2.fromScale(progress, 1)
end)

task.spawn(function()
	while true do
		task.wait(3.5)
		if not gui.Parent then
			break
		end
		tip.Text = TIPS[math.random(1, #TIPS)]
	end
end)

-- 준비 완료 대기(최소 1.5초, 최대 25초)
while os.clock() - started < 25 do
	if player:GetAttribute("ClientReady") == true and os.clock() - started > 1.5 then
		break
	end
	task.wait(0.1)
end

conn:Disconnect()
tween(fill, 0.25, { Size = UDim2.fromScale(1, 1) })
task.wait(0.3)
tween(slime, 0.35, { Size = UDim2.fromOffset(200, 150) }, Enum.EasingStyle.Back)
tween(group, 0.6, { GroupTransparency = 1 })
task.wait(0.65)
gui:Destroy()
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="4">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="5">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="Folder" referent="6">
        <Properties>
          <string name="Name">Config</string>
        </Properties>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[--!strict
-- 소리 설정.
--
-- 샘플(samples): 이름 → 후보 소리 목록. 앞에서부터 실제로 로딩되는 첫 소리를 씁니다.
--   기본값은 로블록스 클라이언트에 내장된 소리(rbxasset://)라서 에셋 업로드 없이 동작합니다.
--   더 좋은 소리를 쓰려면 custom 표에 Creator Store 오디오 ID("rbxassetid://123")를 넣으세요(가장 먼저 시도).
--
-- 큐(cues): 효과 하나 = 여러 겹의 음(layer). 같은 짧은 "핑" 소리를 음정만 바꿔 겹치면
--   동전·합성·환생 같은 효과가 화음/아르페지오로 들립니다.
--   s: 샘플, p: 재생 속도(음정), v: 볼륨, d: 시작 지연(초)
--
-- 음악(music): custom.music(평상시)·custom.musicFrenzy(대폭주) ID가 있으면 그 음악을 반복 재생하고,
--   없으면 아래 패턴으로 오르골풍 배경음악을 만들어 연주합니다.

export type Layer = { s: string, p: number, v: number, d: number? }

-- 반음 n개 위의 재생 속도 배율
local function st(n: number): number
	return 2 ^ (n / 12)
end

local function arp(sample: string, notes: { number }, gap: number, volume: number, base: number?): { Layer }
	local out: { Layer } = {}
	for i, n in notes do
		table.insert(out, { s = sample, p = (base or 1) * st(n), v = volume, d = (i - 1) * gap })
	end
	return out
end

local function chord(sample: string, notes: { number }, delay: number, volume: number): { Layer }
	local out: { Layer } = {}
	for _, n in notes do
		table.insert(out, { s = sample, p = st(n), v = volume, d = delay })
	end
	return out
end

local function concat(...: { Layer }): { Layer }
	local out: { Layer } = {}
	for _, list in { ... } do
		for _, layer in list do
			table.insert(out, layer)
		end
	end
	return out
end

local samples: { [string]: { string } } = {
	ping = { "rbxasset://sounds/electronicpingshort.wav" },
	click = { "rbxasset://sounds/clickfast.wav", "rbxasset://sounds/button.wav" },
	swoosh = { "rbxasset://sounds/swoosh.wav" },
	whoosh = { "rbxasset://sounds/Rocket whoosh 01.wav", "rbxasset://sounds/swoosh.wav" },
	slash = { "rbxasset://sounds/swordslash.wav", "rbxasset://sounds/swordlunge.wav", "rbxasset://sounds/swoosh.wav" },
	hit = { "rbxasset://sounds/collide.wav", "rbxasset://sounds/snap.wav", "rbxasset://sounds/clickfast.wav" },
	splat = { "rbxasset://sounds/splat.wav", "rbxasset://sounds/snap.wav", "rbxasset://sounds/clickfast.wav" },
	jump = { "rbxasset://sounds/action_jump.mp3", "rbxasset://sounds/swoosh.wav" },
	boom = { "rbxasset://sounds/Rocket shot.wav", "rbxasset://sounds/collide.wav" },
}

-- 직접 고른 오디오로 바꾸기(비워 두면 기본 내장 소리/오르골 음악)
local custom: { [string]: string } = {
	ping = "",
	click = "",
	swoosh = "",
	whoosh = "",
	slash = "",
	hit = "",
	splat = "",
	jump = "",
	boom = "",
	music = "",
	musicFrenzy = "",
}

local cues: { [string]: { Layer } } = {
	-- UI
	click = { { s = "click", p = 1.1, v = 0.35 } },
	hover = { { s = "click", p = 1.8, v = 0.1 } },
	open = { { s = "swoosh", p = 1.6, v = 0.22 }, { s = "ping", p = st(19), v = 0.08, d = 0.03 } },
	close = { { s = "swoosh", p = 1.3, v = 0.18 } },
	error = { { s = "click", p = 0.55, v = 0.45 }, { s = "click", p = 0.48, v = 0.4, d = 0.09 } },
	tick = { { s = "click", p = 2.2, v = 0.1 } },

	-- 돈
	buy = arp("ping", { 0, 7, 12 }, 0.06, 0.4),
	coin = { { s = "ping", p = st(12), v = 0.2 } },
	collect = arp("ping", { 0, 4, 7, 12 }, 0.045, 0.38),
	reward = arp("ping", { 0, 4, 7, 12, 16 }, 0.05, 0.35),
	success = arp("ping", { 7, 12 }, 0.07, 0.35),
	questDone = arp("ping", { 4, 7, 12 }, 0.06, 0.35),

	-- 성장
	merge = concat(
		arp("ping", { 0, 4, 7, 12, 16 }, 0.06, 0.34),
		{ { s = "swoosh", p = 1.2, v = 0.3, d = 0.05 }, { s = "ping", p = st(24), v = 0.3, d = 0.36 } }
	),
	mutate = concat(arp("ping", { 12, 16, 19, 24 }, 0.04, 0.3), { { s = "swoosh", p = 1.5, v = 0.2 } }),
	rebirth = concat(
		chord("ping", { 0, 4, 7 }, 0, 0.26),
		chord("ping", { 5, 9, 12 }, 0.22, 0.26),
		chord("ping", { 7, 11, 14 }, 0.44, 0.26),
		chord("ping", { 12, 16, 19, 24 }, 0.7, 0.3),
		{ { s = "whoosh", p = 0.9, v = 0.4, d = 0.7 } }
	),

	-- 행진·공지
	rare = arp("ping", { 7, 12, 16, 19 }, 0.05, 0.34),
	event = concat({ { s = "whoosh", p = 0.7, v = 0.35 } }, arp("ping", { 0, 5, 9 }, 0.12, 0.28)),
	frenzy = concat(
		arp("ping", { 0, 4, 7, 12, 16, 19, 24 }, 0.04, 0.3),
		{ { s = "boom", p = 0.8, v = 0.3, d = 0.28 } }
	),
	poof = { { s = "swoosh", p = 1.8, v = 0.22 }, { s = "ping", p = st(19), v = 0.14, d = 0.02 } },
	flight = { { s = "whoosh", p = 1.3, v = 0.25 } },
	land = { { s = "splat", p = 1.5, v = 0.3 }, { s = "ping", p = st(7), v = 0.18, d = 0.03 } },

	-- 훔치기·전투
	bonk = { { s = "slash", p = 1.35, v = 0.42 }, { s = "hit", p = 0.75, v = 0.6, d = 0.1 } },
	bonkHit = {
		{ s = "hit", p = 0.6, v = 0.8 },
		{ s = "splat", p = 1.1, v = 0.5, d = 0.03 },
		{ s = "ping", p = st(-12), v = 0.3, d = 0.05 },
	},
	steal = concat({ { s = "swoosh", p = 0.85, v = 0.45 } }, arp("ping", { 7, 3 }, 0.1, 0.28)),
	stealSuccess = concat(arp("ping", { 0, 3, 7, 12 }, 0.05, 0.32), { { s = "whoosh", p = 1.1, v = 0.3 } }),
	alarm = arp("ping", { 12, 7, 12, 7 }, 0.18, 0.42),
	lock = { { s = "click", p = 0.6, v = 0.5 }, { s = "ping", p = st(-5), v = 0.32, d = 0.05 }, { s = "ping", p = st(0), v = 0.32, d = 0.12 } },
	zap = { { s = "swoosh", p = 2.0, v = 0.38 }, { s = "hit", p = 1.6, v = 0.28 } },

	-- 슬라임 움직임(위치음)
	hop = { { s = "jump", p = 1.6, v = 0.1 } },
	squish = { { s = "splat", p = 1.8, v = 0.08 } },
}

-- 오르골 배경음악 패턴(반음 단위, 0 = 기준음 C)
local music = {
	sample = "ping",
	rootSpeed = 0.72, -- 기준음(C)의 재생 속도
	calmBpm = 88,
	frenzyBpm = 126,
	-- I - V - vi - IV
	chords = {
		{ 0, 4, 7 },
		{ -5, -1, 2 },
		{ -3, 0, 4 },
		{ -7, -3, 0 },
	},
	-- 마디마다 8분음표 8칸. false = 쉼표
	melody = {
		{ 12, false, 14, 16, false, 14, 12, false },
		{ 11, false, 14, false, 19, false, 14, false },
		{ 12, false, 16, false, 21, 19, 16, false },
		{ 9, false, 12, false, 14, false, 12, false },
	} :: { { number | boolean } },
	volume = { bass = 0.2, arp = 0.055, melody = 0.1 },
}

return {
	samples = samples,
	custom = custom,
	cues = cues,
	music = music,
	semitone = st,
	-- 소리 그룹 기본 볼륨
	groups = { SFX = 0.8, UI = 0.7, Music = 0.45 },
	-- 위치음이 들리는 거리
	positional = { min = 12, max = 110 },
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
-- 경제·규칙 수치. 밸런스 조정은 이 파일만 고치면 됩니다.

export type UpgradeDef = {
	id: string,
	name: { en: string, ko: string },
	desc: { en: string, ko: string },
	icon: string,
	maxLevel: number,
	baseCost: number,
	growth: number,
}

local upgrades: { UpgradeDef } = {
	{
		id = "pads",
		name = { en = "More Pads", ko = "발판 추가" },
		desc = { en = "+1 slime pad in your base", ko = "기지 발판 +1" },
		icon = "🟩",
		maxLevel = 10,
		baseCost = 300,
		growth = 2.5,
	},
	{
		id = "speed",
		name = { en = "Speedy Shoes", ko = "날쌘 신발" },
		desc = { en = "+1.5 walk speed", ko = "이동 속도 +1.5" },
		icon = "👟",
		maxLevel = 8,
		baseCost = 500,
		growth = 2.8,
	},
	{
		id = "lock",
		name = { en = "Stronger Lock", ko = "튼튼한 잠금" },
		desc = { en = "+15s base lock time", ko = "기지 잠금 +15초" },
		icon = "🔒",
		maxLevel = 4,
		baseCost = 8000,
		growth = 6,
	},
	{
		id = "offline",
		name = { en = "Night Shift", ko = "야간 근무" },
		desc = { en = "+10% offline earnings, +1h cap", ko = "오프라인 수입 +10%, 최대 +1시간" },
		icon = "🌙",
		maxLevel = 5,
		baseCost = 15000,
		growth = 5,
	},
	{
		id = "luck",
		name = { en = "Lucky Touch", ko = "행운의 손길" },
		desc = { en = "+1.5% chance a bought slime mutates", ko = "구매한 슬라임 변이 확률 +1.5%" },
		icon = "🍀",
		maxLevel = 10,
		baseCost = 2000,
		growth = 2.7,
	},
	{
		id = "bonk",
		name = { en = "Heavy Hammer", ko = "묵직한 뿅망치" },
		desc = { en = "Faster bonk cooldown, bigger knockback", ko = "뿅망치 재사용 단축, 넉백 증가" },
		icon = "🔨",
		maxLevel = 5,
		baseCost = 1000,
		growth = 4,
	},
}

local upgradeById: { [string]: UpgradeDef } = {}
for _, u in upgrades do
	upgradeById[u.id] = u
end

return {
	startCash = 100,
	sellRatio = 0.5,

	basePads = 10,
	passPads = 4, -- 게임패스 "발판 +4"
	maxPads = 24,

	star = {
		max = 5,
		mult = { 1, 3.5, 12, 40, 135 },
		scale = { 1, 1.2, 1.45, 1.75, 2.1 },
		carryWeight = { 0, 0.05, 0.1, 0.15, 0.2 },
		holdBonus = { 0, 0.3, 0.6, 0.9, 1.2 },
	},

	rebirth = {
		multPer = 0.5, -- 환생 1회당 수입 +50%
		baseCost = 4e6,
		costGrowth = 7,
		-- 환생 r → r+1 에 필요한 최소 보유 등급
		rarityReq = { "epic", "epic", "legendary", "legendary", "mythic", "mythic", "mythic", "mythic" },
		rarityReqLate = "secret",
	},

	offline = {
		baseRate = 0.2,
		ratePerLevel = 0.1,
		baseCapHours = 2,
		capHoursPerLevel = 1,
		minSeconds = 60,
	},

	friendBoostPer = 0.1,
	friendBoostMax = 0.4,
	groupBoost = 0.1,
	indexBonusPer = 0.005,

	parade = {
		interval = 2.5, -- 초마다 1마리
		speed = 7, -- studs/s
		buyRange = 16, -- 서버 검증 거리(프롬프트 거리 + 지연 여유)
		promptRange = 10,
	},

	steal = {
		timeout = 60,
		afterTheftShield = 30,
		rookieShieldSeconds = 600,
		minCarryMult = 0.35,
		revengeSeconds = 15,
		revengeSpeed = 6,
		stealRange = 14,
		thiefProCarryBonus = 0.25,
	},

	lock = {
		baseDuration = 60,
		perLevel = 15,
		cooldown = 10,
	},

	bonk = {
		baseCooldown = 1.0,
		cooldownPerLevel = 0.08,
		range = 9,
		stun = 1.2,
		knockback = 55,
		knockbackPerLevel = 8,
	},

	walkSpeed = {
		base = 16,
		perLevel = 1.5,
	},

	vipMult = 1.5,
	doubleCashMult = 2,
	boostCashMult = 2,

	upgrades = upgrades,
	upgradeById = upgradeById,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Mutations</string>
            <string name="Source"><![CDATA[--!strict
-- 변이 정의. 새 변이 추가 = list에 한 줄 + (선택) SlimeBuilder의 look 처리.
--   mult       : 수입·가치 배수
--   luckWeight : "행운의 손길"(구매 시 무작위 변이)에서의 가중치
--   color      : 몸 색(nil이면 원래 색 유지), material: 몸 재질 이름
--   label      : 머리 위 표시 색

export type Mutation = {
	id: string,
	order: number,
	name: { en: string, ko: string },
	mult: number,
	luckWeight: number,
	color: Color3?,
	material: string?,
	transparency: number?,
	reflectance: number?,
	label: Color3,
	sparkle: Color3?,
	light: Color3?,
}

local rgb = Color3.fromRGB

local list: { Mutation } = {
	{
		id = "none",
		order = 0,
		name = { en = "Normal", ko = "일반" },
		mult = 1,
		luckWeight = 0,
		label = rgb(255, 255, 255),
	},
	{
		id = "gold",
		order = 1,
		name = { en = "Gold", ko = "황금" },
		mult = 2,
		luckWeight = 60,
		color = rgb(255, 200, 40),
		material = "Foil",
		reflectance = 0.2,
		label = rgb(255, 210, 60),
		sparkle = rgb(255, 230, 120),
	},
	{
		id = "diamond",
		order = 2,
		name = { en = "Diamond", ko = "다이아" },
		mult = 3,
		luckWeight = 25,
		color = rgb(170, 240, 255),
		material = "Glass",
		transparency = 0.25,
		reflectance = 0.35,
		label = rgb(140, 230, 255),
		sparkle = rgb(220, 250, 255),
	},
	{
		id = "candy",
		order = 3,
		name = { en = "Candy", ko = "사탕" },
		mult = 4,
		luckWeight = 10,
		color = rgb(255, 130, 200),
		material = "SmoothPlastic",
		label = rgb(255, 140, 210),
		sparkle = rgb(255, 200, 235),
	},
	{
		id = "lava",
		order = 4,
		name = { en = "Lava", ko = "용암" },
		mult = 5,
		luckWeight = 4,
		color = rgb(255, 90, 20),
		material = "CrackedLava",
		label = rgb(255, 120, 40),
		light = rgb(255, 120, 40),
	},
	{
		id = "rainbow",
		order = 5,
		name = { en = "Rainbow", ko = "무지개" },
		mult = 7,
		luckWeight = 0.9,
		color = rgb(255, 80, 80),
		material = "SmoothPlastic",
		label = rgb(255, 120, 255),
		sparkle = rgb(255, 255, 255),
	},
	{
		id = "galaxy",
		order = 6,
		name = { en = "Galaxy", ko = "은하" },
		mult = 10,
		luckWeight = 0.1,
		color = rgb(90, 40, 200),
		material = "ForceField",
		label = rgb(170, 120, 255),
		sparkle = rgb(200, 180, 255),
		light = rgb(140, 90, 255),
	},
}

local byId: { [string]: Mutation } = {}
for _, m in list do
	byId[m.id] = m
end

return {
	list = list,
	byId = byId,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Products</string>
            <string name="Source"><![CDATA[--!strict
-- 게임패스 · 개발자 상품.
-- Creator Dashboard(create.roblox.com)에서 만든 뒤 숫자 ID를 id 칸에 넣으세요.
-- id가 0이면 상점에 표시되지 않고, 관련 혜택은 꺼진 상태로 동작합니다.

export type Pass = {
	key: string,
	id: number,
	icon: string,
	name: { en: string, ko: string },
	desc: { en: string, ko: string },
}

export type Product = {
	key: string,
	id: number,
	icon: string,
	name: { en: string, ko: string },
	desc: { en: string, ko: string },
}

local passes: { Pass } = {
	{
		key = "vip",
		id = 0,
		icon = "👑",
		name = { en = "VIP", ko = "VIP" },
		desc = { en = "x1.5 income forever + VIP chat tag", ko = "수입 영구 ×1.5 + VIP 채팅 태그" },
	},
	{
		key = "doubleCash",
		id = 0,
		icon = "💰",
		name = { en = "2x Cash", ko = "수입 2배" },
		desc = { en = "Double all income forever", ko = "모든 수입 영구 2배" },
	},
	{
		key = "autoCollect",
		id = 0,
		icon = "🧲",
		name = { en = "Auto Collect", ko = "자동 수금" },
		desc = { en = "Cash goes straight to your wallet", ko = "수금 발판 없이 바로 지갑으로" },
	},
	{
		key = "extraPads",
		id = 0,
		icon = "🟪",
		name = { en = "+4 Pads", ko = "발판 +4" },
		desc = { en = "4 extra slime pads", ko = "슬라임 발판 4칸 추가" },
	},
	{
		key = "thiefPro",
		id = 0,
		icon = "🥷",
		name = { en = "Pro Thief", ko = "프로 도둑" },
		desc = { en = "Run 25% faster while carrying", ko = "슬라임을 들고 25% 더 빨리 달리기" },
	},
}

local products: { Product } = {
	{
		key = "serverLuck",
		id = 0,
		icon = "🍀",
		name = { en = "Server Luck x2", ko = "서버 행운 ×2" },
		desc = { en = "15 min of x2 luck for EVERYONE", ko = "15분간 서버 전체 행운 ×2" },
	},
	{
		key = "rainbowStorm",
		id = 0,
		icon = "🌈",
		name = { en = "Summon Rainbow Storm", ko = "무지개 폭풍 소환" },
		desc = { en = "Start a Rainbow Storm for the whole server", ko = "서버 전체에 무지개 폭풍 시작" },
	},
	{
		key = "cashSmall",
		id = 0,
		icon = "💵",
		name = { en = "Pile of Cash", ko = "현금 한 뭉치" },
		desc = { en = "10 minutes of income", ko = "수입 10분치" },
	},
	{
		key = "cashMedium",
		id = 0,
		icon = "💰",
		name = { en = "Bag of Cash", ko = "현금 한 자루" },
		desc = { en = "1 hour of income", ko = "수입 1시간치" },
	},
	{
		key = "cashLarge",
		id = 0,
		icon = "🏦",
		name = { en = "Vault of Cash", ko = "현금 금고" },
		desc = { en = "5 hours of income", ko = "수입 5시간치" },
	},
}

local passByKey: { [string]: Pass } = {}
for _, p in passes do
	passByKey[p.key] = p
end
local productByKey: { [string]: Product } = {}
local productById: { [number]: Product } = {}
for _, p in products do
	productByKey[p.key] = p
	if p.id ~= 0 then
		productById[p.id] = p
	end
end

return {
	passes = passes,
	passByKey = passByKey,
	products = products,
	productByKey = productByKey,
	productById = productById,
	cashPackMinutes = { cashSmall = 10, cashMedium = 60, cashLarge = 300 },
	cashPackMin = { cashSmall = 5000, cashMedium = 30000, cashLarge = 150000 },
	serverLuckSeconds = 900,
	-- 그룹 ID(선택): 그룹 가입자 수입 +10%. 0이면 끔.
	groupId = 0,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Rarities</string>
            <string name="Source"><![CDATA[--!strict
-- 등급 정의. order가 클수록 희귀합니다.
-- weight: 행진 등장 가중치(서버 행운 1배 기준), payback: 가격 = 수입 × payback(초)
-- stealHold: 훔치기 길게 누르기 시간(초), carryWeight: 들고 갈 때 속도 감소량(0~1)

export type Rarity = {
	id: string,
	order: number,
	name: { en: string, ko: string },
	color: Color3,
	weight: number,
	payback: number,
	stealHold: number,
	carryWeight: number,
	announce: boolean,
	glow: boolean,
}

local list: { Rarity } = {
	{
		id = "common",
		order = 1,
		name = { en = "Common", ko = "일반" },
		color = Color3.fromRGB(190, 196, 204),
		weight = 55,
		payback = 20,
		stealHold = 1.0,
		carryWeight = 0.10,
		announce = false,
		glow = false,
	},
	{
		id = "uncommon",
		order = 2,
		name = { en = "Uncommon", ko = "고급" },
		color = Color3.fromRGB(96, 214, 96),
		weight = 28,
		payback = 35,
		stealHold = 1.2,
		carryWeight = 0.16,
		announce = false,
		glow = false,
	},
	{
		id = "rare",
		order = 3,
		name = { en = "Rare", ko = "희귀" },
		color = Color3.fromRGB(70, 150, 255),
		weight = 12,
		payback = 60,
		stealHold = 1.5,
		carryWeight = 0.24,
		announce = false,
		glow = false,
	},
	{
		id = "epic",
		order = 4,
		name = { en = "Epic", ko = "영웅" },
		color = Color3.fromRGB(176, 92, 255),
		weight = 4,
		payback = 100,
		stealHold = 1.8,
		carryWeight = 0.32,
		announce = false,
		glow = false,
	},
	{
		id = "legendary",
		order = 5,
		name = { en = "Legendary", ko = "전설" },
		color = Color3.fromRGB(255, 186, 36),
		weight = 0.85,
		payback = 150,
		stealHold = 2.2,
		carryWeight = 0.40,
		announce = true,
		glow = true,
	},
	{
		id = "mythic",
		order = 6,
		name = { en = "Mythic", ko = "신화" },
		color = Color3.fromRGB(255, 64, 120),
		weight = 0.13,
		payback = 220,
		stealHold = 2.6,
		carryWeight = 0.46,
		announce = true,
		glow = true,
	},
	{
		id = "secret",
		order = 7,
		name = { en = "SECRET", ko = "비밀" },
		color = Color3.fromRGB(30, 30, 36),
		weight = 0.02,
		payback = 320,
		stealHold = 3.0,
		carryWeight = 0.52,
		announce = true,
		glow = true,
	},
}

local byId: { [string]: Rarity } = {}
for _, r in list do
	byId[r.id] = r
end

return {
	list = list,
	byId = byId,
	count = #list,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[--!strict
-- 보상 표: 7일 출석, 접속 선물, 일일 퀘스트.
-- 보상 형식(Reward):
--   cashMinutes/minCash : 현재 수입 N분치 현금(최소 minCash)
--   boost/seconds       : 개인 부스트("cash2x")
--   giftRarity          : 해당 등급 이상 슬라임 1마리(빈 발판 없으면 판매가 현금)
--   serverLuck          : 서버 전체 행운 ×2 (초)

export type Reward = {
	cashMinutes: number?,
	minCash: number?,
	boost: string?,
	seconds: number?,
	giftRarity: string?,
	serverLuck: number?,
}

export type QuestDef = {
	id: string,
	kind: string,
	goals: { number },
	text: { en: string, ko: string },
	reward: Reward,
}

local daily: { Reward } = {
	{ cashMinutes = 3, minCash = 300 },
	{ boost = "cash2x", seconds = 600 },
	{ cashMinutes = 8, minCash = 800 },
	{ serverLuck = 300 },
	{ cashMinutes = 15, minCash = 2000 },
	{ boost = "cash2x", seconds = 1200 },
	{ giftRarity = "epic" },
}

export type Gift = { minutes: number, reward: Reward }

local gifts: { Gift } = {
	{ minutes = 2, reward = { cashMinutes = 2, minCash = 150 } },
	{ minutes = 5, reward = { boost = "cash2x", seconds = 300 } },
	{ minutes = 10, reward = { giftRarity = "uncommon" } },
	{ minutes = 15, reward = { cashMinutes = 5, minCash = 1000 } },
	{ minutes = 25, reward = { giftRarity = "rare" } },
	{ minutes = 40, reward = { boost = "cash2x", seconds = 900 } },
	{ minutes = 60, reward = { giftRarity = "epic" } },
}

local quests: { QuestDef } = {
	{
		id = "buy",
		kind = "buy",
		goals = { 8, 12, 20 },
		text = { en = "Buy {n} slimes", ko = "슬라임 {n}마리 구매하기" },
		reward = { cashMinutes = 5, minCash = 500 },
	},
	{
		id = "buyRare",
		kind = "buyRare",
		goals = { 1, 2 },
		text = { en = "Buy {n} Rare+ slimes", ko = "희귀 이상 슬라임 {n}마리 구매하기" },
		reward = { cashMinutes = 8, minCash = 800 },
	},
	{
		id = "merge",
		kind = "merge",
		goals = { 1, 2, 3 },
		text = { en = "Merge slimes {n} times", ko = "슬라임 {n}번 합성하기" },
		reward = { cashMinutes = 8, minCash = 800 },
	},
	{
		id = "steal",
		kind = "steal",
		goals = { 1, 2 },
		text = { en = "Steal {n} slimes", ko = "슬라임 {n}마리 훔치기" },
		reward = { cashMinutes = 10, minCash = 1000 },
	},
	{
		id = "bonk",
		kind = "bonk",
		goals = { 10, 20 },
		text = { en = "Bonk players {n} times", ko = "뿅망치로 {n}번 때리기" },
		reward = { cashMinutes = 5, minCash = 500 },
	},
	{
		id = "defend",
		kind = "defend",
		goals = { 1 },
		text = { en = "Bonk a thief {n} time", ko = "도둑을 {n}번 저지하기" },
		reward = { boost = "cash2x", seconds = 600 },
	},
	{
		id = "collect",
		kind = "collect",
		goals = { 10, 20 },
		text = { en = "Collect cash {n} times", ko = "수금 {n}번 하기" },
		reward = { cashMinutes = 4, minCash = 400 },
	},
	{
		id = "play",
		kind = "playtime",
		goals = { 600, 1200 },
		text = { en = "Play for {t}", ko = "{t} 동안 플레이하기" },
		reward = { cashMinutes = 6, minCash = 600 },
	},
	{
		id = "upgrade",
		kind = "upgrade",
		goals = { 2, 3 },
		text = { en = "Buy {n} upgrades", ko = "업그레이드 {n}번 하기" },
		reward = { cashMinutes = 6, minCash = 600 },
	},
}

local questById: { [string]: QuestDef } = {}
for _, q in quests do
	questById[q.id] = q
end

return {
	daily = daily,
	gifts = gifts,
	quests = quests,
	questById = questById,
	questsPerDay = 3,
	questAllBonus = { giftRarity = "rare" } :: Reward,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Slimes</string>
            <string name="Source"><![CDATA[--!strict
-- 슬라임 종류 표. 새 슬라임 추가 = 아래 list에 한 줄 추가.
--   income    : ★1·변이 없음 기준 초당 수입
--   price     : 비워 두면 income × 등급 payback 으로 자동 계산(보기 좋은 숫자로 반올림)
--   color     : 몸 색, accent: 장식 기본 색
--   material  : Enum.Material 이름(선택)
--   accessories: SlimeBuilder의 장식 함수 이름 목록
--   transparency: 몸 투명도(선택)

local Rarities = require(script.Parent.Rarities)

export type Species = {
	id: string,
	name: { en: string, ko: string },
	rarity: string,
	income: number,
	price: number,
	color: Color3,
	accent: Color3,
	material: string?,
	transparency: number?,
	accessories: { string },
}

type Def = {
	id: string,
	en: string,
	ko: string,
	rarity: string,
	income: number,
	price: number?,
	color: Color3,
	accent: Color3?,
	material: string?,
	transparency: number?,
	acc: { string }?,
}

local rgb = Color3.fromRGB

local defs: { Def } = {
	-- 일반
	{ id = "blobby", en = "Blobby", ko = "말랑이", rarity = "common", income = 1, color = rgb(130, 222, 120) },
	{ id = "droplet", en = "Droplet", ko = "물방울", rarity = "common", income = 2, color = rgb(110, 190, 255), acc = { "droplet" } },
	{ id = "mochi", en = "Mochi", ko = "찹쌀떡", rarity = "common", income = 3, color = rgb(255, 232, 238), accent = rgb(255, 120, 170), acc = { "bow" } },
	{ id = "bubbles", en = "Bubbles", ko = "방울이", rarity = "common", income = 5, color = rgb(150, 235, 255), material = "Glass", transparency = 0.2, acc = { "bubbles" } },
	{ id = "jellybean", en = "Jelly Bean", ko = "젤리빈", rarity = "common", income = 7, color = rgb(255, 150, 60), accent = rgb(90, 200, 90), acc = { "sprout" } },
	{ id = "pudding", en = "Pudding", ko = "푸딩", rarity = "common", income = 10, color = rgb(255, 222, 110), accent = rgb(150, 85, 40), acc = { "caramel" } },
	-- 고급
	{ id = "leafy", en = "Leafy", ko = "풀잎이", rarity = "uncommon", income = 15, color = rgb(70, 190, 90), accent = rgb(40, 150, 60), acc = { "leaf" } },
