      <Item class="Folder" referent="23">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- 숫자·시간·문장 포맷.

local Format = {}

local SUFFIXES = {
	"K",
	"M",
	"B",
	"T",
	"Qa",
	"Qi",
	"Sx",
	"Sp",
	"Oc",
	"No",
	"Dc",
	"Ud",
	"Dd",
	"Td",
	"Qad",
	"Qid",
	"Sxd",
	"Spd",
	"Ocd",
	"Nod",
	"Vg",
}

-- 1234 → "1.23K", 12345678 → "12.3M"
function Format.number(n: number): string
	if n ~= n then
		return "0"
	end
	if n < 0 then
		return "-" .. Format.number(-n)
	end
	if n < 1000 then
		if n < 10 and n ~= math.floor(n) then
			return string.format("%.1f", math.floor(n * 10) / 10)
		end
		return tostring(math.floor(n))
	end
	-- log10의 부동소수 오차 보정(1000 → 2.9999… 같은 경우)
	local tier = math.max(1, math.floor(math.log10(n) / 3))
	while n >= 10 ^ ((tier + 1) * 3) do
		tier += 1
	end
	while tier > 1 and n < 10 ^ (tier * 3) do
		tier -= 1
	end
	local scaled = n / 10 ^ (tier * 3)
	local suffix = SUFFIXES[tier]
	if not suffix then
		return string.format("%.2e", n)
	end
	local text
	if scaled >= 100 then
		text = string.format("%d", math.floor(scaled))
	elseif scaled >= 10 then
		text = string.format("%.1f", math.floor(scaled * 10) / 10)
	else
		text = string.format("%.2f", math.floor(scaled * 100) / 100)
	end
	-- "1.50" → "1.5", "2.00" → "2"
	if string.find(text, ".", 1, true) then
		text = string.gsub(text, "0+$", "")
		text = string.gsub(text, "%.$", "")
	end
	return text .. suffix
end

function Format.cash(n: number): string
	return "$" .. Format.number(n)
end

-- 초 → "45s" / "4:05" / "1h 05m"
function Format.time(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	if s < 60 then
		return s .. "s"
	elseif s < 3600 then
		return string.format("%d:%02d", s // 60, s % 60)
	else
		return string.format("%dh %02dm", s // 3600, (s % 3600) // 60)
	end
end

-- "Buy {n} slimes" + { n = 3 } → "Buy 3 slimes"
function Format.fill(template: string, args: { [string]: any }?): string
	if not args then
		return template
	end
	local out = string.gsub(template, "{(%w+)}", function(key: string): string
		local v = args[key]
		if v == nil then
			return "{" .. key .. "}"
		end
		return tostring(v)
	end)
	return out
end

-- 배수 표시: 1.5 → "x1.5", 2 → "x2"
function Format.mult(m: number): string
	if m == math.floor(m) then
		return "x" .. Format.number(m)
	end
	if m < 100 then
		local t = string.format("%.2f", m)
		t = string.gsub(t, "0+$", "")
		t = string.gsub(t, "%.$", "")
		return "x" .. t
	end
	return "x" .. Format.number(m)
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Loop</string>
            <string name="Source"><![CDATA[--!strict
-- 반복 작업 도우미: 한 번의 오류가 루프 전체를 멈추지 않게 합니다.

local Loop = {}

-- fn을 안전하게 실행. 오류가 나면 label과 함께 경고를 남기고 false
function Loop.try(label: string, fn: () -> ()): boolean
	local packed = table.pack(pcall(fn))
	if not packed[1] then
		warn(string.format("[%s] %s", label, tostring(packed[2])))
		return false
	end
	return true
end

-- interval초마다 fn 실행(별도 스레드)
function Loop.every(label: string, interval: number, fn: () -> ())
	task.spawn(function()
		while true do
			task.wait(interval)
			Loop.try(label, fn)
		end
	end)
end

return Loop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Rng</string>
            <string name="Source"><![CDATA[--!strict
-- 시드 고정 난수(퀘스트 선택처럼 "같은 날 같은 결과"가 필요한 곳에 사용).
-- mulberry32 알고리즘. 전투·뽑기에는 Random.new()를 씁니다.

local Rng = {}
Rng.__index = Rng

export type Rng = typeof(setmetatable({} :: { state: number }, Rng))

function Rng.new(seed: number): Rng
	return setmetatable({ state = bit32.band(math.floor(seed), 0xFFFFFFFF) }, Rng)
end

local function mul32(a: number, b: number): number
	-- 32비트 곱셈(하위 32비트). 16비트로 쪼개 double 정밀도 손실 방지
	local aHi, aLo = bit32.rshift(a, 16), bit32.band(a, 0xFFFF)
	local bHi, bLo = bit32.rshift(b, 16), bit32.band(b, 0xFFFF)
	local lo = aLo * bLo
	local mid = bit32.band(aHi * bLo + aLo * bHi, 0xFFFF)
	return bit32.band(lo + mid * 65536, 0xFFFFFFFF)
end

-- [0, 1)
function Rng.next(self: Rng): number
	self.state = bit32.band(self.state + 0x6D2B79F5, 0xFFFFFFFF)
	local t = self.state
	t = mul32(bit32.bxor(t, bit32.rshift(t, 15)), bit32.bor(t, 1))
	t = bit32.bxor(t, t + mul32(bit32.bxor(t, bit32.rshift(t, 7)), bit32.bor(t, 61)))
	t = bit32.band(t, 0xFFFFFFFF)
	return bit32.bxor(t, bit32.rshift(t, 14)) / 4294967296
end

-- [a, b] 정수
function Rng.int(self: Rng, a: number, b: number): number
	return a + math.floor(self:next() * (b - a + 1))
end

return Rng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- 가벼운 시그널(BindableEvent 없이). 연결된 함수는 task.spawn으로 실행되어
-- 한 리스너의 오류·대기가 다른 리스너를 막지 않습니다.

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

type Listener = { fn: (...any) -> (), connected: boolean }

export type Signal = {
	_listeners: { Listener },
	Connect: (self: Signal, fn: (...any) -> ()) -> Connection,
	Once: (self: Signal, fn: (...any) -> ()) -> Connection,
	Fire: (self: Signal, ...any) -> (),
	Wait: (self: Signal) -> ...any,
}

local Signal = {}

local function connect(self: Signal, fn: (...any) -> ()): Connection
	local listener: Listener = { fn = fn, connected = true }
	table.insert(self._listeners, listener)
	local conn: Connection = {
		Connected = true,
		Disconnect = function(c: Connection)
			c.Connected = false
			listener.connected = false
			local i = table.find(self._listeners, listener)
			if i then
				table.remove(self._listeners, i)
			end
		end,
	}
	return conn
end

local function once(self: Signal, fn: (...any) -> ()): Connection
	local conn: Connection? = nil
	conn = connect(self, function(...)
		if conn then
			conn:Disconnect()
		end
		fn(...)
	end)
	return conn :: Connection
end

local function fire(self: Signal, ...: any)
	for _, listener in table.clone(self._listeners) do
		if listener.connected then
			task.spawn(listener.fn, ...)
		end
	end
end

local function wait(self: Signal): ...any
	local thread = coroutine.running()
	once(self, function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal.new(): Signal
	return {
		_listeners = {},
		Connect = connect,
		Once = once,
		Fire = fire,
		Wait = wait,
	}
end

return Signal
]]></string>
          </Properties>
        </Item>
