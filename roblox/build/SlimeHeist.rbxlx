	frenzyStart = { en = "⚡ SLIME FRENZY! x5 luck, x2 income for 3 minutes!", ko = "⚡ 슬라임 대폭주! 3분간 행운 ×5, 수입 ×2!" },
	frenzyEnd = { en = "Frenzy is over. See you next hour!", ko = "대폭주 끝! 다음 정각에 또 만나요!" },
	serverLuck = { en = "🍀 {name} gave everyone x2 luck for {minutes} min!", ko = "🍀 {name}님이 모두에게 {minutes}분간 행운 ×2 선물!" },
	stormBought = { en = "🌈 {name} summoned a Rainbow Storm!", ko = "🌈 {name}님이 무지개 폭풍을 불렀어요!" },

	-- 성장
	shopTitle = { en = "Upgrades", ko = "업그레이드" },
	rebirthTitle = { en = "Rebirth", ko = "환생" },
	rebirthHeader = { en = "Rebirth {a} → {b}", ko = "환생 {a} → {b}" },
	rebirthBonus = { en = "Income bonus {a} → {b}", ko = "수입 보너스 {a} → {b}" },
	rebirthCash = { en = "Cash {a} / {b}", ko = "현금 {a} / {b}" },
	rebirthRarity = { en = "Own a {rarity}+ slime", ko = "{rarity} 이상 슬라임 보유" },
	rebirthInfo = {
		en = "Resets cash & slimes. Keeps upgrades, Index and your ⭐ favorite slime.",
		ko = "현금과 슬라임은 초기화, 업그레이드·도감·⭐즐겨찾기 슬라임은 유지돼요.",
	},
	rebirthButton = { en = "REBIRTH!", ko = "환생하기!" },
	rebirthNeedCash = { en = "Not enough cash to rebirth!", ko = "환생할 현금이 부족해요!" },
	rebirthNeedRarity = { en = "You need a rarer slime to rebirth!", ko = "환생하려면 더 희귀한 슬라임이 필요해요!" },
	rebirthAnnounce = { en = "♻️ {name} reached Rebirth {n}!", ko = "♻️ {name}님이 {n}번째 환생!" },
	boostEnded = { en = "Your x2 cash boost ended.", ko = "수입 2배 부스트가 끝났어요." },
	friendJoined = { en = "👋 Your friend {name} joined! +10% income", ko = "👋 친구 {name}님 입장! 수입 +10%" },

	-- 도감
	indexTitle = { en = "Slime Index", ko = "슬라임 도감" },
	indexSummary = { en = "Found {a}/{b}  ·  +{p}% income", ko = "발견 {a}/{b}  ·  수입 +{p}%" },

	-- 퀘스트·출석·선물
	questsTitle = { en = "Quests", ko = "퀘스트" },
	dailyTitle = { en = "Daily Login", ko = "매일 출석" },
	dayN = { en = "Day {n}", ko = "{n}일차" },
	claimDaily = { en = "CLAIM TODAY", ko = "오늘 보상 받기" },
	comeBackTomorrow = { en = "Come back tomorrow!", ko = "내일 또 오세요!" },
	todayQuests = { en = "Today's Quests", ko = "오늘의 퀘스트" },
	questBonus = { en = "All 3 done: {reward}", ko = "3개 모두 완료: {reward}" },
	newQuestsIn = { en = "New quests in {t}", ko = "새 퀘스트까지 {t}" },
	questDone = { en = "✅ Quest complete! Claim your reward.", ko = "✅ 퀘스트 완료! 보상을 받으세요." },
	questAllDone = { en = "🏆 All quests done! Bonus slime!", ko = "🏆 퀘스트 전부 완료! 보너스 슬라임!" },
	newQuests = { en = "📜 New daily quests!", ko = "📜 새 일일 퀘스트!" },
	rewardCash = { en = "{m} min of cash", ko = "수입 {m}분치" },
	rewardSlime = { en = "{rarity}+ slime", ko = "{rarity}+ 슬라임" },
	rewardServerLuck = { en = "Server luck {t}", ko = "서버 행운 {t}" },
	giftsTitle = { en = "Free Gifts", ko = "무료 선물" },

	-- 스토어
	storeTitle = { en = "Store", ko = "스토어" },
	storePasses = { en = "Game Passes", ko = "게임패스" },
	storeProducts = { en = "Boosts", ko = "부스트" },
	storeSoon = { en = "Store coming soon!", ko = "스토어 준비 중이에요!" },
	thanksPurchase = { en = "💖 Thank you for your support!", ko = "💖 구매해 주셔서 감사해요!" },

	-- 오프라인
	offlineTitle = { en = "Welcome back!", ko = "돌아온 걸 환영해요!" },
	offlineText = {
		en = "While you were away ({t}), your slimes made {cash}!",
		ko = "자리를 비운 동안({t}) 슬라임들이 {cash}을(를) 벌었어요!",
	},
	collectIt = { en = "COLLECT", ko = "받기" },

	-- 설정·튜토리얼
	settingsTitle = { en = "Settings", ko = "설정" },
	sfx = { en = "Sound", ko = "효과음" },
	skipTutorial = { en = "Skip tutorial", ko = "튜토리얼 건너뛰기" },
	howToPlay = {
		en = "HOW TO PLAY\n1. Buy slimes from the Slime Parade in the middle.\n2. Slimes make cash at your base. Step on the GREEN plate to collect.\n3. Merge 3 same slimes into a bigger ★ slime.\n4. Steal slimes from other bases (hold E) and run home!\n5. BONK thieves with F. Step on the RED plate to lock your base.\n6. Weather turns slimes Gold, Diamond, Rainbow... Every hour: SLIME FRENZY!",
		ko = "게임 방법\n1. 가운데 슬라임 행진에서 슬라임을 사세요.\n2. 슬라임이 기지에서 돈을 벌어요. 초록 발판을 밟아 수금!\n3. 같은 슬라임 3마리를 합치면 더 큰 ★ 슬라임!\n4. 남의 기지 슬라임을 훔쳐서(E 길게) 집으로 달려요!\n5. 도둑은 F로 뿅! 빨간 발판을 밟으면 기지 잠금.\n6. 날씨가 슬라임을 황금·다이아·무지개로! 매시 정각은 슬라임 대폭주!",
	},
	tut0 = { en = "👉 Walk to the Slime Parade and buy a slime (E)!", ko = "👉 슬라임 행진으로 가서 슬라임을 사세요 (E)!" },
	tut1wait = { en = "💰 Your slime is making cash at your base...", ko = "💰 기지의 슬라임이 돈을 벌고 있어요..." },
	tut1 = { en = "👉 Step on the GREEN plate at your base to collect!", ko = "👉 기지의 초록 발판을 밟아 수금하세요!" },
	tut2 = { en = "👉 Step on the RED plate to lock your base from thieves!", ko = "👉 빨간 발판을 밟아 도둑으로부터 기지를 잠그세요!" },
	tipMerge = { en = "💡 Tip: 3 same slimes = MERGE into a ★ slime (x3.5 income)!", ko = "💡 팁: 같은 슬라임 3마리 = ★ 합성 (수입 ×3.5)!" },
	tipBonk = { en = "💡 Tip: Press F (or 🔨) to BONK thieves and make them drop slimes!", ko = "💡 팁: F(또는 🔨)로 도둑을 때리면 슬라임을 떨어뜨려요!" },
	tipWeather = { en = "💡 Tip: Weather events mutate slimes. Stay online!", ko = "💡 팁: 날씨 이벤트 중엔 슬라임이 변이해요. 접속해 있으세요!" },
	tipSteal = { en = "💡 Tip: Hold E on other players' slimes to STEAL them!", ko = "💡 팁: 남의 슬라임에 E를 길게 누르면 훔칠 수 있어요!" },
}

return T
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Weather</string>
            <string name="Source"><![CDATA[--!strict
-- 날씨 이벤트. 이벤트 중 행진 슬라임과 기지 슬라임에 변이가 붙습니다.
-- 새 날씨 추가 = events에 한 줄(변이 id는 Mutations에 있어야 함).

export type WeatherEvent = {
	id: string,
	name: { en: string, ko: string },
	desc: { en: string, ko: string },
	mutation: string,
	duration: number,
	weight: number,
	luck: number, -- 이벤트 중 서버 행운 배수
	-- 연출(클라이언트)
	clockTime: number,
	ambient: Color3,
	tint: Color3,
	fog: Color3,
	particle: string, -- "rain" | "snow" | "sparkle" | "ember" | "stars" | "candy"
	particleColor: Color3,
}

local rgb = Color3.fromRGB

local events: { WeatherEvent } = {
	{
		id = "golden",
		name = { en = "Golden Hour", ko = "황금 시간" },
		desc = { en = "Slimes may turn GOLD (x2)!", ko = "슬라임이 황금(×2)으로 변할 수 있어요!" },
		mutation = "gold",
		duration = 120,
		weight = 35,
		luck = 1,
		clockTime = 17.6,
		ambient = rgb(150, 120, 70),
		tint = rgb(255, 225, 160),
		fog = rgb(255, 210, 140),
		particle = "sparkle",
		particleColor = rgb(255, 220, 90),
	},
	{
		id = "crystal",
		name = { en = "Crystal Storm", ko = "수정 폭풍" },
		desc = { en = "Slimes may turn DIAMOND (x3)!", ko = "슬라임이 다이아(×3)로 변할 수 있어요!" },
		mutation = "diamond",
		duration = 120,
		weight = 25,
		luck = 1,
		clockTime = 9,
		ambient = rgb(110, 150, 190),
		tint = rgb(200, 235, 255),
		fog = rgb(190, 230, 255),
		particle = "snow",
		particleColor = rgb(200, 245, 255),
	},
	{
		id = "sugar",
		name = { en = "Sugar Rush", ko = "슈가 러시" },
		desc = { en = "Slimes may turn CANDY (x4)!", ko = "슬라임이 사탕(×4)으로 변할 수 있어요!" },
		mutation = "candy",
		duration = 120,
		weight = 18,
		luck = 1.5,
		clockTime = 13,
		ambient = rgb(170, 110, 150),
		tint = rgb(255, 205, 235),
		fog = rgb(255, 190, 225),
		particle = "candy",
		particleColor = rgb(255, 140, 210),
	},
	{
		id = "volcano",
		name = { en = "Volcano Eruption", ko = "화산 폭발" },
		desc = { en = "Slimes may turn LAVA (x5)!", ko = "슬라임이 용암(×5)으로 변할 수 있어요!" },
		mutation = "lava",
		duration = 120,
		weight = 12,
		luck = 1.5,
		clockTime = 19.2,
		ambient = rgb(160, 70, 40),
		tint = rgb(255, 190, 160),
		fog = rgb(120, 50, 30),
		particle = "ember",
		particleColor = rgb(255, 120, 40),
	},
	{
		id = "rainbow",
		name = { en = "Rainbow Storm", ko = "무지개 폭풍" },
		desc = { en = "Slimes may turn RAINBOW (x7)!", ko = "슬라임이 무지개(×7)로 변할 수 있어요!" },
		mutation = "rainbow",
		duration = 150,
		weight = 7,
		luck = 2,
		clockTime = 12,
		ambient = rgb(150, 140, 180),
		tint = rgb(240, 230, 255),
		fog = rgb(230, 210, 255),
		particle = "rain",
		particleColor = rgb(255, 255, 255),
	},
	{
		id = "meteor",
		name = { en = "Meteor Shower", ko = "유성우" },
		desc = { en = "Slimes may turn GALAXY (x10)!", ko = "슬라임이 은하(×10)로 변할 수 있어요!" },
		mutation = "galaxy",
		duration = 150,
		weight = 3,
		luck = 3,
		clockTime = 0.5,
		ambient = rgb(70, 60, 130),
		tint = rgb(190, 180, 255),
		fog = rgb(30, 20, 70),
		particle = "stars",
		particleColor = rgb(200, 180, 255),
	},
}

local byId: { [string]: WeatherEvent } = {}
for _, e in events do
	byId[e.id] = e
end

return {
	events = events,
	byId = byId,
	calmDuration = 240, -- 이벤트 사이 맑은 시간(초)
	paradeMutationChance = 0.3, -- 이벤트 중 행진 슬라임에 이벤트 변이가 붙을 확률
	baseMutationChance = 0.02, -- 이벤트 중 기지 슬라임이 10초마다 변이를 얻을 확률
	baseMutationInterval = 10,
	-- 평상시 행진 슬라임 변이 확률(날씨 무관)
	ambientMutationChance = 0.03,
	-- 슬라임 대폭주: 매시 정각(UTC)부터 frenzyDuration초
	frenzy = {
		duration = 180,
		luck = 5,
		incomeMult = 2,
		events = { "rainbow", "meteor" },
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[--!strict
-- 맵 배치 수치와 좌표 계산. 서버(맵 생성·검증)와 클라이언트(행진 그리기)가 같이 씁니다.
--
--            북(+Z) 출구 포털
--   서쪽 기지 5~8  |도로|  동쪽 기지 1~4
--            남(-Z) 입구 포털 · 광장(순위표)
--
-- 기지 좌표계: 원점 = 기지 입구 가운데 바닥, LookVector = 기지 안쪽.
--   x = 좌우, d = 입구에서 안쪽으로 들어간 거리

local Economy = require(script.Parent.Economy)

local World = {}

World.groundTop = 0
World.floorTop = 1
World.padTop = 1.4

World.road = {
	halfWidth = 9,
	startZ = -178,
	endZ = 178,
	top = 0.2,
}

World.parade = {
	x = 0,
	startZ = -172,
	endZ = 172,
}

World.plot = {
	count = 8,
	frontX = 30,
	width = 68,
	depth = 76,
	wallHeight = 18,
	wallThickness = 2,
	zCenters = { -114, -38, 38, 114 },
}

World.pads = {
	cols = 6,
	rows = 4,
	colSpacing = 11,
	firstRowDepth = 24,
	rowSpacing = 12,
	size = 8,
}

World.front = {
	collect = { x = -14, d = 9 },
	lock = { x = 14, d = 9 },
	spawn = { x = 0, d = 11 },
	plateSize = 8,
}

World.plaza = {
	centerZ = -212,
	spawn = Vector3.new(0, 1, -205),
}

World.bounds = {
	minX = -175,
	maxX = 175,
	minZ = -262,
	maxZ = 205,
}

-- 기지 i의 기준 좌표계
function World.plotFrame(i: number): CFrame
	local side = if i <= 4 then 1 else -1
	local zc = World.plot.zCenters[(i - 1) % 4 + 1]
	local origin = Vector3.new(side * World.plot.frontX, 0, zc)
	return CFrame.lookAt(origin, origin + Vector3.new(side, 0, 0))
end

-- 기지 좌표(x, 높이 y, 깊이 d) → 월드 CFrame(기지 안쪽을 바라봄)
function World.plotPoint(i: number, x: number, y: number, d: number): CFrame
	return World.plotFrame(i) * CFrame.new(x, y, -d)
end

-- 발판 p(1~24)의 기지 좌표
function World.padLocal(p: number): (number, number)
	local cols = World.pads.cols
	local row = math.floor((p - 1) / cols) + 1
	local col = (p - 1) % cols + 1
	local x = -((cols - 1) * World.pads.colSpacing) / 2 + (col - 1) * World.pads.colSpacing
	local d = World.pads.firstRowDepth + (row - 1) * World.pads.rowSpacing
	return x, d
end

-- 발판 위 슬라임 기준점(바닥 중심). 슬라임은 도로 쪽(입구)을 바라봅니다.
function World.padCFrame(i: number, p: number): CFrame
	local x, d = World.padLocal(p)
	return World.plotPoint(i, x, World.padTop, d) * CFrame.Angles(0, math.pi, 0)
end

-- 월드 좌표 → 기지 좌표 (x, y, d)
function World.toPlotLocal(i: number, pos: Vector3): (number, number, number)
	local rel = World.plotFrame(i):PointToObjectSpace(pos)
	return rel.X, rel.Y, -rel.Z
end

function World.isInsidePlot(i: number, pos: Vector3, margin: number?): boolean
	local m = margin or 0
	local x, y, d = World.toPlotLocal(i, pos)
	local half = World.plot.width / 2
	return math.abs(x) <= half + m and d >= -m and d <= World.plot.depth + m and y > -10 and y < 60
end

-- 입구 밖(도로 쪽) 안전한 위치: 잠긴 기지에서 밀어낼 때 사용
function World.outsidePlot(i: number): CFrame
	return World.plotPoint(i, 0, 3, -8) * CFrame.Angles(0, math.pi, 0)
end

function World.spawnCFrame(i: number): CFrame
	return World.plotPoint(i, World.front.spawn.x, World.floorTop + 3, World.front.spawn.d)
		* CFrame.Angles(0, math.pi, 0)
end

World.paradeLength = World.parade.endZ - World.parade.startZ
World.paradeDuration = World.paradeLength / Economy.parade.speed

-- 행진 슬라임이 출발 후 t초에 있는 위치(바닥 중심). 끝을 지나면 nil.
function World.paradePosition(t: number): Vector3?
	if t < 0 or t > World.paradeDuration then
		return nil
	end
	return Vector3.new(World.parade.x, World.road.top, World.parade.startZ + t * Economy.parade.speed)
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="14">
        <Properties>
          <string name="Name">Logic</string>
        </Properties>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Calc</string>
            <string name="Source"><![CDATA[--!strict
-- 경제 공식 모음(순수 함수). 서버가 판정에 쓰고, 클라이언트는 같은 공식으로 미리보기를 보여줍니다.

local Shared = script.Parent.Parent
local Economy = require(Shared.Config.Economy)
local Slimes = require(Shared.Config.Slimes)
local Rarities = require(Shared.Config.Rarities)
local Mutations = require(Shared.Config.Mutations)
local Weather = require(Shared.Config.Weather)
local Types = require(Shared.Types)

type SlimeData = Types.SlimeData
type PlayerData = Types.PlayerData
type IncomeContext = Types.IncomeContext

local Calc = {}

function Calc.starMult(star: number): number
	return Economy.star.mult[math.clamp(star, 1, Economy.star.max)]
end

function Calc.starScale(star: number): number
	return Economy.star.scale[math.clamp(star, 1, Economy.star.max)]
end

function Calc.mutMult(mut: string): number
	local m = Mutations.byId[mut]
	return if m then m.mult else 1
end

function Calc.rarityOf(speciesId: string): number
	local s = Slimes.byId[speciesId]
	if not s then
		return 0
	end
	return Rarities.byId[s.rarity].order
end

-- 슬라임 1마리의 초당 수입(배수 적용 전)
function Calc.slimeIncome(s: { id: string, star: number, mut: string }): number
	local species = Slimes.byId[s.id]
	if not species then
		return 0
	end
	return species.income * Calc.starMult(s.star) * Calc.mutMult(s.mut)
end

-- 슬라임 가치(★n = 같은 슬라임 3^(n-1)마리를 합친 것)
function Calc.slimeValue(s: { id: string, star: number, mut: string }): number
	local species = Slimes.byId[s.id]
	if not species then
		return 0
	end
	return species.price * 3 ^ (math.clamp(s.star, 1, Economy.star.max) - 1) * Calc.mutMult(s.mut)
end

function Calc.sellPrice(s: { id: string, star: number, mut: string }): number
	return math.floor(Calc.slimeValue(s) * Economy.sellRatio)
end

function Calc.baseIncome(data: PlayerData): number
	local total = 0
	for _, s in data.slimes do
		total += Calc.slimeIncome(s)
	end
	return total
end

function Calc.indexCount(data: PlayerData): number
	local n = 0
	for speciesId, muts in data.index do
		if Slimes.byId[speciesId] then
			for mutId, found in muts do
				if found and Mutations.byId[mutId] then
					n += 1
				end
			end
		end
	end
	return n
end

function Calc.indexTotal(): number
	return #Slimes.list * #Mutations.list
end

function Calc.rebirthMult(rebirths: number): number
	return 1 + Economy.rebirth.multPer * rebirths
end

function Calc.friendMult(friends: number): number
	return 1 + math.min(Economy.friendBoostMax, friends * Economy.friendBoostPer)
end

-- 모든 수입 배수를 곱한 값
function Calc.multiplier(data: PlayerData, ctx: IncomeContext): number
	local m = Calc.rebirthMult(data.rebirths)
	m *= 1 + Calc.indexCount(data) * Economy.indexBonusPer
	m *= Calc.friendMult(ctx.friends)
	if ctx.group then
		m *= 1 + Economy.groupBoost
	end
	if ctx.vip then
		m *= Economy.vipMult
	end
	if ctx.doubleCash then
		m *= Economy.doubleCashMult
	end
	if (data.boosts.cash2x or 0) > 0 then
		m *= Economy.boostCashMult
	end
	if ctx.frenzy then
		m *= Weather.frenzy.incomeMult
	end
	return m
end

function Calc.incomePerSecond(data: PlayerData, ctx: IncomeContext): number
	return Calc.baseIncome(data) * Calc.multiplier(data, ctx)
end

function Calc.upgradeLevel(data: PlayerData, id: string): number
	return data.upgrades[id] or 0
end

-- 다음 단계 비용. 최대치면 nil
function Calc.upgradeCost(id: string, level: number): number?
	local def = Economy.upgradeById[id]
	if not def or level >= def.maxLevel then
		return nil
	end
	local raw = def.baseCost * def.growth ^ level
	local mag = 10 ^ math.max(0, math.floor(math.log10(raw)) - 1)
	return math.floor(raw / mag + 0.5) * mag
end

function Calc.padCount(data: PlayerData, extraPads: boolean): number
	local n = Economy.basePads + Calc.upgradeLevel(data, "pads")
	if extraPads then
		n += Economy.passPads
	end
	return math.min(n, Economy.maxPads)
end

function Calc.walkSpeed(data: PlayerData): number
	return Economy.walkSpeed.base + Economy.walkSpeed.perLevel * Calc.upgradeLevel(data, "speed")
end

function Calc.lockDuration(data: PlayerData): number
	return Economy.lock.baseDuration + Economy.lock.perLevel * Calc.upgradeLevel(data, "lock")
end

function Calc.bonkCooldown(data: PlayerData): number
	return Economy.bonk.baseCooldown - Economy.bonk.cooldownPerLevel * Calc.upgradeLevel(data, "bonk")
end

function Calc.bonkKnockback(data: PlayerData): number
	return Economy.bonk.knockback + Economy.bonk.knockbackPerLevel * Calc.upgradeLevel(data, "bonk")
end

-- 구매한 슬라임에 무작위 변이가 붙을 확률
function Calc.luckyTouchChance(data: PlayerData): number
	return 0.015 * Calc.upgradeLevel(data, "luck")
end

function Calc.offlineRate(data: PlayerData): number
	return Economy.offline.baseRate + Economy.offline.ratePerLevel * Calc.upgradeLevel(data, "offline")
end

function Calc.offlineCapSeconds(data: PlayerData): number
	return (Economy.offline.baseCapHours + Economy.offline.capHoursPerLevel * Calc.upgradeLevel(data, "offline"))
		* 3600
end

-- 오프라인 보상. (금액, 인정된 초)
function Calc.offlineEarnings(data: PlayerData, awaySeconds: number, incomePerSecond: number): (number, number)
	if awaySeconds < Economy.offline.minSeconds or incomePerSecond <= 0 then
		return 0, 0
	end
	local counted = math.min(awaySeconds, Calc.offlineCapSeconds(data))
	return math.floor(counted * incomePerSecond * Calc.offlineRate(data)), counted
end

function Calc.rebirthCost(rebirths: number): number
	return Economy.rebirth.baseCost * Economy.rebirth.costGrowth ^ rebirths
end

function Calc.rebirthRarityReq(rebirths: number): string
	return Economy.rebirth.rarityReq[rebirths + 1] or Economy.rebirth.rarityReqLate
end

function Calc.bestRarityOwned(data: PlayerData): number
	local best = 0
	for _, s in data.slimes do
		best = math.max(best, Calc.rarityOf(s.id))
	end
	return best
end

-- 환생 가능 여부. (가능?, 실패 이유 텍스트 키)
function Calc.canRebirth(data: PlayerData): (boolean, string?)
	if data.cash < Calc.rebirthCost(data.rebirths) then
		return false, "rebirthNeedCash"
	end
	local req = Rarities.byId[Calc.rebirthRarityReq(data.rebirths)]
	if Calc.bestRarityOwned(data) < req.order then
		return false, "rebirthNeedRarity"
	end
	return true, nil
end

-- 들고 달릴 때 속도 배수
function Calc.carrySpeedMult(s: { id: string, star: number }, thiefPro: boolean): number
	local species = Slimes.byId[s.id]
	local weight = if species then Rarities.byId[species.rarity].carryWeight else 0
	weight += Economy.star.carryWeight[math.clamp(s.star, 1, Economy.star.max)]
	local mult = 1 - weight
	if thiefPro then
		mult *= 1 + Economy.steal.thiefProCarryBonus
	end
	return math.clamp(mult, Economy.steal.minCarryMult, 1)
end

-- 훔치기 길게 누르기 시간
function Calc.stealHold(s: { id: string, star: number }): number
	local species = Slimes.byId[s.id]
	local base = if species then Rarities.byId[species.rarity].stealHold else 1
	return base + Economy.star.holdBonus[math.clamp(s.star, 1, Economy.star.max)]
end

-- 보상용 현금: 현재 수입 N분치(최소값 보장)
function Calc.cashReward(minutes: number, minCash: number, incomePerSecond: number): number
	return math.floor(math.max(minCash, incomePerSecond * 60 * minutes))
end

return Calc
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Data</string>
            <string name="Source"><![CDATA[--!strict
-- 저장 데이터 기본값 · 버전 이전 · 정리(순수 함수).
-- 구조를 바꿀 때: VERSION을 올리고 migrations에 이전 함수를 추가하세요.

local Shared = script.Parent.Parent
local Economy = require(Shared.Config.Economy)
local Slimes = require(Shared.Config.Slimes)
local Mutations = require(Shared.Config.Mutations)
local Types = require(Shared.Types)

type PlayerData = Types.PlayerData
type SlimeData = Types.SlimeData

local Data = {}

Data.VERSION = 1

function Data.default(): PlayerData
	return {
		version = Data.VERSION,
		cash = Economy.startCash,
		vault = 0,
		totalEarned = 0,
		rebirths = 0,
		steals = 0,
		slimes = {},
		nextUid = 1,
		upgrades = {},
		index = {},
		boosts = {},
		daily = { streak = 0, lastDay = -1 },
		quests = { day = -1, list = {}, bonusClaimed = false },
		tutorial = 0,
		lastOnline = 0,
		playTime = 0,
		settings = { music = true, sfx = true },
		receipts = {},
		stats = { bought = 0, merges = 0, bonks = 0, stolenFrom = 0 },
	}
end

-- 버전별 이전 함수: migrations[n] 은 버전 n 데이터를 n+1로 바꿉니다.
local migrations: { [number]: (any) -> () } = {}

local function num(v: any, default: number, min: number?, max: number?): number
	if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge then
		return default
	end
	if min and v < min then
		return min
	end
	if max and v > max then
		return max
	end
	return v
end

local function bool(v: any, default: boolean): boolean
	if type(v) == "boolean" then
		return v
	end
	return default
end

local function tbl(v: any): { [any]: any }
	if type(v) == "table" then
		return v
	end
	return {}
end

-- 어떤 값이 들어와도 올바른 PlayerData를 돌려줍니다(손상·누락 필드 복구).
function Data.reconcile(raw: any): PlayerData
	local d = Data.default()
	if type(raw) ~= "table" then
		return d
	end
	local src: { [string]: any } = raw

	local version = num(src.version, 0, 0)
	while version < Data.VERSION do
		local m = migrations[version]
		if m then
			m(src)
		end
		version += 1
	end

	d.cash = num(src.cash, d.cash, 0)
	d.vault = num(src.vault, 0, 0)
	d.totalEarned = num(src.totalEarned, 0, 0)
	d.rebirths = math.floor(num(src.rebirths, 0, 0))
	d.steals = math.floor(num(src.steals, 0, 0))
	d.nextUid = math.floor(num(src.nextUid, 1, 1))
	d.tutorial = math.floor(num(src.tutorial, 0, 0))
	d.lastOnline = num(src.lastOnline, 0, 0)
	d.playTime = num(src.playTime, 0, 0)

	for id, level in tbl(src.upgrades) do
		local def = Economy.upgradeById[id]
		if def then
			d.upgrades[id] = math.floor(num(level, 0, 0, def.maxLevel))
		end
	end

	for speciesId, muts in tbl(src.index) do
		if type(speciesId) == "string" and Slimes.byId[speciesId] then
			local entry = {}
			for mutId, found in tbl(muts) do
				if type(mutId) == "string" and Mutations.byId[mutId] and found == true then
					entry[mutId] = true
				end
			end
			d.index[speciesId] = entry
		end
	end

	for key, seconds in tbl(src.boosts) do
		if type(key) == "string" then
			local s = num(seconds, 0, 0)
			if s > 0 then
				d.boosts[key] = s
			end
		end
	end

	local daily = tbl(src.daily)
	d.daily.streak = math.floor(num(daily.streak, 0, 0, 7))
	d.daily.lastDay = math.floor(num(daily.lastDay, -1))

	local quests = tbl(src.quests)
	d.quests.day = math.floor(num(quests.day, -1))
	d.quests.bonusClaimed = bool(quests.bonusClaimed, false)
	for _, q in tbl(quests.list) do
		if type(q) == "table" and type(q.id) == "string" then
			table.insert(d.quests.list, {
				id = q.id,
				goal = math.max(1, num(q.goal, 1, 1)),
				progress = num(q.progress, 0, 0),
				claimed = bool(q.claimed, false),
			})
		end
	end

	local settings = tbl(src.settings)
	d.settings.music = bool(settings.music, true)
	d.settings.sfx = bool(settings.sfx, true)

	for _, r in tbl(src.receipts) do
		if type(r) == "string" then
			table.insert(d.receipts, r)
		end
	end

	local stats = tbl(src.stats)
	d.stats.bought = num(stats.bought, 0, 0)
	d.stats.merges = num(stats.merges, 0, 0)
	d.stats.bonks = num(stats.bonks, 0, 0)
	d.stats.stolenFrom = num(stats.stolenFrom, 0, 0)

	-- 슬라임: 알 수 없는 종류는 버리고, 발판 번호가 겹치거나 범위를 벗어나면 다시 배정
	local usedPads: { [number]: boolean } = {}
	local needPad: { string } = {}
	local favSeen = false
	local maxUid = 0
	for uid, s in tbl(src.slimes) do
		if type(uid) == "string" and type(s) == "table" and type(s.id) == "string" and Slimes.byId[s.id] then
			local mut = if type(s.mut) == "string" and Mutations.byId[s.mut] then s.mut else "none"
			local slime: SlimeData = {
				id = s.id,
				star = math.floor(num(s.star, 1, 1, Economy.star.max)),
				mut = mut,
				pad = math.floor(num(s.pad, 0, 0)),
				fav = nil,
			}
			if s.fav == true and not favSeen then
				slime.fav = true
				favSeen = true
			end
			if slime.pad < 1 or slime.pad > Economy.maxPads or usedPads[slime.pad] then
				table.insert(needPad, uid)
			else
				usedPads[slime.pad] = true
			end
			d.slimes[uid] = slime
			local n = tonumber(uid)
			if n then
				maxUid = math.max(maxUid, n)
			end
		end
	end
	table.sort(needPad)
	for _, uid in needPad do
		local pad = Data.freePadFrom(usedPads, Economy.maxPads)
		if pad then
			usedPads[pad] = true
			d.slimes[uid].pad = pad
		else
			d.slimes[uid] = nil -- 자리가 전혀 없으면(이론상 불가) 제거
		end
	end
	d.nextUid = math.max(d.nextUid, maxUid + 1)
	d.version = Data.VERSION
	return d
end

function Data.freePadFrom(used: { [number]: boolean }, padCount: number): number?
	for p = 1, padCount do
		if not used[p] then
			return p
		end
	end
	return nil
end

function Data.usedPads(data: PlayerData): { [number]: boolean }
	local used = {}
	for _, s in data.slimes do
		used[s.pad] = true
	end
	return used
end

function Data.freePad(data: PlayerData, padCount: number): number?
	return Data.freePadFrom(Data.usedPads(data), padCount)
end

function Data.slimeCount(data: PlayerData): number
	local n = 0
	for _ in data.slimes do
		n += 1
	end
	return n
end

-- 새 uid 발급
function Data.newUid(data: PlayerData): string
	local uid = tostring(data.nextUid)
	data.nextUid += 1
	return uid
end

-- 도감 등록. 새로 발견했으면 true
function Data.discover(data: PlayerData, speciesId: string, mut: string): boolean
	local entry = data.index[speciesId]
	if not entry then
		entry = {}
		data.index[speciesId] = entry
	end
	if entry[mut] then
		return false
	end
	entry[mut] = true
	return true
end

-- 영수증 기록(최근 50개만 유지)
function Data.addReceipt(data: PlayerData, receiptId: string)
	table.insert(data.receipts, receiptId)
	while #data.receipts > 50 do
		table.remove(data.receipts, 1)
	end
end

function Data.hasReceipt(data: PlayerData, receiptId: string): boolean
	return table.find(data.receipts, receiptId) ~= nil
end

return Data
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Merge</string>
            <string name="Source"><![CDATA[--!strict
-- ★ 합성 규칙(순수 함수).
-- 같은 종류·같은 ★ 3마리 → ★+1 한 마리. 변이는 셋 중 가장 좋은 것.
-- 재료는 "누른 슬라임 + 변이가 가장 낮은 같은 슬라임 2마리"(즐겨찾기·이동 중인 슬라임 제외).

local Shared = script.Parent.Parent
local Economy = require(Shared.Config.Economy)
local Mutations = require(Shared.Config.Mutations)
local Types = require(Shared.Types)

type SlimeData = Types.SlimeData

local Merge = {}

local function mutOrder(mut: string): number
	local m = Mutations.byId[mut]
	return if m then m.order else 0
end

-- 합성 재료 uid 3개(첫 번째가 target). 불가능하면 nil
function Merge.findSet(slimes: { [string]: SlimeData }, targetUid: string, busy: { [string]: boolean }?): { string }?
	local target = slimes[targetUid]
	if not target or target.star >= Economy.star.max then
		return nil
	end
	if busy and busy[targetUid] then
		return nil
	end
	local candidates: { string } = {}
	for uid, s in slimes do
		if uid ~= targetUid and s.id == target.id and s.star == target.star and not s.fav then
			if not (busy and busy[uid]) then
				table.insert(candidates, uid)
			end
		end
	end
	if #candidates < 2 then
		return nil
	end
	table.sort(candidates, function(a, b)
		local ma, mb = mutOrder(slimes[a].mut), mutOrder(slimes[b].mut)
		if ma ~= mb then
			return ma < mb
		end
		return a < b
	end)
	return { targetUid, candidates[1], candidates[2] }
end

-- 합성 결과(새 슬라임 데이터). 발판은 target 자리.
function Merge.result(slimes: { [string]: SlimeData }, set: { string }): SlimeData
	local target = slimes[set[1]]
	local best = target.mut
	local fav = target.fav == true
	for i = 2, #set do
		local s = slimes[set[i]]
		if mutOrder(s.mut) > mutOrder(best) then
			best = s.mut
		end
	end
	return {
		id = target.id,
		star = target.star + 1,
		mut = best,
		pad = target.pad,
		fav = if fav then true else nil,
	}
end

-- 합성 가능한 조합 수(UI 배지용): 종류·★ 별로 3마리씩 묶은 개수
function Merge.countAvailable(slimes: { [string]: SlimeData }): number
	local groups: { [string]: number } = {}
	for _, s in slimes do
		if s.star < Economy.star.max and not s.fav then
			local key = s.id .. "#" .. s.star
			groups[key] = (groups[key] or 0) + 1
		end
	end
	local n = 0
	for _, count in groups do
		n += count // 3
	end
	return n
end

return Merge
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Progress</string>
            <string name="Source"><![CDATA[--!strict
-- 일일 퀘스트 · 출석 · 접속 선물 · 대폭주 시각 계산(순수 함수).

local Shared = script.Parent.Parent
local Rewards = require(Shared.Config.Rewards)
local Weather = require(Shared.Config.Weather)
local Rng = require(Shared.Util.Rng)
local Types = require(Shared.Types)

type PlayerData = Types.PlayerData
type QuestState = Types.QuestState

local Progress = {}

local DAY = 86400

-- UTC 기준 날짜 번호
function Progress.dayNumber(unixTime: number): number
	return math.floor(unixTime / DAY)
end

function Progress.secondsUntilNextDay(unixTime: number): number
	return DAY - (unixTime % DAY)
end

-- 오늘의 퀘스트 3개(유저·날짜별로 고정)
function Progress.generateQuests(day: number, userId: number): { QuestState }
	local rng = Rng.new(day * 7919 + (userId % 1000003) * 31 + 17)
	local pool = table.clone(Rewards.quests)
	local out: { QuestState } = {}
	for _ = 1, math.min(Rewards.questsPerDay, #pool) do
		local i = rng:int(1, #pool)
		local def = table.remove(pool, i) :: Rewards.QuestDef
		local goal = def.goals[rng:int(1, #def.goals)]
		table.insert(out, { id = def.id, goal = goal, progress = 0, claimed = false })
	end
	return out
end

-- 날짜가 바뀌었으면 퀘스트를 새로 뽑습니다. 바뀌었으면 true
function Progress.refreshQuests(data: PlayerData, now: number, userId: number): boolean
	local day = Progress.dayNumber(now)
	if data.quests.day == day and #data.quests.list > 0 then
		return false
	end
	data.quests.day = day
	data.quests.list = Progress.generateQuests(day, userId)
	data.quests.bonusClaimed = false
	return true
end

-- 퀘스트 진행 이벤트. 진행도가 바뀌었으면 true
function Progress.questEvent(data: PlayerData, kind: string, amount: number): boolean
	local changed = false
	for _, q in data.quests.list do
		local def = Rewards.questById[q.id]
		if def and def.kind == kind and not q.claimed and q.progress < q.goal then
			q.progress = math.min(q.goal, q.progress + amount)
			changed = true
		end
	end
	return changed
end

function Progress.allQuestsClaimed(data: PlayerData): boolean
	if #data.quests.list == 0 then
		return false
	end
	for _, q in data.quests.list do
		if not q.claimed then
			return false
		end
	end
	return true
end

-- 출석 보상 상태: (오늘 받을 수 있나?, 받게 될 날짜 칸 1~7)
function Progress.dailyStatus(data: PlayerData, now: number): (boolean, number)
	local day = Progress.dayNumber(now)
	if data.daily.lastDay == day then
		return false, math.max(1, data.daily.streak)
	end
	local streak = data.daily.streak
	if data.daily.lastDay ~= day - 1 or streak >= #Rewards.daily then
		streak = 0 -- 하루 빠졌거나 7일 완주 → 1일차부터
	end
	return true, streak + 1
end

-- 출석 처리. 받은 칸 번호 반환(못 받으면 nil)
function Progress.claimDaily(data: PlayerData, now: number): number?
	local can, slot = Progress.dailyStatus(data, now)
	if not can then
		return nil
	end
	data.daily.streak = slot
	data.daily.lastDay = Progress.dayNumber(now)
	return slot
end

-- 접속 선물 i를 지금 받을 수 있나
function Progress.giftReady(i: number, sessionSeconds: number): boolean
	local g = Rewards.gifts[i]
	return g ~= nil and sessionSeconds >= g.minutes * 60
end

-- 대폭주: 매시 정각(UTC)부터 duration초
function Progress.frenzyActive(unixTime: number): boolean
	return unixTime % 3600 < Weather.frenzy.duration
end

function Progress.frenzyEndsAt(unixTime: number): number
	return unixTime - unixTime % 3600 + Weather.frenzy.duration
end

function Progress.secondsUntilFrenzy(unixTime: number): number
	if Progress.frenzyActive(unixTime) then
		return 0
	end
	return 3600 - unixTime % 3600
end

return Progress
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Roll</string>
            <string name="Source"><![CDATA[--!strict
-- 뽑기(순수 함수). rand는 [0,1) 난수를 돌려주는 함수입니다.

local Shared = script.Parent.Parent
local Rarities = require(Shared.Config.Rarities)
local Slimes = require(Shared.Config.Slimes)
local Mutations = require(Shared.Config.Mutations)
local Weather = require(Shared.Config.Weather)

type Rand = () -> number

local Roll = {}

-- 행운이 등급 가중치에 주는 효과: 영웅 이상 ×luck, 희귀 ×√luck, 일반·고급은 그대로.
-- (희귀까지 크게 올리면 전체 합이 커져서 전설 이상 확률이 덜 오르므로)
function Roll.rarityWeight(order: number, baseWeight: number, luck: number): number
	if order >= 4 then
		return baseWeight * luck
	elseif order == 3 then
		return baseWeight * math.sqrt(luck)
	end
	return baseWeight
end

function Roll.pickWeighted<T>(items: { T }, weightOf: (T) -> number, rand: Rand): T
	local total = 0
	for _, item in items do
		total += math.max(0, weightOf(item))
	end
	local r = rand() * total
	for _, item in items do
		local w = math.max(0, weightOf(item))
		if r < w then
			return item
		end
		r -= w
	end
	return items[#items]
end

-- 등급 확률표(합=1). UI 표시와 테스트에 사용
function Roll.rarityChances(luck: number, minOrder: number?): { [string]: number }
	local total = 0
	for _, r in Rarities.list do
		if r.order >= (minOrder or 1) then
			total += Roll.rarityWeight(r.order, r.weight, luck)
		end
	end
	local out = {}
	for _, r in Rarities.list do
		if r.order >= (minOrder or 1) then
			out[r.id] = Roll.rarityWeight(r.order, r.weight, luck) / total
		else
			out[r.id] = 0
		end
	end
	return out
end

function Roll.rarity(luck: number, rand: Rand, minOrder: number?): string
	local pool = {}
	for _, r in Rarities.list do
		if r.order >= (minOrder or 1) then
			table.insert(pool, r)
		end
	end
	local picked = Roll.pickWeighted(pool, function(r)
		return Roll.rarityWeight(r.order, r.weight, luck)
	end, rand)
	return picked.id
end

-- 같은 등급 안에서는 싼 슬라임이 더 자주 나옵니다(가중치 n, n-1, ..., 1)
function Roll.species(rarityId: string, rand: Rand): string
	local bucket = Slimes.byRarity[rarityId]
	assert(bucket and #bucket > 0, "no slimes for rarity " .. rarityId)
	local n = #bucket
	local indices = {}
	for i = 1, n do
		indices[i] = i
	end
	local i = Roll.pickWeighted(indices, function(idx)
		return n - idx + 1
	end, rand)
	return bucket[i].id
end

-- 행운의 손길/평상시 변이: luckWeight 기준
function Roll.randomMutation(rand: Rand): string
	local pool = {}
	for _, m in Mutations.list do
		if m.luckWeight > 0 then
			table.insert(pool, m)
		end
	end
	return Roll.pickWeighted(pool, function(m)
		return m.luckWeight
	end, rand).id
end

-- 행진 슬라임 변이: 날씨 변이 우선, 없으면 평상시 확률
function Roll.paradeMutation(weatherMutation: string?, rand: Rand): string
	if weatherMutation and rand() < Weather.paradeMutationChance then
		return weatherMutation
	end
	if rand() < Weather.ambientMutationChance then
		return Roll.randomMutation(rand)
	end
	return "none"
end

-- 더 좋은 변이인가?
function Roll.isBetterMutation(new: string, old: string): boolean
	local a, b = Mutations.byId[new], Mutations.byId[old]
	if not a then
		return false
	end
	if not b then
		return true
	end
	return a.mult > b.mult
end

return Roll
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- 원격 이벤트 이름과 생성/조회. 서버가 만들고 클라이언트는 기다려서 받습니다.
--
-- 클라이언트 → 서버
--   Action (RemoteFunction) : (name, payload) → { ok, msg?, ... }   UI 조작 전부
--   Bonk   (RemoteEvent)    : 뿅망치 휘두르기
-- 서버 → 클라이언트
--   State  : StateView 전체
--   Money  : { cash, vault, income }
--   Notify : { kind, key, args? }
--   Parade : { op = "spawn" | "remove" | "sync", ... }
--   Fx     : 연출 이벤트 { kind, ... }

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

local FOLDER = "Remotes"
local EVENTS = { "State", "Money", "Notify", "Parade", "Fx", "Bonk" }
local FUNCTIONS = { "Action" }

local function folder(): Folder
	if RunService:IsServer() then
		local f = ReplicatedStorage:FindFirstChild(FOLDER)
		if not f then
			local created = Instance.new("Folder")
			created.Name = FOLDER
			for _, name in EVENTS do
				local e = Instance.new("RemoteEvent")
				e.Name = name
				e.Parent = created
			end
			for _, name in FUNCTIONS do
				local fn = Instance.new("RemoteFunction")
				fn.Name = name
				fn.Parent = created
			end
			created.Parent = ReplicatedStorage
			f = created
		end
		return f :: Folder
	end
	return ReplicatedStorage:WaitForChild(FOLDER) :: Folder
end

function Net.event(name: string): RemoteEvent
	assert(table.find(EVENTS, name), "unknown remote event " .. name)
	return folder():WaitForChild(name) :: RemoteEvent
end

function Net.func(name: string): RemoteFunction
	assert(table.find(FUNCTIONS, name), "unknown remote function " .. name)
	return folder():WaitForChild(name) :: RemoteFunction
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">SlimeBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- 슬라임 모델을 기본 도형(파트)만으로 조립합니다. 외부 에셋이 필요 없습니다.
-- 서버(기지 슬라임·들고 가는 슬라임)와 클라이언트(행진·도감 미리보기)가 같이 씁니다.
--
-- 좌표: 기준점(origin) = 슬라임 바닥 중심, 얼굴은 origin의 LookVector(-Z) 방향.
-- 몸 크기(★1): 가로 4 × 높이 3.2 × 세로 4. ★에 따라 전체가 커집니다.
--
-- 새 장식 추가: ACCESSORIES 표에 함수 하나 추가 → Config/Slimes의 acc에 이름 사용.

local Shared = script.Parent
local Slimes = require(Shared.Config.Slimes)
local Rarities = require(Shared.Config.Rarities)
local Mutations = require(Shared.Config.Mutations)
local Economy = require(Shared.Config.Economy)

local SlimeBuilder = {}

export type BuildInfo = {
	id: string,
	star: number,
	mut: string,
}

type PartOpts = {
	shape: string?, -- "sphere"(늘어나는 타원체) | "ball" | "cylinder" | nil(상자)
	material: Enum.Material?,
	transparency: number?,
	reflectance: number?,
	shadow: boolean?,
}

-- 몸 타원체 반지름(★1 기준)
local RX, RY, RZ = 2, 1.6, 2
local CY = 1.6

type Ctx = {
	model: Model,
	origin: CFrame,
	s: number,
	accent: Color3,
	body: Color3,
}

local function makePart(ctx: Ctx, name: string, size: Vector3, localCf: CFrame, color: Color3, opts: PartOpts?): Part
	local o: PartOpts = opts or {}
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = o.shadow == true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = o.material or Enum.Material.SmoothPlastic
	p.Color = color
	p.Transparency = o.transparency or 0
	p.Reflectance = o.reflectance or 0
	p.Size = size * ctx.s
	local shape = o.shape
	if shape == "sphere" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	elseif shape == "ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "cylinder" then
		p.Shape = Enum.PartType.Cylinder
	end
	-- localCf의 위치만 크기 배율을 적용
	local pos = localCf.Position * ctx.s
	p.CFrame = ctx.origin * (CFrame.new(pos) * (localCf - localCf.Position))
	p.Parent = ctx.model
	return p
end

local function v(x: number, y: number, z: number): Vector3
	return Vector3.new(x, y, z)
end

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z)
end

local rad = math.rad

-- 몸 표면 위의 점(높이 h: -1~1, 방위각 theta: 0=정면)
local function onSurface(theta: number, h: number, inset: number?): Vector3
	local r = math.sqrt(math.max(0, 1 - h * h))
	local k = 1 - (inset or 0)
	return Vector3.new(RX * r * math.sin(theta) * k, CY + h * RY * k, -RZ * r * math.cos(theta) * k)
end

-- 정면(-Z) 표면의 z 좌표
local function frontZ(x: number, y: number): number
	local t = 1 - (x / RX) ^ 2 - ((y - CY) / RY) ^ 2
	return -RZ * math.sqrt(math.max(0, t))
end

-- 세로 원기둥(원기둥 축은 X이므로 Z축으로 90도 회전)
local UPRIGHT = CFrame.Angles(0, 0, rad(90))

local ACCESSORIES: { [string]: (ctx: Ctx) -> () } = {}

ACCESSORIES.droplet = function(ctx)
	makePart(ctx, "Droplet", v(0.8, 1.1, 0.8), at(0, 3.55, 0), ctx.body, { shape = "sphere" })
end

ACCESSORIES.bow = function(ctx)
	makePart(ctx, "BowL", v(0.95, 0.6, 0.35), at(0.55, 3.0, 0.2) * CFrame.Angles(0, 0, rad(25)), ctx.accent, { shape = "sphere" })
	makePart(ctx, "BowR", v(0.95, 0.6, 0.35), at(1.45, 3.0, 0.2) * CFrame.Angles(0, 0, rad(-25)), ctx.accent, { shape = "sphere" })
	makePart(ctx, "Knot", v(0.4, 0.4, 0.4), at(1.0, 3.0, 0.2), ctx.accent, { shape = "ball" })
end

ACCESSORIES.bubbles = function(ctx)
	local glass = { shape = "ball", material = Enum.Material.Glass, transparency = 0.35 }
	makePart(ctx, "Bubble1", v(0.55, 0.55, 0.55), at(1.9, 2.9, 0.7), Color3.fromRGB(210, 245, 255), glass)
	makePart(ctx, "Bubble2", v(0.4, 0.4, 0.4), at(-2.0, 2.2, -0.4), Color3.fromRGB(210, 245, 255), glass)
	makePart(ctx, "Bubble3", v(0.32, 0.32, 0.32), at(1.3, 3.8, -0.5), Color3.fromRGB(210, 245, 255), glass)
end

ACCESSORIES.sprout = function(ctx)
	makePart(ctx, "Stem", v(0.7, 0.16, 0.16), at(0, 3.45, 0) * UPRIGHT, ctx.accent, { shape = "cylinder" })
	makePart(ctx, "LeafL", v(0.7, 0.14, 0.35), at(-0.33, 3.8, 0) * CFrame.Angles(0, 0, rad(-25)), ctx.accent, { shape = "sphere" })
	makePart(ctx, "LeafR", v(0.7, 0.14, 0.35), at(0.33, 3.8, 0) * CFrame.Angles(0, 0, rad(25)), ctx.accent, { shape = "sphere" })
end

ACCESSORIES.caramel = function(ctx)
	makePart(ctx, "Caramel", v(3.0, 0.7, 3.0), at(0, 2.95, 0), ctx.accent, { shape = "sphere" })
end

ACCESSORIES.leaf = function(ctx)
	makePart(ctx, "Stem", v(0.6, 0.18, 0.18), at(0.1, 3.4, 0) * UPRIGHT, Color3.fromRGB(90, 60, 30), { shape = "cylinder" })
	makePart(ctx, "Leaf", v(2.3, 0.16, 1.1), at(0.8, 3.75, 0.1) * CFrame.Angles(0, rad(15), rad(22)), ctx.accent, { shape = "sphere" })
end

ACCESSORIES.pebbles = function(ctx)
	local m = { shape = "ball", material = Enum.Material.Slate }
	makePart(ctx, "Pebble1", v(0.7, 0.7, 0.7), at(1.9, 0.3, -0.9), ctx.accent, m)
	makePart(ctx, "Pebble2", v(0.55, 0.55, 0.55), at(-2.0, 0.25, 0.5), ctx.accent, m)
	makePart(ctx, "Pebble3", v(0.5, 0.5, 0.5), at(0.9, 0.25, 1.95), ctx.accent, m)
end

ACCESSORIES.antenna = function(ctx)
	local dark = Color3.fromRGB(35, 30, 30)
	makePart(ctx, "AntennaL", v(1.1, 0.13, 0.13), at(-0.5, 3.55, 0) * CFrame.Angles(0, 0, rad(110)), dark, { shape = "cylinder" })
	makePart(ctx, "AntennaR", v(1.1, 0.13, 0.13), at(0.5, 3.55, 0) * CFrame.Angles(0, 0, rad(70)), dark, { shape = "cylinder" })
	makePart(ctx, "TipL", v(0.36, 0.36, 0.36), at(-0.69, 4.07, 0), ctx.accent, { shape = "ball" })
	makePart(ctx, "TipR", v(0.36, 0.36, 0.36), at(0.69, 4.07, 0), ctx.accent, { shape = "ball" })
end

ACCESSORIES.stripes = function(ctx)
	makePart(ctx, "Stripe1", v(3.8, 0.34, 3.8), at(0, 1.02, 0), ctx.accent, { shape = "sphere" })
	makePart(ctx, "Stripe2", v(3.0, 0.3, 3.0), at(0, 0.5, 0), ctx.accent, { shape = "sphere" })
end

ACCESSORIES.chips = function(ctx)
	local spots = { { 0.9, 0.3 }, { 2.2, -0.2 }, { 3.5, 0.5 }, { 4.4, 0.05 }, { 5.3, -0.45 }, { 0.6, 0.72 }, { -0.6, 0.72 } }
	for i, spot in spots do
		makePart(ctx, "Chip" .. i, v(0.36, 0.36, 0.36), CFrame.new(onSurface(spot[1], spot[2], 0.02)), ctx.accent, { shape = "ball" })
	end
end

ACCESSORIES.straw = function(ctx)
	makePart(ctx, "Straw", v(2.4, 0.26, 0.26), at(0.55, 3.7, 0.2) * CFrame.Angles(0, 0, rad(72)), ctx.accent, { shape = "cylinder" })
end

ACCESSORIES.icespikes = function(ctx)
	local ice = { shape = "sphere", material = Enum.Material.Glass, transparency = 0.15 }
	makePart(ctx, "Spike1", v(0.55, 1.6, 0.55), at(0, 3.55, 0), ctx.accent, ice)
	makePart(ctx, "Spike2", v(0.45, 1.2, 0.45), at(-0.8, 3.3, 0.2) * CFrame.Angles(0, 0, rad(20)), ctx.accent, ice)
	makePart(ctx, "Spike3", v(0.45, 1.2, 0.45), at(0.8, 3.3, 0.2) * CFrame.Angles(0, 0, rad(-20)), ctx.accent, ice)
	makePart(ctx, "Spike4", v(0.4, 1.0, 0.4), at(0, 3.25, 0.85) * CFrame.Angles(rad(20), 0, 0), ctx.accent, ice)
end

ACCESSORIES.bolt = function(ctx)
	local neon = { material = Enum.Material.Neon }
	makePart(ctx, "Bolt1", v(0.35, 1.1, 0.35), at(0, 3.6, 0) * CFrame.Angles(0, 0, rad(30)), ctx.accent, neon)
	makePart(ctx, "Bolt2", v(0.35, 1.1, 0.35), at(0, 4.56, 0) * CFrame.Angles(0, 0, rad(-30)), ctx.accent, neon)
	makePart(ctx, "Bolt3", v(0.35, 1.1, 0.35), at(0, 5.51, 0) * CFrame.Angles(0, 0, rad(30)), ctx.accent, neon)
end

ACCESSORIES.coral = function(ctx)
	local branches = { { -0.6, -25 }, { 0, 0 }, { 0.6, 25 } }
	for i, b in branches do
		local x, tilt = b[1], rad(b[2])
		makePart(ctx, "Branch" .. i, v(1.3, 0.3, 0.3), at(x, 3.6, 0) * CFrame.Angles(0, 0, rad(90) - tilt), ctx.accent, { shape = "cylinder" })
		local tip = Vector3.new(x + math.sin(tilt) * 0.65, 3.6 + math.cos(tilt) * 0.65, 0)
		makePart(ctx, "Tip" .. i, v(0.45, 0.45, 0.45), CFrame.new(tip), ctx.accent, { shape = "ball" })
	end
end

ACCESSORIES.cloud = function(ctx)
	local white = Color3.fromRGB(255, 255, 255)
	makePart(ctx, "Cloud1", v(1.3, 1.1, 1.3), at(0, 3.35, 0), white, { shape = "sphere" })
	makePart(ctx, "Cloud2", v(1.0, 0.85, 1.0), at(-0.75, 3.2, 0.1), white, { shape = "sphere" })
	makePart(ctx, "Cloud3", v(1.05, 0.9, 1.05), at(0.8, 3.2, -0.1), white, { shape = "sphere" })
	makePart(ctx, "Cloud4", v(0.85, 0.75, 0.85), at(0.2, 3.75, 0.35), white, { shape = "sphere" })
end

ACCESSORIES.flame = function(ctx)
	local outer = makePart(ctx, "Flame", v(1.0, 1.5, 1.0), at(0, 3.7, 0), ctx.accent, { shape = "sphere", material = Enum.Material.Neon, transparency = 0.1 })
	makePart(ctx, "FlameCore", v(0.55, 0.9, 0.55), at(0, 3.55, -0.15), Color3.fromRGB(255, 250, 200), { shape = "sphere", material = Enum.Material.Neon })
	local fire = Instance.new("Fire")
	fire.Size = 2.5 * ctx.s
	fire.Heat = 6
	fire.Color = Color3.fromRGB(255, 140, 40)
	fire.SecondaryColor = Color3.fromRGB(255, 230, 90)
	fire.Parent = outer
end

ACCESSORIES.headband = function(ctx)
	makePart(ctx, "Band", v(3.15, 0.42, 3.15), at(0, 2.65, 0), ctx.accent, { shape = "sphere" })
	makePart(ctx, "TailL", v(0.3, 0.14, 1.3), at(-0.25, 2.45, 1.95) * CFrame.Angles(rad(25), rad(-12), 0), ctx.accent)
	makePart(ctx, "TailR", v(0.3, 0.14, 1.3), at(0.25, 2.4, 1.95) * CFrame.Angles(rad(35), rad(12), 0), ctx.accent)
end

ACCESSORIES.wizardhat = function(ctx)
	local star = Color3.fromRGB(255, 230, 90)
	makePart(ctx, "Brim", v(0.22, 3.3, 3.3), at(0, 3.05, 0) * UPRIGHT, ctx.accent, { shape = "cylinder" })
	makePart(ctx, "Cone1", v(0.8, 2.1, 2.1), at(0, 3.5, 0) * UPRIGHT, ctx.accent, { shape = "cylinder" })
	makePart(ctx, "Cone2", v(0.75, 1.45, 1.45), at(0.08, 4.2, 0.05) * UPRIGHT * CFrame.Angles(0, 0, 0), ctx.accent, { shape = "cylinder" })
	makePart(ctx, "Cone3", v(0.7, 0.85, 0.85), at(0.2, 4.85, 0.1) * UPRIGHT, ctx.accent, { shape = "cylinder" })
	makePart(ctx, "Star", v(0.5, 0.5, 0.5), at(0.3, 5.35, 0.1), star, { shape = "ball", material = Enum.Material.Neon })
end

ACCESSORIES.piratehat = function(ctx)
	local black = Color3.fromRGB(30, 30, 35)
	makePart(ctx, "Brim", v(0.25, 3.5, 3.5), at(0, 3.05, 0) * UPRIGHT, black, { shape = "cylinder" })
	makePart(ctx, "Crown", v(2.7, 1.1, 1.7), at(0, 3.55, 0.1), black, { shape = "sphere" })
	makePart(ctx, "Skull", v(0.45, 0.45, 0.2), at(0, 3.6, -0.78), Color3.fromRGB(245, 245, 240), { shape = "sphere" })
end

ACCESSORIES.eyepatch = function(ctx)
	local black = Color3.fromRGB(20, 20, 22)
	local x, y = 0.75, 2.0
	makePart(ctx, "Patch", v(0.8, 0.95, 0.3), CFrame.new(x, y, frontZ(x, y) - 0.12), black, { shape = "sphere" })
	makePart(ctx, "Strap", v(3.95, 0.12, 3.95), at(0, 2.25, 0) * CFrame.Angles(0, 0, rad(-14)), black, { shape = "sphere" })
end

ACCESSORIES.visor = function(ctx)
	makePart(ctx, "Visor", v(4.02, 0.5, 4.02), at(0, 2.0, 0), ctx.accent, { shape = "sphere", material = Enum.Material.Neon })
end

ACCESSORIES.crown = function(ctx)
	local gold = Color3.fromRGB(255, 205, 50)
	local gem = Color3.fromRGB(255, 50, 80)
	makePart(ctx, "CrownBase", v(0.4, 2.0, 2.0), at(0, 3.12, 0) * UPRIGHT, gold, { shape = "cylinder", material = Enum.Material.Foil })
	for i = 1, 6 do
		local a = rad(i * 60)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local pos = Vector3.new(0, 3.55, 0) + dir * 0.85
		makePart(ctx, "Spike" .. i, v(0.45, 0.7, 0.18), CFrame.lookAt(pos, pos + dir), gold, { material = Enum.Material.Foil })
		makePart(ctx, "Tip" .. i, v(0.22, 0.22, 0.22), CFrame.new(pos + Vector3.new(0, 0.42, 0)), gold, { shape = "ball" })
	end
	makePart(ctx, "Gem", v(0.35, 0.35, 0.35), at(0, 3.15, -0.98), gem, { shape = "ball", material = Enum.Material.Neon })
end

ACCESSORIES.cape = function(ctx)
	makePart(ctx, "Cape", v(2.6, 2.75, 0.12), at(0, 1.5, 1.78) * CFrame.Angles(rad(-18), 0, 0), ctx.accent, { material = Enum.Material.Fabric })
end

ACCESSORIES.horns = function(ctx)
	makePart(ctx, "HornL", v(0.45, 1.3, 0.45), at(-0.95, 3.2, -0.2) * CFrame.Angles(0, 0, rad(25)), ctx.accent, { shape = "sphere" })
	makePart(ctx, "HornR", v(0.45, 1.3, 0.45), at(0.95, 3.2, -0.2) * CFrame.Angles(0, 0, rad(-25)), ctx.accent, { shape = "sphere" })
end

ACCESSORIES.wings = function(ctx)
	local mat = if ctx.accent.R + ctx.accent.G + ctx.accent.B > 2.4 then Enum.Material.SmoothPlastic else Enum.Material.Neon
	makePart(ctx, "WingL", v(2.3, 1.4, 0.15), at(-2.25, 2.3, 0.8) * CFrame.Angles(0, rad(-25), rad(-20)), ctx.accent, { shape = "sphere", material = mat, transparency = 0.1 })
	makePart(ctx, "WingR", v(2.3, 1.4, 0.15), at(2.25, 2.3, 0.8) * CFrame.Angles(0, rad(25), rad(20)), ctx.accent, { shape = "sphere", material = mat, transparency = 0.1 })
end

ACCESSORIES.halo = function(ctx)
	local gold = Color3.fromRGB(255, 235, 120)
	for i = 1, 12 do
		local a = rad(i * 30)
		makePart(ctx, "Halo" .. i, v(0.3, 0.3, 0.3), at(math.cos(a) * 0.95, 4.1, math.sin(a) * 0.95), gold, { shape = "ball", material = Enum.Material.Neon })
	end
end

ACCESSORIES.kabuto = function(ctx)
	local gold = Color3.fromRGB(230, 190, 70)
	local dark = Color3.fromRGB(60, 20, 25)
	makePart(ctx, "Helmet", v(4.3, 1.9, 4.3), at(0, 2.95, 0.05), dark, { shape = "sphere", material = Enum.Material.Metal })
	makePart(ctx, "CrestL", v(0.25, 1.5, 0.12), at(-0.45, 4.0, -1.25) * CFrame.Angles(0, 0, rad(30)), gold, { material = Enum.Material.Foil })
	makePart(ctx, "CrestR", v(0.25, 1.5, 0.12), at(0.45, 4.0, -1.25) * CFrame.Angles(0, 0, rad(-30)), gold, { material = Enum.Material.Foil })
	makePart(ctx, "Badge", v(0.4, 0.4, 0.15), at(0, 3.4, -1.95), gold, { shape = "sphere", material = Enum.Material.Foil })
end

ACCESSORIES.crest = function(ctx)
	local neon = { shape = "sphere", material = Enum.Material.Neon }
	makePart(ctx, "Crest1", v(0.35, 1.6, 0.35), at(-0.35, 3.7, 0.45) * CFrame.Angles(rad(15), 0, rad(22)), ctx.accent, neon)
	makePart(ctx, "Crest2", v(0.38, 1.9, 0.38), at(0, 3.9, 0.45) * CFrame.Angles(rad(15), 0, 0), ctx.accent, neon)
	makePart(ctx, "Crest3", v(0.35, 1.6, 0.35), at(0.35, 3.7, 0.45) * CFrame.Angles(rad(15), 0, rad(-22)), ctx.accent, neon)
end

ACCESSORIES.tentacles = function(ctx)
	for i = 1, 6 do
		local a = rad(i * 60 + 30)
		local pos = Vector3.new(math.cos(a) * 1.9, 0.35, math.sin(a) * 1.9)
		local cf = CFrame.new(pos) * CFrame.Angles(0, -a, 0) * CFrame.Angles(0, 0, rad(-12))
		makePart(ctx, "Tentacle" .. i, v(1.7, 0.45, 0.45), cf, ctx.accent, { shape = "cylinder" })
		local tip = (cf * CFrame.new(0.85, 0, 0)).Position
		makePart(ctx, "Suck" .. i, v(0.5, 0.5, 0.5), CFrame.new(tip), ctx.accent, { shape = "ball" })
	end
end

ACCESSORIES.orbit = function(ctx)
	local tilt = CFrame.Angles(rad(18), 0, rad(8))
	for i = 1, 8 do
		local a = rad(i * 45)
		local pos = (CFrame.new(0, 1.8, 0) * tilt * CFrame.new(math.cos(a) * 2.9, 0, math.sin(a) * 2.9)).Position
		makePart(ctx, "Orb" .. i, v(0.38, 0.38, 0.38), CFrame.new(pos), ctx.accent, { shape = "ball", material = Enum.Material.Neon })
	end
end

ACCESSORIES.glitch = function(ctx)
	local cubes = {
		{ 1.8, 2.6, -0.5, 0.8 },
		{ -1.95, 1.2, 0.6, 0.65 },
		{ 0.9, 0.35, -1.75, 0.5 },
		{ -1.2, 3.1, 0.9, 0.55 },
		{ 2.1, 1.0, 1.1, 0.45 },
		{ -0.5, 3.5, -0.6, 0.4 },
	}
	for i, c in cubes do
		local color = if i % 2 == 0 then ctx.accent else ctx.body
		makePart(ctx, "Glitch" .. i, v(c[4], c[4], c[4]), at(c[1], c[2], c[3]) * CFrame.Angles(rad(i * 17), rad(i * 29), 0), color, { material = Enum.Material.Neon, transparency = 0.15 })
	end
end

function SlimeBuilder.hasAccessory(name: string): boolean
	return ACCESSORIES[name] ~= nil
end

local function materialOf(name: string?): Enum.Material?
	if not name then
		return nil
	end
	local ok, value = pcall(function(): Enum.Material
		return (Enum.Material :: any)[name]
	end)
	return if ok then value else nil
end

-- 슬라임 모델을 만듭니다(모든 파트 Anchored). origin 기본값은 원점.
-- scaleMult: ★ 크기에 추가로 곱할 배율(머리 위에 들 때 등)
function SlimeBuilder.build(info: BuildInfo, origin: CFrame?, scaleMult: number?): Model
	local species = Slimes.byId[info.id] or Slimes.list[1]
	local rarity = Rarities.byId[species.rarity]
	local mutation = Mutations.byId[info.mut] or Mutations.byId.none
	local star = math.clamp(info.star, 1, Economy.star.max)
	local s = Economy.star.scale[star] * (scaleMult or 1)

	local model = Instance.new("Model")
	model.Name = species.id

	local bodyColor = mutation.color or species.color
	local ctx: Ctx = {
		model = model,
		origin = origin or CFrame.new(),
		s = s,
		accent = species.accent,
		body = bodyColor,
	}

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Transparency = 1
	root.Size = Vector3.new(1, 1, 1)
	root.CFrame = ctx.origin
	root.Parent = model
	model.PrimaryPart = root

	local bodyMaterial = materialOf(mutation.material) or materialOf(species.material) or Enum.Material.SmoothPlastic
	local bodyTransparency = mutation.transparency or species.transparency or 0
	local body = makePart(ctx, "Body", v(RX * 2, RY * 2, RZ * 2), at(0, CY, 0), bodyColor, {
		shape = "sphere",
		material = bodyMaterial,
		transparency = bodyTransparency,
		reflectance = mutation.reflectance,
		shadow = true,
	})
	if mutation.id == "rainbow" then
		body:SetAttribute("Rainbow", true)
	end

	-- 광택
	makePart(ctx, "Shine", v(0.9, 0.45, 0.6), at(-0.85, 2.75, -0.95) * CFrame.Angles(0, rad(-30), rad(20)), Color3.new(1, 1, 1), {
		shape = "sphere",
		transparency = 0.45,
	})

	-- 눈·하이라이트·입·볼
	local black = Color3.fromRGB(25, 22, 30)
	for _, side in { -1, 1 } do
		local ex, ey = 0.72 * side, 2.0
		local ez = frontZ(ex, ey)
		makePart(ctx, "Eye", v(0.55, 0.8, 0.35), CFrame.new(ex, ey, ez + 0.06), black, { shape = "sphere" })
		makePart(ctx, "EyeShine", v(0.2, 0.2, 0.2), CFrame.new(ex - 0.08, ey + 0.18, ez - 0.07), Color3.new(1, 1, 1), { shape = "ball" })
		local cx, cy = 1.25 * side, 1.55
		makePart(ctx, "Cheek", v(0.55, 0.3, 0.3), CFrame.new(cx, cy, frontZ(cx, cy) + 0.08), Color3.fromRGB(255, 130, 150), {
			shape = "sphere",
			transparency = 0.25,
		})
	end
	makePart(ctx, "Mouth", v(0.5, 0.26, 0.25), CFrame.new(0, 1.45, frontZ(0, 1.45) + 0.06), black, { shape = "sphere" })

	for _, accName in species.accessories do
		local fn = ACCESSORIES[accName]
		if fn then
			fn(ctx)
		end
	end

	-- 등급 빛
	if rarity.glow then
		local light = Instance.new("PointLight")
		light.Color = rarity.color
		light.Range = 10 * s
		light.Brightness = 1.4
		light.Parent = body
	end
	-- 변이 효과
	if mutation.sparkle then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = mutation.sparkle
		sparkles.Parent = body
	end
	if mutation.light then
		local light = Instance.new("PointLight")
		light.Color = mutation.light
		light.Range = 12 * s
		light.Brightness = 2
		light.Parent = body
	end
	if mutation.id == "lava" then
		local fire = Instance.new("Fire")
		fire.Size = 3 * s
		fire.Heat = 4
		fire.Color = Color3.fromRGB(255, 90, 20)
		fire.SecondaryColor = Color3.fromRGB(255, 200, 60)
		fire.Parent = body
	end

	model:SetAttribute("SpeciesId", species.id)
	model:SetAttribute("Star", star)
	model:SetAttribute("Mutation", mutation.id)
	model:SetAttribute("Height", (RY * 2) * s)
	return model
end

-- 슬라임 높이(★ 반영)
function SlimeBuilder.height(star: number): number
	return RY * 2 * Economy.star.scale[math.clamp(star, 1, Economy.star.max)]
end

return SlimeBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- 서버·클라이언트가 공유하는 데이터 형태.

export type SlimeData = {
	id: string, -- 슬라임 종류 id (Config/Slimes)
	star: number, -- 1~5
	mut: string, -- 변이 id (Config/Mutations)
	pad: number, -- 발판 번호
	fav: boolean?, -- 즐겨찾기: 도난 불가 + 환생 시 유지
}

export type QuestState = {
	id: string,
	goal: number,
	progress: number,
	claimed: boolean,
}

export type PlayerData = {
	version: number,
	cash: number,
	vault: number,
	totalEarned: number,
	rebirths: number,
	steals: number,
	slimes: { [string]: SlimeData },
	nextUid: number,
	upgrades: { [string]: number },
	index: { [string]: { [string]: boolean } },
	boosts: { [string]: number },
	daily: { streak: number, lastDay: number },
	quests: { day: number, list: { QuestState }, bonusClaimed: boolean },
	tutorial: number,
	lastOnline: number,
	playTime: number,
	settings: { music: boolean, sfx: boolean },
	receipts: { string },
	stats: { bought: number, merges: number, bonks: number, stolenFrom: number },
}

-- 수입 계산에 필요한 "데이터 밖" 정보
export type IncomeContext = {
	vip: boolean,
	doubleCash: boolean,
	friends: number,
	group: boolean,
	frenzy: boolean,
}

-- 서버 → 클라이언트 상태 묶음
export type StateView = {
	data: PlayerData,
	passes: { [string]: boolean },
	income: number,
	multiplier: number,
	friends: number,
	plot: number,
	sessionSeconds: number, -- 이번 접속 경과 시간(접속 선물용)
	giftsClaimed: { [string]: boolean }, -- 키: 선물 번호 문자열("1"~"7")
	offline: { amount: number, seconds: number }?,
}

-- 행진 슬라임(서버·클라이언트 공통)
export type ParadeSlime = {
	key: number,
	id: string,
	mut: string,
	price: number,
	spawnAt: number, -- workspace:GetServerTimeNow() 기준
}

return {}
]]></string>
        </Properties>
