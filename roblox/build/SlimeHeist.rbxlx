        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
-- 경제·규칙 수치. 밸런스 조정은 이 파일만 고치면 됩니다.

export type UpgradeDef = {
	id: string,
	name: { en: string, ko: string },
	desc: { en: string, ko: string },
	icon: string,
	maxLevel: number,
	baseCost: number,
	growth: number,
}

local upgrades: { UpgradeDef } = {
	{
		id = "pads",
		name = { en = "More Pads", ko = "발판 추가" },
		desc = { en = "+1 slime pad in your base", ko = "기지 발판 +1" },
		icon = "🟩",
		maxLevel = 10,
		baseCost = 300,
		growth = 2.5,
	},
	{
		id = "speed",
		name = { en = "Speedy Shoes", ko = "날쌘 신발" },
		desc = { en = "+1.5 walk speed", ko = "이동 속도 +1.5" },
		icon = "👟",
		maxLevel = 8,
		baseCost = 500,
		growth = 2.8,
	},
	{
		id = "lock",
		name = { en = "Stronger Lock", ko = "튼튼한 잠금" },
		desc = { en = "+15s base lock time", ko = "기지 잠금 +15초" },
		icon = "🔒",
		maxLevel = 4,
		baseCost = 8000,
		growth = 6,
	},
	{
		id = "offline",
		name = { en = "Night Shift", ko = "야간 근무" },
		desc = { en = "+10% offline earnings, +1h cap", ko = "오프라인 수입 +10%, 최대 +1시간" },
		icon = "🌙",
		maxLevel = 5,
		baseCost = 15000,
		growth = 5,
	},
	{
		id = "luck",
		name = { en = "Lucky Touch", ko = "행운의 손길" },
		desc = { en = "+1.5% chance a bought slime mutates", ko = "구매한 슬라임 변이 확률 +1.5%" },
		icon = "🍀",
		maxLevel = 10,
		baseCost = 2000,
		growth = 2.7,
	},
	{
		id = "bonk",
		name = { en = "Heavy Hammer", ko = "묵직한 뿅망치" },
		desc = { en = "Faster bonk cooldown, bigger knockback", ko = "뿅망치 재사용 단축, 넉백 증가" },
		icon = "🔨",
		maxLevel = 5,
		baseCost = 1000,
		growth = 4,
	},
}

local upgradeById: { [string]: UpgradeDef } = {}
for _, u in upgrades do
	upgradeById[u.id] = u
end

return {
	startCash = 100,
	sellRatio = 0.5,

	basePads = 10,
	passPads = 4, -- 게임패스 "발판 +4"
	maxPads = 24,

	star = {
		max = 5,
		mult = { 1, 3.5, 12, 40, 135 },
		scale = { 1, 1.2, 1.45, 1.75, 2.1 },
		carryWeight = { 0, 0.05, 0.1, 0.15, 0.2 },
		holdBonus = { 0, 0.3, 0.6, 0.9, 1.2 },
	},

	rebirth = {
		multPer = 0.5, -- 환생 1회당 수입 +50%
		baseCost = 4e6,
		costGrowth = 7,
		-- 환생 r → r+1 에 필요한 최소 보유 등급
		rarityReq = { "epic", "epic", "legendary", "legendary", "mythic", "mythic", "mythic", "mythic" },
		rarityReqLate = "secret",
	},

	offline = {
		baseRate = 0.2,
		ratePerLevel = 0.1,
		baseCapHours = 2,
		capHoursPerLevel = 1,
		minSeconds = 60,
	},

	friendBoostPer = 0.1,
	friendBoostMax = 0.4,
	groupBoost = 0.1,
	indexBonusPer = 0.005,

	parade = {
		interval = 2.5, -- 초마다 1마리
		speed = 7, -- studs/s
		buyRange = 16, -- 서버 검증 거리(프롬프트 거리 + 지연 여유)
		promptRange = 10,
	},

	steal = {
		timeout = 60,
		afterTheftShield = 30,
		rookieShieldSeconds = 600,
		minCarryMult = 0.35,
		revengeSeconds = 15,
		revengeSpeed = 6,
		stealRange = 14,
		thiefProCarryBonus = 0.25,
	},

	lock = {
		baseDuration = 60,
		perLevel = 15,
		cooldown = 10,
	},

	bonk = {
		baseCooldown = 1.0,
		cooldownPerLevel = 0.08,
		range = 9,
		stun = 1.2,
		knockback = 55,
		knockbackPerLevel = 8,
	},

	walkSpeed = {
		base = 16,
		perLevel = 1.5,
	},

	vipMult = 1.5,
	doubleCashMult = 2,
	boostCashMult = 2,

	upgrades = upgrades,
	upgradeById = upgradeById,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Mutations</string>
            <string name="Source"><![CDATA[--!strict
-- 변이 정의. 새 변이 추가 = list에 한 줄 + (선택) SlimeBuilder의 look 처리.
--   mult       : 수입·가치 배수
--   luckWeight : "행운의 손길"(구매 시 무작위 변이)에서의 가중치
--   color      : 몸 색(nil이면 원래 색 유지), material: 몸 재질 이름
--   label      : 머리 위 표시 색

export type Mutation = {
	id: string,
	order: number,
	name: { en: string, ko: string },
	mult: number,
	luckWeight: number,
	color: Color3?,
	material: string?,
	transparency: number?,
	reflectance: number?,
	label: Color3,
	sparkle: Color3?,
	light: Color3?,
}

local rgb = Color3.fromRGB

local list: { Mutation } = {
	{
		id = "none",
		order = 0,
		name = { en = "Normal", ko = "일반" },
		mult = 1,
		luckWeight = 0,
		label = rgb(255, 255, 255),
	},
	{
		id = "gold",
		order = 1,
		name = { en = "Gold", ko = "황금" },
		mult = 2,
		luckWeight = 60,
		color = rgb(255, 200, 40),
		material = "Foil",
		reflectance = 0.2,
		label = rgb(255, 210, 60),
		sparkle = rgb(255, 230, 120),
	},
	{
		id = "diamond",
		order = 2,
		name = { en = "Diamond", ko = "다이아" },
		mult = 3,
		luckWeight = 25,
		color = rgb(170, 240, 255),
		material = "Glass",
		transparency = 0.25,
		reflectance = 0.35,
		label = rgb(140, 230, 255),
		sparkle = rgb(220, 250, 255),
	},
	{
		id = "candy",
		order = 3,
		name = { en = "Candy", ko = "사탕" },
		mult = 4,
		luckWeight = 10,
		color = rgb(255, 130, 200),
		material = "SmoothPlastic",
		label = rgb(255, 140, 210),
		sparkle = rgb(255, 200, 235),
	},
	{
		id = "lava",
		order = 4,
		name = { en = "Lava", ko = "용암" },
		mult = 5,
		luckWeight = 4,
		color = rgb(255, 90, 20),
		material = "CrackedLava",
		label = rgb(255, 120, 40),
		light = rgb(255, 120, 40),
	},
	{
		id = "rainbow",
		order = 5,
		name = { en = "Rainbow", ko = "무지개" },
		mult = 7,
		luckWeight = 0.9,
		color = rgb(255, 80, 80),
		material = "SmoothPlastic",
		label = rgb(255, 120, 255),
		sparkle = rgb(255, 255, 255),
	},
	{
		id = "galaxy",
		order = 6,
		name = { en = "Galaxy", ko = "은하" },
		mult = 10,
		luckWeight = 0.1,
		color = rgb(90, 40, 200),
		material = "ForceField",
		label = rgb(170, 120, 255),
		sparkle = rgb(200, 180, 255),
		light = rgb(140, 90, 255),
	},
}

local byId: { [string]: Mutation } = {}
for _, m in list do
	byId[m.id] = m
end

return {
	list = list,
	byId = byId,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Products</string>
            <string name="Source"><![CDATA[--!strict
-- 게임패스 · 개발자 상품.
-- Creator Dashboard(create.roblox.com)에서 만든 뒤 숫자 ID를 id 칸에 넣으세요.
-- id가 0이면 상점에 표시되지 않고, 관련 혜택은 꺼진 상태로 동작합니다.

export type Pass = {
	key: string,
	id: number,
	icon: string,
	name: { en: string, ko: string },
	desc: { en: string, ko: string },
}

export type Product = {
	key: string,
	id: number,
	icon: string,
	name: { en: string, ko: string },
	desc: { en: string, ko: string },
}

local passes: { Pass } = {
	{
		key = "vip",
		id = 0,
		icon = "👑",
		name = { en = "VIP", ko = "VIP" },
		desc = { en = "x1.5 income forever + VIP chat tag", ko = "수입 영구 ×1.5 + VIP 채팅 태그" },
	},
	{
		key = "doubleCash",
		id = 0,
		icon = "💰",
		name = { en = "2x Cash", ko = "수입 2배" },
		desc = { en = "Double all income forever", ko = "모든 수입 영구 2배" },
	},
	{
		key = "autoCollect",
		id = 0,
		icon = "🧲",
		name = { en = "Auto Collect", ko = "자동 수금" },
		desc = { en = "Cash goes straight to your wallet", ko = "수금 발판 없이 바로 지갑으로" },
	},
	{
		key = "extraPads",
		id = 0,
		icon = "🟪",
		name = { en = "+4 Pads", ko = "발판 +4" },
		desc = { en = "4 extra slime pads", ko = "슬라임 발판 4칸 추가" },
	},
	{
		key = "thiefPro",
		id = 0,
		icon = "🥷",
		name = { en = "Pro Thief", ko = "프로 도둑" },
		desc = { en = "Run 25% faster while carrying", ko = "슬라임을 들고 25% 더 빨리 달리기" },
	},
}

local products: { Product } = {
	{
		key = "serverLuck",
		id = 0,
		icon = "🍀",
		name = { en = "Server Luck x2", ko = "서버 행운 ×2" },
		desc = { en = "15 min of x2 luck for EVERYONE", ko = "15분간 서버 전체 행운 ×2" },
	},
	{
		key = "rainbowStorm",
		id = 0,
		icon = "🌈",
		name = { en = "Summon Rainbow Storm", ko = "무지개 폭풍 소환" },
		desc = { en = "Start a Rainbow Storm for the whole server", ko = "서버 전체에 무지개 폭풍 시작" },
	},
	{
		key = "cashSmall",
		id = 0,
		icon = "💵",
		name = { en = "Pile of Cash", ko = "현금 한 뭉치" },
		desc = { en = "10 minutes of income", ko = "수입 10분치" },
	},
	{
		key = "cashMedium",
		id = 0,
		icon = "💰",
		name = { en = "Bag of Cash", ko = "현금 한 자루" },
		desc = { en = "1 hour of income", ko = "수입 1시간치" },
	},
	{
		key = "cashLarge",
		id = 0,
		icon = "🏦",
		name = { en = "Vault of Cash", ko = "현금 금고" },
		desc = { en = "5 hours of income", ko = "수입 5시간치" },
	},
}

local passByKey: { [string]: Pass } = {}
for _, p in passes do
	passByKey[p.key] = p
end
local productByKey: { [string]: Product } = {}
local productById: { [number]: Product } = {}
for _, p in products do
	productByKey[p.key] = p
	if p.id ~= 0 then
		productById[p.id] = p
	end
end

return {
	passes = passes,
	passByKey = passByKey,
	products = products,
	productByKey = productByKey,
	productById = productById,
	cashPackMinutes = { cashSmall = 10, cashMedium = 60, cashLarge = 300 },
	cashPackMin = { cashSmall = 5000, cashMedium = 30000, cashLarge = 150000 },
	serverLuckSeconds = 900,
	-- 그룹 ID(선택): 그룹 가입자 수입 +10%. 0이면 끔.
	groupId = 0,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Rarities</string>
            <string name="Source"><![CDATA[--!strict
-- 등급 정의. order가 클수록 희귀합니다.
-- weight: 행진 등장 가중치(서버 행운 1배 기준), payback: 가격 = 수입 × payback(초)
-- stealHold: 훔치기 길게 누르기 시간(초), carryWeight: 들고 갈 때 속도 감소량(0~1)

export type Rarity = {
	id: string,
	order: number,
	name: { en: string, ko: string },
	color: Color3,
	weight: number,
	payback: number,
	stealHold: number,
	carryWeight: number,
	announce: boolean,
	glow: boolean,
}

local list: { Rarity } = {
	{
		id = "common",
		order = 1,
		name = { en = "Common", ko = "일반" },
		color = Color3.fromRGB(190, 196, 204),
		weight = 55,
		payback = 20,
		stealHold = 1.0,
		carryWeight = 0.10,
		announce = false,
		glow = false,
	},
	{
		id = "uncommon",
		order = 2,
		name = { en = "Uncommon", ko = "고급" },
		color = Color3.fromRGB(96, 214, 96),
		weight = 28,
		payback = 35,
		stealHold = 1.2,
		carryWeight = 0.16,
		announce = false,
		glow = false,
	},
	{
		id = "rare",
		order = 3,
		name = { en = "Rare", ko = "희귀" },
		color = Color3.fromRGB(70, 150, 255),
		weight = 12,
		payback = 60,
		stealHold = 1.5,
		carryWeight = 0.24,
		announce = false,
		glow = false,
	},
	{
		id = "epic",
		order = 4,
		name = { en = "Epic", ko = "영웅" },
		color = Color3.fromRGB(176, 92, 255),
		weight = 4,
		payback = 100,
		stealHold = 1.8,
		carryWeight = 0.32,
		announce = false,
		glow = false,
	},
	{
		id = "legendary",
		order = 5,
		name = { en = "Legendary", ko = "전설" },
		color = Color3.fromRGB(255, 186, 36),
		weight = 0.85,
		payback = 150,
		stealHold = 2.2,
		carryWeight = 0.40,
		announce = true,
		glow = true,
	},
	{
		id = "mythic",
		order = 6,
		name = { en = "Mythic", ko = "신화" },
		color = Color3.fromRGB(255, 64, 120),
		weight = 0.13,
		payback = 220,
		stealHold = 2.6,
		carryWeight = 0.46,
		announce = true,
		glow = true,
	},
	{
		id = "secret",
		order = 7,
		name = { en = "SECRET", ko = "비밀" },
		color = Color3.fromRGB(30, 30, 36),
		weight = 0.02,
		payback = 320,
		stealHold = 3.0,
		carryWeight = 0.52,
		announce = true,
		glow = true,
	},
}

local byId: { [string]: Rarity } = {}
for _, r in list do
	byId[r.id] = r
end

return {
	list = list,
	byId = byId,
	count = #list,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[--!strict
-- 보상 표: 7일 출석, 접속 선물, 일일 퀘스트.
-- 보상 형식(Reward):
--   cashMinutes/minCash : 현재 수입 N분치 현금(최소 minCash)
--   boost/seconds       : 개인 부스트("cash2x")
--   giftRarity          : 해당 등급 이상 슬라임 1마리(빈 발판 없으면 판매가 현금)
--   serverLuck          : 서버 전체 행운 ×2 (초)

export type Reward = {
	cashMinutes: number?,
	minCash: number?,
	boost: string?,
	seconds: number?,
	giftRarity: string?,
	serverLuck: number?,
}

export type QuestDef = {
	id: string,
	kind: string,
	goals: { number },
	text: { en: string, ko: string },
	reward: Reward,
}

local daily: { Reward } = {
	{ cashMinutes = 3, minCash = 300 },
	{ boost = "cash2x", seconds = 600 },
	{ cashMinutes = 8, minCash = 800 },
	{ serverLuck = 300 },
	{ cashMinutes = 15, minCash = 2000 },
	{ boost = "cash2x", seconds = 1200 },
	{ giftRarity = "epic" },
}

export type Gift = { minutes: number, reward: Reward }

local gifts: { Gift } = {
	{ minutes = 2, reward = { cashMinutes = 2, minCash = 150 } },
	{ minutes = 5, reward = { boost = "cash2x", seconds = 300 } },
	{ minutes = 10, reward = { giftRarity = "uncommon" } },
	{ minutes = 15, reward = { cashMinutes = 5, minCash = 1000 } },
	{ minutes = 25, reward = { giftRarity = "rare" } },
	{ minutes = 40, reward = { boost = "cash2x", seconds = 900 } },
	{ minutes = 60, reward = { giftRarity = "epic" } },
}

local quests: { QuestDef } = {
	{
		id = "buy",
		kind = "buy",
		goals = { 8, 12, 20 },
		text = { en = "Buy {n} slimes", ko = "슬라임 {n}마리 구매하기" },
		reward = { cashMinutes = 5, minCash = 500 },
	},
	{
		id = "buyRare",
		kind = "buyRare",
		goals = { 1, 2 },
		text = { en = "Buy {n} Rare+ slimes", ko = "희귀 이상 슬라임 {n}마리 구매하기" },
		reward = { cashMinutes = 8, minCash = 800 },
	},
	{
		id = "merge",
		kind = "merge",
		goals = { 1, 2, 3 },
		text = { en = "Merge slimes {n} times", ko = "슬라임 {n}번 합성하기" },
		reward = { cashMinutes = 8, minCash = 800 },
	},
	{
		id = "steal",
		kind = "steal",
		goals = { 1, 2 },
		text = { en = "Steal {n} slimes", ko = "슬라임 {n}마리 훔치기" },
		reward = { cashMinutes = 10, minCash = 1000 },
	},
	{
		id = "bonk",
		kind = "bonk",
		goals = { 10, 20 },
		text = { en = "Bonk players {n} times", ko = "뿅망치로 {n}번 때리기" },
		reward = { cashMinutes = 5, minCash = 500 },
	},
	{
		id = "defend",
		kind = "defend",
		goals = { 1 },
		text = { en = "Bonk a thief {n} time", ko = "도둑을 {n}번 저지하기" },
		reward = { boost = "cash2x", seconds = 600 },
	},
	{
		id = "collect",
		kind = "collect",
		goals = { 10, 20 },
		text = { en = "Collect cash {n} times", ko = "수금 {n}번 하기" },
		reward = { cashMinutes = 4, minCash = 400 },
	},
	{
		id = "play",
		kind = "playtime",
		goals = { 600, 1200 },
		text = { en = "Play for {t}", ko = "{t} 동안 플레이하기" },
		reward = { cashMinutes = 6, minCash = 600 },
	},
	{
		id = "upgrade",
		kind = "upgrade",
		goals = { 2, 3 },
		text = { en = "Buy {n} upgrades", ko = "업그레이드 {n}번 하기" },
		reward = { cashMinutes = 6, minCash = 600 },
	},
}

local questById: { [string]: QuestDef } = {}
for _, q in quests do
	questById[q.id] = q
end

return {
	daily = daily,
	gifts = gifts,
	quests = quests,
	questById = questById,
	questsPerDay = 3,
	questAllBonus = { giftRarity = "rare" } :: Reward,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Slimes</string>
            <string name="Source"><![CDATA[--!strict
-- 슬라임 종류 표. 새 슬라임 추가 = 아래 list에 한 줄 추가.
--   income    : ★1·변이 없음 기준 초당 수입
--   price     : 비워 두면 income × 등급 payback 으로 자동 계산(보기 좋은 숫자로 반올림)
--   color     : 몸 색, accent: 장식 기본 색
--   material  : Enum.Material 이름(선택)
--   accessories: SlimeBuilder의 장식 함수 이름 목록
--   transparency: 몸 투명도(선택)

local Rarities = require(script.Parent.Rarities)

export type Species = {
	id: string,
	name: { en: string, ko: string },
	rarity: string,
	income: number,
	price: number,
	color: Color3,
	accent: Color3,
	material: string?,
	transparency: number?,
	accessories: { string },
}

type Def = {
	id: string,
	en: string,
	ko: string,
	rarity: string,
	income: number,
	price: number?,
	color: Color3,
	accent: Color3?,
	material: string?,
	transparency: number?,
	acc: { string }?,
}

local rgb = Color3.fromRGB

local defs: { Def } = {
	-- 일반
	{ id = "blobby", en = "Blobby", ko = "말랑이", rarity = "common", income = 1, color = rgb(130, 222, 120) },
	{ id = "droplet", en = "Droplet", ko = "물방울", rarity = "common", income = 2, color = rgb(110, 190, 255), acc = { "droplet" } },
	{ id = "mochi", en = "Mochi", ko = "찹쌀떡", rarity = "common", income = 3, color = rgb(255, 232, 238), accent = rgb(255, 120, 170), acc = { "bow" } },
	{ id = "bubbles", en = "Bubbles", ko = "방울이", rarity = "common", income = 5, color = rgb(150, 235, 255), material = "Glass", transparency = 0.2, acc = { "bubbles" } },
	{ id = "jellybean", en = "Jelly Bean", ko = "젤리빈", rarity = "common", income = 7, color = rgb(255, 150, 60), accent = rgb(90, 200, 90), acc = { "sprout" } },
	{ id = "pudding", en = "Pudding", ko = "푸딩", rarity = "common", income = 10, color = rgb(255, 222, 110), accent = rgb(150, 85, 40), acc = { "caramel" } },
	-- 고급
	{ id = "leafy", en = "Leafy", ko = "풀잎이", rarity = "uncommon", income = 15, color = rgb(70, 190, 90), accent = rgb(40, 150, 60), acc = { "leaf" } },
	{ id = "rocky", en = "Rocky", ko = "돌멩이", rarity = "uncommon", income = 22, color = rgb(150, 150, 160), accent = rgb(110, 110, 120), material = "Slate", acc = { "pebbles" } },
	{ id = "honey", en = "Honey", ko = "꿀벌이", rarity = "uncommon", income = 30, color = rgb(255, 196, 40), accent = rgb(40, 30, 20), acc = { "antenna", "stripes" } },
	{ id = "minty", en = "Mint Choco", ko = "민트초코", rarity = "uncommon", income = 40, color = rgb(150, 240, 210), accent = rgb(90, 55, 35), acc = { "chips" } },
	{ id = "soda", en = "Soda", ko = "사이다", rarity = "uncommon", income = 55, color = rgb(200, 245, 255), accent = rgb(255, 90, 90), material = "Glass", transparency = 0.25, acc = { "straw", "bubbles" } },
	-- 희귀
	{ id = "frosty", en = "Frosty", ko = "눈꽃이", rarity = "rare", income = 80, color = rgb(190, 235, 255), accent = rgb(120, 200, 255), material = "Ice", acc = { "icespikes" } },
	{ id = "sparky", en = "Sparky", ko = "찌릿이", rarity = "rare", income = 110, color = rgb(255, 238, 70), accent = rgb(255, 255, 200), acc = { "bolt" } },
	{ id = "coral", en = "Coral", ko = "산호", rarity = "rare", income = 150, color = rgb(255, 120, 110), accent = rgb(255, 170, 150), acc = { "coral" } },
	{ id = "cloudy", en = "Cloudy", ko = "구름이", rarity = "rare", income = 200, color = rgb(245, 248, 255), accent = rgb(255, 255, 255), acc = { "cloud" } },
	{ id = "ember", en = "Ember", ko = "불씨", rarity = "rare", income = 270, color = rgb(255, 110, 40), accent = rgb(255, 210, 60), acc = { "flame" } },
	-- 영웅
	{ id = "ninja", en = "Ninja", ko = "닌자", rarity = "epic", income = 400, color = rgb(45, 50, 80), accent = rgb(230, 40, 50), acc = { "headband" } },
	{ id = "wizard", en = "Wizard", ko = "마법사", rarity = "epic", income = 600, color = rgb(140, 90, 230), accent = rgb(70, 40, 160), acc = { "wizardhat" } },
	{ id = "pirate", en = "Pirate", ko = "해적", rarity = "epic", income = 850, color = rgb(60, 190, 180), accent = rgb(30, 30, 35), acc = { "piratehat", "eyepatch" } },
	{ id = "robo", en = "Robo", ko = "로보", rarity = "epic", income = 1200, color = rgb(185, 195, 210), accent = rgb(255, 50, 60), material = "DiamondPlate", acc = { "visor", "antenna" } },
	-- 전설
	{ id = "king", en = "King Slime", ko = "슬라임 킹", rarity = "legendary", income = 2500, color = rgb(60, 110, 255), accent = rgb(255, 205, 50), acc = { "crown", "cape" } },
	{ id = "dragon", en = "Dragon", ko = "드래곤", rarity = "legendary", income = 4000, color = rgb(220, 50, 50), accent = rgb(255, 200, 80), acc = { "horns", "wings" } },
	{ id = "angel", en = "Angel", ko = "천사", rarity = "legendary", income = 6000, color = rgb(255, 250, 235), accent = rgb(255, 225, 120), acc = { "halo", "wings" } },
	{ id = "samurai", en = "Samurai", ko = "사무라이", rarity = "legendary", income = 9000, color = rgb(150, 25, 35), accent = rgb(230, 190, 70), acc = { "kabuto" } },
	-- 신화
	{ id = "phoenix", en = "Phoenix", ko = "불사조", rarity = "mythic", income = 20000, color = rgb(255, 120, 30), accent = rgb(255, 230, 80), material = "Neon", acc = { "crest", "wings", "flame" } },
	{ id = "kraken", en = "Kraken", ko = "크라켄", rarity = "mythic", income = 35000, color = rgb(110, 40, 170), accent = rgb(180, 90, 230), acc = { "tentacles", "piratehat" } },
	{ id = "void", en = "Void", ko = "보이드", rarity = "mythic", income = 60000, color = rgb(20, 16, 30), accent = rgb(170, 60, 255), acc = { "orbit", "horns" } },
	-- 비밀
	{ id = "galaxyemperor", en = "Galaxy Emperor", ko = "은하 황제", rarity = "secret", income = 150000, color = rgb(40, 30, 110), accent = rgb(255, 220, 90), material = "ForceField", acc = { "crown", "orbit", "cape" } },
	{ id = "glitch", en = "Glitch", ko = "글리치", rarity = "secret", income = 300000, color = rgb(255, 40, 200), accent = rgb(40, 255, 240), material = "Neon", acc = { "glitch", "visor" } },
	{ id = "slimegod", en = "Slime God", ko = "슬라임 신", rarity = "secret", income = 600000, color = rgb(255, 215, 70), accent = rgb(255, 255, 255), material = "Neon", acc = { "halo", "wings", "crown" } },
}

-- 가격을 유효숫자 2자리로 깔끔하게 반올림
local function nice(n: number): number
	if n < 100 then
		return math.max(1, math.floor(n + 0.5))
	end
	local mag = 10 ^ (math.floor(math.log10(n)) - 1)
	return math.floor(n / mag + 0.5) * mag
end

local list: { Species } = {}
local byId: { [string]: Species } = {}
local byRarity: { [string]: { Species } } = {}

for _, d in defs do
	local rarity = Rarities.byId[d.rarity]
	assert(rarity, "unknown rarity " .. d.rarity .. " for " .. d.id)
	assert(byId[d.id] == nil, "duplicate slime id " .. d.id)
	local s: Species = {
		id = d.id,
		name = { en = d.en, ko = d.ko },
		rarity = d.rarity,
		income = d.income,
		price = d.price or nice(d.income * rarity.payback),
		color = d.color,
		accent = d.accent or d.color,
		material = d.material,
		transparency = d.transparency,
		accessories = d.acc or {},
	}
	table.insert(list, s)
	byId[s.id] = s
	local bucket = byRarity[s.rarity]
	if not bucket then
		bucket = {}
		byRarity[s.rarity] = bucket
	end
	table.insert(bucket, s)
end

return {
	list = list,
	byId = byId,
	byRarity = byRarity,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Text</string>
            <string name="Source"><![CDATA[--!strict
-- 화면 문구(영어/한국어). {이름} 자리는 Format.fill로 채워집니다.
-- 서버 알림 인자 중 slime/mut/rarity/weather/quest 는 클라이언트에서 이름으로 바뀝니다.

export type Entry = { en: string, ko: string }

local T: { [string]: Entry } = {
	-- 공통
	claim = { en = "CLAIM", ko = "받기" },
	claimed = { en = "Already claimed!", ko = "이미 받았어요!" },
	buy = { en = "BUY", ko = "구매" },
	owned = { en = "OWNED ✓", ko = "보유 중 ✓" },
	maxed = { en = "MAX", ko = "최대" },
	levelOf = { en = "Lv {a}/{b}", ko = "Lv {a}/{b}" },
	error = { en = "Something went wrong. Try again!", ko = "문제가 생겼어요. 다시 시도해 주세요!" },
	notReady = { en = "Not ready yet!", ko = "아직 준비되지 않았어요!" },
	tooFast = { en = "Slow down!", ko = "너무 빨라요!" },
	badRequest = { en = "Can't do that.", ko = "할 수 없어요." },
	youGot = { en = "You got {what}!", ko = "{what} 획득!" },
	adminResult = { en = "[Admin] {text}", ko = "[관리자] {text}" },

	-- 메뉴
	menuShop = { en = "Shop", ko = "상점" },
	menuIndex = { en = "Index", ko = "도감" },
	menuRebirth = { en = "Rebirth", ko = "환생" },
	menuQuests = { en = "Quests", ko = "퀘스트" },
	menuGifts = { en = "Gifts", ko = "선물" },
	menuStore = { en = "Store", ko = "스토어" },
	menuSettings = { en = "Settings", ko = "설정" },
	lockButton = { en = "LOCK", ko = "잠금" },

	-- HUD
	vaultChip = { en = "🏦 {cash} at base!", ko = "🏦 기지에 {cash}!" },
	frenzyIn = { en = "⚡ Frenzy in {t}", ko = "⚡ 대폭주까지 {t}" },
	frenzyNow = { en = "⚡ SLIME FRENZY {t}", ko = "⚡ 슬라임 대폭주 {t}" },
	luckChip = { en = "Luck {x}", ko = "행운 {x}" },

	-- 행진·구매
	buyFor = { en = "Buy {cash}", ko = "{cash}에 구매" },
	gone = { en = "Too late, it's gone!", ko = "앗, 이미 사라졌어요!" },
	tooFar = { en = "Get closer!", ko = "더 가까이 가세요!" },
	baseFull = { en = "Your base is full! Sell or merge slimes.", ko = "기지가 꽉 찼어요! 팔거나 합성하세요." },
	noCash = { en = "Not enough cash!", ko = "돈이 부족해요!" },
	noPlot = { en = "You don't have a base yet.", ko = "아직 기지가 없어요." },
	luckyTouch = { en = "🍀 Lucky Touch! It became {mut}!", ko = "🍀 행운의 손길! {mut} 변이!" },
	rareSpawn = { en = "✨ A {rarity} {slime} is on the parade!", ko = "✨ {rarity} {slime} 등장! 행진으로 달려가세요!" },
	newIndex = { en = "📖 New in Index: {mut} {slime}! (+income)", ko = "📖 도감 등록: {mut} {slime}! (수입 증가)" },

	-- 기지 슬라임 관리
	manage = { en = "Manage", ko = "관리" },
	manageTitle = { en = "My Slime", ko = "내 슬라임" },
	merge = { en = "MERGE", ko = "합성" },
	mergeInfo = { en = "Merge 3 same slimes ({n}/3): income {a} → {b}", ko = "같은 슬라임 3마리 합성({n}/3): 수입 {a} → {b}" },
	maxStar = { en = "Max stars reached!", ko = "최대 ★ 달성!" },
	cantMerge = { en = "You need 3 of the same slime with the same stars.", ko = "같은 슬라임·같은 ★ 3마리가 필요해요." },
	sellFor = { en = "SELL {cash}", ko = "판매 {cash}" },
	soldFor = { en = "Sold for {cash}", ko = "{cash}에 판매했어요" },
	favOn = { en = "Favorite (protected)", ko = "즐겨찾기 (보호 중)" },
	favOff = { en = "Make Favorite", ko = "즐겨찾기 지정" },
	favHelp = { en = "Your favorite can't be stolen and stays after Rebirth. (Only 1)", ko = "즐겨찾기 1마리는 도둑맞지 않고 환생해도 남아요." },
	favLocked = { en = "Can't sell your favorite.", ko = "즐겨찾기 슬라임은 팔 수 없어요." },
