	slimeIncome = { en = "{a}/s  (with bonuses {b}/s)", ko = "초당 {a} (보너스 포함 {b})" },
	slimeMutated = { en = "🌈 Your {slime} became {mut}!", ko = "🌈 {slime}이(가) {mut}(으)로 변했어요!" },
