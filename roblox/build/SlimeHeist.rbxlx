	weatherDesc_volcano = { en = "Slimes may turn LAVA (x5)!", ko = "슬라임이 용암(×5)으로 변할 수 있어요!" },
	weatherDesc_rainbow = { en = "Slimes may turn RAINBOW (x7)!", ko = "슬라임이 무지개(×7)로 변할 수 있어요!" },
