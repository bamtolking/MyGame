	weatherEnd = { en = "{weather} ended.", ko = "{weather}이(가) 끝났어요." },
	weatherDesc_golden = { en = "Slimes may turn GOLD (x2)!", ko = "슬라임이 황금(×2)으로 변할 수 있어요!" },
	weatherDesc_crystal = { en = "Slimes may turn DIAMOND (x3)!", ko = "슬라임이 다이아(×3)로 변할 수 있어요!" },
