          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">Panel</string>
              <string name="Source"><![CDATA[--!strict
-- 가운데 모달 창. 한 번에 하나만 열립니다.
-- 열릴 때: 배경 흐림(블러) + 어두운 막 + 창이 아래에서 튀어 오르며 커짐 + 소리
-- 닫힐 때: 창이 작아지며 사라짐

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Kit = require(script.Parent.Kit)
local Sound = require(script.Parent.Parent.Controllers.Sound)

local Panel = {}

export type PanelObj = {
	name: string,
	root: Frame,
	window: Frame,
	content: ScrollingFrame,
	title: TextLabel,
	isOpen: boolean,
	onOpen: (() -> ())?,
	onClose: (() -> ())?,
}

local gui: ScreenGui? = nil
local blur: BlurEffect? = nil
local panels: { [string]: PanelObj } = {}
local current: PanelObj? = nil

function Panel.gui(): ScreenGui
	if not gui then
		local g = Kit.new("ScreenGui", {
			Name = "Panels",
			ResetOnSpawn = false,
			DisplayOrder = 20,
			IgnoreGuiInset = true,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
		}) :: ScreenGui
		gui = g
		local b = Instance.new("BlurEffect")
		b.Name = "PanelBlur"
		b.Size = 0
		b.Parent = Lighting
		blur = b
		return g
	end
	return gui :: ScreenGui
end

local function fitScale(): number
	local cam = Workspace.CurrentCamera
	if not cam then
		return 1
	end
	local size = cam.ViewportSize
	return math.clamp(math.min(size.Y / 560, size.X / 640), 0.6, 1.15)
end

local function setBlur(on: boolean)
	local b = blur
	if b then
		Kit.tween(b, 0.25, { Size = if on then 12 else 0 })
	end
end

function Panel.new(name: string, titleText: string, color: Color3): PanelObj
	local screen = Panel.gui()
	local root = Kit.new("Frame", {
		Name = name,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(12, 6, 26),
		BackgroundTransparency = 1,
		Visible = false,
		Active = true,
		Parent = screen,
	}) :: Frame
	local backdrop = Kit.new("TextButton", {
		Name = "Backdrop",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = root,
	}) :: TextButton

	local window = Kit.new("Frame", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(600, 450),
		BackgroundColor3 = Kit.colors.bg,
		Parent = root,
	}) :: Frame
	Kit.corner(window, 24)
	Kit.stroke(window, 5)
	Kit.gradient(window, Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 185, 215))
	local scale = Instance.new("UIScale")
	scale.Name = "FitScale"
	scale.Parent = window

	-- 창 아래 두께감
	local base = Kit.new("Frame", {
		Name = "Base",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundColor3 = Kit.darken(Kit.colors.bg, 0.4),
		ZIndex = 0,
		Parent = window,
	}) :: Frame
	Kit.corner(base, 24)

	local header = Kit.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 66),
		BackgroundColor3 = color,
		Parent = window,
	}) :: Frame
	Kit.corner(header, 24)
	Kit.gradient(header, Kit.lighten(color, 0.25), Kit.darken(color, 0.15))
	-- 헤더 아래 모서리를 네모로 보이게 덮개
	local cover = Kit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.new(0, 0, 1, -22),
		BackgroundColor3 = Kit.darken(color, 0.15),
		BorderSizePixel = 0,
		Parent = header,
	}) :: Frame
	assert(cover)
	-- 헤더 광택
	local gloss = Kit.new("Frame", {
		Size = UDim2.new(1, -24, 0, 22),
		Position = UDim2.fromOffset(12, 5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.8,
		BorderSizePixel = 0,
		Parent = header,
	}) :: Frame
	Kit.corner(gloss, 11)
	local title = Kit.label({
		Size = UDim2.new(1, -140, 0, 46),
		Position = UDim2.fromOffset(70, 10),
		Text = titleText,
		stroke = 3,
		Parent = header,
	})
	local closeBtn = Kit.button({
		Text = "X",
		Color = Kit.colors.red,
		Size = UDim2.fromOffset(50, 50),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 7),
		Radius = 25,
		Parent = header,
	})

	local content = Kit.new("ScrollingFrame", {
		Name = "Content",
		Position = UDim2.fromOffset(12, 76),
		Size = UDim2.new(1, -24, 1, -88),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Kit.colors.purple,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = window,
	}) :: ScrollingFrame
	local pad = Instance.new("UIPadding")
	pad.PaddingRight = UDim.new(0, 10)
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 12)
	pad.PaddingLeft = UDim.new(0, 2)
	pad.Parent = content

	local obj: PanelObj = {
		name = name,
		root = root,
		window = window,
		content = content,
		title = title,
		isOpen = false,
		onOpen = nil,
		onClose = nil,
	}
	panels[name] = obj

	local function close()
		Panel.close(name)
	end
	closeBtn.Activated:Connect(close)
	backdrop.Activated:Connect(close)
	window:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if obj.isOpen then
			scale.Scale = fitScale()
		end
	end)
	scale.Scale = fitScale()
	return obj
end

function Panel.open(name: string)
	local p = panels[name]
	if not p then
		return
	end
	if current and current ~= p then
		Panel.close(current.name, true)
	end
	local wasOpen = p.isOpen
	current = p
	p.isOpen = true
	p.root.Visible = true
	if not wasOpen then
		Sound.play("open")
		setBlur(true)
		p.root.BackgroundTransparency = 1
		Kit.tween(p.root, 0.2, { BackgroundTransparency = 0.45 })
		local scale = p.window:FindFirstChild("FitScale")
		if scale and scale:IsA("UIScale") then
			local target = fitScale()
			scale.Scale = target * 0.8
			Kit.tween(scale, 0.28, { Scale = target }, Enum.EasingStyle.Back)
		end
		p.window.Position = UDim2.new(0.5, 0, 0.52, 40)
		Kit.tween(p.window, 0.28, { Position = UDim2.fromScale(0.5, 0.52) }, Enum.EasingStyle.Back)
	end
	if p.onOpen then
		p.onOpen()
	end
end

-- instant: 다른 창으로 바로 바꿀 때(닫힘 애니메이션·블러 해제 생략)
function Panel.close(name: string, instant: boolean?)
	local p = panels[name]
	if not p or not p.isOpen then
		return
	end
	p.isOpen = false
	if current == p then
		current = nil
	end
	if p.onClose then
		p.onClose()
	end
	if instant then
		p.root.Visible = false
		return
	end
	Sound.play("close")
	setBlur(false)
	Kit.tween(p.root, 0.16, { BackgroundTransparency = 1 })
	local scale = p.window:FindFirstChild("FitScale")
	if scale and scale:IsA("UIScale") then
		Kit.tween(scale, 0.16, { Scale = fitScale() * 0.85 })
	end
	task.delay(0.16, function()
		if not p.isOpen then
			p.root.Visible = false
		end
	end)
end

function Panel.toggle(name: string)
	local p = panels[name]
	if p and p.isOpen then
		Panel.close(name)
	else
		Panel.open(name)
	end
end

function Panel.isOpen(name: string): boolean
	local p = panels[name]
	return p ~= nil and p.isOpen
end

function Panel.anyOpen(): boolean
	return current ~= nil
end

function Panel.clear(p: PanelObj)
	for _, c in p.content:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

return Panel
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="72">
            <Properties>
              <string name="Name">Panels</string>
            </Properties>
            <Item class="ModuleScript" referent="73">
              <Properties>
                <string name="Name">Gifts</string>
                <string name="Source"><![CDATA[--!strict
-- 접속 선물: 이번 접속에서 N분 지나면 받을 수 있는 무료 선물 7개.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rewards = require(Shared.Config.Rewards)
local Format = require(Shared.Util.Format)

local UI = script.Parent.Parent
local Client = UI.Parent
local Kit = require(UI.Kit)
local Panel = require(UI.Panel)
local Notify = require(UI.Notify)
local Lang = require(Client.Lang)
local State = require(Client.State)
local Quests = require(script.Parent.Quests)

local Gifts = {}

type Cell = { button: TextButton, index: number }
local cells: { Cell } = {}

local function claimed(i: number): boolean
	local view = State.view
	return view ~= nil and view.giftsClaimed[tostring(i)] == true
end

local function refresh()
	local elapsed = State.sessionSeconds()
	for _, cell in cells do
		local gift = Rewards.gifts[cell.index]
		local left = gift.minutes * 60 - elapsed
		if claimed(cell.index) then
			cell.button.Text = "✅"
			Kit.setEnabled(cell.button, false)
		elseif left <= 0 then
			cell.button.Text = Lang.t("claim")
			Kit.setEnabled(cell.button, true, Kit.colors.green)
		else
			cell.button.Text = Format.time(left)
			Kit.setEnabled(cell.button, false)
		end
	end
end

function Gifts.init()
	local p = Panel.new("Gifts", "🎁 " .. Lang.t("giftsTitle"), Kit.colors.red)
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(0.25, -8, 0, 150)
	grid.CellPadding = UDim2.fromOffset(8, 8)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
	grid.Parent = p.content
	for i, gift in Rewards.gifts do
		local card = Kit.new("Frame", { BackgroundColor3 = Kit.colors.card, LayoutOrder = i, Parent = p.content }) :: Frame
		Kit.corner(card, 14)
		Kit.stroke(card, 3)
		Kit.label({ Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 6), Text = "🎁", stroke = false, Parent = card })
		Kit.label({
			Size = UDim2.new(1, -8, 0, 40),
			Position = UDim2.fromOffset(4, 52),
			Text = Quests.rewardText(gift.reward),
			TextColor3 = Kit.colors.yellow,
			Font = Kit.fontBody,
			TextWrapped = true,
			Parent = card,
		})
		local index = i
		local button = Kit.button({
			Text = "",
			Color = Kit.colors.green,
			Size = UDim2.new(1, -12, 0, 42),
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -6),
			Parent = card,
		}, function()
			local result = State.action("ClaimGift", index)
			Notify.result(result)
		end)
		table.insert(cells, { button = button, index = i })
	end
	p.onOpen = refresh
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 1 and p.isOpen then
			acc = 0
			refresh()
		end
	end)
	State.changed:Connect(function()
		if p.isOpen then
			refresh()
		end
	end)
end

function Gifts.claimable(): number
	local elapsed = State.sessionSeconds()
	local n = 0
	for i, gift in Rewards.gifts do
		if not claimed(i) and elapsed >= gift.minutes * 60 then
			n += 1
		end
	end
	return n
end

return Gifts
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="74">
              <Properties>
                <string name="Name">Index</string>
                <string name="Source"><![CDATA[--!strict
-- 도감: 슬라임 30종 × 변이 7종. 발견 1칸당 수입 +0.5%.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Slimes = require(Shared.Config.Slimes)
local Rarities = require(Shared.Config.Rarities)
local Mutations = require(Shared.Config.Mutations)
local Economy = require(Shared.Config.Economy)
local Calc = require(Shared.Logic.Calc)
local Format = require(Shared.Util.Format)

local UI = script.Parent.Parent
local Client = UI.Parent
local Kit = require(UI.Kit)
local Panel = require(UI.Panel)
local Viewport = require(UI.Viewport)
local Lang = require(Client.Lang)
local State = require(Client.State)

local Index = {}

type Card = {
	id: string,
	viewport: ViewportFrame,
	name: TextLabel,
	dots: { [string]: Frame },
}

local cards: { Card } = {}
local summary: TextLabel
local setProgress: (number) -> ()
local built = false
local panel: Panel.PanelObj

local function build()
	built = true
	local grid = Kit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Parent = panel.content,
	}) :: Frame
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.new(1 / 3, -8, 0, 150)
	layout.CellPadding = UDim2.fromOffset(8, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid
	for i, s in Slimes.list do
		local rarity = Rarities.byId[s.rarity]
		local card = Kit.new("Frame", { BackgroundColor3 = Kit.colors.card, LayoutOrder = i, Parent = grid }) :: Frame
		Kit.corner(card, 14)
		local st = Kit.stroke(card, 3, rarity.color)
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		local vp = Viewport.slime(card, { id = s.id, star = 1, mut = "none" }, {
			Size = UDim2.new(1, 0, 0, 92),
			Position = UDim2.fromOffset(0, 4),
		})
		local name = Kit.label({
			Size = UDim2.new(1, -8, 0, 24),
			Position = UDim2.fromOffset(4, 96),
			Text = "???",
			TextColor3 = if rarity.id == "secret" then Kit.colors.white else rarity.color,
			Parent = card,
		})
		local dotRow = Kit.new("Frame", {
			Size = UDim2.new(1, -8, 0, 18),
			Position = UDim2.fromOffset(4, 124),
			BackgroundTransparency = 1,
			Parent = card,
		}) :: Frame
		Kit.list(dotRow, false, 3, Enum.HorizontalAlignment.Center)
		local dots: { [string]: Frame } = {}
		for j, m in Mutations.list do
			local dot = Kit.new("Frame", {
				Size = UDim2.fromOffset(15, 15),
				BackgroundColor3 = m.label,
				BackgroundTransparency = 0.8,
				LayoutOrder = j,
				Parent = dotRow,
			}) :: Frame
			Kit.corner(dot, 8)
			Kit.stroke(dot, 1.5)
			dots[m.id] = dot
		end
		table.insert(cards, { id = s.id, viewport = vp, name = name, dots = dots })
	end
end

local function refresh()
	if not built then
		build()
	end
	local data = State.data()
	if not data then
		return
	end
	local count = Calc.indexCount(data)
	summary.Text = Lang.t("indexSummary", {
		a = count,
		b = Calc.indexTotal(),
		p = Format.number(count * Economy.indexBonusPer * 100),
	})
	setProgress(count / Calc.indexTotal())
	for _, card in cards do
		local found = data.index[card.id]
		local any = found ~= nil and next(found) ~= nil
		card.viewport.ImageColor3 = if any then Color3.new(1, 1, 1) else Color3.new(0, 0, 0)
		card.name.Text = if any then Lang.slime(card.id) else "???"
		for mutId, dot in card.dots do
			dot.BackgroundTransparency = if found and found[mutId] then 0 else 0.8
		end
	end
end

function Index.init()
	panel = Panel.new("Index", "📖 " .. Lang.t("indexTitle"), Kit.colors.blue)
	Kit.list(panel.content, true, 10, Enum.HorizontalAlignment.Center)
	summary = Kit.label({ Size = UDim2.new(1, 0, 0, 32), Text = "", TextColor3 = Kit.colors.yellow, LayoutOrder = 1, Parent = panel.content })
	local _bar
	_bar, setProgress = Kit.progress(panel.content, Kit.colors.blue, { LayoutOrder = 2, Size = UDim2.new(0.9, 0, 0, 16) })
	panel.onOpen = refresh
	State.changed:Connect(function()
		if panel.isOpen then
			refresh()
		end
	end)
end

return Index
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="75">
              <Properties>
                <string name="Name">Manage</string>
                <string name="Source"><![CDATA[--!strict
-- 내 슬라임 관리: 합성(★), 판매, 즐겨찾기(도난 불가 + 환생 유지).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Slimes = require(Shared.Config.Slimes)
local Rarities = require(Shared.Config.Rarities)
local Mutations = require(Shared.Config.Mutations)
local Economy = require(Shared.Config.Economy)
local Calc = require(Shared.Logic.Calc)
local Merge = require(Shared.Logic.Merge)
local Format = require(Shared.Util.Format)

local UI = script.Parent.Parent
local Client = UI.Parent
local Kit = require(UI.Kit)
local Panel = require(UI.Panel)
local Notify = require(UI.Notify)
local Viewport = require(UI.Viewport)
local Lang = require(Client.Lang)
local State = require(Client.State)
local Sound = require(Client.Controllers.Sound)

local Manage = {}

local panel: Panel.PanelObj
local currentUid: string? = nil
local viewport: ViewportFrame
local nameLabel: TextLabel
local rarityLabel: TextLabel
local mutLabel: TextLabel
local incomeLabel: TextLabel
local mergeLabel: TextLabel
local mergeButton: TextButton
local sellButton: TextButton
local favButton: TextButton
local shownKey = ""

local function countSame(uid: string): number
	local data = State.data()
	if not data then
		return 0
	end
	local target = data.slimes[uid]
	local n = 0
	for u, s in data.slimes do
		if s.id == target.id and s.star == target.star and (u == uid or not s.fav) then
			n += 1
		end
	end
	return n
end

local function refresh()
	local data = State.data()
	local uid = currentUid
	if not data or not uid then
		return
	end
	local s = data.slimes[uid]
	if not s then
		Panel.close("Manage")
		return
	end
	local species = Slimes.byId[s.id]
	local rarity = Rarities.byId[species.rarity]
	local mutation = Mutations.byId[s.mut] or Mutations.byId.none
	local key = s.id .. s.mut
	if key ~= shownKey then
		shownKey = key
		Viewport.set(viewport, { id = s.id, star = s.star, mut = s.mut })
	end
	nameLabel.Text = Lang.slime(s.id) .. " " .. string.rep("★", s.star)
	rarityLabel.Text = Lang.rarity(rarity.id)
	rarityLabel.TextColor3 = if rarity.id == "secret" then Kit.colors.white else rarity.color
	mutLabel.Visible = mutation.id ~= "none"
	mutLabel.Text = "✨ " .. Lang.mut(mutation.id) .. " " .. Format.mult(mutation.mult)
	mutLabel.TextColor3 = mutation.label
	local base = Calc.slimeIncome(s)
	local view = State.view
	local mult = if view then view.multiplier else 1
	incomeLabel.Text = Lang.t("slimeIncome", { a = Format.cash(base), b = Format.cash(base * mult) })

	local have = countSame(uid)
	local canMerge = Merge.findSet(data.slimes, uid) ~= nil
	if s.star >= Economy.star.max then
		mergeLabel.Text = Lang.t("maxStar")
		Kit.setEnabled(mergeButton, false)
	else
		mergeLabel.Text = Lang.t("mergeInfo", {
			n = math.min(have, 3),
			a = Format.mult(Calc.starMult(s.star)),
			b = Format.mult(Calc.starMult(s.star + 1)),
		})
		Kit.setEnabled(mergeButton, canMerge, Kit.colors.purple)
	end
	sellButton.Text = Lang.t("sellFor", { cash = Format.cash(Calc.sellPrice(s)) })
	Kit.setEnabled(sellButton, not s.fav, Kit.colors.red)
	favButton.Text = if s.fav then "⭐ " .. Lang.t("favOn") else "☆ " .. Lang.t("favOff")
	favButton.BackgroundColor3 = if s.fav then Kit.colors.yellow else Kit.colors.gray
end

function Manage.open(uid: string)
	currentUid = uid
	shownKey = ""
	Panel.open("Manage")
	refresh()
end

function Manage.init()
	panel = Panel.new("Manage", "🟢 " .. Lang.t("manageTitle"), Kit.colors.purple)
	Kit.list(panel.content, true, 8, Enum.HorizontalAlignment.Center)
	local top = Kit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 150),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = panel.content,
	}) :: Frame
	viewport = Viewport.slime(top, { id = Slimes.list[1].id, star = 1, mut = "none" }, {
		Size = UDim2.fromOffset(150, 150),
	})
	local info = Kit.new("Frame", {
		Size = UDim2.new(1, -160, 1, 0),
		Position = UDim2.fromOffset(160, 0),
		BackgroundTransparency = 1,
		Parent = top,
	}) :: Frame
	Kit.list(info, true, 4, Enum.HorizontalAlignment.Left)
	nameLabel = Kit.label({ Size = UDim2.new(1, 0, 0, 38), Text = "", LayoutOrder = 1, TextXAlignment = Enum.TextXAlignment.Left, Parent = info })
	rarityLabel = Kit.label({ Size = UDim2.new(1, 0, 0, 26), Text = "", LayoutOrder = 2, TextXAlignment = Enum.TextXAlignment.Left, Parent = info })
	mutLabel = Kit.label({ Size = UDim2.new(1, 0, 0, 24), Text = "", LayoutOrder = 3, TextXAlignment = Enum.TextXAlignment.Left, Parent = info })
	incomeLabel = Kit.label({
		Size = UDim2.new(1, 0, 0, 24),
		Text = "",
		TextColor3 = Kit.colors.cash,
		LayoutOrder = 4,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = info,
	})

	mergeLabel = Kit.label({
		Size = UDim2.new(1, 0, 0, 26),
		Text = "",
		TextColor3 = Kit.colors.yellow,
		LayoutOrder = 2,
		Parent = panel.content,
	})
	local buttons = Kit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 60),
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Parent = panel.content,
	}) :: Frame
	Kit.list(buttons, false, 10, Enum.HorizontalAlignment.Center)
	mergeButton = Kit.button({ Text = "⭐ " .. Lang.t("merge"), Color = Kit.colors.purple, Size = UDim2.fromOffset(170, 56), LayoutOrder = 1, Parent = buttons }, function()
		local uid = currentUid
		if uid then
			local result = State.action("Merge", uid)
			if result.ok then
				Sound.play("merge")
			else
				Notify.result(result)
			end
		end
	end)
	sellButton = Kit.button({ Text = "", Color = Kit.colors.red, Size = UDim2.fromOffset(170, 56), LayoutOrder = 2, Parent = buttons }, function()
		local uid = currentUid
		if uid then
			local result = State.action("Sell", uid)
			if result.ok then
				Sound.play("collect", 0.8)
				Panel.close("Manage")
			else
				Notify.result(result)
			end
		end
	end)
	favButton = Kit.button({ Text = "", Color = Kit.colors.gray, Size = UDim2.fromOffset(250, 52), LayoutOrder = 4, Parent = panel.content }, function()
		local uid = currentUid
		if uid then
			Notify.result(State.action("Favorite", uid))
		end
	end)
	Kit.label({
		Size = UDim2.new(1, 0, 0, 40),
		Text = Lang.t("favHelp"),
		TextColor3 = Kit.colors.muted,
		Font = Kit.fontBody,
		TextWrapped = true,
		stroke = false,
		LayoutOrder = 5,
		Parent = panel.content,
	})
	panel.onClose = function()
		currentUid = nil
	end
	State.changed:Connect(function()
		if panel.isOpen then
			refresh()
		end
	end)
end

return Manage
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="76">
              <Properties>
                <string name="Name">Offline</string>
                <string name="Source"><![CDATA[--!strict
-- "돌아온 걸 환영해요!" 오프라인 수입 팝업.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Util.Format)

local UI = script.Parent.Parent
local Client = UI.Parent
local Kit = require(UI.Kit)
local Panel = require(UI.Panel)
local Lang = require(Client.Lang)
local State = require(Client.State)
local Sound = require(Client.Controllers.Sound)

local Offline = {}

local text: TextLabel
local shown = false

function Offline.init()
	local p = Panel.new("Offline", "🌙 " .. Lang.t("offlineTitle"), Kit.colors.blue)
	Kit.list(p.content, true, 12, Enum.HorizontalAlignment.Center)
	text = Kit.label({
		Size = UDim2.new(1, 0, 0, 120),
		Text = "",
		TextWrapped = true,
		LayoutOrder = 1,
		Parent = p.content,
	})
	Kit.button({ Text = Lang.t("collectIt"), Color = Kit.colors.green, Size = UDim2.fromOffset(240, 64), LayoutOrder = 2, Shine = true, Parent = p.content }, function()
		State.action("ClaimOffline")
		Sound.play("collect")
		Panel.close("Offline")
	end)
	p.onClose = function()
		-- 닫기만 해도 받도록(놓치지 않게)
		local view = State.view
		if view and view.offline then
			State.action("ClaimOffline")
		end
	end
	State.changed:Connect(function(view)
		if not shown and view.offline and view.offline.amount > 0 then
			shown = true
			text.Text = Lang.t("offlineText", {
				t = Format.time(view.offline.seconds),
				cash = Format.cash(view.offline.amount),
			})
			Panel.open("Offline")
		end
	end)
end

return Offline
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="77">
              <Properties>
                <string name="Name">Quests</string>
                <string name="Source"><![CDATA[--!strict
-- 퀘스트 창: 7일 출석 + 오늘의 퀘스트 3개 + 전부 완료 보너스.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rewards = require(Shared.Config.Rewards)
local Progress = require(Shared.Logic.Progress)
local Format = require(Shared.Util.Format)

local UI = script.Parent.Parent
local Client = UI.Parent
local Kit = require(UI.Kit)
local Panel = require(UI.Panel)
local Notify = require(UI.Notify)
local Lang = require(Client.Lang)
local State = require(Client.State)

local Quests = {}

-- 보상 한 줄 설명
function Quests.rewardText(r: Rewards.Reward): string
	if r.giftRarity then
		return "🎁 " .. Lang.t("rewardSlime", { rarity = r.giftRarity })
	elseif r.boost then
		return "💰x2 " .. Format.time(r.seconds or 0)
	elseif r.serverLuck then
		return "🍀 " .. Lang.t("rewardServerLuck", { t = Format.time(r.serverLuck) })
	elseif r.cashMinutes then
		return "💵 " .. Lang.t("rewardCash", { m = r.cashMinutes })
	end
	return ""
end

local panel: Panel.PanelObj
local dayCells: { { frame: Frame, label: TextLabel } } = {}
local dailyButton: TextButton
local questBox: Frame
local bonusLabel: TextLabel
local resetLabel: TextLabel

local function refresh()
	local data = State.data()
	if not data then
		return
	end
	local now = os.time()
	local can, slot = Progress.dailyStatus(data, now)
	for i, cell in dayCells do
		local done = (not can and i <= data.daily.streak) or (can and i < slot)
		local isToday = i == slot
		cell.frame.BackgroundColor3 = if isToday and can
			then Kit.colors.yellow
			elseif done then Kit.colors.green
			else Kit.colors.card
		cell.label.Text = (if done then "✅\n" else "") .. Lang.t("dayN", { n = i })
	end
	Kit.setEnabled(dailyButton, can, Kit.colors.yellow)
	dailyButton.Text = if can then Lang.t("claimDaily") else Lang.t("comeBackTomorrow")

	for _, c in questBox:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for i, q in data.quests.list do
		local def = Rewards.questById[q.id]
		local card = Kit.new("Frame", {
			Size = UDim2.new(1, 0, 0, 86),
			BackgroundColor3 = Kit.colors.card,
			LayoutOrder = i,
			Parent = questBox,
		}) :: Frame
		Kit.corner(card, 14)
		Kit.stroke(card, 3)
		Kit.label({
			Size = UDim2.new(1, -170, 0, 30),
			Position = UDim2.fromOffset(12, 8),
			Text = Lang.quest(q.id, q.goal),
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		if def then
			Kit.label({
				Size = UDim2.new(1, -170, 0, 20),
				Position = UDim2.fromOffset(12, 38),
				Text = Quests.rewardText(def.reward),
				TextColor3 = Kit.colors.yellow,
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = Kit.fontBody,
				stroke = false,
				Parent = card,
			})
		end
		local _, setBar = Kit.progress(card, Kit.colors.green, {
			Size = UDim2.new(1, -180, 0, 14),
			Position = UDim2.fromOffset(12, 64),
		})
		setBar(q.progress / q.goal)
		local done = q.progress >= q.goal
		local index = i
		local btn = Kit.button({
			Text = if q.claimed then "✅" elseif done then Lang.t("claim") else (Format.number(math.floor(q.progress)) .. "/" .. Format.number(q.goal)),
			Color = Kit.colors.green,
			Size = UDim2.fromOffset(140, 52),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Parent = card,
		}, function()
			local result = State.action("ClaimQuest", index)
			Notify.result(result)
		end)
		Kit.setEnabled(btn, done and not q.claimed, Kit.colors.green)
	end
	local all = Progress.allQuestsClaimed(data)
	bonusLabel.Text = (if data.quests.bonusClaimed then "✅ " else "🏆 ")
		.. Lang.t("questBonus", { reward = Quests.rewardText(Rewards.questAllBonus) })
	bonusLabel.TextColor3 = if all then Kit.colors.cash else Kit.colors.white
	resetLabel.Text = Lang.t("newQuestsIn", { t = Format.time(Progress.secondsUntilNextDay(now)) })
end

function Quests.init()
	panel = Panel.new("Quests", "📜 " .. Lang.t("questsTitle"), Kit.colors.orange)
	Kit.list(panel.content, true, 10, Enum.HorizontalAlignment.Center)

	Kit.label({ Size = UDim2.new(1, 0, 0, 30), Text = Lang.t("dailyTitle"), LayoutOrder = 1, Parent = panel.content })
	local strip = Kit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 70),
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = panel.content,
	}) :: Frame
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(1 / 7, -6, 1, 0)
	grid.CellPadding = UDim2.fromOffset(6, 0)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = strip
	for i, reward in Rewards.daily do
		local cell = Kit.new("Frame", { BackgroundColor3 = Kit.colors.card, LayoutOrder = i, Parent = strip }) :: Frame
		Kit.corner(cell, 10)
		Kit.stroke(cell, 2)
		local label = Kit.label({ Size = UDim2.new(1, -4, 0.45, 0), Position = UDim2.fromOffset(2, 2), Text = "", Parent = cell })
		Kit.label({
			Size = UDim2.new(1, -4, 0.48, 0),
			Position = UDim2.new(0, 2, 0.5, 0),
			Text = Quests.rewardText(reward),
			TextColor3 = Kit.colors.yellow,
			Font = Kit.fontBody,
			TextWrapped = true,
			Parent = cell,
		})
		dayCells[i] = { frame = cell, label = label }
	end
	dailyButton = Kit.button({
		Text = "",
		Color = Kit.colors.yellow,
		Size = UDim2.fromOffset(240, 50),
		LayoutOrder = 3,
		Shine = true,
		Parent = panel.content,
	}, function()
		local result = State.action("ClaimDaily")
		Notify.result(result)
	end)

	Kit.label({ Size = UDim2.new(1, 0, 0, 30), Text = Lang.t("todayQuests"), LayoutOrder = 4, Parent = panel.content })
	questBox = Kit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 5,
		Parent = panel.content,
	}) :: Frame
	Kit.list(questBox, true, 8, Enum.HorizontalAlignment.Center)
	bonusLabel = Kit.label({ Size = UDim2.new(1, 0, 0, 28), Text = "", LayoutOrder = 6, Parent = panel.content })
	resetLabel = Kit.label({
		Size = UDim2.new(1, 0, 0, 22),
		Text = "",
		TextColor3 = Kit.colors.muted,
		Font = Kit.fontBody,
		stroke = false,
		LayoutOrder = 7,
		Parent = panel.content,
	})

	panel.onOpen = refresh
	State.changed:Connect(function()
		if panel.isOpen then
			refresh()
		end
	end)
end

-- 받을 수 있는 보상 수(배지)
function Quests.claimable(): number
	local data = State.data()
	if not data then
		return 0
	end
	local n = 0
	if (Progress.dailyStatus(data, os.time())) then
		n += 1
	end
	for _, q in data.quests.list do
		if not q.claimed and q.progress >= q.goal then
			n += 1
		end
	end
	return n
end

return Quests
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="78">
              <Properties>
                <string name="Name">Rebirth</string>
                <string name="Source"><![CDATA[--!strict
-- 환생 창: 조건(현금·등급), 보상 미리보기, 유지/초기화 안내.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarities = require(Shared.Config.Rarities)
local Calc = require(Shared.Logic.Calc)
local Format = require(Shared.Util.Format)

local UI = script.Parent.Parent
local Client = UI.Parent
local Kit = require(UI.Kit)
local Panel = require(UI.Panel)
local Notify = require(UI.Notify)
local Lang = require(Client.Lang)
local State = require(Client.State)

local Rebirth = {}

local header: TextLabel
local bonus: TextLabel
local cashText: TextLabel
local setCash: (number) -> ()
local rarityText: TextLabel
local button: TextButton

local function refresh()
	local data = State.data()
	if not data then
		return
	end
	local r = data.rebirths
	header.Text = Lang.t("rebirthHeader", { a = r, b = r + 1 })
	bonus.Text = Lang.t("rebirthBonus", {
		a = Format.mult(Calc.rebirthMult(r)),
		b = Format.mult(Calc.rebirthMult(r + 1)),
	})
	local cost = Calc.rebirthCost(r)
	cashText.Text = Lang.t("rebirthCash", { a = Format.cash(math.min(data.cash, cost)), b = Format.cash(cost) })
	setCash(data.cash / cost)
	local req = Rarities.byId[Calc.rebirthRarityReq(r)]
	local hasRarity = Calc.bestRarityOwned(data) >= req.order
	rarityText.Text = (if hasRarity then "✅ " else "❌ ") .. Lang.t("rebirthRarity", { rarity = req.id })
	rarityText.TextColor3 = if hasRarity then Kit.colors.cash else Color3.fromRGB(255, 170, 170)
	local ok = Calc.canRebirth(data)
	Kit.setEnabled(button, ok, Kit.colors.pink)
end

function Rebirth.init()
	local p = Panel.new("Rebirth", "♻️ " .. Lang.t("rebirthTitle"), Kit.colors.pink)
	Kit.list(p.content, true, 10, Enum.HorizontalAlignment.Center)
	header = Kit.label({ Size = UDim2.new(1, 0, 0, 44), Text = "", TextColor3 = Kit.colors.yellow, LayoutOrder = 1, stroke = 3, Parent = p.content })
	bonus = Kit.label({ Size = UDim2.new(1, 0, 0, 34), Text = "", TextColor3 = Kit.colors.cash, LayoutOrder = 2, Parent = p.content })
	cashText = Kit.label({ Size = UDim2.new(1, 0, 0, 28), Text = "", LayoutOrder = 3, Parent = p.content })
	local bar
	bar, setCash = Kit.progress(p.content, Kit.colors.green, { LayoutOrder = 4, Size = UDim2.new(0.9, 0, 0, 18) })
	assert(bar)
	rarityText = Kit.label({ Size = UDim2.new(1, 0, 0, 30), Text = "", LayoutOrder = 5, Parent = p.content })
	Kit.label({
		Size = UDim2.new(1, -10, 0, 58),
		Text = Lang.t("rebirthInfo"),
		TextColor3 = Kit.colors.muted,
		Font = Kit.fontBody,
		TextWrapped = true,
		stroke = false,
		LayoutOrder = 6,
		Parent = p.content,
	})
	button = Kit.button({
		Text = Lang.t("rebirthButton"),
		Color = Kit.colors.pink,
		Size = UDim2.fromOffset(260, 64),
		LayoutOrder = 7,
		Shine = true,
		Parent = p.content,
	}, function()
		local result = State.action("Rebirth")
		if result.ok then
			Panel.close("Rebirth")
		else
			Notify.result(result)
		end
	end)
	p.onOpen = refresh
	State.changed:Connect(function()
		if p.isOpen then
			refresh()
		end
	end)
	State.money:Connect(function()
		if p.isOpen then
			refresh()
		end
	end)
end

function Rebirth.ready(): boolean
	local data = State.data()
	return data ~= nil and (Calc.canRebirth(data))
end

return Rebirth
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="79">
              <Properties>
                <string name="Name">Settings</string>
                <string name="Source"><![CDATA[--!strict
-- 설정: 음악 · 효과음 · 효과(흔들림/섬광) 스위치, 튜토리얼 건너뛰기, 게임 방법.
-- 저장된 설정은 접속하자마자 적용됩니다.

local UI = script.Parent.Parent
local Client = UI.Parent
local Kit = require(UI.Kit)
local Panel = require(UI.Panel)
local Lang = require(Client.Lang)
local State = require(Client.State)
local Sound = require(Client.Controllers.Sound)
local Fx = require(Client.Controllers.Fx)

local Settings = {}

type Toggle = { key: string, knob: Frame, track: TextButton, label: TextLabel }
local toggles: { Toggle } = {}

-- 저장된 설정을 소리·연출에 반영
function Settings.apply()
	local data = State.data()
	if not data then
		return
	end
	Sound.enabled = data.settings.sfx
	Sound.musicEnabled = data.settings.music
	Fx.reduced = not data.settings.fx
end

local function valueOf(key: string): boolean
	local data = State.data()
	if not data then
		return true
	end
	local s = data.settings :: any
	return s[key] ~= false
end

local function refresh()
	Settings.apply()
	for _, t in toggles do
		local on = valueOf(t.key)
		Kit.tween(t.knob, 0.18, { Position = if on then UDim2.new(1, -30, 0.5, 0) else UDim2.new(0, 4, 0.5, 0) }, Enum.EasingStyle.Back)
		t.track.BackgroundColor3 = if on then Kit.colors.green else Kit.colors.gray
		t.label.Text = if on then "ON" else "OFF"
	end
end

local function toggleRow(parent: Instance, order: number, icon: string, textKey: string, key: string)
	local card = Kit.card(parent, { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 64) })
	Kit.label({ Size = UDim2.fromOffset(46, 46), Position = UDim2.fromOffset(10, 9), Text = icon, stroke = false, Parent = card })
	Kit.label({
		Size = UDim2.new(1, -190, 0, 34),
		Position = UDim2.fromOffset(66, 15),
		Text = Lang.t(textKey),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	local track = Kit.new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(100, 34),
		BackgroundColor3 = Kit.colors.green,
		Text = "",
		AutoButtonColor = false,
		Parent = card,
	}) :: TextButton
	Kit.corner(track, 17)
	Kit.stroke(track, 2.5).ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	local label = Kit.label({
		Size = UDim2.new(1, -44, 1, -8),
		Position = UDim2.fromOffset(12, 4),
		Text = "ON",
		Parent = track,
	})
	local knob = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(1, -30, 0.5, 0),
		Size = UDim2.fromOffset(26, 26),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = track,
	}) :: Frame
	Kit.corner(knob, 13)
	Kit.stroke(knob, 2)
	track.Activated:Connect(function()
		local data = State.data()
		local nextValue = not valueOf(key)
		if data then
			(data.settings :: any)[key] = nextValue
		end
		Sound.play("click")
		refresh()
		State.action("Settings", { [key] = nextValue })
	end)
	table.insert(toggles, { key = key, knob = knob, track = track, label = label })
end

function Settings.init()
	local p = Panel.new("Settings", "⚙️ " .. Lang.t("settingsTitle"), Kit.colors.gray)
	Kit.list(p.content, true, 10, Enum.HorizontalAlignment.Center)
	toggleRow(p.content, 1, "🎵", "music", "music")
	toggleRow(p.content, 2, "🔊", "sfx", "sfx")
	toggleRow(p.content, 3, "✨", "effects", "fx")
	Kit.button({ Text = Lang.t("skipTutorial"), Color = Kit.colors.blue, Size = UDim2.fromOffset(260, 54), LayoutOrder = 4, Parent = p.content }, function()
		State.action("SkipTutorial")
		Panel.close("Settings")
	end)
	local help = Kit.card(p.content, { LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 12)
	pad.PaddingBottom = UDim.new(0, 12)
	pad.PaddingLeft = UDim.new(0, 14)
	pad.PaddingRight = UDim.new(0, 14)
	pad.Parent = help
	Kit.label({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = Lang.t("howToPlay"),
		TextScaled = false,
		TextSize = 18,
		TextWrapped = true,
		Font = Kit.fontBody,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Kit.colors.white,
		stroke = false,
		Parent = help,
	})
	p.onOpen = refresh
	State.changed:Connect(refresh)
end

return Settings
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="80">
              <Properties>
                <string name="Name">Shop</string>
                <string name="Source"><![CDATA[--!strict
-- 업그레이드 상점.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local Calc = require(Shared.Logic.Calc)
local Format = require(Shared.Util.Format)

local UI = script.Parent.Parent
local Client = UI.Parent
local Kit = require(UI.Kit)
local Panel = require(UI.Panel)
local Notify = require(UI.Notify)
local Lang = require(Client.Lang)
local State = require(Client.State)
local Sound = require(Client.Controllers.Sound)

local Shop = {}

type Row = { level: TextLabel, effect: TextLabel, setBar: (number) -> (), button: TextButton, card: Frame, id: string, last: number }
local rows: { Row } = {}

-- 소수점이 필요 없으면 정수로
local function num(v: number): string
	if math.abs(v - math.round(v)) < 0.001 then
		return tostring(math.round(v))
	end
	return (string.format("%.2f", v):gsub("0+$", ""))
end

-- 업그레이드 효과 "현재 → 다음" 문구
local function effectText(data: any, id: string, level: number): string
	local def = Economy.upgradeById[id]
	if level >= def.maxLevel then
		return Lang.t("effectMax")
	end
	local now = table.clone(data)
	now.upgrades = table.clone(data.upgrades)
	local after = table.clone(now)
	after.upgrades = table.clone(now.upgrades)
	after.upgrades[id] = level + 1
	if id == "pads" then
		local extra = State.hasPass("extraPads")
		return Lang.t("effectPads", { a = Calc.padCount(now, extra), b = Calc.padCount(after, extra) })
	elseif id == "speed" then
		return Lang.t("effectSpeed", { a = num(Calc.walkSpeed(now)), b = num(Calc.walkSpeed(after)) })
	elseif id == "lock" then
		return Lang.t("effectLock", { a = num(Calc.lockDuration(now)), b = num(Calc.lockDuration(after)) })
	elseif id == "offline" then
		return Lang.t("effectOffline", {
			a = num(Calc.offlineRate(now) * 100),
			b = num(Calc.offlineRate(after) * 100),
			c = num(Calc.offlineCapSeconds(now) / 3600),
			d = num(Calc.offlineCapSeconds(after) / 3600),
		})
	elseif id == "luck" then
		return Lang.t("effectLuck", { a = num(Calc.luckyTouchChance(now) * 100), b = num(Calc.luckyTouchChance(after) * 100) })
	elseif id == "bonk" then
		return Lang.t("effectBonk", { a = num(Calc.bonkCooldown(now)), b = num(Calc.bonkCooldown(after)) })
	end
	return Lang.pick(def.desc)
end

local function refresh()
	local data = State.data()
	if not data then
		return
	end
	for _, r in rows do
		local def = Economy.upgradeById[r.id]
		local level = Calc.upgradeLevel(data, r.id)
		r.level.Text = Lang.t("levelOf", { a = level, b = def.maxLevel })
		r.effect.Text = effectText(data, r.id, level)
		r.setBar(level / def.maxLevel)
		if level > r.last and r.last >= 0 then
			Kit.bump(r.level, 0.35)
			Kit.bump(r.effect, 0.15)
		end
		r.last = level
		local cost = Calc.upgradeCost(r.id, level)
		if cost then
			r.button.Text = Format.cash(cost)
			Kit.setEnabled(r.button, data.cash >= cost, Kit.colors.green)
		else
			r.button.Text = Lang.t("maxed")
			Kit.setEnabled(r.button, false)
		end
	end
end

function Shop.init()
	local p = Panel.new("Shop", "🛒 " .. Lang.t("shopTitle"), Kit.colors.green)
	Kit.list(p.content, true, 8, Enum.HorizontalAlignment.Center)
	for i, def in Economy.upgrades do
		local card = Kit.card(p.content, { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 96) })
		local iconBg = Kit.new("Frame", {
			Size = UDim2.fromOffset(64, 64),
			Position = UDim2.fromOffset(10, 16),
			BackgroundColor3 = Kit.darken(Kit.colors.card, 0.25),
			Parent = card,
		}) :: Frame
		Kit.corner(iconBg, 14)
		Kit.label({ Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1), Text = def.icon, stroke = false, Parent = iconBg })
		Kit.label({
			Size = UDim2.new(1, -330, 0, 28),
			Position = UDim2.fromOffset(86, 8),
			Text = Lang.pick(def.name),
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		local level = Kit.label({
			Size = UDim2.fromOffset(84, 24),
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -152, 0, 10),
			Text = "",
			TextColor3 = Kit.colors.yellow,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = card,
		})
		local effect = Kit.label({
			Size = UDim2.new(1, -250, 0, 22),
			Position = UDim2.fromOffset(86, 40),
			Text = Lang.pick(def.desc),
			TextColor3 = Kit.colors.cash,
			Font = Kit.fontBody,
			TextXAlignment = Enum.TextXAlignment.Left,
			stroke = false,
			Parent = card,
		})
		local _, setBar = Kit.progress(card, Kit.colors.yellow, {
			Size = UDim2.new(1, -250, 0, 12),
			Position = UDim2.fromOffset(86, 70),
		})
		local id = def.id
		local row: Row
		local button = Kit.button({
			Text = "",
			Color = Kit.colors.green,
			Size = UDim2.fromOffset(130, 56),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Parent = card,
		}, function()
			local result = State.action("Upgrade", id)
			if result.ok then
				local data = State.data()
				local n = if data then Calc.upgradeLevel(data, id) + 1 else 1
				Sound.play("buy", 1 + math.min(n, 10) * 0.03)
				Sound.play("success", 1.05, 0.6)
				Kit.pop(row.card, 0.25)
			else
				Notify.result(result)
			end
		end)
		row = { level = level, effect = effect, setBar = setBar, button = button, card = card, id = id, last = -1 }
		table.insert(rows, row)
	end
	p.onOpen = refresh
	State.changed:Connect(function()
		if p.isOpen then
			refresh()
		end
	end)
	State.money:Connect(function()
		if p.isOpen then
			refresh()
		end
	end)
end

-- 살 수 있는 업그레이드 수(메뉴 배지용)
function Shop.affordable(): number
	local data = State.data()
	if not data then
		return 0
	end
	local n = 0
	for _, def in Economy.upgrades do
		local cost = Calc.upgradeCost(def.id, Calc.upgradeLevel(data, def.id))
		if cost and data.cash >= cost then
			n += 1
		end
	end
	return n
end

return Shop
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="81">
              <Properties>
                <string name="Name">Store</string>
                <string name="Source"><![CDATA[--!strict
-- 로벅스 상점: 게임패스 · 개발자 상품. ID가 0인 상품은 숨깁니다.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Products = require(Shared.Config.Products)

local UI = script.Parent.Parent
local Client = UI.Parent
local Kit = require(UI.Kit)
local Panel = require(UI.Panel)
local Lang = require(Client.Lang)
local State = require(Client.State)

local Store = {}

type Item = { kind: string, key: string, id: number, button: TextButton }
local items: { Item } = {}

local function priceText(id: number, infoType: Enum.InfoType): string
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfoAsync(id, infoType)
	end)
	if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
		return "R$ " .. tostring(info.PriceInRobux)
	end
	return Lang.t("buy")
end

local function card(parent: Instance, order: number, icon: string, name: string, desc: string, kind: string, key: string, id: number)
	local c = Kit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 78),
		BackgroundColor3 = Kit.colors.card,
		LayoutOrder = order,
		Parent = parent,
	}) :: Frame
	Kit.corner(c, 14)
	Kit.stroke(c, 3)
	Kit.label({ Size = UDim2.fromOffset(56, 56), Position = UDim2.fromOffset(10, 11), Text = icon, stroke = false, Parent = c })
	Kit.label({
		Size = UDim2.new(1, -230, 0, 30),
		Position = UDim2.fromOffset(74, 8),
		Text = name,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = c,
	})
	Kit.label({
		Size = UDim2.new(1, -230, 0, 24),
		Position = UDim2.fromOffset(74, 42),
		Text = desc,
		TextColor3 = Kit.colors.muted,
		Font = Kit.fontBody,
		TextXAlignment = Enum.TextXAlignment.Left,
		stroke = false,
		Parent = c,
	})
	local button = Kit.button({
		Text = "...",
		Color = Kit.colors.green,
		Size = UDim2.fromOffset(130, 52),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Parent = c,
	}, function()
		if kind == "pass" then
			if not State.hasPass(key) then
				MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, id)
			end
		else
			MarketplaceService:PromptProductPurchase(Players.LocalPlayer, id)
		end
	end)
	table.insert(items, { kind = kind, key = key, id = id, button = button })
	task.spawn(function()
		local text = priceText(id, if kind == "pass" then Enum.InfoType.GamePass else Enum.InfoType.Product)
		button:SetAttribute("Price", text)
		Store.refresh()
	end)
end

function Store.refresh()
	for _, item in items do
		local price = item.button:GetAttribute("Price")
		if item.kind == "pass" and State.hasPass(item.key) then
			item.button.Text = Lang.t("owned")
			Kit.setEnabled(item.button, false)
		else
			item.button.Text = if type(price) == "string" then price else "..."
			Kit.setEnabled(item.button, true, Kit.colors.green)
		end
	end
end

function Store.init()
	local p = Panel.new("Store", "💎 " .. Lang.t("storeTitle"), Kit.colors.purple)
	Kit.list(p.content, true, 8, Enum.HorizontalAlignment.Center)
	local order = 0
	local any = false
	order += 1
	Kit.label({ Size = UDim2.new(1, 0, 0, 30), Text = Lang.t("storePasses"), LayoutOrder = order, Parent = p.content })
	for _, pass in Products.passes do
		if pass.id ~= 0 then
			any = true
			order += 1
			card(p.content, order, pass.icon, Lang.pick(pass.name), Lang.pick(pass.desc), "pass", pass.key, pass.id)
		end
	end
	order += 1
	Kit.label({ Size = UDim2.new(1, 0, 0, 30), Text = Lang.t("storeProducts"), LayoutOrder = order, Parent = p.content })
	for _, product in Products.products do
		if product.id ~= 0 then
			any = true
			order += 1
			card(p.content, order, product.icon, Lang.pick(product.name), Lang.pick(product.desc), "product", product.key, product.id)
		end
	end
	if not any then
		order += 1
		Kit.label({
			Size = UDim2.new(1, 0, 0, 80),
			Text = Lang.t("storeSoon"),
			TextColor3 = Kit.colors.muted,
			TextWrapped = true,
			LayoutOrder = order,
			Parent = p.content,
		})
	end
	p.onOpen = Store.refresh
	State.changed:Connect(function()
		if p.isOpen then
			Store.refresh()
		end
	end)
end

return Store
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">Prompts</string>
              <string name="Source"><![CDATA[--!strict
-- 게임 전용 상호작용 프롬프트(ProximityPrompt Style = Custom).
-- 프롬프트 속성으로 모양을 정합니다:
--   Theme  : "buy" | "steal" | "manage"   (테두리·버튼 색)
--   Price  : number(선택)                 → 가격 줄, 살 수 있으면 초록/부족하면 빨강
--   Accent : Color3(선택)                 → 대상 이름 색(등급 색)
-- 길게 누르는 프롬프트는 게이지가 차오르고, 터치 화면에서는 카드를 눌러 실행합니다.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local State = require(Client.State)
local Kit = require(script.Parent.Kit)
local Sound = require(Client.Controllers.Sound)

local Prompts = {}

local THEME: { [string]: Color3 } = {
	buy = Kit.colors.green,
	steal = Kit.colors.red,
	manage = Kit.colors.blue,
}

type Shown = { gui: BillboardGui, conns: { RBXScriptConnection }, refresh: () -> () }
local shown: { [ProximityPrompt]: Shown } = {}
local playerGui: Instance

local function keyText(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType): string
	if inputType == Enum.ProximityPromptInputType.Touch then
		return "👆"
	elseif inputType == Enum.ProximityPromptInputType.Gamepad then
		return (string.gsub(prompt.GamepadKeyCode.Name, "Button", ""))
	end
	return prompt.KeyboardKeyCode.Name
end

local function hide(prompt: ProximityPrompt)
	local s = shown[prompt]
	if not s then
		return
	end
	shown[prompt] = nil
	for _, c in s.conns do
		c:Disconnect()
	end
	local g = s.gui
	local card = g:FindFirstChild("Card")
	if card and card:IsA("GuiObject") then
		Kit.tween(Kit.scaleOf(card), 0.12, { Scale = 0.6 })
	end
	task.delay(0.12, function()
		g:Destroy()
	end)
end

local function show(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType)
	hide(prompt)
	local theme = prompt:GetAttribute("Theme")
	local color = THEME[if type(theme) == "string" then theme else "manage"] or Kit.colors.blue
	local price = prompt:GetAttribute("Price")
	local accent = prompt:GetAttribute("Accent")
	local touch = inputType == Enum.ProximityPromptInputType.Touch

	local gui = Kit.new("BillboardGui", {
		Name = "SlimePrompt",
		Adornee = prompt.Parent,
		AlwaysOnTop = true,
		Size = UDim2.fromOffset(250, if type(price) == "number" then 86 else 66),
		StudsOffset = Vector3.new(0, 2.2, 0),
		LightInfluence = 0,
		ResetOnSpawn = false,
		Active = touch,
		Parent = playerGui,
	}) :: BillboardGui

	local card = Kit.new(if touch then "TextButton" else "Frame", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Kit.colors.bg,
		Parent = gui,
	}) :: GuiObject
	if card:IsA("TextButton") then
		card.Text = ""
		card.AutoButtonColor = false
	end
	Kit.corner(card, 16)
	Kit.stroke(card, 3, color)
	Kit.gradient(card, Color3.fromRGB(255, 255, 255), Color3.fromRGB(185, 180, 210))

	local key = Kit.label({
		Size = UDim2.fromOffset(46, 46),
		Position = UDim2.fromOffset(10, 10),
		Text = keyText(prompt, inputType),
		BackgroundColor3 = color,
		BackgroundTransparency = 0,
		stroke = 2,
		Parent = card,
	})
	Kit.corner(key, 12)
	Kit.gradient(key, Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190))

	Kit.label({
		Size = UDim2.new(1, -72, 0, 26),
		Position = UDim2.fromOffset(64, 7),
		Text = prompt.ActionText,
		TextXAlignment = Enum.TextXAlignment.Left,
		stroke = 2.5,
		Parent = card,
	})
	Kit.label({
		Size = UDim2.new(1, -72, 0, 20),
		Position = UDim2.fromOffset(64, 34),
		Text = prompt.ObjectText,
		TextColor3 = if typeof(accent) == "Color3" then accent else Kit.colors.muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	local priceLabel: TextLabel? = nil
	if type(price) == "number" then
		priceLabel = Kit.label({
			Size = UDim2.new(1, -20, 0, 22),
			Position = UDim2.fromOffset(10, 58),
			Text = "💵 " .. Format.cash(price),
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
	end

	-- 길게 누르기 게이지
	local holdBar = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 8, 1, -4),
		Size = UDim2.new(0, 0, 0, 5),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Visible = prompt.HoldDuration > 0,
		Parent = card,
	}) :: Frame
	Kit.corner(holdBar, 3)

	local function refresh()
		if priceLabel and type(price) == "number" then
			local ok = State.cash >= price
			priceLabel.TextColor3 = if ok then Kit.colors.cash else Color3.fromRGB(255, 120, 120)
		end
	end
	refresh()

	local conns: { RBXScriptConnection } = {}
	table.insert(
		conns,
		prompt.PromptButtonHoldBegan:Connect(function()
			holdBar.Size = UDim2.new(0, 0, 0, 5)
			Kit.tween(holdBar, prompt.HoldDuration, { Size = UDim2.new(1, -16, 0, 5) }, Enum.EasingStyle.Linear)
			Kit.bump(card, 0.05)
		end)
	)
	table.insert(
		conns,
		prompt.PromptButtonHoldEnded:Connect(function()
			Kit.tween(holdBar, 0.12, { Size = UDim2.new(0, 0, 0, 5) })
		end)
	)
	table.insert(
		conns,
		prompt.Triggered:Connect(function()
			Kit.pop(card, 0.5)
		end)
	)
	if card:IsA("GuiButton") then
		table.insert(
			conns,
			card.InputBegan:Connect(function(input: InputObject)
				if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
					prompt:InputHoldBegin()
				end
			end)
		)
		table.insert(
			conns,
			card.InputEnded:Connect(function(input: InputObject)
				if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
					prompt:InputHoldEnd()
				end
			end)
		)
	end
	table.insert(conns, State.money:Connect(refresh) :: any)

	shown[prompt] = { gui = gui, conns = conns, refresh = refresh }
	Kit.pop(card, 0.6)
	Sound.play("hover")
end

function Prompts.init()
	playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	ProximityPromptService.PromptShown:Connect(function(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType)
		if prompt.Style == Enum.ProximityPromptStyle.Custom then
			show(prompt, inputType)
		end
	end)
	ProximityPromptService.PromptHidden:Connect(function(prompt: ProximityPrompt)
		hide(prompt)
	end)
end

-- 프롬프트 모양 공통 설정
function Prompts.style(prompt: ProximityPrompt, theme: string, accent: Color3?, price: number?)
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt:SetAttribute("Theme", theme)
	if accent then
		prompt:SetAttribute("Accent", accent)
	end
	if price then
		prompt:SetAttribute("Price", price)
	end
end

return Prompts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">Viewport</string>
              <string name="Source"><![CDATA[--!strict
-- 3D 슬라임 미리보기(ViewportFrame).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SlimeBuilder = require(Shared.SlimeBuilder)

local Kit = require(script.Parent.Kit)

local Viewport = {}

export type Info = { id: string, star: number, mut: string }

function Viewport.slime(parent: Instance, info: Info, props: Kit.Props?): ViewportFrame
	local vf = Kit.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Ambient = Color3.fromRGB(190, 190, 200),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-0.4, -1, 0.6),
	}) :: ViewportFrame
	if props then
		for k, v in props do
			(vf :: any)[k] = v
		end
	end
	Viewport.set(vf, info)
	vf.Parent = parent
	return vf
end

-- 이미 있는 뷰포트의 슬라임을 바꿉니다.
function Viewport.set(vf: ViewportFrame, info: Info)
	for _, c in vf:GetChildren() do
		if c:IsA("Model") or c:IsA("Camera") then
			c:Destroy()
		end
	end
	-- ★ 크기와 상관없이 같은 크기로 보이게 1배로 만들고, 장식 높이를 고려해 카메라를 둡니다
	local model = SlimeBuilder.build({ id = info.id, star = 1, mut = info.mut })
	model.Parent = vf
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.CFrame = CFrame.lookAt(Vector3.new(3.2, 4.2, -10.5), Vector3.new(0, 2.3, 0))
	cam.Parent = vf
	vf.CurrentCamera = cam
end

return Viewport
]]></string>
