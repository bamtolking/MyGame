      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">Bus</string>
          <string name="Source"><![CDATA[--!strict
-- 서비스끼리 서로 require 하지 않고 소식을 주고받는 통로(순환 참조 방지).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Signal = require(ReplicatedStorage:WaitForChild("Shared").Util.Signal)

return {
	-- (session, kind: string, amount: number) 퀘스트 진행
	quest = Signal.new(),
	-- (session) 수입 배수에 영향을 주는 상태가 바뀜(업그레이드·패스·친구 등)
	incomeChanged = Signal.new(),
	-- (session, uid) 슬라임이 기지에서 사라짐(판매·합성·도난 완료·환생)
	slimeRemoved = Signal.new(),
	-- (session) 캐릭터가 새로 생김
	characterSpawned = Signal.new(),
	-- (session, plot) 보호 중인 기지에서 밀려남(들고 있던 그 기지 슬라임은 되돌려야 함)
	kickedFromPlot = Signal.new(),
}
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="34">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- 서버 시작점: 서비스 초기화 → 시작 → 입장/퇴장 순서 조율.

local ServerScriptService = game:GetService("ServerScriptService")

local Server = ServerScriptService:WaitForChild("Server")
local Services = Server:WaitForChild("Services")

local Sessions = require(Server.Sessions)
local Remote = require(Server.Remote)

local DataService = require(Services.DataService)
local MapService = require(Services.MapService)
local WeatherService = require(Services.WeatherService)
local EconomyService = require(Services.EconomyService)
local PlotService = require(Services.PlotService)
local SlimeService = require(Services.SlimeService)
local ParadeService = require(Services.ParadeService)
local StealService = require(Services.StealService)
local ProgressService = require(Services.ProgressService)
local ShopService = require(Services.ShopService)
local LeaderboardService = require(Services.LeaderboardService)
local AdminService = require(Services.AdminService)

type Service = { init: () -> (), start: () -> () }

local order: { Service } = {
	MapService,
	WeatherService,
	DataService,
	EconomyService,
	PlotService,
	SlimeService,
	ParadeService,
	StealService,
	ProgressService,
	ShopService,
	LeaderboardService,
	AdminService,
}

for _, service in order do
	service.init()
end

-- 입장: 데이터 로드가 끝난 뒤 순서대로(기지 배정 → 슬라임 → 진행도 → 패스 → 순위 → 캐릭터)
Sessions.added:Connect(function(session: Sessions.Session)
	PlotService.onJoin(session)
	SlimeService.onJoin(session)
	ProgressService.onJoin(session)
	ShopService.onJoin(session)
	LeaderboardService.onJoin(session)
	EconomyService.pushState(session)
	PlotService.spawnCharacter(session)
end)

-- 퇴장: 저장 전에 동기적으로 정리(도난 취소 → 모델 제거 → 기지 반납)
Sessions.removing:Connect(function(session: Sessions.Session)
	StealService.onLeave(session)
	SlimeService.onLeave(session)
	PlotService.onLeave(session)
end)

Remote.start()
for _, service in order do
	service.start()
end

print("[SlimeHeist] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">Remote</string>
          <string name="Source"><![CDATA[--!strict
-- 서버 쪽 원격 통신 도우미: 액션 처리기 등록, 알림·연출 보내기.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local Sessions = require(script.Parent.Sessions)

local Remote = {}

export type Result = { [string]: any }
type Handler = { interval: number, fn: (Sessions.Session, any) -> Result }

local handlers: { [string]: Handler } = {}

-- 액션 등록. interval: 같은 플레이어가 이 액션을 다시 보낼 수 있는 최소 간격(초)
function Remote.on(name: string, interval: number, fn: (Sessions.Session, any) -> Result)
	assert(handlers[name] == nil, "duplicate action " .. name)
	handlers[name] = { interval = interval, fn = fn }
end

function Remote.start()
	local action = Net.func("Action")
	action.OnServerInvoke = function(player: Player, name: any, payload: any): any
		if type(name) ~= "string" then
			return { ok = false, msg = "badRequest" }
		end
		local handler = handlers[name]
		local session = Sessions.get(player)
		if not handler or not session then
			return { ok = false, msg = "notReady" }
		end
		if not Sessions.throttle(session, name, handler.interval) then
			return { ok = false, msg = "tooFast" }
		end
		local ok, result = pcall(handler.fn, session, payload)
		if not ok then
			warn(string.format("[Action] %s failed for %s: %s", name, player.Name, tostring(result)))
			return { ok = false, msg = "error" }
		end
		return result
	end
end

-- 알림 종류: "info" | "success" | "error" | "announce" | "event" | "rare" | "steal"
function Remote.notify(player: Player, kind: string, key: string, args: { [string]: any }?)
	Net.event("Notify"):FireClient(player, { kind = kind, key = key, args = args })
end

function Remote.notifyAll(kind: string, key: string, args: { [string]: any }?)
	Net.event("Notify"):FireAllClients({ kind = kind, key = key, args = args })
end

function Remote.fx(player: Player, kind: string, data: { [string]: any }?)
	Net.event("Fx"):FireClient(player, { kind = kind, data = data })
end

function Remote.fxAll(kind: string, data: { [string]: any }?)
	Net.event("Fx"):FireAllClients({ kind = kind, data = data })
end

function Remote.fxOthers(except: Player, kind: string, data: { [string]: any }?)
	for _, p in Players:GetPlayers() do
		if p ~= except then
			Net.event("Fx"):FireClient(p, { kind = kind, data = data })
		end
	end
end

return Remote
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="36">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[--!strict
-- 관리자 채팅 명령(테스트·라이브 이벤트용). Studio에서는 누구나, 라이브에서는 제작자와 ADMINS만.
--   /cash 1e6        현금 추가
--   /event rainbow   날씨 이벤트 시작 (golden, crystal, sugar, volcano, rainbow, meteor, stop)
--   /spawn legendary [mut] | /spawn dragon [mut]   행진에 슬라임 소환
--   /luck 600        서버 행운 ×2 (초)
--   /give dragon 3 galaxy   내 기지에 슬라임 지급(★, 변이)
--   /rebirthme       환생 조건 무시하고 1회 환생 조건 충족(현금·등급)
--   /wipe            내 데이터 초기화(다음 접속 시 적용)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Slimes = require(Shared.Config.Slimes)
local Rarities = require(Shared.Config.Rarities)
local Mutations = require(Shared.Config.Mutations)
local Weather = require(Shared.Config.Weather)
local Calc = require(Shared.Logic.Calc)
local Data = require(Shared.Logic.Data)

local Server = script.Parent.Parent
local Sessions = require(Server.Sessions)
local Remote = require(Server.Remote)
local EconomyService = require(script.Parent.EconomyService)
local ParadeService = require(script.Parent.ParadeService)
local SlimeService = require(script.Parent.SlimeService)
local WeatherService = require(script.Parent.WeatherService)

local AdminService = {}

-- 라이브 서버 관리자 userId 목록
local ADMINS: { number } = {}

local function isAdmin(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
		return true
	end
	return table.find(ADMINS, player.UserId) ~= nil
end

local function words(text: string): { string }
	local out = {}
	for w in string.gmatch(text, "%S+") do
		table.insert(out, w)
	end
	return out
end

local commands: { [string]: (Sessions.Session, { string }) -> string } = {}

commands.cash = function(session, args)
	local amount = tonumber(args[2]) or 1e6
	EconomyService.addCash(session, amount)
	return "cash +" .. amount
end

commands.event = function(_session, args)
	local id = args[2] or "rainbow"
	if id == "stop" then
		WeatherService.stopEvent()
		return "weather stopped"
	end
	if not Weather.byId[id] then
		return "unknown event"
	end
	WeatherService.startEvent(id)
	return "event " .. id
end

commands.spawn = function(_session, args)
	local what = args[2] or "legendary"
	local mut = if args[3] and Mutations.byId[args[3]] then args[3] else nil
	if Rarities.byId[what] then
		ParadeService.spawn(what, nil, mut)
	elseif Slimes.byId[what] then
		ParadeService.spawn(Slimes.byId[what].rarity, what, mut)
	else
		return "unknown slime/rarity"
	end
	return "spawned " .. what
end

commands.luck = function(session, args)
	WeatherService.addServerLuck(tonumber(args[2]) or 600, session.player.DisplayName)
	return "luck on"
end

commands.give = function(session, args)
	local id = args[2] or "dragon"
	if not Slimes.byId[id] then
		return "unknown slime"
	end
	local star = math.clamp(tonumber(args[3]) or 1, 1, 5)
	local mut = if args[4] and Mutations.byId[args[4]] then args[4] else "none"
	local uid = SlimeService.add(session, { id = id, star = star, mut = mut })
	return if uid then "given " .. id else "base full"
end

commands.rebirthme = function(session, _args)
	local cost = Calc.rebirthCost(session.data.rebirths)
	if session.data.cash < cost then
		EconomyService.addCash(session, cost - session.data.cash)
	end
	local req = Calc.rebirthRarityReq(session.data.rebirths)
	local list = Slimes.byRarity[req]
	if Calc.bestRarityOwned(session.data) < Rarities.byId[req].order and list then
		SlimeService.add(session, { id = list[1].id, star = 1, mut = "none" })
	end
	return "rebirth ready"
end

commands.wipe = function(session, _args)
	local fresh = Data.default()
	for k, v in fresh :: any do
		(session.data :: any)[k] = v
	end
	SlimeService.renderAll(session)
	session.dirty = true
	return "data wiped"
end

local function handle(source: TextSource, text: string)
	local player = Players:GetPlayerByUserId(source.UserId)
	if not player or not isAdmin(player) then
		return
	end
	local session = Sessions.get(player)
	if not session then
		return
	end
	local args = words(text)
	local name = string.lower(string.sub(args[1] or "", 2))
	local fn = commands[name]
	if fn then
		local ok, result = pcall(fn, session, args)
		Remote.notify(player, "info", "adminResult", { text = if ok then result else tostring(result) })
	end
end

function AdminService.init() end

function AdminService.start()
	local folder = Instance.new("Folder")
	folder.Name = "AdminCommands"
	for name in commands do
		local cmd = Instance.new("TextChatCommand")
		cmd.Name = "Admin_" .. name
		cmd.PrimaryAlias = "/" .. name
		cmd.Triggered:Connect(handle)
		cmd.Parent = folder
	end
	folder.Parent = TextChatService
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
-- 저장: DataStore UpdateAsync + 세션 잠금.
--  · 불러올 때 다른 서버가 잠가 두었으면 잠시 기다렸다 다시 시도(오래된 잠금은 인계)
--  · 60초마다 자동 저장, 나갈 때 저장 후 잠금 해제, 서버 종료 시 모두 저장
--  · Studio에서 API 접근이 꺼져 있으면 메모리 저장으로 전환(경고 출력)

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DataLogic = require(Shared.Logic.Data)
local Types = require(Shared.Types)

local Server = script.Parent.Parent
local Sessions = require(Server.Sessions)

local DataService = {}

local STORE_NAME = "SlimeHeist_v1"
local AUTOSAVE_INTERVAL = 60
local LOCK_EXPIRE = 180 -- 이 시간 동안 갱신 안 된 잠금은 버려진 것으로 봄
local LOAD_ATTEMPTS = 6
local JOB_ID = if game.JobId ~= "" then game.JobId else "studio-" .. tostring(math.random(1, 1e9))

type Stored = {
	data: any,
	lock: { job: string, time: number }?,
}

local store: DataStore? = nil
local memory: { [string]: Stored } = {} -- Studio 대체 저장소
local loading: { [Player]: boolean } = {}
local saving: { [number]: boolean } = {}
local inflight = 0 -- 진행 중인 저장 수(서버 종료 시 모두 끝날 때까지 대기)

local function keyOf(userId: number): string
	return "u_" .. userId
end

local function update(key: string, transform: (Stored?) -> Stored?): (boolean, string?)
	if not store then
		local result = transform(memory[key])
		if result then
			memory[key] = table.clone(result)
		end
		return true, nil
	end
	local s = store :: DataStore
	local ok, err = pcall(function()
		s:UpdateAsync(key, function(old: any): any
			local result = transform(old)
			return result
		end)
	end)
	return ok, if ok then nil else tostring(err)
end

-- 불러오기(잠금 획득). 실패하면 nil
local function load(player: Player): Types.PlayerData?
	local key = keyOf(player.UserId)
	for attempt = 1, LOAD_ATTEMPTS do
		local result: any = nil
		local locked = false
		local force = attempt == LOAD_ATTEMPTS
		local ok, err = update(key, function(old: Stored?): Stored?
			local now = os.time()
			local current: Stored = old or { data = nil, lock = nil }
			local lock = current.lock
			if lock and lock.job ~= JOB_ID and now - lock.time < LOCK_EXPIRE and not force then
				locked = true
				return nil -- 쓰기 취소
			end
			result = current.data
			return { data = current.data, lock = { job = JOB_ID, time = now } }
		end)
		if ok and not locked then
			return DataLogic.reconcile(result)
		end
		if not player.Parent then
			return nil
		end
		if not ok then
			warn(string.format("[Data] load failed for %d (attempt %d): %s", player.UserId, attempt, tostring(err)))
		end
		task.wait(if locked then 5 else 2 * attempt)
	end
	return nil
end

local function save(session: Sessions.Session, release: boolean): boolean
	local userId = session.userId
	if saving[userId] and not release then
		return false
	end
	saving[userId] = true
	inflight += 1
	session.data.lastOnline = os.time()
	local snapshot = session.data
	local lostLock = false
	local ok, err = update(keyOf(userId), function(old: Stored?): Stored?
		if old and old.lock and old.lock.job ~= JOB_ID then
			lostLock = true -- 다른 서버가 이어받음: 덮어쓰지 않음
			return nil
		end
		return {
			data = snapshot,
			lock = if release then nil else { job = JOB_ID, time = os.time() },
		}
	end)
	saving[userId] = nil
	inflight -= 1
	if not ok then
		warn(string.format("[Data] save failed for %d: %s", userId, tostring(err)))
	elseif lostLock then
		warn(string.format("[Data] session lock for %d was taken by another server; save skipped", userId))
	end
	return ok and not lostLock
end

local function onPlayerAdded(player: Player)
	if loading[player] then
		return
	end
	loading[player] = true
	local data = load(player)
	loading[player] = nil
	if not player.Parent then
		return
	end
	if not data then
		player:Kick("데이터를 불러오지 못했어요. 잠시 후 다시 접속해 주세요. (Could not load your data, please rejoin.)")
		return
	end
	local session = Sessions.new(player, data)
	Sessions.add(session)
end

local function onPlayerRemoving(player: Player)
	local session = Sessions.remove(player)
	if session then
		save(session, true)
	end
end

function DataService.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
		-- Studio에서 API 접근이 꺼져 있으면 여기서 오류가 납니다
		local probeOk, probeErr = pcall(function()
			(result :: DataStore):GetAsync("__probe")
		end)
		if not probeOk then
			if RunService:IsStudio() then
				warn(
					"[Data] DataStore 사용 불가 → 메모리 저장으로 실행합니다. 저장하려면 Game Settings > Security > "
						.. "Enable Studio Access to API Services 를 켜세요. ("
						.. tostring(probeErr)
						.. ")"
				)
				store = nil
			else
				warn("[Data] DataStore probe failed: " .. tostring(probeErr))
			end
		end
	else
		warn("[Data] DataStore unavailable, using memory: " .. tostring(result))
		store = nil
	end
end

function DataService.start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, p in Players:GetPlayers() do
		task.spawn(onPlayerAdded, p)
	end

	-- 자동 저장(플레이어마다 시점을 흩어서)
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL / math.max(1, #Sessions.all()))
			local list = Sessions.all()
			table.sort(list, function(a, b)
				return (a.data.lastOnline or 0) < (b.data.lastOnline or 0)
			end)
			local oldest = list[1]
			if oldest and os.time() - oldest.data.lastOnline >= AUTOSAVE_INTERVAL then
				task.spawn(save, oldest, false)
			end
		end
	end)

	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			local session = Sessions.remove(player)
			if session then
				task.spawn(save, session, true)
			end
		end
		-- PlayerRemoving에서 시작된 저장까지 포함해 모두 끝날 때까지 대기
		local started = os.clock()
		task.wait()
		while inflight > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)
end

-- 중요한 변경(결제 등) 직후 즉시 저장
function DataService.saveNow(session: Sessions.Session): boolean
	return save(session, false)
end

function DataService.isPersistent(): boolean
	return store ~= nil
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict
-- 돈: 1초마다 수입 → 기지 금고, 수금, 부스트 시간, 플레이 시간, 클라이언트 상태 전송.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Calc = require(Shared.Logic.Calc)
local Format = require(Shared.Util.Format)
local Loop = require(Shared.Util.Loop)
local Net = require(Shared.Net)
local Types = require(Shared.Types)

local Server = script.Parent.Parent
local Sessions = require(Server.Sessions)
local Bus = require(Server.Bus)
local Remote = require(Server.Remote)
local MapService = require(script.Parent.MapService)
local WeatherService = require(script.Parent.WeatherService)

local EconomyService = {}

function EconomyService.context(session: Sessions.Session): Types.IncomeContext
	return {
		vip = session.passes.vip == true,
		doubleCash = session.passes.doubleCash == true,
		friends = session.friends,
		group = session.group,
		frenzy = WeatherService.isFrenzy(),
	}
end

function EconomyService.recalc(session: Sessions.Session)
	local ctx = EconomyService.context(session)
	local income = Calc.incomePerSecond(session.data, ctx)
	local mult = Calc.multiplier(session.data, ctx)
	if income ~= session.income or mult ~= session.multiplier then
		session.income = income
		session.multiplier = mult
		session.dirty = true
	end
end

function EconomyService.markDirty(session: Sessions.Session)
	session.dirty = true
end

function EconomyService.addCash(session: Sessions.Session, amount: number)
	if amount <= 0 or amount ~= amount then
		return
	end
	session.data.cash += amount
	session.data.totalEarned += amount
	session.moneyDirty = true
end

function EconomyService.spend(session: Sessions.Session, amount: number): boolean
	if amount < 0 or amount ~= amount or session.data.cash < amount then
		return false
	end
	session.data.cash -= amount
	session.moneyDirty = true
	return true
end

local function updateVaultLabel(session: Sessions.Session)
	local plot = MapService.plots[session.plot]
	if plot then
		plot.vaultLabel.Text = Format.cash(session.data.vault)
	end
end

function EconomyService.collect(session: Sessions.Session): number
	local amount = math.floor(session.data.vault)
	if amount <= 0 then
		return 0
	end
	session.data.vault -= amount
	session.data.cash += amount
	session.moneyDirty = true
	updateVaultLabel(session)
	Remote.fx(session.player, "collect", { amount = amount })
	Bus.quest:Fire(session, "collect", 1)
	if session.data.tutorial == 1 then
		session.data.tutorial = 2
		session.dirty = true
	end
	return amount
end

function EconomyService.buildView(session: Sessions.Session): Types.StateView
	return {
		data = session.data,
		passes = session.passes,
		income = session.income,
		multiplier = session.multiplier,
		friends = session.friends,
		plot = session.plot,
		sessionSeconds = os.clock() - session.joinedClock,
		giftsClaimed = session.giftsClaimed,
		offline = session.offline,
	}
end

function EconomyService.pushState(session: Sessions.Session)
	session.dirty = false
	session.moneyDirty = false
	Net.event("State"):FireClient(session.player, EconomyService.buildView(session))
end

local function pushMoney(session: Sessions.Session)
	session.moneyDirty = false
	Net.event("Money"):FireClient(session.player, {
		cash = session.data.cash,
		vault = session.data.vault,
		income = session.income,
	})
end

local function incomeTick()
	for _, session in Sessions.all() do
		local data = session.data
		EconomyService.recalc(session)

		local earned = session.income
		if earned > 0 then
			if session.passes.autoCollect then
				data.cash += earned
			else
				data.vault += earned
			end
			data.totalEarned += earned
			session.moneyDirty = true
			updateVaultLabel(session)
		end

		-- 부스트는 접속 중에만 줄어듭니다
		for key, seconds in data.boosts do
			local left = seconds - 1
			if left <= 0 then
				data.boosts[key] = nil
				session.dirty = true
				Remote.notify(session.player, "info", "boostEnded")
			else
				data.boosts[key] = left
			end
		end

		data.playTime += 1
		if os.clock() - session.lastPlaytimeQuest >= 10 then
			session.lastPlaytimeQuest = os.clock()
			Bus.quest:Fire(session, "playtime", 10)
		end
	end
end

function EconomyService.init() end

function EconomyService.start()
	Bus.incomeChanged:Connect(function(session: Sessions.Session)
		EconomyService.recalc(session)
		session.dirty = true
	end)
	WeatherService.changed:Connect(function()
		for _, s in Sessions.all() do
			EconomyService.recalc(s)
		end
	end)

	Loop.every("Economy", 1, incomeTick)

	-- 상태 전송: 구조가 바뀌면 전체, 돈만 바뀌면 가벼운 Money 이벤트
	task.spawn(function()
		while true do
			task.wait(0.2)
			for _, session in Sessions.all() do
				if session.player.Parent ~= Players then
					continue
				end
				if session.dirty then
					EconomyService.pushState(session)
				elseif session.moneyDirty then
					pushMoney(session)
				end
			end
		end
	end)

	Remote.on("GetState", 1, function(session)
		EconomyService.pushState(session)
		return { ok = true }
	end)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
-- 순위표: 플레이어 목록(leaderstats) + 광장의 전체 서버 순위판 3개(누적 수입·환생·훔치기).
-- OrderedDataStore는 정수만 저장하므로 누적 수입은 log10 값을 1e9배 해서 저장합니다.
-- DataStore를 못 쓰는 환경(Studio)에서는 현재 서버 플레이어로 순위판을 채웁니다.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Util.Format)

local Server = script.Parent.Parent
local Sessions = require(Server.Sessions)
local MapService = require(script.Parent.MapService)

local LeaderboardService = {}

type Board = {
	key: string,
	title: string,
	store: OrderedDataStore?,
	encode: (Sessions.Session) -> number,
	decode: (number) -> string,
	rows: { TextLabel },
	titleLabel: TextLabel?,
}

local LOG_SCALE = 1e9

local boards: { Board } = {
	{
		key = "LB_Earned_v1",
		title = "💰 TOP EARNERS",
		store = nil,
		encode = function(s)
			return math.floor(math.log10(s.data.totalEarned + 1) * LOG_SCALE)
		end,
		decode = function(v)
			return Format.cash(10 ^ (v / LOG_SCALE) - 1)
		end,
		rows = {},
		titleLabel = nil,
	},
	{
		key = "LB_Rebirths_v1",
		title = "♻️ TOP REBIRTHS",
		store = nil,
		encode = function(s)
			return s.data.rebirths
		end,
		decode = function(v)
			return Format.number(v)
		end,
		rows = {},
		titleLabel = nil,
	},
	{
		key = "LB_Steals_v1",
		title = "🥷 TOP THIEVES",
		store = nil,
		encode = function(s)
			return s.data.steals
		end,
		decode = function(v)
			return Format.number(v)
		end,
		rows = {},
		titleLabel = nil,
	},
}

local nameCache: { [number]: string } = {}

local function nameOf(userId: number): string
	local cached = nameCache[userId]
	if cached then
		return cached
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and type(name) == "string" then name else ("#" .. userId)
	nameCache[userId] = result
	return result
end

local function buildBoardGui(board: Board, part: BasePart)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back -- 순위판 파트의 Back 면이 도로/광장 쪽
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.Parent = part

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 6)
	layout.Parent = gui
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 16)
	pad.PaddingLeft = UDim.new(0, 18)
	pad.PaddingRight = UDim.new(0, 18)
	pad.Parent = gui

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 70)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(255, 225, 90)
	title.Text = board.title
	title.LayoutOrder = 0
	title.Parent = gui
	board.titleLabel = title

	for i = 1, 10 do
		local row = Instance.new("TextLabel")
		row.Size = UDim2.new(1, 0, 0, 46)
		row.BackgroundColor3 = if i % 2 == 0 then Color3.fromRGB(60, 45, 100) else Color3.fromRGB(75, 55, 120)
		row.BackgroundTransparency = 0.1
		row.Font = Enum.Font.FredokaOne
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = if i == 1
			then Color3.fromRGB(255, 215, 60)
			elseif i == 2 then Color3.fromRGB(220, 225, 235)
			elseif i == 3 then Color3.fromRGB(240, 170, 110)
			else Color3.new(1, 1, 1)
		row.Text = string.format("  %d. ---", i)
		row.LayoutOrder = i
		row.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = row
		board.rows[i] = row
	end
end

local function fill(board: Board, entries: { { userId: number, value: number } })
	for i = 1, 10 do
		local e = entries[i]
		local row = board.rows[i]
		if row then
			row.Text = if e
				then string.format("  %d. %s  —  %s", i, nameOf(e.userId), board.decode(e.value))
				else string.format("  %d. ---", i)
		end
	end
end

local function localEntries(board: Board): { { userId: number, value: number } }
	local list = {}
	for _, s in Sessions.all() do
		table.insert(list, { userId = s.userId, value = board.encode(s) })
	end
	table.sort(list, function(a, b)
		return a.value > b.value
	end)
	return list
end

local function refresh()
	for _, board in boards do
		local store = board.store
		local entries: { { userId: number, value: number } }? = nil
		if store then
			local ok, pages = pcall(function()
				return store:GetSortedAsync(false, 10)
			end)
			if ok and pages then
				local list = {}
				for _, item in (pages :: DataStorePages):GetCurrentPage() do
					local userId = tonumber(string.match(item.key, "%d+"))
					if userId then
						table.insert(list, { userId = userId, value = item.value })
					end
				end
				entries = list
			end
		end
		fill(board, entries or localEntries(board))
	end
end

local function push()
	for _, board in boards do
		local store = board.store
		if store then
			for _, s in Sessions.all() do
				local value = board.encode(s)
				if value > 0 then
					pcall(function()
						store:SetAsync("u_" .. s.userId, value)
					end)
				end
			end
		end
	end
end

function LeaderboardService.init() end

function LeaderboardService.start()
	local map = MapService.map
	local folder = map and map:FindFirstChild("Leaderboards")
	if folder then
		for i, board in boards do
			local part = folder:FindFirstChild("Board" .. i)
			if part and part:IsA("BasePart") then
				buildBoardGui(board, part)
			end
		end
	end
	for _, board in boards do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore(board.key)
		end)
		if ok then
			board.store = store
		end
	end

	-- leaderstats(플레이어 목록) 갱신
	task.spawn(function()
		while true do
			task.wait(1)
			for _, s in Sessions.all() do
				local stats = s.player:FindFirstChild("leaderstats")
				if stats then
					local cash = stats:FindFirstChild("Cash")
					if cash and cash:IsA("StringValue") then
						cash.Value = Format.cash(s.data.cash)
					end
					local reb = stats:FindFirstChild("Rebirths")
					if reb and reb:IsA("IntValue") then
						reb.Value = s.data.rebirths
					end
					local steals = stats:FindFirstChild("Steals")
					if steals and steals:IsA("IntValue") then
						steals.Value = s.data.steals
					end
				end
			end
		end
	end)

	task.spawn(function()
		task.wait(5)
		while true do
			push()
			refresh()
			task.wait(120)
		end
	end)
end

function LeaderboardService.onJoin(session: Sessions.Session)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Value = Format.cash(session.data.cash)
	cash.Parent = stats
	local reb = Instance.new("IntValue")
	reb.Name = "Rebirths"
	reb.Value = session.data.rebirths
	reb.Parent = stats
	local steals = Instance.new("IntValue")
	steals.Name = "Steals"
	steals.Value = session.data.steals
	steals.Parent = stats
	stats.Parent = session.player
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[--!strict
-- 맵 전체를 코드로 생성합니다: 잔디·언덕, 행진 컨베이어, 포털, 분수 광장, 기지 8개,
-- 나무·소나무·덤불·꽃밭·벤치·가로등·울타리·경계벽.
-- 기지 파트 참조는 PlotService가 사용합니다.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local World = require(Shared.Config.World)

local MapService = {}

export type PlotParts = {
	model: Model,
	floor: BasePart,
	pads: { BasePart },
	collect: BasePart,
	lock: BasePart,
	barrier: BasePart,
	signs: { TextLabel },
	vaultLabel: TextLabel,
	lockLabel: TextLabel,
	slimes: Folder,
}

MapService.plots = {} :: { [number]: PlotParts }
MapService.map = nil :: Model?

-- 기지별 바닥 색
local PLOT_COLORS = {
	Color3.fromRGB(255, 196, 214),
	Color3.fromRGB(190, 225, 255),
	Color3.fromRGB(200, 245, 200),
	Color3.fromRGB(255, 232, 170),
	Color3.fromRGB(225, 205, 255),
	Color3.fromRGB(180, 240, 235),
	Color3.fromRGB(255, 210, 180),
	Color3.fromRGB(230, 230, 240),
}

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function decor(p: Part): Part
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	return p
end

local function surfaceText(
	parent: BasePart,
	face: Enum.NormalId,
	text: string,
	color: Color3,
	stroke: Color3?,
	pixelsPerStud: number?
): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 30
	gui.LightInfluence = 0
	gui.Parent = parent
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = color
	label.Parent = gui
	local st = Instance.new("UIStroke")
	st.Color = stroke or Color3.fromRGB(40, 30, 60)
	st.Thickness = 3
	st.Parent = label
	return label
end

local function billboard(parent: BasePart, offset: Vector3, size: UDim2, maxDistance: number): (BillboardGui, TextLabel)
	local gui = Instance.new("BillboardGui")
	gui.Size = size
	gui.StudsOffset = offset
	gui.MaxDistance = maxDistance
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.Parent = parent
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = ""
	label.Parent = gui
	local st = Instance.new("UIStroke")
	st.Color = Color3.fromRGB(30, 25, 45)
	st.Thickness = 2.5
	st.Parent = label
	return gui, label
end

local function tree(parent: Instance, pos: Vector3, scale: number)
	local trunkH = 7 * scale
	decor(part(parent, "Trunk", Vector3.new(trunkH, 1.6 * scale, 1.6 * scale), CFrame.new(pos + Vector3.new(0, trunkH / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(125, 85, 55), Enum.Material.Wood)).Shape =
		Enum.PartType.Cylinder
	local leafColor = Color3.fromRGB(80 + math.random(0, 40), 180 + math.random(0, 40), 90)
	local top = pos + Vector3.new(0, trunkH, 0)
	local leaves = {
		{ offset = Vector3.new(0, 2.2, 0), size = 7.5 },
		{ offset = Vector3.new(2.2, 0.8, 0.8), size = 5 },
		{ offset = Vector3.new(-2, 1, -1), size = 5.5 },
		{ offset = Vector3.new(0.5, 4.3, 0.3), size = 4.5 },
	}
	for i, l in leaves do
		local ball = decor(part(parent, "Leaves" .. i, Vector3.one * l.size * scale, CFrame.new(top + l.offset * scale), leafColor, Enum.Material.Grass))
		ball.Shape = Enum.PartType.Ball
	end
end

local function lamp(parent: Instance, pos: Vector3)
	decor(part(parent, "Pole", Vector3.new(0.6, 10, 0.6), CFrame.new(pos + Vector3.new(0, 5, 0)), Color3.fromRGB(60, 60, 75), Enum.Material.Metal))
	local bulb = decor(part(parent, "Bulb", Vector3.new(1.6, 1.6, 1.6), CFrame.new(pos + Vector3.new(0, 10.5, 0)), Color3.fromRGB(255, 240, 190), Enum.Material.Neon))
	bulb.Shape = Enum.PartType.Ball
	local light = Instance.new("PointLight")
	light.Range = 18
	light.Brightness = 1.2
	light.Color = Color3.fromRGB(255, 225, 170)
	light.Parent = bulb
end

local function ball(parent: Instance, name: string, diameter: number, pos: Vector3, color: Color3, material: Enum.Material?): Part
	local p = decor(part(parent, name, Vector3.one * diameter, CFrame.new(pos), color, material))
	p.Shape = Enum.PartType.Ball
	return p
end

-- 원기둥(세로)
local function column(parent: Instance, name: string, height: number, diameter: number, pos: Vector3, color: Color3, material: Enum.Material?): Part
	local p = part(parent, name, Vector3.new(height, diameter, diameter), CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function pine(parent: Instance, pos: Vector3, scale: number)
	decor(column(parent, "PineTrunk", 4 * scale, 1.2 * scale, pos + Vector3.new(0, 2 * scale, 0), Color3.fromRGB(110, 75, 50), Enum.Material.Wood))
	local green = Color3.fromRGB(40 + math.random(0, 20), 130 + math.random(0, 30), 70)
	for k, layer in { { 3, 9 }, { 5.5, 7 }, { 8, 5 }, { 10.2, 3 } } do
		decor(column(parent, "PineLayer" .. k, 2.6 * scale, layer[2] * scale, pos + Vector3.new(0, layer[1] * scale, 0), green, Enum.Material.Grass))
	end
end

local function bush(parent: Instance, pos: Vector3, scale: number)
	local green = Color3.fromRGB(70 + math.random(0, 30), 170 + math.random(0, 30), 80)
	ball(parent, "Bush", 3.2 * scale, pos + Vector3.new(0, 1 * scale, 0), green, Enum.Material.Grass)
	ball(parent, "Bush", 2.4 * scale, pos + Vector3.new(1.5 * scale, 0.8 * scale, 0.3 * scale), green, Enum.Material.Grass)
	ball(parent, "Bush", 2.2 * scale, pos + Vector3.new(-1.3 * scale, 0.7 * scale, -0.4 * scale), green, Enum.Material.Grass)
end

local FLOWER_COLORS = {
	Color3.fromRGB(255, 110, 150),
	Color3.fromRGB(255, 220, 80),
	Color3.fromRGB(170, 120, 255),
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(255, 150, 60),
}

local function flowerBed(parent: Instance, center: Vector3, width: number, depth: number)
	decor(part(parent, "Soil", Vector3.new(width, 0.6, depth), CFrame.new(center + Vector3.new(0, 0.3, 0)), Color3.fromRGB(120, 80, 55), Enum.Material.Ground))
	decor(part(parent, "BedEdge", Vector3.new(width + 1, 0.4, depth + 1), CFrame.new(center + Vector3.new(0, 0.2, 0)), Color3.fromRGB(200, 190, 175), Enum.Material.Brick))
	local n = math.floor(width * depth / 6)
	for _ = 1, n do
		local off = Vector3.new((math.random() - 0.5) * (width - 1), 0.9, (math.random() - 0.5) * (depth - 1))
		ball(parent, "Flower", 0.7 + math.random() * 0.4, center + off, FLOWER_COLORS[math.random(1, #FLOWER_COLORS)])
	end
end

local function bench(parent: Instance, cf: CFrame)
	local wood = Color3.fromRGB(170, 115, 70)
	local metal = Color3.fromRGB(60, 60, 75)
	decor(part(parent, "BenchSeat", Vector3.new(6, 0.4, 1.8), cf * CFrame.new(0, 1.6, 0), wood, Enum.Material.Wood))
	decor(part(parent, "BenchBack", Vector3.new(6, 1.6, 0.3), cf * CFrame.new(0, 2.7, 0.8) * CFrame.Angles(math.rad(-12), 0, 0), wood, Enum.Material.Wood))
	for _, x in { -2.6, 2.6 } do
		decor(part(parent, "BenchLeg", Vector3.new(0.3, 1.6, 1.6), cf * CFrame.new(x, 0.8, 0), metal, Enum.Material.Metal))
	end
end

local function fountain(parent: Instance, center: Vector3)
	local stone = Color3.fromRGB(215, 210, 225)
	local water = Color3.fromRGB(110, 200, 255)
	column(parent, "FountainRim", 1.6, 17, center + Vector3.new(0, 0.8, 0), stone, Enum.Material.Marble)
	local pool = decor(column(parent, "FountainWater", 0.3, 15.6, center + Vector3.new(0, 1.5, 0), water, Enum.Material.Glass))
	pool.Transparency = 0.25
	column(parent, "FountainPillar", 5, 2, center + Vector3.new(0, 3.5, 0), stone, Enum.Material.Marble)
	column(parent, "FountainBowl", 0.9, 7, center + Vector3.new(0, 6, 0), stone, Enum.Material.Marble)
	local top = decor(column(parent, "FountainTopWater", 0.3, 6.2, center + Vector3.new(0, 6.5, 0), water, Enum.Material.Glass))
	top.Transparency = 0.25
	local spout = ball(parent, "FountainSpout", 1.6, center + Vector3.new(0, 7.4, 0), Color3.fromRGB(180, 235, 255), Enum.Material.Neon)
	local spray = Instance.new("ParticleEmitter")
	spray.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	spray.Color = ColorSequence.new(Color3.fromRGB(190, 235, 255))
	spray.LightEmission = 0.6
	spray.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0.2) })
	spray.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	spray.Lifetime = NumberRange.new(1.1, 1.5)
	spray.Speed = NumberRange.new(12, 16)
	spray.SpreadAngle = Vector2.new(18, 18)
	spray.Acceleration = Vector3.new(0, -26, 0)
	spray.Rate = 60
	spray.EmissionDirection = Enum.NormalId.Top
	spray.Parent = spout
end

-- 멀리 보이는 언덕(큰 공을 땅에 반쯤 묻음)
local function hill(parent: Instance, pos: Vector3, diameter: number, color: Color3)
	local h = ball(parent, "Hill", diameter, pos, color, Enum.Material.Grass)
	h.CastShadow = false
end

-- 경계 울타리(기둥 + 가로대 2줄)
local function fence(parent: Instance, a: Vector3, b: Vector3)
	local white = Color3.fromRGB(250, 245, 235)
	local dir = b - a
	local length = dir.Magnitude
	local n = math.floor(length / 14)
	for k = 0, n do
		local pos = a + dir * (k / n)
		decor(part(parent, "FencePost", Vector3.new(0.8, 4, 0.8), CFrame.new(pos + Vector3.new(0, 2, 0)), white, Enum.Material.Wood))
	end
	local mid = (a + b) / 2
	local look = CFrame.lookAt(mid, mid + Vector3.new(dir.Unit.X, 0, dir.Unit.Z))
	for _, y in { 1.4, 3 } do
		decor(part(parent, "FenceRail", Vector3.new(0.3, 0.5, length), look + Vector3.new(0, y, 0), white, Enum.Material.Wood))
	end
end

-- 링 모양 포털(작은 네온 조각을 원형으로)
local function portal(parent: Instance, center: Vector3, color: Color3, label: string)
	local model = Instance.new("Model")
	model.Name = "Portal"
	model.Parent = parent
	local radius = 11
	for i = 1, 24 do
		local a = math.rad(i * 15)
		local p = Vector3.new(math.cos(a) * radius, math.sin(a) * radius, 0)
		if p.Y > -1 then
			local cf = CFrame.new(center + Vector3.new(p.X, p.Y + 1, 0)) * CFrame.Angles(0, 0, a)
			decor(part(model, "Ring", Vector3.new(1.4, 3.2, 1.4), cf, color, Enum.Material.Neon))
		end
	end
	local inner = decor(part(model, "Swirl", Vector3.new(19, 11, 0.3), CFrame.new(center + Vector3.new(0, 6, 0)), color, Enum.Material.ForceField))
	inner.Transparency = 0.2
	local signPart = decor(part(model, "Sign", Vector3.new(20, 4, 0.5), CFrame.new(center + Vector3.new(0, 14.5, 0)), Color3.fromRGB(40, 30, 70)))
	surfaceText(signPart, Enum.NormalId.Front, label, Color3.new(1, 1, 1))
	surfaceText(signPart, Enum.NormalId.Back, label, Color3.new(1, 1, 1))
	-- 받침대와 양옆 기둥
	for _, side in { -1, 1 } do
		decor(column(model, "PortalBase", 2.4, 5, center + Vector3.new(side * radius, 1.2, 0), Color3.fromRGB(70, 60, 110), Enum.Material.Slate))
		ball(model, "PortalOrb", 2.2, center + Vector3.new(side * radius, 3.4, 0), color, Enum.Material.Neon)
	end
	local glow = Instance.new("PointLight")
	glow.Color = color
	glow.Range = 26
	glow.Brightness = 2
	glow.Parent = inner
	-- 클라이언트가 고리를 돌릴 때 쓰는 중심점
	model:SetAttribute("Center", center + Vector3.new(0, 1, 0))
end

local function buildPlot(root: Instance, i: number): PlotParts
	local model = Instance.new("Model")
	model.Name = "Plot" .. i
	model:SetAttribute("PlotIndex", i)
	model:SetAttribute("OwnerUserId", 0)
	model.Parent = root

	local P = World.plot
	local W, D, H, T = P.width, P.depth, P.wallHeight, P.wallThickness
	local color = PLOT_COLORS[i] or Color3.new(1, 1, 1)
	local wallColor = color:Lerp(Color3.fromRGB(90, 80, 110), 0.35)

	local floor = part(model, "Floor", Vector3.new(W, 1, D), World.plotPoint(i, 0, 0.5, D / 2), color, Enum.Material.SmoothPlastic)
	-- 벽(좌·우·뒤)
	for _, side in { -1, 1 } do
		part(model, "Wall", Vector3.new(T, H, D), World.plotPoint(i, side * (W / 2 + T / 2), H / 2 + 1, D / 2), wallColor)
	end
	part(model, "BackWall", Vector3.new(W + T * 2, H, T), World.plotPoint(i, 0, H / 2 + 1, D + T / 2), wallColor)
	-- 입구 기둥 + 간판
	for _, side in { -1, 1 } do
		part(model, "Pillar", Vector3.new(3, H + 6, 3), World.plotPoint(i, side * (W / 2 + T / 2), (H + 6) / 2 + 1, 0), wallColor:Lerp(Color3.new(0, 0, 0), 0.2))
	end
	local signPart = part(model, "Sign", Vector3.new(W - 4, 5, 1), World.plotPoint(i, 0, H + 4.5, -0.5), Color3.fromRGB(45, 35, 75))
	-- 간판 파트는 기지 안쪽을 바라보므로 Back 면이 도로를 향함(양면 모두 글씨)
	local signs = {
		surfaceText(signPart, Enum.NormalId.Front, "EMPTY BASE", Color3.new(1, 1, 1), nil, 20),
		surfaceText(signPart, Enum.NormalId.Back, "EMPTY BASE", Color3.new(1, 1, 1), nil, 20),
	}

	-- 장식: 벽 윗단, 벽 기둥, 입구 조명·깃발, 뒷벽 슬라임 엠블럼, 발판 구역 카펫
	local bright = color:Lerp(Color3.new(1, 1, 1), 0.35)
	local deep = color:Lerp(Color3.fromRGB(60, 40, 90), 0.55)
	local decoFolder = Instance.new("Folder")
	decoFolder.Name = "Decor"
	decoFolder.Parent = model
	for _, side in { -1, 1 } do
		decor(part(decoFolder, "WallCap", Vector3.new(T + 1, 1, D + 1), World.plotPoint(i, side * (W / 2 + T / 2), H + 1.5, D / 2), bright))
		for k = 1, 3 do
			local d = k * D / 4
			decor(part(decoFolder, "WallRib", Vector3.new(0.6, H, 2), World.plotPoint(i, side * (W / 2 - 0.3), H / 2 + 1, d), deep))
		end
		-- 입구 기둥 위 조명 + 깃발
		local orb = ball(decoFolder, "PillarLamp", 3, World.plotPoint(i, side * (W / 2 + T / 2), H + 8.6, 0).Position, bright, Enum.Material.Neon)
		local light = Instance.new("PointLight")
		light.Color = bright
		light.Range = 20
		light.Brightness = 1.5
		light.Parent = orb
		decor(part(decoFolder, "FlagPole", Vector3.new(0.3, 7, 0.3), World.plotPoint(i, side * (W / 2 + T / 2), H + 13.5, 0), Color3.fromRGB(230, 230, 240), Enum.Material.Metal))
		decor(part(decoFolder, "Flag", Vector3.new(0.12, 2.4, 3.6), World.plotPoint(i, side * (W / 2 + T / 2), H + 15.6, 1.9), bright, Enum.Material.Fabric))
	end
	decor(part(decoFolder, "BackCap", Vector3.new(W + T * 2 + 1, 1, T + 1), World.plotPoint(i, 0, H + 1.5, D + T / 2), bright))
	-- 뒷벽 엠블럼(기지 색 슬라임 얼굴). 기지 좌표계의 +Z가 입구 쪽이라 얼굴 부품은 +Z로 내밈
	local emblemCf = World.plotPoint(i, 0, 10, D - 0.2)
	local face = decor(part(decoFolder, "EmblemBody", Vector3.new(16, 11, 1), emblemCf, bright))
	local faceMesh = Instance.new("SpecialMesh")
	faceMesh.MeshType = Enum.MeshType.Sphere
	faceMesh.Parent = face
	for _, sx in { -1, 1 } do
		local eye = decor(part(decoFolder, "EmblemEye", Vector3.new(1.6, 2.4, 0.6), emblemCf * CFrame.new(sx * 2.6, 1, 0.5), Color3.fromRGB(35, 30, 45)))
		local em = Instance.new("SpecialMesh")
		em.MeshType = Enum.MeshType.Sphere
		em.Parent = eye
		ball(decoFolder, "EmblemShine", 0.7, (emblemCf * CFrame.new(sx * 2.6 - 0.3, 1.6, 0.9)).Position, Color3.new(1, 1, 1))
	end
	local smile = decor(part(decoFolder, "EmblemMouth", Vector3.new(3, 1, 0.6), emblemCf * CFrame.new(0, -1.8, 0.5), Color3.fromRGB(35, 30, 45)))
	local sm = Instance.new("SpecialMesh")
	sm.MeshType = Enum.MeshType.Sphere
	sm.Parent = smile
	-- 발판 구역 카펫
	decor(part(decoFolder, "Carpet", Vector3.new(W - 4, 0.08, D - 22), World.plotPoint(i, 0, World.floorTop + 0.04, 17 + (D - 22) / 2), color:Lerp(Color3.new(1, 1, 1), 0.3)))

	-- 발판(+ 테두리)
	local pads: { BasePart } = {}
	for p = 1, World.pads.cols * World.pads.rows do
		local x, d = World.padLocal(p)
		decor(part(decoFolder, "PadRim", Vector3.new(World.pads.size + 1, 0.3, World.pads.size + 1), World.plotPoint(i, x, World.floorTop + 0.15, d), deep))
		local pad = part(model, "Pad" .. p, Vector3.new(World.pads.size, 0.4, World.pads.size), World.plotPoint(i, x, World.floorTop + 0.2, d), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic)
		pad:SetAttribute("Pad", p)
		pads[p] = pad
	end

	-- 수금 발판 / 잠금 발판
	local F = World.front
	local collect = part(model, "CollectPlate", Vector3.new(F.plateSize, 0.5, F.plateSize), World.plotPoint(i, F.collect.x, World.floorTop + 0.25, F.collect.d), Color3.fromRGB(70, 220, 110), Enum.Material.Neon)
	local lock = part(model, "LockPlate", Vector3.new(F.plateSize, 0.5, F.plateSize), World.plotPoint(i, F.lock.x, World.floorTop + 0.25, F.lock.d), Color3.fromRGB(255, 80, 90), Enum.Material.Neon)
	local _, vaultLabel = billboard(collect, Vector3.new(0, 4, 0), UDim2.fromScale(10, 2.4), 90)
	local _, lockLabel = billboard(lock, Vector3.new(0, 4, 0), UDim2.fromScale(10, 2.4), 90)
	vaultLabel.TextColor3 = Color3.fromRGB(140, 255, 150)
	lockLabel.TextColor3 = Color3.fromRGB(255, 170, 170)
	vaultLabel.Text = "$0"
	lockLabel.Text = "LOCK"
	-- 발판 윗면 아이콘(기지 좌표계에서 윗면 글자가 입구 쪽을 향하도록 Top 면 사용)
	surfaceText(collect, Enum.NormalId.Top, "💰", Color3.new(1, 1, 1), Color3.fromRGB(20, 90, 40), 25)
	surfaceText(lock, Enum.NormalId.Top, "🔒", Color3.new(1, 1, 1), Color3.fromRGB(110, 20, 30), 25)
	for _, plate in { collect, lock } do
		decor(part(decoFolder, "PlateRim", Vector3.new(F.plateSize + 1.2, 0.35, F.plateSize + 1.2), plate.CFrame - Vector3.new(0, 0.1, 0), Color3.fromRGB(245, 245, 250), Enum.Material.Metal))
	end

	-- 방어막(잠금 시 보임). 충돌은 각 클라이언트가 주인 여부에 따라 로컬로 켭니다.
	local barrier = part(model, "Barrier", Vector3.new(W, H + 1, 0.6), World.plotPoint(i, 0, (H + 1) / 2 + 1, 0.3), Color3.fromRGB(255, 70, 90), Enum.Material.ForceField)
	barrier.Transparency = 1
	barrier.CanCollide = false
	barrier.CanQuery = false
	barrier.CanTouch = false
	barrier.CastShadow = false

	local slimes = Instance.new("Folder")
	slimes.Name = "Slimes"
	slimes.Parent = model

	return {
		model = model,
		floor = floor,
		pads = pads,
		collect = collect,
		lock = lock,
		barrier = barrier,
		signs = signs,
		vaultLabel = vaultLabel,
		lockLabel = lockLabel,
		slimes = slimes,
	}
end

function MapService.init()
	-- Studio 편집 화면용으로 구워 둔 미리보기 맵은 지우고 코드로 새로 만듭니다
	local preview = Workspace:FindFirstChild("Map")
	if preview then
		preview:Destroy()
	end
	local map = Instance.new("Model")
	map.Name = "Map"

	local B = World.bounds
	local sizeX, sizeZ = B.maxX - B.minX, B.maxZ - B.minZ
	local cx, cz = (B.minX + B.maxX) / 2, (B.minZ + B.maxZ) / 2

	-- 바닥
	part(map, "Ground", Vector3.new(sizeX + 400, 2, sizeZ + 400), CFrame.new(cx, -1, cz), Color3.fromRGB(110, 200, 95), Enum.Material.Grass)
	-- 경계벽(보이지 않음)
	local wallH = 60
	for _, w in {
		{ size = Vector3.new(2, wallH, sizeZ), pos = Vector3.new(B.minX - 1, wallH / 2, cz) },
		{ size = Vector3.new(2, wallH, sizeZ), pos = Vector3.new(B.maxX + 1, wallH / 2, cz) },
		{ size = Vector3.new(sizeX, wallH, 2), pos = Vector3.new(cx, wallH / 2, B.minZ - 1) },
		{ size = Vector3.new(sizeX, wallH, 2), pos = Vector3.new(cx, wallH / 2, B.maxZ + 1) },
	} do
		local p = part(map, "Boundary", w.size, CFrame.new(w.pos), Color3.new(1, 1, 1))
		p.Transparency = 1
		p.CastShadow = false
	end

	-- 행진 도로
	local R = World.road
	local roadLen = R.endZ - R.startZ
	part(map, "Road", Vector3.new(R.halfWidth * 2, 0.4, roadLen), CFrame.new(0, R.top - 0.2, (R.startZ + R.endZ) / 2), Color3.fromRGB(80, 70, 110), Enum.Material.SmoothPlastic)
	for _, side in { -1, 1 } do
		part(map, "Curb", Vector3.new(1.2, 0.8, roadLen), CFrame.new(side * (R.halfWidth + 0.6), 0.4, (R.startZ + R.endZ) / 2), Color3.fromRGB(255, 220, 90), Enum.Material.SmoothPlastic)
	end
	-- 컨베이어 레일(금속 + 네온 줄)과 벨트 이음매
	for _, side in { -1, 1 } do
		decor(part(map, "Rail", Vector3.new(0.8, 1.1, roadLen), CFrame.new(side * (R.halfWidth - 0.5), R.top + 0.55, (R.startZ + R.endZ) / 2), Color3.fromRGB(150, 155, 175), Enum.Material.Metal))
		decor(part(map, "RailGlow", Vector3.new(0.35, 0.2, roadLen), CFrame.new(side * (R.halfWidth - 0.5), R.top + 1.2, (R.startZ + R.endZ) / 2), Color3.fromRGB(120, 230, 255), Enum.Material.Neon))
	end
	local seam = R.startZ + 4
	while seam < R.endZ do
		decor(part(map, "BeltSeam", Vector3.new(R.halfWidth * 2 - 2, 0.05, 0.5), CFrame.new(0, R.top + 0.02, seam), Color3.fromRGB(65, 55, 92)))
		seam += 8
	end

	-- 도로 화살표(클라이언트가 흐르게 움직임)
	local arrows = Instance.new("Folder")
	arrows.Name = "RoadArrows"
	arrows.Parent = map
	local step = 12
	local z = R.startZ + 6
	while z < R.endZ - 4 do
		for _, side in { -1, 1 } do
			local arm = decor(part(arrows, "Arrow", Vector3.new(0.9, 0.12, 4.2), CFrame.new(side * 1.3, R.top + 0.03, z) * CFrame.Angles(0, math.rad(-side * 40), 0), Color3.fromRGB(150, 130, 255), Enum.Material.Neon))
			arm.Transparency = 0.35
		end
		z += step
	end

	-- 인도(도로와 기지 사이)
	for _, side in { -1, 1 } do
		part(map, "Walkway", Vector3.new(World.plot.frontX - R.halfWidth - 1.2, 0.2, roadLen), CFrame.new(side * (R.halfWidth + 1.2 + (World.plot.frontX - R.halfWidth - 1.2) / 2), 0.1, (R.startZ + R.endZ) / 2), Color3.fromRGB(235, 225, 205), Enum.Material.Pavement)
	end

	-- 포털
	portal(map, Vector3.new(0, 0, World.parade.startZ - 2), Color3.fromRGB(120, 255, 170), "SLIME PARADE")
	portal(map, Vector3.new(0, 0, World.parade.endZ + 2), Color3.fromRGB(255, 120, 200), "BYE BYE!")

	-- 광장
	local plaza = part(map, "Plaza", Vector3.new(150, 0.3, 60), CFrame.new(0, 0.15, World.plaza.centerZ), Color3.fromRGB(245, 235, 215), Enum.Material.Pavement)
	plaza.Name = "Plaza"
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PlazaSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 0.4, 10)
	spawn.CFrame = CFrame.new(World.plaza.spawn)
	spawn.Color = Color3.fromRGB(120, 255, 170)
	spawn.Material = Enum.Material.Neon
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Transparency = 0.3
	spawn.Parent = map
	local title = part(map, "TitleSign", Vector3.new(60, 14, 2), CFrame.new(0, 12, World.plaza.centerZ - 26), Color3.fromRGB(60, 40, 110))
	surfaceText(title, Enum.NormalId.Back, "SLIME HEIST!", Color3.fromRGB(255, 230, 90), Color3.fromRGB(120, 40, 160), 12)
	surfaceText(title, Enum.NormalId.Front, "SLIME HEIST!", Color3.fromRGB(255, 230, 90), Color3.fromRGB(120, 40, 160), 12)
	for _, side in { -1, 1 } do
		part(map, "TitlePost", Vector3.new(2, 20, 2), CFrame.new(side * 31, 10, World.plaza.centerZ - 26), Color3.fromRGB(90, 70, 140))
		ball(map, "TitleOrb", 3, Vector3.new(side * 31, 21, World.plaza.centerZ - 26), Color3.fromRGB(255, 220, 90), Enum.Material.Neon)
	end
	local plazaDeco = Instance.new("Folder")
	plazaDeco.Name = "PlazaDecor"
	plazaDeco.Parent = map
	fountain(plazaDeco, Vector3.new(0, 0.3, World.plaza.centerZ - 11))
	for _, side in { -1, 1 } do
		flowerBed(plazaDeco, Vector3.new(side * 24, 0.3, World.plaza.centerZ - 11), 10, 5)
		flowerBed(plazaDeco, Vector3.new(side * 66, 0.3, World.plaza.centerZ + 18), 12, 5)
		bench(plazaDeco, CFrame.new(side * 22, 0.3, World.plaza.centerZ + 6) * CFrame.Angles(0, math.pi, 0))
		bench(plazaDeco, CFrame.new(side * 40, 0.3, World.plaza.centerZ - 20))
	end

	-- 순위표 자리(LeaderboardService가 채움)
	local boards = Instance.new("Folder")
	boards.Name = "Leaderboards"
	boards.Parent = map
	for bi, x in { -55, 55, 0 } do
		local z0 = if bi == 3 then World.parade.endZ + 22 else World.plaza.centerZ - 8
		local face = if bi == 3 then math.pi else 0
		local board = part(boards, "Board" .. bi, Vector3.new(20, 26, 1.5), CFrame.new(x, 14, z0) * CFrame.Angles(0, face, 0), Color3.fromRGB(40, 30, 70))
		board:SetAttribute("BoardIndex", bi)
		for _, sx in { -1, 1 } do
			part(boards, "BoardPost", Vector3.new(1.5, 28, 1.5), CFrame.new(x, 14, z0) * CFrame.Angles(0, face, 0) * CFrame.new(sx * 10.5, 0, 0), Color3.fromRGB(90, 70, 140))
		end
	end

	-- 나무(둥근 나무와 소나무를 섞어서)·덤불·언덕·울타리·가로등
	math.randomseed(12345)
	local nature = Instance.new("Folder")
	nature.Name = "Nature"
	nature.Parent = map
	for zz = -230, 190, 26 do
		for k, xx in { -150, -128, 128, 150 } do
			local pos = Vector3.new(xx + math.random(-4, 4), 0, zz + math.random(-6, 6))
			if (k + zz // 26) % 3 == 0 then
				pine(nature, pos, 1 + math.random() * 0.4)
			else
				tree(nature, pos, 0.9 + math.random() * 0.4)
			end
		end
	end
	for zz = -140, 140, 16 do
		for _, xx in { -114, 114 } do
			bush(nature, Vector3.new(xx + math.random(-2, 2), 0, zz + math.random(-3, 3)), 0.9 + math.random() * 0.3)
		end
	end
	local hillColors = { Color3.fromRGB(95, 185, 90), Color3.fromRGB(120, 200, 100), Color3.fromRGB(80, 165, 85) }
	for k, h in {
		{ -250, -180, 150 },
		{ -260, -40, 190 },
		{ -245, 110, 160 },
		{ 250, -160, 170 },
		{ 262, 0, 150 },
		{ 250, 140, 190 },
		{ -120, 300, 180 },
		{ 60, 310, 210 },
		{ -80, -330, 170 },
		{ 110, -320, 150 },
	} do
		hill(nature, Vector3.new(h[1], -h[3] * 0.32, h[2]), h[3], hillColors[k % #hillColors + 1])
	end
	local fenceInset = 3
	local corners = {
		Vector3.new(B.minX + fenceInset, 0, B.minZ + fenceInset),
		Vector3.new(B.maxX - fenceInset, 0, B.minZ + fenceInset),
		Vector3.new(B.maxX - fenceInset, 0, B.maxZ - fenceInset),
		Vector3.new(B.minX + fenceInset, 0, B.maxZ - fenceInset),
	}
	for k = 1, 4 do
		fence(nature, corners[k], corners[k % 4 + 1])
	end
	for _, xx in { -64, -38, 38, 64 } do
		tree(nature, Vector3.new(xx, 0, World.plaza.centerZ + math.random(-8, 8)), 1)
	end
	for zz = World.road.startZ + 20, World.road.endZ - 10, 38 do
		lamp(map, Vector3.new(-(World.road.halfWidth + 3), 0.2, zz))
		lamp(map, Vector3.new(World.road.halfWidth + 3, 0.2, zz))
	end

	-- 기지
	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = map
	for i = 1, World.plot.count do
		MapService.plots[i] = buildPlot(plotsFolder, i)
	end

	map.Parent = Workspace
	MapService.map = map
end

function MapService.start() end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">ParadeService</string>
            <string name="Source"><![CDATA[--!strict
-- 슬라임 행진(공유 컨베이어). 서버는 목록과 출발 시각만 관리하고,
-- 위치는 공식(World.paradePosition)으로 계산합니다. 그리기는 클라이언트 몫.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Slimes = require(Shared.Config.Slimes)
local Rarities = require(Shared.Config.Rarities)
local Mutations = require(Shared.Config.Mutations)
local Economy = require(Shared.Config.Economy)
local World = require(Shared.Config.World)
local Calc = require(Shared.Logic.Calc)
local Roll = require(Shared.Logic.Roll)
local Net = require(Shared.Net)
local Loop = require(Shared.Util.Loop)
local Types = require(Shared.Types)

local Server = script.Parent.Parent
local Sessions = require(Server.Sessions)
local Bus = require(Server.Bus)
local Remote = require(Server.Remote)
local EconomyService = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)
local SlimeService = require(script.Parent.SlimeService)
local WeatherService = require(script.Parent.WeatherService)

local ParadeService = {}

local active: { [number]: Types.ParadeSlime } = {}
local nextKey = 1
local random = Random.new()

local function rand(): number
	return random:NextNumber()
end

local function now(): number
	return Workspace:GetServerTimeNow()
end

-- 변이 슬라임은 수입 배수만큼 비싸지 않음(이득이라 눈에 띄면 달려가게)
function ParadeService.priceOf(id: string, mut: string): number
	local species = Slimes.byId[id]
	local mult = Calc.mutMult(mut)
	return math.floor(species.price * (1 + (mult - 1) * 0.5))
end

function ParadeService.spawn(rarity: string?, speciesId: string?, mut: string?): Types.ParadeSlime
	local r = rarity or Roll.rarity(WeatherService.luck(), rand)
	local id = speciesId or Roll.species(r, rand)
	local m = mut or Roll.paradeMutation(WeatherService.currentMutation(), rand)
	local entry: Types.ParadeSlime = {
		key = nextKey,
		id = id,
		mut = m,
		price = ParadeService.priceOf(id, m),
		spawnAt = now(),
	}
	nextKey += 1
	active[entry.key] = entry
	Net.event("Parade"):FireAllClients({ op = "spawn", slime = entry })

	local species = Slimes.byId[id]
	local rar = Rarities.byId[species.rarity]
	if rar.announce or (Mutations.byId[m] and Mutations.byId[m].mult >= 5) then
		Remote.notifyAll("rare", "rareSpawn", { slime = id, mut = m, rarity = rar.id })
	end
	return entry
end

local function removeEntry(key: number, buyerUserId: number?)
	if active[key] then
		active[key] = nil
		Net.event("Parade"):FireAllClients({ op = "remove", key = key, buyer = buyerUserId })
	end
end

function ParadeService.positionOf(entry: Types.ParadeSlime): Vector3?
	return World.paradePosition(now() - entry.spawnAt)
end

function ParadeService.buy(session: Sessions.Session, key: any): (boolean, string?)
	if type(key) ~= "number" then
		return false, "badRequest"
	end
	local entry = active[key]
	if not entry then
		return false, "gone"
	end
	local pos = ParadeService.positionOf(entry)
	if not pos then
		removeEntry(key)
		return false, "gone"
	end
	local root = PlotService.rootPart(session.player)
	if not root then
		return false, "tooFar"
	end
	local flat = Vector3.new(root.Position.X - pos.X, 0, root.Position.Z - pos.Z)
	if flat.Magnitude > Economy.parade.buyRange or math.abs(root.Position.Y - pos.Y) > 20 then
		return false, "tooFar"
	end
	if session.plot == 0 then
		return false, "noPlot"
	end
	if not SlimeService.freePad(session) then
		return false, "baseFull"
	end
	if not EconomyService.spend(session, entry.price) then
		return false, "noCash"
	end

	removeEntry(key, session.userId)
	local mut = entry.mut
	if mut == "none" and rand() < Calc.luckyTouchChance(session.data) then
		mut = Roll.randomMutation(rand)
		Remote.notify(session.player, "success", "luckyTouch", { mut = mut })
	end
	local uid = SlimeService.add(session, { id = entry.id, star = 1, mut = mut })
	if not uid then
		-- 이론상 위에서 확인했지만, 혹시 모를 경우 환불
		EconomyService.addCash(session, entry.price)
		return false, "baseFull"
	end

	session.data.stats.bought += 1
	Bus.quest:Fire(session, "buy", 1)
	if Calc.rarityOf(entry.id) >= Rarities.byId.rare.order then
		Bus.quest:Fire(session, "buyRare", 1)
	end
	if session.data.tutorial == 0 then
		session.data.tutorial = 1
		session.dirty = true
	end
	Remote.fxAll("bought", {
		key = key,
		plot = session.plot,
		uid = uid,
		userId = session.userId,
		id = entry.id,
		mut = mut,
	})
	return true, nil
end

function ParadeService.list(): { Types.ParadeSlime }
	local out = {}
	for _, e in active do
		table.insert(out, e)
	end
	return out
end

function ParadeService.init() end

function ParadeService.start()
	Loop.every("Parade", Economy.parade.interval, function()
		-- 끝까지 간 슬라임 정리
		local t = now()
		for key, e in active do
			if t - e.spawnAt > World.paradeDuration + 1 then
				active[key] = nil
			end
		end
		if #Players:GetPlayers() > 0 then
			ParadeService.spawn()
		end
	end)

	Remote.on("Buy", 0.15, function(session, key)
		local ok, msg = ParadeService.buy(session, key)
		return { ok = ok, msg = msg }
	end)
	Remote.on("ParadeSync", 1, function(_session)
		return { ok = true, list = ParadeService.list(), serverTime = now() }
	end)
end

return ParadeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[--!strict
-- 기지: 배정/해제, 캐릭터 스폰, 수금·잠금 발판, 방어막(잠금·도난 후 보호·초보 보호),
-- 잠긴 기지에 들어온 남 밀어내기, 이동 속도, 친구 보너스.
--
-- 기지 모델 속성(클라이언트가 읽음):
--   OwnerUserId, OwnerName, PadCount, LockEnds, ShieldEnds, LockCooldownEnds, Rookie

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local World = require(Shared.Config.World)
local Economy = require(Shared.Config.Economy)
local Products = require(Shared.Config.Products)
local Calc = require(Shared.Logic.Calc)
local Loop = require(Shared.Util.Loop)

local Server = script.Parent.Parent
local Sessions = require(Server.Sessions)
local Bus = require(Server.Bus)
local Remote = require(Server.Remote)
local MapService = require(script.Parent.MapService)
local EconomyService = require(script.Parent.EconomyService)

local PlotService = {}

local owners: { [number]: Sessions.Session } = {}
local lockEnds: { [number]: number } = {}
local shieldEnds: { [number]: number } = {}
local cooldownEnds: { [number]: number } = {}
local touchDebounce: { [Player]: { [string]: number } } = {}
local kickNotice: { [Player]: number } = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

function PlotService.rootPart(player: Player): BasePart?
	local char = player.Character
	if not char then
		return nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function PlotService.sessionAt(plot: number): Sessions.Session?
	return owners[plot]
end

-- 위치가 들어 있는 기지 번호(없으면 0)
function PlotService.plotAt(pos: Vector3): number
	for i = 1, World.plot.count do
		if World.isInsidePlot(i, pos, 0) then
			return i
		end
	end
	return 0
end

local function isRookie(session: Sessions.Session): boolean
	return session.data.rebirths == 0 and session.data.playTime < Economy.steal.rookieShieldSeconds
end

-- 기지가 보호 중인가? (true, "lock" | "shield" | "rookie")
function PlotService.protection(plot: number): (boolean, string?)
	local t = now()
	if (lockEnds[plot] or 0) > t then
		return true, "lock"
	end
	if (shieldEnds[plot] or 0) > t then
		return true, "shield"
	end
	local owner = owners[plot]
	if owner and isRookie(owner) then
		return true, "rookie"
	end
	return false, nil
end

local BARRIER_COLORS = {
	lock = Color3.fromRGB(255, 70, 90),
	shield = Color3.fromRGB(90, 170, 255),
	rookie = Color3.fromRGB(90, 230, 130),
}

local function refreshBarrier(plot: number)
	local parts = MapService.plots[plot]
	if not parts then
		return
	end
	local protected, kind = PlotService.protection(plot)
	parts.barrier.Transparency = if protected then 0.35 else 1
	if kind then
		parts.barrier.Color = BARRIER_COLORS[kind]
	end
	local model = parts.model
	model:SetAttribute("LockEnds", lockEnds[plot] or 0)
	model:SetAttribute("ShieldEnds", shieldEnds[plot] or 0)
	model:SetAttribute("LockCooldownEnds", cooldownEnds[plot] or 0)
	local owner = owners[plot]
	model:SetAttribute("Rookie", owner ~= nil and isRookie(owner))

	local t = now()
	local label = parts.lockLabel
	if (lockEnds[plot] or 0) > t then
		label.Text = "🔒 " .. math.ceil(lockEnds[plot] - t) .. "s"
	elseif (cooldownEnds[plot] or 0) > t then
		label.Text = "⏳ " .. math.ceil(cooldownEnds[plot] - t) .. "s"
	elseif kind == "rookie" then
		label.Text = "🛡 NEW"
	elseif kind == "shield" then
		label.Text = "🛡 " .. math.ceil(shieldEnds[plot] - t) .. "s"
	else
		label.Text = "LOCK"
	end
end

function PlotService.shield(plot: number, seconds: number)
	shieldEnds[plot] = math.max(shieldEnds[plot] or 0, now() + seconds)
	refreshBarrier(plot)
end

function PlotService.padCount(session: Sessions.Session): number
	return Calc.padCount(session.data, session.passes.extraPads == true)
end

function PlotService.refreshPads(session: Sessions.Session)
	local parts = MapService.plots[session.plot]
	if not parts then
		return
	end
	local count = PlotService.padCount(session)
	parts.model:SetAttribute("PadCount", count)
	for p, pad in parts.pads do
		local open = p <= count
		pad.Color = if open then Color3.fromRGB(255, 255, 255) else Color3.fromRGB(120, 115, 135)
		pad.Transparency = if open then 0 else 0.5
		pad.Material = if open then Enum.Material.SmoothPlastic else Enum.Material.Glass
	end
end

function PlotService.updateSpeed(session: Sessions.Session)
	local char = session.player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	local speed = Calc.walkSpeed(session.data) * session.carryMult
	if session.revengeUntil > os.clock() then
		speed += Economy.steal.revengeSpeed
	end
	hum.WalkSpeed = speed
end

function PlotService.spawnCharacter(session: Sessions.Session)
	local player = session.player
	if player.Parent ~= Players or Sessions.get(player) ~= session then
		return
	end
	local ok, err = pcall(function()
		player:LoadCharacterAsync()
	end)
	if not ok then
		warn("[Plot] LoadCharacter failed: " .. tostring(err))
		return
	end
	local char = player.Character
	if not char then
		return
	end
	local cf = if session.plot > 0 then World.spawnCFrame(session.plot) else CFrame.new(World.plaza.spawn + Vector3.new(0, 3, 0))
	char:PivotTo(cf)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.Died:Connect(function()
			task.delay(3, function()
				PlotService.spawnCharacter(session)
			end)
		end)
	end
	session.carryMult = 1
	PlotService.updateSpeed(session)
	Bus.characterSpawned:Fire(session)
end

local function debounced(player: Player, key: string, seconds: number): boolean
	local entry = touchDebounce[player]
	if not entry then
		entry = {}
		touchDebounce[player] = entry
	end
	local t = os.clock()
	if entry[key] and t - entry[key] < seconds then
		return false
	end
	entry[key] = t
	return true
end

local function ownerFromHit(plot: number, hit: BasePart): Sessions.Session?
	local model = hit:FindFirstAncestorOfClass("Model")
	if not model then
		return nil
	end
	local player = Players:GetPlayerFromCharacter(model)
	if not player then
		return nil
	end
	local owner = owners[plot]
	if owner and owner.player == player then
		return owner
	end
	return nil
end

function PlotService.lock(session: Sessions.Session): (boolean, string?)
	local plot = session.plot
	if plot == 0 then
		return false, "noPlot"
	end
	local t = now()
	if (lockEnds[plot] or 0) > t then
		return false, "alreadyLocked"
	end
	if (cooldownEnds[plot] or 0) > t then
		return false, "lockCooldown"
	end
	local duration = Calc.lockDuration(session.data)
	lockEnds[plot] = t + duration
	cooldownEnds[plot] = t + duration + Economy.lock.cooldown
	refreshBarrier(plot)
	Remote.fx(session.player, "lock", { seconds = duration })
	if session.data.tutorial == 2 then
		session.data.tutorial = 3
		session.dirty = true
	end
	return true, nil
end

local function connectPlates(plot: number)
	local parts = MapService.plots[plot]
	parts.collect.Touched:Connect(function(hit: BasePart)
		local owner = ownerFromHit(plot, hit)
		if owner and debounced(owner.player, "collect", 0.6) then
			EconomyService.collect(owner)
		end
	end)
	parts.lock.Touched:Connect(function(hit: BasePart)
		local owner = ownerFromHit(plot, hit)
		if owner and debounced(owner.player, "lock", 1) then
			local ok, msg = PlotService.lock(owner)
			if not ok and msg then
				local t = now()
				local secs = if msg == "alreadyLocked"
					then math.ceil((lockEnds[plot] or t) - t)
					else math.ceil((cooldownEnds[plot] or t) - t)
				Remote.notify(owner.player, "info", msg, { s = secs })
			end
		end
	end)
end

local function setSign(plot: number, text: string)
	for _, label in MapService.plots[plot].signs do
		label.Text = text
	end
end

-- 가장 앞(낮은 번호)의 빈 기지 배정
function PlotService.assign(session: Sessions.Session): number
	for i = 1, World.plot.count do
		if not owners[i] then
			owners[i] = session
			session.plot = i
			lockEnds[i], shieldEnds[i], cooldownEnds[i] = 0, 0, 0
			local model = MapService.plots[i].model
			model:SetAttribute("OwnerUserId", session.userId)
			model:SetAttribute("OwnerName", session.player.DisplayName)
			setSign(i, session.player.DisplayName .. "'s Base")
			PlotService.refreshPads(session)
			refreshBarrier(i)
			return i
		end
	end
	return 0
end

function PlotService.release(session: Sessions.Session)
	local plot = session.plot
	if plot > 0 and owners[plot] == session then
		owners[plot] = nil
		lockEnds[plot], shieldEnds[plot], cooldownEnds[plot] = 0, 0, 0
		local parts = MapService.plots[plot]
		parts.model:SetAttribute("OwnerUserId", 0)
		parts.model:SetAttribute("OwnerName", "")
		parts.vaultLabel.Text = "$0"
		setSign(plot, "EMPTY BASE")
		for _, pad in parts.pads do
			pad.Color = Color3.fromRGB(255, 255, 255)
			pad.Transparency = 0
			pad.Material = Enum.Material.SmoothPlastic
		end
		refreshBarrier(plot)
	end
	session.plot = 0
	touchDebounce[session.player] = nil
	kickNotice[session.player] = nil
end

-- 친구·그룹 보너스 계산(웹 호출이라 비동기). 친구 관계는 세션에 기록해 두고 나갈 때 재사용
local function recount(session: Sessions.Session)
	local n = 0
	for userId in session.friendSet do
		if Sessions.byUserId(userId) then
			n += 1
		end
	end
	if n ~= session.friends then
		session.friends = n
		Bus.incomeChanged:Fire(session)
	end
end

local function refreshSocial(session: Sessions.Session)
	for _, other in Sessions.all() do
		if other ~= session then
			local ok, isFriend = pcall(function()
				return session.player:IsFriendsWithAsync(other.userId)
			end)
			if ok and isFriend and Sessions.get(session.player) == session then
				session.friendSet[other.userId] = true
				other.friendSet[session.userId] = true
				recount(other)
				Remote.notify(other.player, "success", "friendJoined", { name = session.player.DisplayName })
			end
		end
	end
	if Products.groupId ~= 0 then
		local ok, inGroup = pcall(function()
			return session.player:IsInGroupAsync(Products.groupId)
		end)
		session.group = ok and inGroup == true
	end
	recount(session)
	Bus.incomeChanged:Fire(session)
end

local function onLeaveSocial(session: Sessions.Session)
	for _, other in Sessions.all() do
		if other.friendSet[session.userId] then
			other.friendSet[session.userId] = nil
			recount(other)
		end
	end
end

-- 잠긴 기지에서 남을 밀어내기 + 방어막 표시 갱신
local function guardTick()
	for plot = 1, World.plot.count do
		local owner = owners[plot]
		if not owner then
			continue
		end
		local protected = PlotService.protection(plot)
		if protected then
			for _, player in Players:GetPlayers() do
				if player ~= owner.player then
					local root = PlotService.rootPart(player)
					if root and World.isInsidePlot(plot, root.Position, 0) then
						local char = player.Character
						local intruder = Sessions.get(player)
						if intruder then
							Bus.kickedFromPlot:Fire(intruder, plot)
						end
						if char then
							char:PivotTo(World.outsidePlot(plot))
							local last = kickNotice[player] or 0
							if os.clock() - last > 3 then
								kickNotice[player] = os.clock()
								Remote.notify(player, "error", "baseLocked")
								Remote.fx(player, "zap", {})
							end
						end
					end
				end
			end
		end
	end
end

local lastBarrierRefresh = 0

function PlotService.init() end

function PlotService.start()
	for i = 1, World.plot.count do
		connectPlates(i)
	end
	task.spawn(function()
		while true do
			task.wait(0.2)
			Loop.try("PlotGuard", guardTick)
			if os.clock() - lastBarrierRefresh >= 1 then
				lastBarrierRefresh = os.clock()
				for i = 1, World.plot.count do
					refreshBarrier(i)
				end
				for _, s in Sessions.all() do
					if s.revengeUntil > 0 and s.revengeUntil <= os.clock() then
						s.revengeUntil = 0
						PlotService.updateSpeed(s)
					end
				end
			end
		end
	end)

	Remote.on("Lock", 1, function(session)
		-- 모바일에서 발판 대신 버튼으로 잠글 때: 주인이 기지 안에 있어야 함
		local root = PlotService.rootPart(session.player)
		if not root or session.plot == 0 or not World.isInsidePlot(session.plot, root.Position, 4) then
			return { ok = false, msg = "goHomeToLock" }
		end
		local ok, msg = PlotService.lock(session)
		return { ok = ok, msg = msg }
	end)
end

function PlotService.onJoin(session: Sessions.Session)
	PlotService.assign(session)
	task.spawn(refreshSocial, session)
end

function PlotService.onLeave(session: Sessions.Session)
	onLeaveSocial(session)
	PlotService.release(session)
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">ProgressService</string>
            <string name="Source"><![CDATA[--!strict
-- 성장·보상: 업그레이드, 환생, 일일 퀘스트, 7일 출석, 접속 선물, 오프라인 수입, 튜토리얼, 설정.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local Rewards = require(Shared.Config.Rewards)
local Calc = require(Shared.Logic.Calc)
local Progress = require(Shared.Logic.Progress)

local Server = script.Parent.Parent
local Sessions = require(Server.Sessions)
local Bus = require(Server.Bus)
local Remote = require(Server.Remote)
local EconomyService = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)
local SlimeService = require(script.Parent.SlimeService)
local StealService = require(script.Parent.StealService)
local WeatherService = require(script.Parent.WeatherService)

local ProgressService = {}

export type Granted = {
	cash: number?,
	boost: string?,
	seconds: number?,
	slime: string?,
	serverLuck: number?,
}

-- 보상 지급. 클라이언트 팝업용 요약을 돌려줍니다.
function ProgressService.grant(session: Sessions.Session, reward: Rewards.Reward): Granted
	local out: Granted = {}
	if reward.cashMinutes then
		local amount = Calc.cashReward(reward.cashMinutes, reward.minCash or 0, session.income)
		EconomyService.addCash(session, amount)
		out.cash = amount
	end
	if reward.boost and reward.seconds then
		session.data.boosts[reward.boost] = (session.data.boosts[reward.boost] or 0) + reward.seconds
		out.boost = reward.boost
		out.seconds = reward.seconds
		Bus.incomeChanged:Fire(session)
	end
	if reward.giftRarity then
		local _, id = SlimeService.giveRandom(session, reward.giftRarity)
		out.slime = id
	end
	if reward.serverLuck then
		WeatherService.addServerLuck(reward.serverLuck, session.player.DisplayName)
		out.serverLuck = reward.serverLuck
	end
	session.dirty = true
	Remote.fx(session.player, "reward", out :: any)
	return out
end

local function upgrade(session: Sessions.Session, id: any): (boolean, string?)
	if type(id) ~= "string" or not Economy.upgradeById[id] then
		return false, "badRequest"
	end
	local level = Calc.upgradeLevel(session.data, id)
	local cost = Calc.upgradeCost(id, level)
	if not cost then
		return false, "maxed"
	end
	if not EconomyService.spend(session, cost) then
		return false, "noCash"
	end
	session.data.upgrades[id] = level + 1
	if id == "pads" then
		PlotService.refreshPads(session)
	elseif id == "speed" then
		PlotService.updateSpeed(session)
	end
	Bus.quest:Fire(session, "upgrade", 1)
	Bus.incomeChanged:Fire(session)
	session.dirty = true
	return true, nil
end

local function rebirth(session: Sessions.Session): (boolean, string?)
	local ok, why = Calc.canRebirth(session.data)
	if not ok then
		return false, why
	end
	StealService.cancelAllFor(session)
	local data = session.data
	-- 즐겨찾기 1마리는 1번 발판으로 데려갑니다
	local keep = nil
	for _, s in data.slimes do
		if s.fav then
			keep = { id = s.id, star = s.star, mut = s.mut, pad = 1, fav = true }
			break
		end
	end
	SlimeService.clearModels(session)
	data.slimes = {}
	session.busy = {}
	if keep then
		data.slimes[tostring(data.nextUid)] = keep
		data.nextUid += 1
	end
	data.cash = Economy.startCash
	data.vault = 0
	data.rebirths += 1
	SlimeService.renderAll(session)
	Bus.incomeChanged:Fire(session)
	session.dirty = true
	Remote.notifyAll("announce", "rebirthAnnounce", { name = session.player.DisplayName, n = data.rebirths })
	Remote.fx(session.player, "rebirth", { n = data.rebirths })
	return true, nil
end

local function claimQuest(session: Sessions.Session, index: any): (boolean, string?, Granted?)
	if type(index) ~= "number" then
		return false, "badRequest", nil
	end
	local q = session.data.quests.list[index]
	if not q or q.claimed or q.progress < q.goal then
		return false, "notReady", nil
	end
	local def = Rewards.questById[q.id]
	if not def then
		return false, "badRequest", nil
	end
	q.claimed = true
	local granted = ProgressService.grant(session, def.reward)
	if Progress.allQuestsClaimed(session.data) and not session.data.quests.bonusClaimed then
		session.data.quests.bonusClaimed = true
		ProgressService.grant(session, Rewards.questAllBonus)
		Remote.notify(session.player, "success", "questAllDone")
	end
	return true, nil, granted
end

local function claimGift(session: Sessions.Session, index: any): (boolean, string?, Granted?)
	if type(index) ~= "number" or not Rewards.gifts[index] then
		return false, "badRequest", nil
	end
	local key = tostring(index)
	if session.giftsClaimed[key] then
		return false, "claimed", nil
	end
	if not Progress.giftReady(index, os.clock() - session.joinedClock + 1) then
		return false, "notReady", nil
	end
	session.giftsClaimed[key] = true
	return true, nil, ProgressService.grant(session, Rewards.gifts[index].reward)
end

local function onQuest(session: Sessions.Session, kind: string, amount: number)
	if Sessions.get(session.player) ~= session then
		return
	end
	local before: { [number]: boolean } = {}
	for i, q in session.data.quests.list do
		before[i] = q.progress >= q.goal
	end
	if Progress.questEvent(session.data, kind, amount) then
		session.dirty = true
		for i, q in session.data.quests.list do
			if not before[i] and q.progress >= q.goal then
				Remote.notify(session.player, "success", "questDone", { quest = q.id })
			end
		end
	end
end

function ProgressService.init() end

function ProgressService.start()
	Bus.quest:Connect(onQuest)

	-- 자정(UTC)이 지나면 퀘스트 새로 뽑기
	task.spawn(function()
		while true do
			task.wait(30)
			for _, s in Sessions.all() do
				if Progress.refreshQuests(s.data, os.time(), s.userId) then
					s.dirty = true
					Remote.notify(s.player, "info", "newQuests")
				end
			end
		end
	end)

	Remote.on("Upgrade", 0.15, function(session, id)
		local ok, msg = upgrade(session, id)
		return { ok = ok, msg = msg }
	end)
	Remote.on("Rebirth", 2, function(session)
		local ok, msg = rebirth(session)
		return { ok = ok, msg = msg }
	end)
	Remote.on("ClaimDaily", 1, function(session)
		local slot = Progress.claimDaily(session.data, os.time())
		if not slot then
			return { ok = false, msg = "claimed" }
		end
		return { ok = true, granted = ProgressService.grant(session, Rewards.daily[slot]), slot = slot }
	end)
	Remote.on("ClaimQuest", 0.3, function(session, index)
		local ok, msg, granted = claimQuest(session, index)
		return { ok = ok, msg = msg, granted = granted }
	end)
	Remote.on("ClaimGift", 0.3, function(session, index)
		local ok, msg, granted = claimGift(session, index)
		return { ok = ok, msg = msg, granted = granted }
	end)
	Remote.on("ClaimOffline", 1, function(session)
		local offline = session.offline
		if not offline then
			return { ok = false, msg = "claimed" }
		end
		session.offline = nil
		EconomyService.addCash(session, offline.amount)
		session.dirty = true
		Remote.fx(session.player, "reward", { cash = offline.amount })
		return { ok = true }
	end)
	Remote.on("SkipTutorial", 1, function(session)
		session.data.tutorial = math.max(session.data.tutorial, 3)
		session.dirty = true
		return { ok = true }
	end)
	Remote.on("Settings", 0.5, function(session, payload)
		if type(payload) == "table" then
			if type(payload.music) == "boolean" then
				session.data.settings.music = payload.music
			end
			if type(payload.sfx) == "boolean" then
				session.data.settings.sfx = payload.sfx
			end
			if type(payload.fx) == "boolean" then
				session.data.settings.fx = payload.fx
			end
			session.dirty = true
		end
		return { ok = true }
	end)
end

function ProgressService.onJoin(session: Sessions.Session)
	local data = session.data
	Progress.refreshQuests(data, os.time(), session.userId)
	EconomyService.recalc(session)
	if data.lastOnline > 0 then
		local away = os.time() - data.lastOnline
		local amount, seconds = Calc.offlineEarnings(data, away, session.income)
		if amount > 0 then
			session.offline = { amount = amount, seconds = seconds }
		end
	end
	session.dirty = true
end

return ProgressService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!strict
-- 게임패스 · 개발자 상품. 영수증 ID를 저장 데이터에 기록해 중복 지급을 막습니다.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Products = require(Shared.Config.Products)
local Calc = require(Shared.Logic.Calc)
local Data = require(Shared.Logic.Data)

local Server = script.Parent.Parent
local Sessions = require(Server.Sessions)
local Bus = require(Server.Bus)
local Remote = require(Server.Remote)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)
local WeatherService = require(script.Parent.WeatherService)

local ShopService = {}

local function applyPasses(session: Sessions.Session)
	session.player:SetAttribute("VIP", session.passes.vip == true)
	PlotService.refreshPads(session)
	PlotService.updateSpeed(session)
	Bus.incomeChanged:Fire(session)
	session.dirty = true
end

local function grantProduct(session: Sessions.Session, key: string)
	if key == "serverLuck" then
		WeatherService.addServerLuck(Products.serverLuckSeconds, session.player.DisplayName)
	elseif key == "rainbowStorm" then
		WeatherService.startEvent("rainbow")
		Remote.notifyAll("announce", "stormBought", { name = session.player.DisplayName })
	else
		local minutes = (Products.cashPackMinutes :: any)[key] :: number?
		local minCash = (Products.cashPackMin :: any)[key] :: number?
		if minutes and minCash then
			local amount = Calc.cashReward(minutes, minCash, session.income)
			EconomyService.addCash(session, amount)
			Remote.fx(session.player, "reward", { cash = amount })
		end
	end
	Remote.notify(session.player, "success", "thanksPurchase")
end

local function processReceipt(receipt: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local session = player and Sessions.get(player)
	if not session then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	if Data.hasReceipt(session.data, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local product = Products.productById[receipt.ProductId]
	if not product then
		warn("[Shop] unknown product id " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	grantProduct(session, product.key)
	Data.addReceipt(session.data, purchaseId)
	session.dirty = true
	if DataService.isPersistent() and not DataService.saveNow(session) then
		-- 지급 기록은 메모리에 있으므로 재시도 때 중복 지급되지 않습니다
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function ShopService.init() end

function ShopService.start()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
		if not purchased then
			return
		end
		local session = Sessions.get(player)
		if not session then
			return
		end
		for _, pass in Products.passes do
			if pass.id ~= 0 and pass.id == passId then
				session.passes[pass.key] = true
				applyPasses(session)
				Remote.notify(player, "success", "thanksPurchase")
				Remote.fx(player, "rebirth", { n = 0 })
			end
		end
	end)
end

function ShopService.onJoin(session: Sessions.Session)
	task.spawn(function()
		for _, pass in Products.passes do
			if pass.id ~= 0 then
				local ok, owns = pcall(function()
					return MarketplaceService:UserOwnsGamePassAsync(session.userId, pass.id)
				end)
				if ok and owns then
					session.passes[pass.key] = true
				end
			end
		end
		if Sessions.get(session.player) == session then
			applyPasses(session)
		end
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">SlimeService</string>
            <string name="Source"><![CDATA[--!strict
-- 기지 슬라임: 데이터 ↔ 모델 동기화, 추가/제거, 판매, 합성, 즐겨찾기, 날씨 변이, 도감.
-- 모델: Plot.Slimes 폴더 안, 태그 "BaseSlime", 속성 Uid/OwnerUserId/SpeciesId/Star/Mutation/Pad/Fav

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Slimes = require(Shared.Config.Slimes)
local Rarities = require(Shared.Config.Rarities)
local Weather = require(Shared.Config.Weather)
local World = require(Shared.Config.World)
local Calc = require(Shared.Logic.Calc)
local Data = require(Shared.Logic.Data)
local Merge = require(Shared.Logic.Merge)
local Roll = require(Shared.Logic.Roll)
local SlimeBuilder = require(Shared.SlimeBuilder)
local Loop = require(Shared.Util.Loop)
local Types = require(Shared.Types)

local Server = script.Parent.Parent
local Sessions = require(Server.Sessions)
local Bus = require(Server.Bus)
local Remote = require(Server.Remote)
local MapService = require(script.Parent.MapService)
local EconomyService = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)
local WeatherService = require(script.Parent.WeatherService)

local SlimeService = {}

export type SlimeInfo = { id: string, star: number, mut: string }

local models: { [Sessions.Session]: { [string]: Model } } = {}
local random = Random.new()

local function modelsOf(session: Sessions.Session): { [string]: Model }
	local m = models[session]
	if not m then
		m = {}
		models[session] = m
	end
	return m
end

local function destroyModel(session: Sessions.Session, uid: string)
	local m = modelsOf(session)
	local model = m[uid]
	if model then
		model:Destroy()
		m[uid] = nil
	end
end

-- uid 슬라임의 모델을 (다시) 만듭니다. 도둑이 들고 가는 중이면 만들지 않습니다.
function SlimeService.render(session: Sessions.Session, uid: string)
	destroyModel(session, uid)
	local s = session.data.slimes[uid]
	local plot = MapService.plots[session.plot]
	if not s or not plot or session.busy[uid] then
		return
	end
	local model = SlimeBuilder.build({ id = s.id, star = s.star, mut = s.mut }, World.padCFrame(session.plot, s.pad))
	model.Name = "Slime_" .. uid
	model:SetAttribute("Uid", uid)
	model:SetAttribute("OwnerUserId", session.userId)
	model:SetAttribute("Pad", s.pad)
	model:SetAttribute("Fav", s.fav == true)
	model:SetAttribute("PlotIndex", session.plot)
	CollectionService:AddTag(model, "BaseSlime")
	model.Parent = plot.slimes
	modelsOf(session)[uid] = model
end

function SlimeService.renderAll(session: Sessions.Session)
	for uid in modelsOf(session) do
		destroyModel(session, uid)
	end
	for uid in session.data.slimes do
		SlimeService.render(session, uid)
	end
end

function SlimeService.clearModels(session: Sessions.Session)
	for uid in modelsOf(session) do
		destroyModel(session, uid)
	end
	models[session] = nil
end

function SlimeService.freePad(session: Sessions.Session): number?
	return Data.freePad(session.data, PlotService.padCount(session))
end

-- 도감 등록 + 새 발견 알림
local function discover(session: Sessions.Session, id: string, mut: string)
	if Data.discover(session.data, id, mut) then
		Remote.notify(session.player, "success", "newIndex", { slime = id, mut = mut })
		Bus.incomeChanged:Fire(session)
	end
end

-- 슬라임 추가. 빈 발판이 없으면 nil
function SlimeService.add(session: Sessions.Session, info: SlimeInfo, keepFav: boolean?): string?
	local pad = SlimeService.freePad(session)
	if not pad then
		return nil
	end
	local uid = Data.newUid(session.data)
	session.data.slimes[uid] = {
		id = info.id,
		star = math.clamp(info.star, 1, 5),
		mut = info.mut,
		pad = pad,
		fav = if keepFav then true else nil,
	}
	discover(session, info.id, info.mut)
	SlimeService.render(session, uid)
	Bus.incomeChanged:Fire(session)
	return uid
end

-- 데이터에서 제거(모델 포함)
function SlimeService.remove(session: Sessions.Session, uid: string): Types.SlimeData?
	local s = session.data.slimes[uid]
	if not s then
		return nil
	end
	session.data.slimes[uid] = nil
	session.busy[uid] = nil
	destroyModel(session, uid)
	Bus.slimeRemoved:Fire(session, uid)
	Bus.incomeChanged:Fire(session)
	return s
end

-- 선물 슬라임(최소 등급 이상 무작위). 자리가 없으면 판매가를 현금으로
function SlimeService.giveRandom(session: Sessions.Session, minRarity: string): (string?, string)
	local minOrder = Rarities.byId[minRarity].order
	local rand = function(): number
		return random:NextNumber()
	end
	local rarity = Roll.rarity(WeatherService.luck(), rand, minOrder)
	local id = Roll.species(rarity, rand)
	local info = { id = id, star = 1, mut = "none" }
	local uid = SlimeService.add(session, info)
	if not uid then
		EconomyService.addCash(session, Calc.sellPrice(info))
		Remote.notify(session.player, "info", "giftToCash", { slime = id })
	end
	return uid, id
end

local function isOwnSlime(session: Sessions.Session, uid: any): boolean
	return type(uid) == "string" and session.data.slimes[uid] ~= nil and not session.busy[uid]
end

function SlimeService.sell(session: Sessions.Session, uid: string): (boolean, string?)
	if not isOwnSlime(session, uid) then
		return false, "notFound"
	end
	local s = session.data.slimes[uid]
	if s.fav then
		return false, "favLocked"
	end
	local price = Calc.sellPrice(s)
	SlimeService.remove(session, uid)
	EconomyService.addCash(session, price)
	Remote.fx(session.player, "sell", { amount = price })
	return true, nil
end

function SlimeService.merge(session: Sessions.Session, uid: string): (boolean, string?)
	if not isOwnSlime(session, uid) then
		return false, "notFound"
	end
	local set = Merge.findSet(session.data.slimes, uid, session.busy)
	if not set then
		return false, "cantMerge"
	end
	local result = Merge.result(session.data.slimes, set)
	local fromPads: { number } = {}
	for i = 2, #set do
		table.insert(fromPads, session.data.slimes[set[i]].pad)
		SlimeService.remove(session, set[i])
	end
	session.data.slimes[uid] = result
	discover(session, result.id, result.mut)
	SlimeService.render(session, uid)
	session.data.stats.merges += 1
	Bus.quest:Fire(session, "merge", 1)
	Bus.incomeChanged:Fire(session)
	Remote.fxAll("merge", {
		plot = session.plot,
		uid = uid,
		star = result.star,
		from = fromPads,
		id = result.id,
		owner = session.userId,
	})
	return true, nil
end

function SlimeService.toggleFav(session: Sessions.Session, uid: string): (boolean, string?)
	if not isOwnSlime(session, uid) then
		return false, "notFound"
	end
	local target = session.data.slimes[uid]
	local turnOn = not target.fav
	for _, s in session.data.slimes do
		s.fav = nil
	end
	if turnOn then
		target.fav = true
	end
	for u, model in modelsOf(session) do
		model:SetAttribute("Fav", session.data.slimes[u] ~= nil and session.data.slimes[u].fav == true)
	end
	session.dirty = true
	return true, nil
end

-- 도둑이 들어 올리면 기지에서 사라지고, 실패하면 다시 나타남
function SlimeService.setBusy(session: Sessions.Session, uid: string, busy: boolean)
	if busy then
		session.busy[uid] = true
		destroyModel(session, uid)
	else
		session.busy[uid] = nil
		SlimeService.render(session, uid)
	end
	session.dirty = true
end

function SlimeService.modelOf(session: Sessions.Session, uid: string): Model?
	return modelsOf(session)[uid]
end

-- 날씨 이벤트 중 기지 슬라임 변이
local function weatherTick()
	local mut = WeatherService.currentMutation()
	if not mut then
		return
	end
	for _, session in Sessions.all() do
		local changed: { string } = {}
		for uid, s in session.data.slimes do
			if not session.busy[uid] and random:NextNumber() < Weather.baseMutationChance then
				if Roll.isBetterMutation(mut, s.mut) then
					s.mut = mut
					table.insert(changed, uid)
					discover(session, s.id, mut)
				end
			end
		end
		for _, uid in changed do
			SlimeService.render(session, uid)
			Remote.fxAll("mutate", { plot = session.plot, uid = uid, mut = mut })
		end
		if #changed > 0 then
			local first = session.data.slimes[changed[1]]
			Remote.notify(session.player, "success", "slimeMutated", { slime = first.id, mut = mut, n = #changed })
			Bus.incomeChanged:Fire(session)
		end
	end
end

function SlimeService.init() end

function SlimeService.start()
	Loop.every("SlimeWeather", Weather.baseMutationInterval, weatherTick)

	Remote.on("Sell", 0.2, function(session, uid)
		local ok, msg = SlimeService.sell(session, uid)
		return { ok = ok, msg = msg }
	end)
	Remote.on("Merge", 0.3, function(session, uid)
		local ok, msg = SlimeService.merge(session, uid)
		return { ok = ok, msg = msg }
	end)
	Remote.on("Favorite", 0.3, function(session, uid)
		local ok, msg = SlimeService.toggleFav(session, uid)
		return { ok = ok, msg = msg }
	end)
end

function SlimeService.onJoin(session: Sessions.Session)
	-- 발판 수가 줄었을 수도 있으니(게임패스 환불 등) 범위 밖 발판은 그대로 두되 표시만
	for _, s in session.data.slimes do
		discover(session, s.id, s.mut)
	end
	SlimeService.renderAll(session)
end

function SlimeService.onLeave(session: Sessions.Session)
	SlimeService.clearModels(session)
end

-- 사용하지 않는 경고 방지용(설정 로드 검증)
assert(#Slimes.list > 0, "no slimes configured")

return SlimeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">StealService</string>
            <string name="Source"><![CDATA[--!strict
-- 훔치기 · 들고 달리기 · 배달 · 뿅망치.
--
-- 복제 방지 원칙: 슬라임 데이터는 "배달 완료" 순간에만 피해자 → 도둑으로 옮깁니다.
-- 그 전에는 피해자 데이터에 그대로 있고(busy 표시만), 취소되면 표시만 풀면 됩니다.
-- 그래서 누가 나가거나 서버가 꺼져도 슬라임이 두 개가 되거나 사라지지 않습니다.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Config.Economy)
local Rarities = require(Shared.Config.Rarities)
local Slimes = require(Shared.Config.Slimes)
local World = require(Shared.Config.World)
local Calc = require(Shared.Logic.Calc)
local SlimeBuilder = require(Shared.SlimeBuilder)
local Net = require(Shared.Net)
local Loop = require(Shared.Util.Loop)

local Server = script.Parent.Parent
local Sessions = require(Server.Sessions)
local Bus = require(Server.Bus)
local Remote = require(Server.Remote)
local PlotService = require(script.Parent.PlotService)
local SlimeService = require(script.Parent.SlimeService)

local StealService = {}

type Theft = {
	id: number,
	thief: Sessions.Session,
	victim: Sessions.Session,
	uid: string,
	slimeId: string,
	star: number,
	mut: string,
	started: number,
	startPos: Vector3,
	carried: Model?,
}

type Pending = { plot: number, uid: string, t: number, hold: number }

local thefts: { [number]: Theft } = {}
local pending: { [Sessions.Session]: Pending } = {}
local nextId = 1

-- 훔치기 가능 여부 검사. 가능하면 (피해자 세션, nil)
local function check(thief: Sessions.Session, plot: any, uid: any): (Sessions.Session?, string?)
	if type(plot) ~= "number" or type(uid) ~= "string" then
		return nil, "badRequest"
	end
	if thief.carrying then
		return nil, "alreadyCarrying"
	end
	if thief.plot == 0 then
		return nil, "noPlot"
	end
	local victim = PlotService.sessionAt(plot)
	if not victim or victim == thief then
		return nil, "notFound"
	end
	local s = victim.data.slimes[uid]
	if not s or victim.busy[uid] then
		return nil, "notFound"
	end
	if s.fav then
		return nil, "favProtected"
	end
	local protected, kind = PlotService.protection(plot)
	if protected then
		return nil, if kind == "rookie" then "rookieProtected" else "baseProtected"
	end
	local root = PlotService.rootPart(thief.player)
	if not root then
		return nil, "tooFar"
	end
	local padPos = World.padCFrame(plot, s.pad).Position
	if (root.Position - padPos).Magnitude > Economy.steal.stealRange then
		return nil, "tooFar"
	end
	if not SlimeService.freePad(thief) then
		return nil, "baseFull"
	end
	return victim, nil
end

local function attachCarried(theft: Theft)
	local char = theft.thief.player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not char or not root then
		return
	end
	local scaleMult = math.min(1, 1.3 / Calc.starScale(theft.star))
	local model = SlimeBuilder.build(
		{ id = theft.slimeId, star = theft.star, mut = theft.mut },
		root.CFrame * CFrame.new(0, 2.6, 0.4),
		scaleMult
	)
	model.Name = "CarriedSlime"
	-- 바닥 그림자·발밑 빛 고리는 머리 위에서는 어색하므로 제거
	for _, child in model:GetChildren() do
		if child.Name == "Shadow" or child.Name == "Aura" then
			child:Destroy()
		end
	end
	local modelRoot = model.PrimaryPart :: BasePart
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.Massless = true
			d.CanCollide = false
			if d ~= modelRoot then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = modelRoot
				weld.Part1 = d
				weld.Parent = d
			end
		end
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = modelRoot
	weld.Parent = modelRoot
	model.Parent = char
	theft.carried = model
end

local function finish(theft: Theft)
	thefts[theft.id] = nil
	if theft.carried then
		theft.carried:Destroy()
		theft.carried = nil
	end
	local thief = theft.thief
	if thief.carrying == theft.id then
		thief.carrying = nil
		thief.carryMult = 1
		PlotService.updateSpeed(thief)
		thief.dirty = true
	end
	Net.event("Fx"):FireAllClients({ kind = "carryEnd", data = { thief = thief.userId } })
end

-- 취소: 슬라임은 원래 자리로
function StealService.cancel(theft: Theft, reason: string)
	if not thefts[theft.id] then
		return
	end
	finish(theft)
	local victim = theft.victim
	if Sessions.get(victim.player) == victim and victim.data.slimes[theft.uid] then
		SlimeService.setBusy(victim, theft.uid, false)
		if reason == "bonked" then
			Remote.notify(victim.player, "success", "slimeSaved", { slime = theft.slimeId })
		end
	end
	if Sessions.get(theft.thief.player) == theft.thief then
		Remote.notify(theft.thief.player, "error", "stealFailed_" .. reason)
	end
end

local function complete(theft: Theft)
	local thief, victim = theft.thief, theft.victim
	if Sessions.get(victim.player) ~= victim or not victim.data.slimes[theft.uid] then
		StealService.cancel(theft, "gone")
		return
	end
	if not SlimeService.freePad(thief) then
		StealService.cancel(theft, "baseFull")
		return
	end
	finish(theft)
	local data = SlimeService.remove(victim, theft.uid)
	if not data then
		return
	end
	SlimeService.add(thief, { id = data.id, star = data.star, mut = data.mut })

	thief.data.steals += 1
	victim.data.stats.stolenFrom += 1
	Bus.quest:Fire(thief, "steal", 1)
	PlotService.shield(victim.plot, Economy.steal.afterTheftShield)

	Remote.notify(thief.player, "success", "stealSuccess", { slime = data.id })
	Remote.notify(victim.player, "steal", "gotStolen", { slime = data.id, name = thief.player.DisplayName })
	local rarity = Rarities.byId[Slimes.byId[data.id].rarity]
	if rarity.order >= Rarities.byId.epic.order then
		Remote.notifyAll("announce", "stealAnnounce", {
			thief = thief.player.DisplayName,
			victim = victim.player.DisplayName,
			slime = data.id,
		})
	end
	Remote.fx(thief.player, "stealSuccess", {})
end

local function begin(thief: Sessions.Session, victim: Sessions.Session, uid: string)
	local s = victim.data.slimes[uid]
	local thiefRoot = PlotService.rootPart(thief.player)
	local theft: Theft = {
		id = nextId,
		thief = thief,
		victim = victim,
		uid = uid,
		slimeId = s.id,
		star = s.star,
		mut = s.mut,
		started = os.clock(),
		startPos = if thiefRoot then thiefRoot.Position else Vector3.zero,
		carried = nil,
	}
	nextId += 1
	thefts[theft.id] = theft
	SlimeService.setBusy(victim, uid, true)
	attachCarried(theft)

	thief.carrying = theft.id
	thief.carryMult = Calc.carrySpeedMult(s, thief.passes.thiefPro == true)
	PlotService.updateSpeed(thief)
	thief.dirty = true

	victim.revengeUntil = os.clock() + Economy.steal.revengeSeconds
	PlotService.updateSpeed(victim)

	Remote.notify(thief.player, "info", "carryHint")
	Remote.notify(victim.player, "steal", "stealAlert", { slime = s.id, name = thief.player.DisplayName })
	Remote.fx(victim.player, "revenge", { thief = thief.userId, seconds = Economy.steal.revengeSeconds })
	Net.event("Fx"):FireAllClients({
		kind = "carryStart",
		data = { thief = thief.userId, victim = victim.userId, plot = victim.plot, pad = s.pad },
	})
end

local function tick()
	local t = os.clock()
	for _, theft in thefts do
		local thief = theft.thief
		if Sessions.get(thief.player) ~= thief then
			StealService.cancel(theft, "left")
			continue
		end
		local root = PlotService.rootPart(thief.player)
		if not root or not theft.carried or not theft.carried.Parent then
			StealService.cancel(theft, "died")
		elseif t - theft.started > Economy.steal.timeout then
			StealService.cancel(theft, "timeout")
		elseif thief.plot > 0 and World.isInsidePlot(thief.plot, root.Position, 0) then
			-- 순간이동 방지: 출발점에서 온 평균 속도가 가능한 최고 속도(여유 포함)를 넘으면 무효
			local elapsed = t - theft.started
			local maxSpeed = Calc.walkSpeed(thief.data) * thief.carryMult + Economy.steal.revengeSpeed
			if (root.Position - theft.startPos).Magnitude > maxSpeed * 1.6 * elapsed + 8 then
				StealService.cancel(theft, "tooFast")
			else
				complete(theft)
			end
		end
	end
end

-- 뿅망치
local function bonk(attacker: Sessions.Session)
	local t = os.clock()
	if t - attacker.lastBonk < Calc.bonkCooldown(attacker.data) - 0.05 or t < attacker.stunUntil then
		return
	end
	attacker.lastBonk = t
	local root = PlotService.rootPart(attacker.player)
	if not root then
		return
	end
	local look = root.CFrame.LookVector
	local hits = 0
	for _, target in Sessions.all() do
		if target == attacker or hits >= 3 then
			continue
		end
		local troot = PlotService.rootPart(target.player)
		if not troot then
			continue
		end
		local offset = troot.Position - root.Position
		local flat = Vector3.new(offset.X, 0, offset.Z)
		if flat.Magnitude > Economy.bonk.range or math.abs(offset.Y) > 8 then
			continue
		end
		local dir = if flat.Magnitude > 0.01 then flat.Unit else look
		if dir:Dot(look) < -0.2 then
			continue -- 등 뒤는 안 맞음
		end
		hits += 1
		target.stunUntil = t + Economy.bonk.stun
		Remote.fx(target.player, "knockback", {
			dir = dir,
			power = Calc.bonkKnockback(attacker.data),
			stun = Economy.bonk.stun,
		})
		Bus.quest:Fire(attacker, "bonk", 1)
		attacker.data.stats.bonks += 1
		if target.carrying then
			local theft = thefts[target.carrying]
			if theft then
				StealService.cancel(theft, "bonked")
				Bus.quest:Fire(attacker, "defend", 1)
				Remote.notify(attacker.player, "success", "thiefStopped", { slime = theft.slimeId })
			end
		end
	end
	Net.event("Fx"):FireAllClients({
		kind = "bonk",
		data = { attacker = attacker.userId, pos = root.Position + look * 3, hit = hits > 0 },
	})
end

function StealService.init() end

function StealService.start()
	-- 주인이 잠가서 밀려난 도둑은 그 기지 슬라임을 놓침(순간이동으로 도망치는 것 방지)
	Bus.kickedFromPlot:Connect(function(session: Sessions.Session, plot: number)
		local id = session.carrying
		local theft = id and thefts[id]
		if theft and theft.victim.plot == plot then
			StealService.cancel(theft, "locked")
		end
	end)

	Remote.on("StealStart", 0.3, function(session, payload)
		if type(payload) ~= "table" then
			return { ok = false, msg = "badRequest" }
		end
		local victim, msg = check(session, payload.plot, payload.uid)
		if not victim then
			pending[session] = nil
			return { ok = false, msg = msg }
		end
		local s = victim.data.slimes[payload.uid]
		local hold = Calc.stealHold(s)
		pending[session] = { plot = payload.plot, uid = payload.uid, t = os.clock(), hold = hold }
		return { ok = true, hold = hold }
	end)

	Remote.on("StealFinish", 0.3, function(session, payload)
		if type(payload) ~= "table" then
			return { ok = false, msg = "badRequest" }
		end
		local p = pending[session]
		pending[session] = nil
		if not p or p.plot ~= payload.plot or p.uid ~= payload.uid then
			return { ok = false, msg = "badRequest" }
		end
		if os.clock() - p.t < p.hold - 0.4 then
			return { ok = false, msg = "tooFast" }
		end
		local victim, msg = check(session, p.plot, p.uid)
		if not victim then
			return { ok = false, msg = msg }
		end
		begin(session, victim, p.uid)
		return { ok = true }
	end)

	Net.event("Bonk").OnServerEvent:Connect(function(player: Player)
		local session = Sessions.get(player)
		if session then
			bonk(session)
		end
	end)

	Loop.every("Steal", 0.2, tick)
end

function StealService.onLeave(session: Sessions.Session)
	pending[session] = nil
	for _, theft in thefts do
		if theft.thief == session then
			StealService.cancel(theft, "left")
		elseif theft.victim == session then
			StealService.cancel(theft, "victimLeft")
		end
	end
end

-- 환생 등으로 슬라임을 통째로 지우기 전에 진행 중인 도난을 정리
function StealService.cancelAllFor(session: Sessions.Session)
	for _, theft in thefts do
		if theft.thief == session or theft.victim == session then
			StealService.cancel(theft, "reset")
		end
	end
end

function StealService.isCarrying(session: Sessions.Session): boolean
	return session.carrying ~= nil
end

return StealService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">WeatherService</string>
            <string name="Source"><![CDATA[--!strict
-- 날씨 이벤트 · 매시 정각 대폭주 · 서버 행운.
-- 상태는 ReplicatedStorage.WorldState 폴더의 속성으로 모든 클라이언트에 자동 복제됩니다.
--   Weather(string, ""=맑음) · WeatherEnds · NextWeatherAt · Frenzy(bool) · FrenzyEnds
--   ServerLuck(number) · ServerLuckEnds · Luck(최종 서버 행운 배수)
-- 시간 값은 모두 workspace:GetServerTimeNow() 기준(Frenzy 계산만 UTC os.time).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weather = require(Shared.Config.Weather)
local Progress = require(Shared.Logic.Progress)
local Roll = require(Shared.Logic.Roll)
local Signal = require(Shared.Util.Signal)
local Loop = require(Shared.Util.Loop)

local Server = script.Parent.Parent
local Remote = require(Server.Remote)

local WeatherService = {}

WeatherService.changed = Signal.new() -- () 날씨·대폭주·행운 중 하나라도 바뀜

local state: Folder
local current: Weather.WeatherEvent? = nil
local endsAt = 0
local nextAt = 0
local frenzy = false
local serverLuckEnds = 0
local random = Random.new()

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function publish()
	state:SetAttribute("Weather", if current then current.id else "")
	state:SetAttribute("WeatherEnds", endsAt)
	state:SetAttribute("NextWeatherAt", nextAt)
	state:SetAttribute("Frenzy", frenzy)
	state:SetAttribute("FrenzyEnds", if frenzy then Progress.frenzyEndsAt(os.time()) - os.time() + now() else 0)
	state:SetAttribute("ServerLuck", if serverLuckEnds > now() then 2 else 1)
	state:SetAttribute("ServerLuckEnds", serverLuckEnds)
	state:SetAttribute("Luck", WeatherService.luck())
	WeatherService.changed:Fire()
end

function WeatherService.luck(): number
	local luck = 1
	if current then
		luck *= current.luck
	end
	if frenzy then
		luck *= Weather.frenzy.luck
	end
	if serverLuckEnds > now() then
		luck *= 2
	end
	return luck
end

function WeatherService.current(): Weather.WeatherEvent?
	return current
end

function WeatherService.currentMutation(): string?
	return if current then current.mutation else nil
end

function WeatherService.isFrenzy(): boolean
	return frenzy
end

function WeatherService.startEvent(id: string, duration: number?)
	local event = Weather.byId[id]
	if not event then
		return
	end
	current = event
	endsAt = now() + (duration or event.duration)
	Remote.notifyAll("event", "weatherStart", { weather = event.id })
	publish()
end

function WeatherService.stopEvent()
	if current then
		current = nil
		endsAt = 0
		nextAt = now() + Weather.calmDuration
		publish()
	end
end

-- 서버 행운 ×2 (시간 누적)
function WeatherService.addServerLuck(seconds: number, byName: string?)
	serverLuckEnds = math.max(serverLuckEnds, now()) + seconds
	Remote.notifyAll("announce", "serverLuck", { name = byName or "", minutes = math.floor(seconds / 60) })
	publish()
end

local function pickEvent(): Weather.WeatherEvent
	return Roll.pickWeighted(Weather.events, function(e: Weather.WeatherEvent): number
		return e.weight
	end, function(): number
		return random:NextNumber()
	end)
end

local function tick()
	local t = now()
	local unix = os.time()
	local wasFrenzy = frenzy
	frenzy = Progress.frenzyActive(unix)
	if frenzy and not wasFrenzy then
		local pool = Weather.frenzy.events
		local id = pool[random:NextInteger(1, #pool)]
		Remote.notifyAll("announce", "frenzyStart")
		WeatherService.startEvent(id, Progress.frenzyEndsAt(unix) - unix)
		return
	elseif wasFrenzy and not frenzy then
		Remote.notifyAll("info", "frenzyEnd")
		publish()
	end

	if current and t >= endsAt then
		Remote.notifyAll("info", "weatherEnd", { weather = current.id })
		WeatherService.stopEvent()
	elseif not current and t >= nextAt then
		WeatherService.startEvent(pickEvent().id)
	end

	if serverLuckEnds > 0 and t >= serverLuckEnds then
		serverLuckEnds = 0
		publish()
	end
end

function WeatherService.init()
	state = Instance.new("Folder")
	state.Name = "WorldState"
	state.Parent = ReplicatedStorage
	nextAt = now() + 90 -- 서버 시작 후 첫 이벤트는 조금 빨리
	publish()
end

function WeatherService.start()
	Loop.every("Weather", 1, tick)
end

return WeatherService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">Sessions</string>
          <string name="Source"><![CDATA[--!strict
-- 접속 중인 플레이어의 세션(저장 데이터 + 저장하지 않는 실시간 상태) 등록소.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared.Types)
local Signal = require(Shared.Util.Signal)

export type Session = {
	player: Player,
	userId: number,
	data: Types.PlayerData,
	plot: number, -- 0 = 기지 없음
	passes: { [string]: boolean },
	friends: number,
	friendSet: { [number]: boolean }, -- 같은 서버에 있는 친구 userId
	group: boolean,
	joinedClock: number,
	giftsClaimed: { [string]: boolean }, -- 키: 선물 번호 문자열("1"~"7")
	offline: { amount: number, seconds: number }?,
	income: number,
	multiplier: number,
	dirty: boolean,
	moneyDirty: boolean,
	lastAction: { [string]: number },
	busy: { [string]: boolean }, -- 도둑이 들고 가는 중인 내 슬라임 uid
	carrying: number?, -- 내가 들고 가는 도난 건 id
	carryMult: number, -- 들고 달릴 때 속도 배수(1 = 안 들고 있음)
	lastBonk: number,
	stunUntil: number,
	revengeUntil: number,
	lastPlaytimeQuest: number,
}

local Sessions = {}

local map: { [Player]: Session } = {}

-- (session) 데이터 로드가 끝나 게임에 들어올 준비가 됨
Sessions.added = Signal.new()
-- (session) 나가기 직전(저장 전에 정리할 것들)
Sessions.removing = Signal.new()

function Sessions.get(player: Player): Session?
	return map[player]
end

function Sessions.byUserId(userId: number): Session?
	for _, s in map do
		if s.userId == userId then
			return s
		end
	end
	return nil
end

function Sessions.all(): { Session }
	local out = {}
	for _, s in map do
		table.insert(out, s)
	end
	return out
end

function Sessions.add(session: Session)
	map[session.player] = session
	Sessions.added:Fire(session)
end

function Sessions.remove(player: Player): Session?
	local s = map[player]
	if s then
		map[player] = nil
		Sessions.removing:Fire(s)
	end
	return s
end

function Sessions.new(player: Player, data: Types.PlayerData): Session
	return {
		player = player,
		userId = player.UserId,
		data = data,
		plot = 0,
		passes = {},
		friends = 0,
		friendSet = {},
		group = false,
		joinedClock = os.clock(),
		giftsClaimed = {},
		offline = nil,
		income = 0,
		multiplier = 1,
		dirty = true,
		moneyDirty = true,
		lastAction = {},
		busy = {},
		carrying = nil,
		carryMult = 1,
		lastBonk = 0,
		stunUntil = 0,
		revengeUntil = 0,
		lastPlaytimeQuest = os.clock(),
	}
end

-- 액션 속도 제한: 같은 이름의 요청을 interval초에 한 번만 허용
function Sessions.throttle(session: Session, name: string, interval: number): boolean
	local now = os.clock()
	local last = session.lastAction[name]
	if last and now - last < interval then
		return false
	end
	session.lastAction[name] = now
	return true
end

return Sessions
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="50">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="51">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">120</float>
      <float name="CharacterJumpPower">50</float>
      <float name="CharacterWalkSpeed">16</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="52">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="53">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="54">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">BaseSlimes</string>
              <string name="Source"><![CDATA[--!strict
-- 기지 슬라임: 이름표 + 프롬프트(내 것은 "관리", 남의 것은 길게 눌러 "훔치기").

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Calc = require(Shared.Logic.Calc)
local Slimes = require(Shared.Config.Slimes)
local Rarities = require(Shared.Config.Rarities)
local SlimeBuilder = require(Shared.SlimeBuilder)

local Client = script.Parent.Parent
local Lang = require(Client.Lang)
local State = require(Client.State)
local SlimeLabel = require(Client.SlimeLabel)
local Notify = require(Client.UI.Notify)
local Manage = require(Client.UI.Panels.Manage)
local Prompts = require(Client.UI.Prompts)
local Sound = require(script.Parent.Sound)

local BaseSlimes = {}

local player = Players.LocalPlayer
local prompts: { [Model]: ProximityPrompt } = {}

local function plotModel(index: number): Instance?
	local map = Workspace:FindFirstChild("Map")
	local plots = map and map:FindFirstChild("Plots")
	return plots and plots:FindFirstChild("Plot" .. index)
end

local function isProtected(index: number): boolean
	local plot = plotModel(index)
	if not plot then
		return false
	end
	local now = Workspace:GetServerTimeNow()
	local lockEnds = plot:GetAttribute("LockEnds")
	local shieldEnds = plot:GetAttribute("ShieldEnds")
	return (type(lockEnds) == "number" and lockEnds > now)
		or (type(shieldEnds) == "number" and shieldEnds > now)
		or plot:GetAttribute("Rookie") == true
end

local function setup(model: Instance)
	if not model:IsA("Model") or prompts[model] then
		return
	end
	local body = model:WaitForChild("Body", 5)
	if not body or not body:IsA("BasePart") then
		return
	end
	local id = model:GetAttribute("SpeciesId")
	local star = model:GetAttribute("Star")
	local mut = model:GetAttribute("Mutation")
	local uid = model:GetAttribute("Uid")
	local owner = model:GetAttribute("OwnerUserId")
	local plotIndex = model:GetAttribute("PlotIndex")
	if type(id) ~= "string" or type(star) ~= "number" or type(mut) ~= "string" or type(uid) ~= "string" then
		return
	end
	local info = { id = id, star = star, mut = mut }

	local gui = SlimeLabel.create(body, info, "base")
	gui.Parent = model

	local attach = Instance.new("Attachment")
	attach.Position = Vector3.new(0, SlimeBuilder.height(star) / 2, 0)
	attach.Parent = body
	local prompt = Instance.new("ProximityPrompt")
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = 9
	local rarity = Rarities.byId[Slimes.byId[id].rarity]
	local accent = if rarity.id == "secret" then Color3.new(1, 1, 1) else rarity.color
	prompt.ObjectText = Lang.slime(id) .. " " .. string.rep("★", star)
	prompt.Parent = attach
	prompts[model] = prompt

	if owner == player.UserId then
		prompt.ActionText = Lang.t("manage")
		prompt.HoldDuration = 0
		Prompts.style(prompt, "manage", accent)
		prompt.Triggered:Connect(function()
			Manage.open(uid)
		end)
	else
		local fav = model:GetAttribute("Fav") == true
		prompt.ActionText = if fav then Lang.t("protectedFav") else Lang.t("steal")
		prompt.Enabled = not fav
		prompt.HoldDuration = Calc.stealHold(info)
		Prompts.style(prompt, "steal", accent)
		local payload = { plot = plotIndex, uid = uid }
		prompt.PromptButtonHoldBegan:Connect(function()
			task.spawn(function()
				local result = State.action("StealStart", payload)
				if not result.ok then
					Notify.result(result)
				end
			end)
		end)
		prompt.Triggered:Connect(function()
			local result = State.action("StealFinish", payload)
			if result.ok then
				Sound.play("steal")
			else
				Notify.result(result)
			end
		end)
	end
end

local function cleanup(model: Instance)
	if model:IsA("Model") then
		prompts[model] = nil
	end
end

function BaseSlimes.init()
	CollectionService:GetInstanceAddedSignal("BaseSlime"):Connect(function(inst)
		task.spawn(setup, inst)
	end)
	CollectionService:GetInstanceRemovedSignal("BaseSlime"):Connect(cleanup)
	for _, inst in CollectionService:GetTagged("BaseSlime") do
		task.spawn(setup, inst)
	end

	-- 보호 중인 기지의 훔치기 프롬프트 끄기
	task.spawn(function()
		while true do
			task.wait(0.5)
			for model, prompt in prompts do
				if model.Parent == nil then
					prompts[model] = nil
				elseif model:GetAttribute("OwnerUserId") ~= player.UserId then
					local plotIndex = model:GetAttribute("PlotIndex")
					local fav = model:GetAttribute("Fav") == true
					local blocked = fav or (type(plotIndex) == "number" and isProtected(plotIndex))
					prompt.Enabled = not blocked
				end
			end
		end
	end)
end

return BaseSlimes
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Fx</string>
              <string name="Source"><![CDATA[--!strict
-- 연출 모음(클라이언트).
--  · 월드: 반짝 터짐, 충격파, 빛기둥, 떠오르는 글자, 망치 휘두르기, 어지러움 별
--  · 슬라임: 구매 시 행진 → 기지 포물선 비행, 합성 시 재료가 날아와 합쳐짐
--  · 화면: 동전이 돈 아이콘으로 날아감, 색종이, 섬광, 도둑 경보 테두리, 카메라 흔들림, 시야 펀치
--  · 설정의 "효과 줄이기"를 켜면 흔들림·섬광·색종이를 줄입니다.

local Debris = game:GetService("Debris")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Mutations = require(Shared.Config.Mutations)
local Slimes = require(Shared.Config.Slimes)
local World = require(Shared.Config.World)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)
local SlimeBuilder = require(Shared.SlimeBuilder)

local Client = script.Parent.Parent
local Lang = require(Client.Lang)
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Hud = require(Client.UI.Hud)
local Notify = require(Client.UI.Notify)
local Sound = require(script.Parent.Sound)

local Fx = {}

Fx.reduced = false -- 효과 줄이기

local player = Players.LocalPlayer
local fxFolder: Folder
local overlay: ScreenGui
local thiefMarks: { [number]: BillboardGui } = {}
local revengeHighlight: Highlight? = nil
local paradeExits: { [number]: { pos: Vector3, t: number } } = {}
local shakeAmount = 0
local shakeUntil = 0
local lastAlarm = 0

local function camera(): Camera
	return Workspace.CurrentCamera :: Camera
end

local function anchoredPart(size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.Neon
	p.Parent = fxFolder
	return p
end

local function near(pos: Vector3, range: number): boolean
	return (camera().CFrame.Position - pos).Magnitude <= range
end

---------------------------------------------------------------------------
-- 기본 연출
---------------------------------------------------------------------------

-- 반짝이 터짐
function Fx.poof(pos: Vector3, color: Color3, amount: number?)
	local p = anchoredPart(Vector3.new(0.2, 0.2, 0.2), CFrame.new(pos), color)
	p.Transparency = 1
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.3), NumberSequenceKeypoint.new(1, 0) })
	emitter.Lifetime = NumberRange.new(0.5, 0.9)
	emitter.Speed = NumberRange.new(10, 24)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = 3
	emitter.Rate = 0
	emitter.Parent = p
	emitter:Emit(if Fx.reduced then 10 else (amount or 30))
	Debris:AddItem(p, 1.5)
end

-- 바닥 충격파 고리
function Fx.ring(pos: Vector3, color: Color3, radius: number, seconds: number?)
	local ring = anchoredPart(Vector3.new(0.3, 1, 1), CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), color)
	ring.Shape = Enum.PartType.Cylinder
	ring.Transparency = 0.15
	local t = seconds or 0.4
	Kit.tween(ring, t, { Size = Vector3.new(0.3, radius * 2, radius * 2), Transparency = 1 })
	Debris:AddItem(ring, t + 0.05)
end

-- 위로 솟는 빛기둥
function Fx.column(pos: Vector3, color: Color3, height: number)
	local col = anchoredPart(Vector3.new(0.5, 5, 5), CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), color)
	col.Shape = Enum.PartType.Cylinder
	col.Transparency = 0.3
	Kit.tween(col, 0.5, {
		Size = Vector3.new(height, 2, 2),
		CFrame = CFrame.new(pos + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Transparency = 1,
	})
	Debris:AddItem(col, 0.55)
end

-- 떠오르는 글자(월드)
function Fx.popText(pos: Vector3, text: string, color: Color3, size: number?)
	local anchor = anchoredPart(Vector3.new(0.2, 0.2, 0.2), CFrame.new(pos), color)
	anchor.Transparency = 1
	local s = size or 1
	local gui = Kit.new("BillboardGui", {
		Size = UDim2.fromOffset(240 * s, 64 * s),
		AlwaysOnTop = true,
		LightInfluence = 0,
		Parent = anchor,
	}) :: BillboardGui
	local label = Kit.label({ Text = text, TextColor3 = color, stroke = 3, Rotation = math.random(-8, 8), Parent = gui })
	Kit.pop(label, 1.2)
	Kit.tween(anchor, 1.1, { CFrame = CFrame.new(pos + Vector3.new(0, 6, 0)) })
	task.delay(0.65, function()
		Kit.tween(label, 0.45, { TextTransparency = 1 })
	end)
	Debris:AddItem(anchor, 1.2)
end

-- 사방으로 튀는 작은 별
function Fx.stars(pos: Vector3, color: Color3, count: number)
	for _ = 1, if Fx.reduced then 3 else count do
		local star = anchoredPart(Vector3.new(0.5, 0.5, 0.5), CFrame.new(pos), color)
		star.Shape = Enum.PartType.Ball
		local dir = Vector3.new(math.random() - 0.5, 0.6 + math.random() * 0.6, math.random() - 0.5).Unit
		Kit.tween(star, 0.5, { CFrame = CFrame.new(pos + dir * (4 + math.random() * 3)), Size = Vector3.new(0.1, 0.1, 0.1) }, Enum.EasingStyle.Quad)
		Debris:AddItem(star, 0.55)
	end
end

---------------------------------------------------------------------------
-- 화면 연출
---------------------------------------------------------------------------

function Fx.shake(amount: number, seconds: number)
	if Fx.reduced then
		amount *= 0.25
	end
	shakeAmount = math.max(shakeAmount, amount)
	shakeUntil = math.max(shakeUntil, os.clock() + seconds)
end

function Fx.flash(color: Color3, alpha: number, seconds: number)
	if Fx.reduced then
		alpha = math.min(1, alpha + 0.4)
	end
	local f = Kit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = alpha,
		BorderSizePixel = 0,
		ZIndex = 50,
		Parent = overlay,
	}) :: Frame
	Kit.tween(f, seconds, { BackgroundTransparency = 1 })
	Debris:AddItem(f, seconds + 0.05)
end

-- 시야를 잠깐 넓혔다 되돌리기(환생 등)
function Fx.fovPunch(amount: number)
	if Fx.reduced then
		return
	end
	local cam = camera()
	local base = cam.FieldOfView
	Kit.tween(cam, 0.15, { FieldOfView = base + amount })
	task.delay(0.15, function()
		Kit.tween(cam, 0.5, { FieldOfView = base }, Enum.EasingStyle.Back)
	end)
end

-- 도둑 경보: 붉은 테두리가 깜빡임 + 사이렌
function Fx.alarm()
	if os.clock() - lastAlarm < 2 then
		return
	end
	lastAlarm = os.clock()
	Sound.play("alarm")
	local frame = Kit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 45,
		Parent = overlay,
	}) :: Frame
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 24
	stroke.Color = Kit.colors.red
	stroke.Transparency = 1
	stroke.Parent = frame
	task.spawn(function()
		for _ = 1, 4 do
			Kit.tween(stroke, 0.18, { Transparency = 0.15 })
			task.wait(0.22)
			Kit.tween(stroke, 0.25, { Transparency = 1 })
			task.wait(0.28)
		end
		frame:Destroy()
	end)
end

-- 화면 색종이
function Fx.confetti(count: number?)
	local colors = { Kit.colors.pink, Kit.colors.yellow, Kit.colors.green, Kit.colors.blue, Kit.colors.purple, Kit.colors.orange }
	local n = count or 60
	if Fx.reduced then
		n = math.floor(n / 4)
	end
	for _ = 1, n do
		local piece = Kit.new("Frame", {
			Size = UDim2.fromOffset(math.random(8, 14), math.random(12, 20)),
			Position = UDim2.new(math.random(), 0, 0, -30),
			BackgroundColor3 = colors[math.random(1, #colors)],
			Rotation = math.random(0, 360),
			BorderSizePixel = 0,
			ZIndex = 40,
			Parent = overlay,
		}) :: Frame
		local fall = 1.4 + math.random() * 1.2
		Kit.tween(piece, fall, {
			Position = UDim2.new(piece.Position.X.Scale + (math.random() - 0.5) * 0.25, 0, 1.1, 0),
			Rotation = piece.Rotation + math.random(-420, 420),
		}, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
		Debris:AddItem(piece, fall + 0.1)
	end
end

-- 월드 위치 → 돈 아이콘까지 동전이 날아감
function Fx.coinsToHud(worldPos: Vector3, count: number)
	local cam = camera()
	local screen, onScreen = cam:WorldToViewportPoint(worldPos)
	local start = if onScreen then Vector2.new(screen.X, screen.Y) else cam.ViewportSize / 2
	local anchor = Hud.cashAnchor()
	local inset = GuiService:GetGuiInset()
	local target = anchor.AbsolutePosition + inset + anchor.AbsoluteSize / 2
	local n = math.clamp(count, 1, if Fx.reduced then 3 else 10)
	for i = 1, n do
		local coinFrame = Kit.new("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(start.X, start.Y),
			Size = UDim2.fromOffset(30, 30),
			BackgroundColor3 = Kit.colors.yellow,
			Text = "$",
			TextScaled = true,
			Font = Kit.font,
			TextColor3 = Color3.new(1, 1, 1),
			ZIndex = 48,
			Parent = overlay,
		}) :: TextLabel
		Kit.corner(coinFrame, 15)
		Kit.stroke(coinFrame, 2, Color3.fromRGB(150, 95, 10)).ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		local burst = start + Vector2.new(math.random(-70, 70), math.random(-80, 10))
		task.delay((i - 1) * 0.05, function()
			Kit.tween(coinFrame, 0.22, { Position = UDim2.fromOffset(burst.X, burst.Y) }, Enum.EasingStyle.Quad)
			task.wait(0.22)
			Kit.tween(coinFrame, 0.45, { Position = UDim2.fromOffset(target.X, target.Y), Size = UDim2.fromOffset(18, 18) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.wait(0.45)
			coinFrame:Destroy()
			Sound.combo("coin", 0.6)
			Hud.coinArrived()
		end)
	end
end

---------------------------------------------------------------------------
-- 전투·훔치기
---------------------------------------------------------------------------

local function characterOf(userId: number): Model?
	local p = Players:GetPlayerByUserId(userId)
	return p and p.Character
end

local function rootOf(userId: number): BasePart?
	local char = characterOf(userId)
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

-- 만화풍 망치를 휘두름(부품으로 즉석 조립)
function Fx.hammer(root: BasePart)
	local pivot = root.CFrame * CFrame.new(1.4, 1.2, -0.6)
	local handleColor = Color3.fromRGB(150, 100, 60)
	local handle = anchoredPart(Vector3.new(0.45, 4.2, 0.45), pivot, handleColor, Enum.Material.Wood)
	local head = anchoredPart(Vector3.new(2.6, 1.5, 1.5), pivot, Color3.fromRGB(235, 60, 80), Enum.Material.SmoothPlastic)
	local band = anchoredPart(Vector3.new(0.5, 1.6, 1.6), pivot, Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic)
	local started = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = math.min(1, (os.clock() - started) / 0.14)
		local eased = t * t
		local angle = math.rad(110 - 130 * eased)
		local base = (root.Parent and root.CFrame or pivot) * CFrame.new(1.4, 1.2, -0.6) * CFrame.Angles(angle, 0, 0)
		handle.CFrame = base * CFrame.new(0, 2.1, 0)
		head.CFrame = base * CFrame.new(0, 4.3, 0)
		band.CFrame = head.CFrame
		if t >= 1 then
			conn:Disconnect()
			for _, p in { handle, head, band } do
				Kit.tween(p, 0.2, { Transparency = 1 })
				Debris:AddItem(p, 0.22)
			end
		end
	end)
end

-- 망치에 맞은 지점: 노란 충격파 + 별 + BONK! 글자
function Fx.impact(pos: Vector3, hit: boolean)
	Fx.ring(pos - Vector3.new(0, 2.5, 0), if hit then Kit.colors.yellow else Color3.new(1, 1, 1), if hit then 9 else 6)
	if hit then
		Fx.stars(pos, Kit.colors.yellow, 8)
		Fx.popText(pos + Vector3.new(0, 2, 0), "BONK!", Kit.colors.yellow, 1.3)
		if near(pos, 35) then
			Fx.shake(0.35, 0.25)
		end
	end
end

-- 맞은 내 머리 위로 도는 어지러움 별
local function dizzy(seconds: number)
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end
	local stars: { Part } = {}
	for i = 1, 3 do
		local s = anchoredPart(Vector3.new(0.6, 0.6, 0.6), head.CFrame, Kit.colors.yellow)
		s.Shape = Enum.PartType.Ball
		stars[i] = s
	end
	local started = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - started
		if t > seconds or not head.Parent then
			conn:Disconnect()
			for _, s in stars do
				s:Destroy()
			end
			return
		end
		for i, s in stars do
			local a = t * 6 + i * (math.pi * 2 / 3)
			s.CFrame = CFrame.new(head.Position + Vector3.new(math.cos(a) * 1.4, 1.3 + math.sin(t * 8 + i) * 0.2, math.sin(a) * 1.4))
		end
	end)
end

local function knockback(dir: Vector3, power: number, stun: number)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or not root:IsA("BasePart") then
		return
	end
	hum:ChangeState(Enum.HumanoidStateType.FallingDown)
	root.AssemblyLinearVelocity = dir * power + Vector3.new(0, 38, 0)
	Sound.play("bonkHit")
	Fx.shake(0.8, 0.35)
	Fx.flash(Color3.fromRGB(255, 240, 180), 0.55, 0.25)
	dizzy(stun + 0.4)
	task.delay(stun, function()
		if hum.Parent and hum.Health > 0 then
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end

local function markThief(userId: number, on: boolean)
	local existing = thiefMarks[userId]
	if existing then
		existing:Destroy()
		thiefMarks[userId] = nil
	end
	if not on then
		return
	end
	local char = characterOf(userId)
	local head = char and char:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end
	local gui = Kit.new("BillboardGui", {
		Name = "ThiefMark",
		Adornee = head,
		Size = UDim2.fromOffset(150, 42),
		StudsOffsetWorldSpace = Vector3.new(0, 7.5, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		Parent = fxFolder,
	}) :: BillboardGui
	local label = Kit.label({
		Text = "🥷 " .. Lang.t("thief"),
		TextColor3 = Color3.new(1, 1, 1),
		BackgroundColor3 = Kit.colors.red,
		BackgroundTransparency = 0,
		stroke = 2.5,
		Parent = gui,
	})
	Kit.corner(label, 14)
	Kit.pop(label, 1.2)
	task.spawn(function()
		while gui.Parent do
			Kit.bump(label, 0.12)
			task.wait(0.6)
		end
	end)
	thiefMarks[userId] = gui
end

---------------------------------------------------------------------------
-- 슬라임 비행
---------------------------------------------------------------------------

local function plotFolder(plot: number): Instance?
	local map = Workspace:FindFirstChild("Map")
	local plots = map and map:FindFirstChild("Plots")
	return plots and plots:FindFirstChild("Plot" .. tostring(plot))
end

function Fx.baseModel(plot: number, uid: string): Model?
	local p = plotFolder(plot)
	local slimes = p and p:FindFirstChild("Slimes")
	local m = slimes and slimes:FindFirstChild("Slime_" .. uid)
	return if m and m:IsA("Model") then m else nil
end

local function setHidden(model: Model, hidden: boolean)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = if hidden then 1 else 0
		elseif d:IsA("BillboardGui") then
			d.Enabled = not hidden
		end
	end
end

-- Parade가 슬라임이 사라진 위치를 알려 줌(구매 비행 출발점)
function Fx.noteParadeExit(key: number, pos: Vector3)
	paradeExits[key] = { pos = pos, t = os.clock() }
end

-- 포물선 비행: from → to, 도착하면 onLand
local function arc(model: Model, from: Vector3, to: Vector3, seconds: number, onLand: () -> ())
	local started = os.clock()
	local peak = math.max(10, (to - from).Magnitude * 0.25)
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = math.min(1, (os.clock() - started) / seconds)
		local pos = from:Lerp(to, t) + Vector3.new(0, math.sin(t * math.pi) * peak, 0)
		local flat = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
		local facing = if flat.Magnitude > 0.1 then CFrame.lookAt(pos, pos + flat) else CFrame.new(pos)
		model:PivotTo(facing * CFrame.Angles(0, 0, math.sin(t * math.pi * 2) * 0.4))
		if t >= 1 then
			conn:Disconnect()
			onLand()
		end
	end)
end

local function ghost(info: { id: string, star: number, mut: string }, at: Vector3): Model
	local model = SlimeBuilder.build(info, CFrame.new(at))
	for _, name in { "Shadow", "Aura" } do
		for _, child in model:GetChildren() do
			if child.Name == name then
				child:Destroy()
			end
		end
	end
	local body = model:FindFirstChild("Body")
	if body and body:IsA("BasePart") then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 0.8, 0)
		a0.Parent = body
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -0.8, 0)
		a1.Parent = body
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.35
		trail.LightEmission = 0.8
		trail.Color = ColorSequence.new(body.Color)
		trail.Transparency = NumberSequence.new(0.3, 1)
		trail.Parent = body
	end
	model.Parent = fxFolder
	return model
end

local function onBought(d: { [string]: any })
	local plot, uid = d.plot, d.uid
	if type(plot) ~= "number" or type(uid) ~= "string" or type(d.id) ~= "string" or not Slimes.byId[d.id] then
		return
	end
	local exit = if type(d.key) == "number" then paradeExits[d.key] else nil
	local destination = World.padCFrame(plot, 1).Position
	-- 실제 모델이 복제되어 올 때까지 잠깐 기다림
	local real: Model? = nil
	for _ = 1, 20 do
		real = Fx.baseModel(plot, uid)
		if real then
			break
		end
		task.wait(0.05)
	end
	if real and real.PrimaryPart then
		destination = real.PrimaryPart.Position
	end
	local from = if exit then exit.pos else destination + Vector3.new(0, 30, 0)
	if not near(destination, 260) and not near(from, 260) then
		return
	end
	if real then
		setHidden(real, true)
	end
	local mut = if type(d.mut) == "string" then d.mut else "none"
	local g = ghost({ id = d.id, star = 1, mut = mut }, from)
	Sound.playAt("flight", from)
	arc(g, from, destination, 0.8, function()
		g:Destroy()
		if real and real.Parent then
			setHidden(real, false)
		end
		Fx.poof(destination + Vector3.new(0, 1.5, 0), Color3.new(1, 1, 1), 26)
		Fx.ring(destination + Vector3.new(0, 0.2, 0), Kit.colors.yellow, 5)
		Sound.playAt("land", destination)
	end)
end

local function onMerge(d: { [string]: any })
	local plot, uid = d.plot, d.uid
	if type(plot) ~= "number" or type(uid) ~= "string" then
		return
	end
	local mine = d.owner == player.UserId
	local target = World.padCFrame(plot, 1).Position
	local real = Fx.baseModel(plot, uid)
	for _ = 1, 20 do
		if real then
			break
		end
		task.wait(0.05)
		real = Fx.baseModel(plot, uid)
	end
	if real and real.PrimaryPart then
		target = real.PrimaryPart.Position
	end
	if not mine and not near(target, 200) then
		return
	end
	local species = if type(d.id) == "string" then Slimes.byId[d.id] else nil
	local color = if species then species.color else Color3.new(1, 1, 1)
	if real then
		setHidden(real, true)
	end
	local from = if type(d.from) == "table" then d.from else {}
	for _, pad in from do
		if type(pad) == "number" then
			local start = World.padCFrame(plot, pad).Position + Vector3.new(0, 1.6, 0)
			local blob = anchoredPart(Vector3.new(2.4, 2.4, 2.4), CFrame.new(start), color, Enum.Material.Neon)
			blob.Shape = Enum.PartType.Ball
			Kit.tween(blob, 0.45, { CFrame = CFrame.new(target + Vector3.new(0, 2, 0)), Size = Vector3.new(1, 1, 1) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			Debris:AddItem(blob, 0.46)
		end
	end
	task.wait(0.45)
	if real and real.Parent then
		setHidden(real, false)
	end
	local star = if type(d.star) == "number" then d.star else 2
	Fx.poof(target + Vector3.new(0, 2, 0), Kit.colors.yellow, 50)
	Fx.ring(target + Vector3.new(0, 0.2, 0), Kit.colors.yellow, 8)
	Fx.column(target, Kit.colors.yellow, 22)
	Fx.popText(target + Vector3.new(0, 5, 0), string.rep("★", star) .. "!", Kit.colors.yellow, 1.4)
	if mine then
		Sound.play("merge")
		Fx.confetti(50)
		Fx.shake(0.25, 0.2)
	else
		Sound.playAt("merge", target)
	end
end

---------------------------------------------------------------------------
-- 서버 연출 이벤트
---------------------------------------------------------------------------

local function ownPlotPart(name: string): BasePart?
	local view = State.view
	if not view or view.plot == 0 then
		return nil
	end
	local p = plotFolder(view.plot)
	local part = p and p:FindFirstChild(name)
	return if part and part:IsA("BasePart") then part else nil
end

local function onFx(msg: { kind: string, data: { [string]: any }? })
	local d: { [string]: any } = msg.data or {}
	local kind = msg.kind
	if kind == "collect" then
		local plate = ownPlotPart("CollectPlate")
		local root = rootOf(player.UserId)
		local from = if plate then plate.Position + Vector3.new(0, 1, 0) elseif root then root.Position else Vector3.zero
		local amount = if type(d.amount) == "number" then d.amount else 0
		Fx.coinsToHud(from, 4 + math.floor(math.log10(amount + 1)))
		Fx.poof(from, Kit.colors.cash, 24)
		Fx.ring(from - Vector3.new(0, 0.8, 0), Kit.colors.cash, 6)
		Sound.play("collect")
	elseif kind == "sell" then
		local root = rootOf(player.UserId)
		if root then
			Fx.coinsToHud(root.Position, 5)
		end
		Notify.toast(Lang.t("soldFor", { cash = Format.cash(d.amount or 0) }), "success")
	elseif kind == "bonk" then
		if d.attacker ~= player.UserId then
			local root = if type(d.attacker) == "number" then rootOf(d.attacker) else nil
			if root then
				Fx.hammer(root)
			end
			if typeof(d.pos) == "Vector3" then
				task.delay(0.14, Fx.impact, d.pos, d.hit == true)
				Sound.playAt("bonk", d.pos, 0.9 + math.random() * 0.2)
			end
		elseif d.hit and typeof(d.pos) == "Vector3" then
			-- 내가 맞혔을 때는 서버 확인 후 별·글자만 추가
			Fx.stars(d.pos, Kit.colors.yellow, 8)
			Fx.popText(d.pos + Vector3.new(0, 2, 0), "BONK!", Kit.colors.yellow, 1.3)
			Fx.shake(0.3, 0.2)
		end
	elseif kind == "knockback" then
		if typeof(d.dir) == "Vector3" then
			knockback(d.dir, d.power or 50, d.stun or 1)
		end
	elseif kind == "carryStart" then
		markThief(d.thief, true)
		if type(d.plot) == "number" and type(d.pad) == "number" then
			local padPos = World.padCFrame(d.plot, d.pad).Position
			Fx.ring(padPos + Vector3.new(0, 0.3, 0), Kit.colors.red, 6)
			Fx.poof(padPos + Vector3.new(0, 2, 0), Kit.colors.red, 20)
			Sound.playAt("steal", padPos)
		end
		if d.victim == player.UserId then
			Fx.alarm()
		end
	elseif kind == "carryEnd" then
		markThief(d.thief, false)
		if revengeHighlight and revengeHighlight.Adornee == characterOf(d.thief) then
			revengeHighlight:Destroy()
			revengeHighlight = nil
		end
	elseif kind == "revenge" then
		local char = characterOf(d.thief)
		if char then
			if revengeHighlight then
				revengeHighlight:Destroy()
			end
			local h = Instance.new("Highlight")
			h.FillColor = Kit.colors.red
			h.OutlineColor = Color3.new(1, 1, 1)
			h.FillTransparency = 0.4
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.Adornee = char
			h.Parent = fxFolder
			revengeHighlight = h
			Debris:AddItem(h, d.seconds or 15)
			Notify.banner(Lang.t("revengeTitle"), Lang.t("revengeSub"), Kit.colors.red, 3, "😡")
			Fx.alarm()
		end
	elseif kind == "stealSuccess" then
		Fx.confetti(45)
		Sound.play("stealSuccess")
		Fx.flash(Kit.colors.green, 0.7, 0.3)
	elseif kind == "merge" then
		onMerge(d)
	elseif kind == "rebirth" then
		Fx.flash(Color3.new(1, 1, 1), 0.2, 0.8)
		Fx.fovPunch(14)
		Fx.shake(0.5, 0.4)
		Fx.confetti(140)
		Sound.play("rebirth")
		local root = rootOf(player.UserId)
		if root then
			Fx.column(root.Position - Vector3.new(0, 3, 0), Kit.colors.pink, 40)
			Fx.ring(root.Position - Vector3.new(0, 2.8, 0), Kit.colors.pink, 16, 0.7)
		end
	elseif kind == "reward" then
		local parts = {}
		if d.cash then
			table.insert(parts, Format.cash(d.cash))
			local root = rootOf(player.UserId)
			if root then
				Fx.coinsToHud(root.Position, 8)
			end
		end
		if d.boost then
			table.insert(parts, "💰x2 " .. Format.time(d.seconds or 0))
		end
		if d.slime then
			table.insert(parts, "🎁 " .. Lang.slime(d.slime))
		end
		if d.serverLuck then
			table.insert(parts, "🍀 x2")
		end
		if #parts > 0 then
			Notify.toast(Lang.t("youGot", { what = table.concat(parts, " + ") }), "success")
		end
		Sound.play("reward")
		Fx.confetti(30)
	elseif kind == "lock" then
		Sound.play("lock")
		local plate = ownPlotPart("LockPlate")
		if plate then
			Fx.ring(plate.Position, Kit.colors.red, 10)
			Fx.column(plate.Position, Kit.colors.red, 16)
		end
		Notify.toast(Lang.t("lockedFor", { s = d.seconds or 60 }), "success")
	elseif kind == "zap" then
		Sound.play("zap")
		Fx.flash(Kit.colors.blue, 0.6, 0.25)
		Fx.shake(0.3, 0.2)
	elseif kind == "bought" then
		onBought(d)
	elseif kind == "mutate" then
		task.wait(0.1)
		local model = if type(d.plot) == "number" and type(d.uid) == "string" then Fx.baseModel(d.plot, d.uid) else nil
		local body = model and model:FindFirstChild("Body")
		if body and body:IsA("BasePart") then
			local color = Color3.new(1, 1, 1)
			if type(d.mut) == "string" and Mutations.byId[d.mut] then
				color = Mutations.byId[d.mut].label
			end
			Fx.poof(body.Position, color, 40)
			Fx.column(body.Position - Vector3.new(0, 1.5, 0), color, 18)
			Sound.playAt("mutate", body.Position)
		end
	end
end

function Fx.init()
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "ClientFx"
	fxFolder.Parent = Workspace
	overlay = Kit.new("ScreenGui", {
		Name = "FxOverlay",
		ResetOnSpawn = false,
		DisplayOrder = 60,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	}) :: ScreenGui
	Net.event("Fx").OnClientEvent:Connect(onFx)
	Notify.onAlarm = Fx.alarm

	-- 카메라 흔들림(카메라 갱신 직후에 살짝 비틀기)
	RunService:BindToRenderStep("SlimeHeistShake", Enum.RenderPriority.Camera.Value + 1, function()
		local now = os.clock()
		if now < shakeUntil and shakeAmount > 0 then
			local left = (shakeUntil - now)
			local a = shakeAmount * math.min(1, left * 4)
			local cam = camera()
			cam.CFrame = cam.CFrame
				* CFrame.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, 0)
				* CFrame.Angles(0, 0, (math.random() - 0.5) * a * 0.05)
		else
			shakeAmount = 0
		end
	end)

	-- 오래된 행진 퇴장 기록 정리
	task.spawn(function()
		while true do
			task.wait(5)
			local now = os.clock()
			for key, e in paradeExits do
				if now - e.t > 5 then
					paradeExits[key] = nil
				end
			end
		end
	end)
end

-- 내가 휘두를 때 즉시 보이는 연출(서버 응답 기다리지 않음)
function Fx.localBonk()
	local root = rootOf(player.UserId)
	if root then
		Fx.hammer(root)
		local pos = root.Position + root.CFrame.LookVector * 3
		task.delay(0.14, Fx.impact, pos, false)
	end
	Sound.play("bonk")
end

return Fx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">Input</string>
              <string name="Source"><![CDATA[--!strict
-- 입력: 뿅망치(F / 게임패드 X / HUD 버튼), 잠금(HUD 버튼), 메뉴 배지 갱신, VIP 채팅 태그.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Calc = require(Shared.Logic.Calc)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local State = require(Client.State)
local Hud = require(Client.UI.Hud)
local Notify = require(Client.UI.Notify)
local Shop = require(Client.UI.Panels.Shop)
local Quests = require(Client.UI.Panels.Quests)
local Gifts = require(Client.UI.Panels.Gifts)
local Rebirth = require(Client.UI.Panels.Rebirth)
local Fx = require(script.Parent.Fx)
local Tutorial = require(script.Parent.Tutorial)

local Input = {}

local lastBonk = 0

local function bonk()
	local data = State.data()
	local cooldown = if data then Calc.bonkCooldown(data) else 1
	local t = os.clock()
	if t - lastBonk < cooldown then
		return
	end
	lastBonk = t
	Net.event("Bonk"):FireServer()
	Fx.localBonk()
	Hud.bonkCooldown(cooldown)
end

local function lock()
	local result = State.action("Lock")
	Notify.result(result)
end

local function refreshBadges()
	Hud.setBadge("Shop", Shop.affordable())
	Hud.setBadge("Quests", Quests.claimable())
	Hud.setBadge("Gifts", Gifts.claimable())
	Hud.setBadge("Rebirth", if Rebirth.ready() then 1 else 0)
end

function Input.init()
	Hud.onBonk = bonk
	Hud.onLock = lock
	Hud.onHome = function()
		Tutorial.guideHome(8)
	end
	ContextActionService:BindAction("SlimeHeistBonk", function(_name, inputState, _obj)
		if inputState == Enum.UserInputState.Begin then
			bonk()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.F, Enum.KeyCode.ButtonX)

	State.changed:Connect(refreshBadges)
	task.spawn(function()
		while true do
			task.wait(1)
			refreshBadges()
		end
	end)

	-- VIP 채팅 태그
	TextChatService.OnIncomingMessage = function(message: TextChatMessage): TextChatMessageProperties?
		local props = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		if source then
			local sender = Players:GetPlayerByUserId(source.UserId)
			if sender and sender:GetAttribute("VIP") == true then
				props.PrefixText = "<font color='#FFD23F'>[VIP]</font> " .. message.PrefixText
			end
		end
		return props
	end
end

return Input
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Music</string>
              <string name="Source"><![CDATA[--!strict
-- 배경음악.
--  · Config/Audio의 custom.music / custom.musicFrenzy 에 오디오 ID가 있으면 그 곡을 반복 재생
--  · 없으면 오르골풍 음악을 코드로 연주(I–V–vi–IV 화음 + 아르페지오 + 멜로디)
--  · 매시 정각 대폭주 중에는 더 빠르고 꽉 찬 편곡

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Audio = require(Shared.Config.Audio)

local Sound = require(script.Parent.Sound)

local Music = {}

local worldState: Instance
local tracks: { calm: Sound?, frenzy: Sound? } = { calm = nil, frenzy = nil }

local function isFrenzy(): boolean
	return worldState:GetAttribute("Frenzy") == true
end

local function makeTrack(id: string, name: string): Sound?
	if id == "" then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = id
	s.Looped = true
	s.Volume = 0.6
	s.SoundGroup = Sound.group("Music")
	s.Parent = Sound.group("Music")
	return s
end

-- 업로드한 음악 파일 재생(있을 때)
local function runTracks()
	while true do
		local want = if isFrenzy() and tracks.frenzy then tracks.frenzy else tracks.calm
		for _, t in { tracks.calm, tracks.frenzy } do
			if t then
				local shouldPlay = t == want and Sound.musicEnabled
				if shouldPlay and not t.IsPlaying then
					t:Play()
				elseif not shouldPlay and t.IsPlaying then
					t:Pause()
				end
			end
		end
		task.wait(0.5)
	end
end

-- 오르골 연주
local function runMusicBox()
	local M = Audio.music
	local st = Audio.semitone
	local bar = 1
	local loop = 0
	while true do
		local frenzy = isFrenzy()
		local step = 60 / (if frenzy then M.frenzyBpm else M.calmBpm) / 2
		local chordNotes = M.chords[bar]
		local melody = M.melody[bar]
		for s = 1, 8 do
			if Sound.musicEnabled then
				local base = M.rootSpeed
				if s == 1 or s == 5 or (frenzy and s % 2 == 1) then
					Sound.note(base * st(chordNotes[1] - 12), M.volume.bass)
				end
				if frenzy or s % 2 == 1 then
					local tone = chordNotes[(s - 1) % 3 + 1] + 12
					Sound.note(base * st(tone), M.volume.arp)
				end
				local m = melody[s]
				-- 홀수 바퀴는 멜로디를 성기게 해서 숨 쉴 틈을 줌
				if type(m) == "number" and (loop % 2 == 0 or frenzy or s % 4 == 1) then
					Sound.note(base * st(m), M.volume.melody)
				end
			end
			task.wait(step)
		end
		bar = bar % #M.chords + 1
		if bar == 1 then
			loop += 1
		end
	end
end

function Music.init()
	worldState = ReplicatedStorage:WaitForChild("WorldState")
	tracks.calm = makeTrack(Audio.custom.music, "MusicCalm")
	tracks.frenzy = makeTrack(Audio.custom.musicFrenzy, "MusicFrenzy")
	if tracks.calm or tracks.frenzy then
		task.spawn(runTracks)
	else
		task.spawn(runMusicBox)
	end
end

return Music
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">Parade</string>
              <string name="Source"><![CDATA[--!strict
-- 슬라임 행진을 클라이언트에서 그립니다.
--  · 60fps 통통 점프: 착지 때 납작, 공중에서 길쭉(스쿼시·스트레치), 바닥 그림자가 높이에 따라 작아짐
--  · 가까운 슬라임은 착지할 때 "찰싹" 위치음
--  · 전설 이상·고배율 변이는 하늘로 솟는 빛기둥 + 멀리서도 보이는 ! 표시
--  · 구매 프롬프트(가격 색이 돈에 따라 바뀜)
-- 위치는 서버와 같은 공식(World.paradePosition)과 서버 시각으로 계산합니다.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Slimes = require(Shared.Config.Slimes)
local Rarities = require(Shared.Config.Rarities)
local Mutations = require(Shared.Config.Mutations)
local Economy = require(Shared.Config.Economy)
local World = require(Shared.Config.World)
local SlimeBuilder = require(Shared.SlimeBuilder)
local Net = require(Shared.Net)
local Types = require(Shared.Types)

local Client = script.Parent.Parent
local Lang = require(Client.Lang)
local State = require(Client.State)
local SlimeLabel = require(Client.SlimeLabel)
local Kit = require(Client.UI.Kit)
local Notify = require(Client.UI.Notify)
local Prompts = require(Client.UI.Prompts)
local Sound = require(script.Parent.Sound)
local Fx = require(script.Parent.Fx)

local Parade = {}

type Entry = {
	data: Types.ParadeSlime,
	model: Model,
	body: BasePart,
	mesh: SpecialMesh?,
	ground: Model,
	price: TextLabel?,
	phase: number,
	lastHop: number,
	rainbow: boolean,
}

local entries: { [number]: Entry } = {}
local folder: Folder
local lastSquishSound = 0
local HOP_RATE = 1.8
local HOP_HEIGHT = 1.4

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function remove(key: number, bought: boolean)
	local e = entries[key]
	if not e then
		return
	end
	entries[key] = nil
	Fx.noteParadeExit(key, e.body.Position)
	if bought then
		Fx.poof(e.body.Position, Color3.fromRGB(255, 255, 255))
		Sound.playAt("poof", e.body.Position)
	end
	e.model:Destroy()
	e.ground:Destroy()
end

-- 빛기둥 + 멀리서 보이는 느낌표
local function beacon(body: BasePart, color: Color3)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 1, 0)
	a0.Parent = body
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, 70, 0)
	a1.Parent = body
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Width0 = 3
	beam.Width1 = 0.6
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Color = ColorSequence.new(color)
	beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) })
	beam.Parent = body
	local mark = Kit.new("BillboardGui", {
		Name = "RareMark",
		Size = UDim2.fromOffset(46, 46),
		StudsOffsetWorldSpace = Vector3.new(0, 16, 0),
		AlwaysOnTop = true,
		MaxDistance = 450,
		LightInfluence = 0,
		Parent = body,
	}) :: BillboardGui
	local label = Kit.label({
		Text = "!",
		BackgroundColor3 = color,
		BackgroundTransparency = 0,
		stroke = 3,
		Parent = mark,
	})
	Kit.corner(label, 23)
	task.spawn(function()
		while label.Parent do
			Kit.bump(label, 0.2)
			task.wait(0.7)
		end
	end)
end

local function add(data: Types.ParadeSlime)
	if entries[data.key] or not Slimes.byId[data.id] then
		return
	end
	local species = Slimes.byId[data.id]
	local rarity = Rarities.byId[species.rarity]
	local mutation = Mutations.byId[data.mut]
	local model = SlimeBuilder.build({ id = data.id, star = 1, mut = data.mut })
	model:SetAttribute("ParadeKey", data.key)
	local body = model:FindFirstChild("Body") :: BasePart
	-- 그림자·발밑 고리는 점프해도 바닥에 남도록 따로 둠
	local ground = Instance.new("Model")
	ground.Name = "Ground"
	-- 부품들이 원점 기준으로 만들어졌으므로 기준점도 원점
	ground.WorldPivot = CFrame.new()
	for _, child in model:GetChildren() do
		if child.Name == "Shadow" or child.Name == "Aura" then
			child.Parent = ground
		end
	end
	local gui = SlimeLabel.create(body, { id = data.id, star = 1, mut = data.mut }, "parade", data.price)
	gui.Parent = model
	local priceLabel = gui:FindFirstChild("Price", true)

	local attach = Instance.new("Attachment")
	attach.Position = Vector3.new(0, 1.6, 0)
	attach.Parent = body
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = Lang.t("buy")
	prompt.ObjectText = Lang.slime(data.id) .. " · " .. Lang.rarity(rarity.id)
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = Economy.parade.promptRange
	prompt.RequiresLineOfSight = false
	Prompts.style(prompt, "buy", if rarity.id == "secret" then Color3.new(1, 1, 1) else rarity.color, data.price)
	prompt.Parent = attach
	local key = data.key
	prompt.Triggered:Connect(function()
		local result = State.action("Buy", key)
		if result.ok then
			Sound.play("buy")
		else
			Notify.result(result)
		end
	end)

	if rarity.announce or (mutation and mutation.mult >= 5) then
		beacon(body, if rarity.id == "secret" then Color3.new(1, 1, 1) else rarity.color)
	end

	model.Parent = folder
	ground.Parent = folder
	entries[data.key] = {
		data = data,
		model = model,
		body = body,
		mesh = body:FindFirstChildOfClass("SpecialMesh"),
		ground = ground,
		price = if priceLabel and priceLabel:IsA("TextLabel") then priceLabel else nil,
		phase = math.random(),
		lastHop = 0,
		rainbow = body:GetAttribute("Rainbow") == true,
	}
end

local function refreshAffordable()
	for _, e in entries do
		if e.price then
			e.price.TextColor3 = if State.cash >= e.data.price
				then Color3.fromRGB(255, 220, 70)
				else Color3.fromRGB(255, 110, 110)
		end
	end
end

-- 진행 방향(+Z)을 바라보는 회전
local FACING = CFrame.Angles(0, math.pi, 0)

local function step()
	local t = now()
	local clock = os.clock()
	local camPos = (Workspace.CurrentCamera :: Camera).CFrame.Position
	for key, e in entries do
		local elapsed = t - e.data.spawnAt
		local pos = World.paradePosition(elapsed)
		if not pos then
			remove(key, false)
			continue
		end
		local hops = elapsed * HOP_RATE + e.phase
		local hopT = hops % 1
		local h = math.sin(hopT * math.pi)
		e.model:PivotTo(CFrame.new(pos + Vector3.new(0, h * HOP_HEIGHT, 0)) * FACING)
		e.ground:PivotTo(CFrame.new(pos) * FACING)
		local mesh = e.mesh
		if mesh then
			-- 착지 전후는 납작, 공중에서는 길쭉
			local squash = if hopT < 0.1 then 1 - (0.1 - hopT) * 2.2 elseif hopT > 0.92 then 1 - (hopT - 0.92) * 2.2 else 1 + h * 0.08
			mesh.Scale = Vector3.new(1 / math.sqrt(squash), squash, 1 / math.sqrt(squash))
		end
		local shadowScale = 1 - h * 0.35
		for _, part in e.ground:GetChildren() do
			if part.Name == "Shadow" and part:IsA("BasePart") then
				part.Transparency = 0.72 + h * 0.15
				local d = 3.9 * shadowScale
				part.Size = Vector3.new(part.Size.X, d, d)
			end
		end
		if e.rainbow then
			e.body.Color = Color3.fromHSV((clock * 0.25 + e.phase) % 1, 0.75, 1)
		end
		-- 새 점프 시작(= 착지) 순간
		local hopIndex = math.floor(hops)
		if hopIndex ~= e.lastHop then
			e.lastHop = hopIndex
			if clock - lastSquishSound > 0.25 and (pos - camPos).Magnitude < 45 then
				lastSquishSound = clock
				Sound.playAt("squish", pos, 0.9 + math.random() * 0.3)
			end
		end
	end
end

function Parade.init()
	folder = Instance.new("Folder")
	folder.Name = "ParadeClient"
	folder.Parent = Workspace

	Net.event("Parade").OnClientEvent:Connect(function(msg: { [string]: any })
		if msg.op == "spawn" then
			add(msg.slime)
			refreshAffordable()
		elseif msg.op == "remove" then
			remove(msg.key, msg.buyer ~= nil)
		end
	end)

	task.spawn(function()
		local result = State.action("ParadeSync")
		if result.ok and type(result.list) == "table" then
			for _, data in result.list do
				add(data)
			end
			refreshAffordable()
		end
	end)

	State.money:Connect(refreshAffordable)
	RunService.RenderStepped:Connect(step)
end

-- 튜토리얼용: 살 수 있는 가장 가까운 행진 슬라임
function Parade.nearestAffordable(from: Vector3): BasePart?
	local best: BasePart? = nil
	local bestDist = math.huge
	for _, e in entries do
		if e.data.price <= State.cash then
			local d = (e.body.Position - from).Magnitude
			if d < bestDist then
				best, bestDist = e.body, d
			end
		end
	end
	return best
end

return Parade
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">Sound</string>
              <string name="Source"><![CDATA[--!strict
-- 소리 엔진(클라이언트).
--  · 샘플마다 소리 인스턴스 풀을 만들어 여러 음을 겹쳐 재생(화음·아르페지오)
--  · 후보 소리 중 실제로 로딩되는 첫 번째를 자동 선택(Config/Audio)
--  · 소리 그룹 SFX / UI / Music, 음악에는 잔향
--  · playAt: 3D 위치음(멀어지면 작아짐), combo: 연속 동작일수록 음이 올라감

local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Audio = require(Shared.Config.Audio)

local Sound = {}

Sound.enabled = true
Sound.musicEnabled = true

local POOL_SIZE = 8
local UI_CUES = { click = true, hover = true, open = true, close = true, error = true, tick = true }
-- 예전 이름 호환
local ALIASES: { [string]: string } = { hit = "bonkHit", alert = "alarm", jump = "hop" }

local root: Folder
local groups: { [string]: SoundGroup } = {}
local pools: { [string]: { Sound } } = {}
local cursor: { [string]: number } = {}
local resolved: { [string]: string } = {}
local comboState: { [string]: { t: number, n: number } } = {}
local musicPool: { Sound } = {} -- 음악 전용(효과음을 끊지 않도록 분리)
local musicCursor = 1

local function candidates(sample: string): { string }
	local list: { string } = {}
	local custom = Audio.custom[sample]
	if custom and custom ~= "" then
		table.insert(list, custom)
	end
	local builtIn: { string } = Audio.samples[sample] or {}
	for _, id in builtIn do
		table.insert(list, id)
	end
	return list
end

-- 후보를 차례로 불러 보고 길이가 있는(=로딩된) 첫 소리를 고릅니다.
local function resolve(sample: string)
	local list = candidates(sample)
	for _, id in list do
		local probe = Instance.new("Sound")
		probe.SoundId = id
		local ok = pcall(function()
			ContentProvider:PreloadAsync({ probe })
		end)
		local length = probe.TimeLength
		probe:Destroy()
		if ok and length > 0 then
			resolved[sample] = id
			for _, s in pools[sample] do
				s.SoundId = id
			end
			if sample == Audio.music.sample then
				for _, s in musicPool do
					s.SoundId = id
				end
			end
			return
		end
	end
end

function Sound.group(name: string): SoundGroup
	return groups[name]
end

local function makeGroup(name: string, volume: number): SoundGroup
	local g = Instance.new("SoundGroup")
	g.Name = name
	g.Volume = volume
	g.Parent = SoundService
	groups[name] = g
	return g
end

function Sound.init()
	root = Instance.new("Folder")
	root.Name = "SlimeHeistAudio"
	root.Parent = SoundService

	makeGroup("SFX", Audio.groups.SFX)
	makeGroup("UI", Audio.groups.UI)
	local music = makeGroup("Music", Audio.groups.Music)
	local reverb = Instance.new("ReverbSoundEffect")
	reverb.DecayTime = 2.2
	reverb.Density = 0.8
	reverb.Diffusion = 0.9
	reverb.WetLevel = -6
	reverb.DryLevel = -1
	reverb.Parent = music
	local eq = Instance.new("EqualizerSoundEffect")
	eq.HighGain = -9
	eq.MidGain = -2
	eq.LowGain = 2
	eq.Parent = music

	for sample in Audio.samples do
		local folder = Instance.new("Folder")
		folder.Name = sample
		folder.Parent = root
		local list: { Sound } = {}
		local first = candidates(sample)[1]
		for i = 1, POOL_SIZE do
			local s = Instance.new("Sound")
			s.Name = sample .. i
			s.SoundId = first or ""
			s.SoundGroup = groups.SFX
			s.Parent = folder
			list[i] = s
		end
		pools[sample] = list
		cursor[sample] = 1
	end
	local musicFolder = Instance.new("Folder")
	musicFolder.Name = "MusicNotes"
	musicFolder.Parent = root
	for i = 1, 12 do
		local s = Instance.new("Sound")
		s.Name = "note" .. i
		s.SoundId = candidates(Audio.music.sample)[1] or ""
		s.SoundGroup = music
		s.Parent = musicFolder
		musicPool[i] = s
	end
	for sample in Audio.samples do
		task.spawn(resolve, sample)
	end
end

local function nextSound(sample: string): Sound?
	local list = pools[sample]
	if not list then
		return nil
	end
	local i = cursor[sample]
	cursor[sample] = i % #list + 1
	return list[i]
end

local function playLayer(layer: Audio.Layer, pitch: number, volume: number, group: SoundGroup)
	local s = nextSound(layer.s)
	if not s then
		return
	end
	s.SoundGroup = group
	s.PlaybackSpeed = layer.p * pitch
	s.Volume = layer.v * volume
	s.TimePosition = 0
	s:Play()
end

-- 효과 재생. pitch/volume은 큐 전체에 곱합니다.
function Sound.play(name: string, pitch: number?, volume: number?)
	if not Sound.enabled then
		return
	end
	local cueName = ALIASES[name] or name
	local cue = Audio.cues[cueName]
	if not cue then
		return
	end
	local group = if UI_CUES[cueName] then groups.UI else groups.SFX
	local p, v = pitch or 1, volume or 1
	for _, layer in cue do
		if layer.d and layer.d > 0 then
			task.delay(layer.d, playLayer, layer, p, v, group)
		else
			playLayer(layer, p, v, group)
		end
	end
end

-- 연속으로 부르면(window초 안) 반음씩 올라가는 효과(동전 여러 개 등)
function Sound.combo(name: string, window: number?): number
	local now = os.clock()
	local state = comboState[name]
	if state == nil or now - state.t > (window or 1.2) then
		state = { t = now, n = 0 }
	end
	assert(state)
	comboState[name] = state
	state.t = now
	state.n = math.min(state.n + 1, 12)
	Sound.play(name, Audio.semitone(state.n - 1))
	return state.n
end

-- 3D 위치음: 카메라에서 멀면 생략
function Sound.playAt(name: string, position: Vector3, pitch: number?, volume: number?)
	if not Sound.enabled then
		return
	end
	local camera = Workspace.CurrentCamera
	if camera and (camera.CFrame.Position - position).Magnitude > Audio.positional.max then
		return
	end
	local cue = Audio.cues[ALIASES[name] or name]
	if not cue then
		return
	end
	local holder = Instance.new("Part")
	holder.Name = "SoundAt"
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.CFrame = CFrame.new(position)
	holder.Parent = Workspace
	local p, v = pitch or 1, volume or 1
	for _, layer in cue do
		local s = Instance.new("Sound")
		s.SoundId = resolved[layer.s] or candidates(layer.s)[1] or ""
		s.PlaybackSpeed = layer.p * p
		s.Volume = layer.v * v * 1.6
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = Audio.positional.min
		s.RollOffMaxDistance = Audio.positional.max
		s.SoundGroup = groups.SFX
		s.Parent = holder
		if layer.d and layer.d > 0 then
			task.delay(layer.d, function()
				s:Play()
			end)
		else
			s:Play()
		end
	end
	Debris:AddItem(holder, 3)
end

-- 음악용 음 하나(Music 그룹, 전용 풀)
function Sound.note(speed: number, volume: number)
	if not Sound.musicEnabled then
		return
	end
	local s = musicPool[musicCursor]
	if not s then
		return
	end
	musicCursor = musicCursor % #musicPool + 1
	s.PlaybackSpeed = speed
	s.Volume = volume
	s.TimePosition = 0
	s:Play()
end

return Sound
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--!strict
-- 첫 3분 튜토리얼: 빛나는 빔으로 목표를 가리킵니다.
--   0: 행진에서 슬라임 사기 → 1: 수금 발판 밟기 → 2: 잠금 발판 밟기 → 3: 끝(팁 몇 개)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local World = require(Shared.Config.World)

local Client = script.Parent.Parent
local Lang = require(Client.Lang)
local State = require(Client.State)
local Hud = require(Client.UI.Hud)
local Notify = require(Client.UI.Notify)
local Parade = require(script.Parent.Parade)
local Sound = require(script.Parent.Sound)

local Tutorial = {}

local player = Players.LocalPlayer
local beam: Beam
local a0: Attachment
local a1: Attachment
local targetPart: Part
local tipsShown = false

local function plotPart(name: string): BasePart?
	local view = State.view
	if not view or view.plot == 0 then
		return nil
	end
	local map = Workspace:FindFirstChild("Map")
	local plots = map and map:FindFirstChild("Plots")
	local plot = plots and plots:FindFirstChild("Plot" .. view.plot)
	local part = plot and plot:FindFirstChild(name)
	return if part and part:IsA("BasePart") then part else nil
end

local function root(): BasePart?
	local char = player.Character
	local r = char and char:FindFirstChild("HumanoidRootPart")
	return if r and r:IsA("BasePart") then r else nil
end

local function showTips()
	if tipsShown then
		return
	end
	tipsShown = true
	task.spawn(function()
		for _, key in { "tipMerge", "tipBonk", "tipWeather", "tipSteal" } do
			task.wait(9)
			Notify.toast(Lang.t(key), "info")
		end
	end)
end

local guideUntil = 0
local lastStep = -1

-- 집(내 기지) 방향 안내: seconds 동안 빔으로 가리킴
function Tutorial.guideHome(seconds: number)
	guideUntil = os.clock() + seconds
end

local function update()
	local data = State.data()
	local r = root()
	if not data or not r then
		beam.Enabled = false
		return
	end
	if a0.Parent ~= r then
		a0.Parent = r
	end
	local step = data.tutorial
	if lastStep ~= -1 and step > lastStep then
		Sound.play("questDone")
	end
	lastStep = step
	local target: Vector3? = nil
	if os.clock() < guideUntil then
		local spawnPart = plotPart("CollectPlate")
		target = if spawnPart then spawnPart.Position else nil
		Hud.setTutorial(Lang.t("homeGuide"))
		if target and (target - r.Position).Magnitude < 14 then
			guideUntil = 0
		end
	elseif step == 0 then
		local slime = Parade.nearestAffordable(r.Position)
		if slime then
			target = slime.Position
		else
			target = Vector3.new(World.parade.x, 2, r.Position.Z)
		end
		Hud.setTutorial(Lang.t("tut0"), 1)
	elseif step == 1 then
		local plate = plotPart("CollectPlate")
		if State.vault < 1 then
			Hud.setTutorial(Lang.t("tut1wait"), 2)
			target = nil
		else
			target = if plate then plate.Position else nil
			Hud.setTutorial(Lang.t("tut1"), 2)
		end
	elseif step == 2 then
		local plate = plotPart("LockPlate")
		target = if plate then plate.Position else nil
		Hud.setTutorial(Lang.t("tut2"), 3)
	else
		Hud.setTutorial(nil)
		showTips()
	end
	if target then
		targetPart.CFrame = CFrame.new(target + Vector3.new(0, 1, 0))
		beam.Enabled = true
	else
		beam.Enabled = false
	end
end

function Tutorial.init()
	targetPart = Instance.new("Part")
	targetPart.Name = "TutorialTarget"
	targetPart.Anchored = true
	targetPart.CanCollide = false
	targetPart.CanQuery = false
	targetPart.CanTouch = false
	targetPart.Transparency = 1
	targetPart.Size = Vector3.new(1, 1, 1)
	targetPart.Parent = Workspace
	a1 = Instance.new("Attachment")
	a1.Parent = targetPart
	a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, -1.5, 0)
	beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Width0 = 1.2
	beam.Width1 = 1.2
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Segments = 20
	beam.CurveSize0 = 4
	beam.CurveSize1 = -4
	beam.Color = ColorSequence.new(Color3.fromRGB(255, 240, 120), Color3.fromRGB(120, 255, 160))
	beam.Transparency = NumberSequence.new(0.2)
	beam.Enabled = false
	beam.Parent = targetPart

	-- 빔이 흐르는 느낌
	local arrow = Instance.new("BillboardGui")
	arrow.Size = UDim2.fromOffset(60, 60)
	arrow.StudsOffset = Vector3.new(0, 4, 0)
	arrow.AlwaysOnTop = true
	arrow.Parent = targetPart
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "⬇"
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 240, 120)
	label.Parent = arrow

	task.spawn(function()
		while true do
			task.wait(0.25)
			local ok = pcall(update)
			arrow.Enabled = ok and beam.Enabled
		end
	end)
	-- 화살표 둥실 + 빔 색 흐름
	RunService.RenderStepped:Connect(function()
		if beam.Enabled then
			local t = os.clock()
			arrow.StudsOffset = Vector3.new(0, 4 + math.abs(math.sin(t * 3)) * 1.5, 0)
			beam.TextureLength = 4
			local k = (t * 0.8) % 1
			beam.Color = ColorSequence.new(Color3.fromHSV(0.14 + k * 0.1, 0.6, 1), Color3.fromHSV(0.33 + k * 0.1, 0.6, 1))
		end
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">WorldFx</string>
              <string name="Source"><![CDATA[--!strict
-- 월드 연출(클라이언트 전용)
--  · 조명: 햇살(SunRays)·블룸·색보정·대기, 날씨별 조명/안개/입자, 유성우
--  · 하늘: 천천히 흘러가는 구름
--  · 포털 고리 조명이 차례로 반짝(마퀴 효과), 도로 화살표 흐름
--  · 기지 슬라임: 말랑 호흡, 눈 깜빡임, 가끔 콩 점프, 내 슬라임 위로 +$ 수입 표시, 무지개 색 순환
--  · 내 수금 발판은 돈이 쌓이면 두근두근, 방어막은 일렁임, 대폭주 중 화면 테두리 번쩍

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weather = require(Shared.Config.Weather)
local World = require(Shared.Config.World)
local Economy = require(Shared.Config.Economy)
local Calc = require(Shared.Logic.Calc)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local State = require(Client.State)
local Fx = require(script.Parent.Fx)

local WorldFx = {}

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera
local worldState: Instance
local correction: ColorCorrectionEffect
local atmosphere: Atmosphere
local emitterPart: Part
local emitter: ParticleEmitter
local frenzyStroke: UIStroke
local frenzyFrame: Frame
local currentWeather = "?"
local popupFolder: Folder

local DEFAULT = {
	clockTime = 14.5,
	ambient = Color3.fromRGB(115, 115, 128),
	tint = Color3.fromRGB(255, 252, 245),
	fog = Color3.fromRGB(199, 220, 255),
}

type ParticleDef = {
	texture: string,
	speed: NumberRange,
	size: number,
	rate: number,
	lifetime: number,
	accel: Vector3,
	squash: number,
}

local PARTICLES: { [string]: ParticleDef } = {
	rain = { texture = "rbxasset://textures/particles/sparkles_main.dds", speed = NumberRange.new(70, 90), size = 0.35, rate = 260, lifetime = 1.2, accel = Vector3.new(0, -40, 0), squash = 3 },
	snow = { texture = "rbxasset://textures/particles/sparkles_main.dds", speed = NumberRange.new(6, 12), size = 0.6, rate = 120, lifetime = 5, accel = Vector3.new(0, -2, 0), squash = 0 },
	sparkle = { texture = "rbxasset://textures/particles/sparkles_main.dds", speed = NumberRange.new(4, 10), size = 0.8, rate = 70, lifetime = 4, accel = Vector3.new(0, -1, 0), squash = 0 },
	ember = { texture = "rbxasset://textures/particles/fire_main.dds", speed = NumberRange.new(8, 16), size = 0.7, rate = 90, lifetime = 3, accel = Vector3.new(0, 6, 0), squash = 0 },
	stars = { texture = "rbxasset://textures/particles/sparkles_main.dds", speed = NumberRange.new(2, 6), size = 0.9, rate = 60, lifetime = 5, accel = Vector3.new(0, -1, 0), squash = 0 },
	candy = { texture = "rbxasset://textures/particles/sparkles_main.dds", speed = NumberRange.new(5, 12), size = 1.0, rate = 80, lifetime = 4, accel = Vector3.new(0, -4, 0), squash = 0 },
}

local function applyWeather(id: string)
	if id == currentWeather then
		return
	end
	currentWeather = id
	local event = Weather.byId[id]
	local clockTime = if event then event.clockTime else DEFAULT.clockTime
	local ambient = if event then event.ambient else DEFAULT.ambient
	local tint = if event then event.tint else DEFAULT.tint
	local fog = if event then event.fog else DEFAULT.fog
	Kit.tween(Lighting, 3, { ClockTime = clockTime, Ambient = ambient, OutdoorAmbient = ambient:Lerp(Color3.new(1, 1, 1), 0.25) })
	Kit.tween(correction, 3, { TintColor = tint, Saturation = if event then 0.2 else 0.12 })
	Kit.tween(atmosphere, 3, { Color = fog, Density = if event then 0.33 else 0.24, Haze = if event then 1.2 else 0.5 })

	if event then
		local def = PARTICLES[event.particle] or PARTICLES.sparkle
		emitter.Texture = def.texture
		emitter.Color = ColorSequence.new(event.particleColor)
		emitter.Speed = def.speed
		emitter.Size = NumberSequence.new(def.size)
		emitter.Rate = def.rate
		emitter.Lifetime = NumberRange.new(def.lifetime)
		emitter.Acceleration = def.accel
		emitter.Squash = NumberSequence.new(def.squash)
		emitter.Enabled = true
	else
		emitter.Enabled = false
	end
end

local function meteor()
	local start = camera.CFrame.Position + Vector3.new(math.random(-120, 120), 140, math.random(-120, 120))
	local finish = start + Vector3.new(math.random(-60, 60), -150, math.random(-60, 60))
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(2.5, 2.5, 2.5)
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(200, 170, 255)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CFrame = CFrame.new(start)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 1, 0)
	a0.Parent = p
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -1, 0)
	a1.Parent = p
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.6
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(Color3.fromRGB(230, 210, 255), Color3.fromRGB(120, 80, 255))
	trail.Transparency = NumberSequence.new(0, 1)
	trail.Parent = p
	p.Parent = Workspace
	Kit.tween(p, 1.4, { CFrame = CFrame.new(finish) }, Enum.EasingStyle.Linear)
	task.delay(2, function()
		p:Destroy()
	end)
end

---------------------------------------------------------------------------
-- 기지(방어막·수금 발판)
---------------------------------------------------------------------------

local function plotsFolder(): Instance?
	local map = Workspace:FindFirstChild("Map")
	return map and map:FindFirstChild("Plots")
end

local function isProtected(plot: Instance, now: number): boolean
	local lockEnds = plot:GetAttribute("LockEnds")
	local shieldEnds = plot:GetAttribute("ShieldEnds")
	return (type(lockEnds) == "number" and lockEnds > now)
		or (type(shieldEnds) == "number" and shieldEnds > now)
		or plot:GetAttribute("Rookie") == true
end

-- 방어막: 보호 중이고 내가 주인이 아니면 로컬 충돌 켜기
local function updateBarriers()
	local plots = plotsFolder()
	if not plots then
		return
	end
	local now = Workspace:GetServerTimeNow()
	for _, plot in plots:GetChildren() do
		local barrier = plot:FindFirstChild("Barrier")
		if barrier and barrier:IsA("BasePart") then
			local owner = plot:GetAttribute("OwnerUserId")
			local protected = isProtected(plot, now)
			barrier.CanCollide = protected and owner ~= 0 and owner ~= player.UserId
			barrier:SetAttribute("ClientProtected", protected)
		end
	end
end

local function animatePlots(t: number)
	local plots = plotsFolder()
	if not plots then
		return
	end
	local view = State.view
	for _, plot in plots:GetChildren() do
		local barrier = plot:FindFirstChild("Barrier")
		if barrier and barrier:IsA("BasePart") and barrier:GetAttribute("ClientProtected") == true then
			barrier.Transparency = 0.3 + 0.15 * math.sin(t * 4)
		end
		if view and plot.Name == "Plot" .. view.plot then
			local plate = plot:FindFirstChild("CollectPlate")
			if plate and plate:IsA("BasePart") then
				if State.vault >= 1 then
					local k = 0.5 + 0.5 * math.sin(t * 6)
					plate.Color = Color3.fromRGB(70, 220, 110):Lerp(Color3.fromRGB(220, 255, 150), k)
				else
					plate.Color = Color3.fromRGB(70, 220, 110)
				end
			end
		end
	end
end

---------------------------------------------------------------------------
-- 도로 화살표 · 포털
---------------------------------------------------------------------------

type Arrow = { part: BasePart, base: CFrame }
local arrows: { Arrow } = {}
local roadEnd = World.road.endZ - 3
type Portal = { rings: { BasePart }, orbs: { BasePart }, orbBase: { CFrame } }
local portals: { Portal } = {}

local function collectMapParts()
	local map = Workspace:WaitForChild("Map", 30)
	if not map then
		return
	end
	local folder = map:WaitForChild("RoadArrows", 10)
	if folder then
		for _, p in folder:GetChildren() do
			if p:IsA("BasePart") then
				table.insert(arrows, { part = p, base = p.CFrame })
			end
		end
	end
	for _, m in map:GetChildren() do
		if m.Name == "Portal" then
			local portal: Portal = { rings = {}, orbs = {}, orbBase = {} }
			for _, p in m:GetChildren() do
				if p:IsA("BasePart") then
					if p.Name == "Ring" then
						table.insert(portal.rings, p)
					elseif p.Name == "PortalOrb" then
						table.insert(portal.orbs, p)
						table.insert(portal.orbBase, p.CFrame)
					end
				end
			end
			table.insert(portals, portal)
		end
	end
end

---------------------------------------------------------------------------
-- 구름
---------------------------------------------------------------------------

type Cloud = { model: Model, speed: number }
local clouds: { Cloud } = {}

local function makeClouds()
	local folder = Instance.new("Folder")
	folder.Name = "Clouds"
	folder.Parent = Workspace
	for i = 1, 14 do
		local model = Instance.new("Model")
		model.Name = "Cloud"
		local center = Vector3.new(math.random(-400, 400), 110 + math.random(0, 40), math.random(-400, 400))
		local puffs = math.random(3, 5)
		for k = 1, puffs do
			local p = Instance.new("Part")
			p.Shape = Enum.PartType.Ball
			local d = 14 + math.random() * 12
			p.Size = Vector3.new(d, d, d)
			p.CFrame = CFrame.new(center + Vector3.new((k - puffs / 2) * 9, math.random() * 4, math.random(-5, 5)))
			p.Color = Color3.fromRGB(255, 255, 255)
			p.Material = Enum.Material.SmoothPlastic
			p.Transparency = 0.08
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Parent = model
		end
		model.Parent = folder
		clouds[i] = { model = model, speed = 2 + math.random() * 3 }
	end
end

---------------------------------------------------------------------------
-- 기지 슬라임 생동감
---------------------------------------------------------------------------

type Eye = { mesh: SpecialMesh, base: Vector3 }
type Living = {
	model: Model,
	body: BasePart,
	mesh: SpecialMesh,
	origin: CFrame,
	phase: number,
	rainbow: boolean,
	eyes: { Eye },
	shines: { BasePart },
	nextBlink: number,
	nextHop: number,
	hopStart: number,
	nextPopup: number,
	mine: boolean,
	income: number,
}
local living: { [Model]: Living } = {}

local function track(inst: Instance)
	if inst.Parent == nil or not inst:IsA("Model") or living[inst] then
		return
	end
	local model = inst
	local body = model:FindFirstChild("Body")
	if not body or not body:IsA("BasePart") then
		return
	end
	local mesh = body:FindFirstChildOfClass("SpecialMesh")
	if not mesh then
		return
	end
	local eyes: { Eye } = {}
	local shines: { BasePart } = {}
	for _, p in model:GetChildren() do
		if p:IsA("BasePart") then
			if p.Name == "Eye" or p.Name == "EyeWhite" then
				local m = p:FindFirstChildOfClass("SpecialMesh")
				if m then
					table.insert(eyes, { mesh = m, base = m.Scale })
				end
			elseif p.Name == "EyeShine" or p.Name == "EyeShine2" then
				table.insert(shines, p)
			end
		end
	end
	local id, star, mut = model:GetAttribute("SpeciesId"), model:GetAttribute("Star"), model:GetAttribute("Mutation")
	local income = 0
	if type(id) == "string" and type(star) == "number" and type(mut) == "string" then
		income = Calc.slimeIncome({ id = id, star = star, mut = mut })
	end
	local now = os.clock()
	living[model] = {
		model = model,
		body = body,
		mesh = mesh,
		origin = model:GetPivot(),
		phase = math.random() * 6.28,
		rainbow = body:GetAttribute("Rainbow") == true,
		eyes = eyes,
		shines = shines,
		nextBlink = now + 1 + math.random() * 4,
		nextHop = now + 4 + math.random() * 8,
		hopStart = 0,
		nextPopup = now + 1 + math.random() * 4,
		mine = model:GetAttribute("OwnerUserId") == player.UserId,
		income = income,
	}
	model.AncestryChanged:Connect(function(_, parent)
		if not parent then
			living[model] = nil
		end
	end)
end

local function incomePopup(pos: Vector3, amount: number)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(pos)
	anchor.Parent = popupFolder
	local gui = Kit.new("BillboardGui", {
		Size = UDim2.fromOffset(120, 34),
		AlwaysOnTop = false,
		LightInfluence = 0,
		MaxDistance = 70,
		Parent = anchor,
	}) :: BillboardGui
	local label = Kit.label({ Text = "+" .. Format.cash(amount), TextColor3 = Kit.colors.cash, stroke = 2.5, Parent = gui })
	Kit.tween(anchor, 1.2, { CFrame = CFrame.new(pos + Vector3.new(0, 4, 0)) }, Enum.EasingStyle.Quad)
	task.delay(0.7, function()
		Kit.tween(label, 0.45, { TextTransparency = 1 })
	end)
	task.delay(1.25, function()
		anchor:Destroy()
	end)
end

local POPUP_EVERY = 4

local function animateSlimes(t: number)
	local camPos = camera.CFrame.Position
	local view = State.view
	local mult = if view then view.multiplier else 1
	for model, s in living do
		if model.Parent == nil then
			living[model] = nil
			continue
		end
		local dist = (s.body.Position - camPos).Magnitude
		if dist > 140 then
			continue
		end
		-- 말랑 호흡
		local k = math.sin(t * 3 + s.phase) * 0.045
		local hopAge = t - s.hopStart
		if hopAge < 0.1 then
			k -= 0.12 -- 점프 직전 움츠림
		end
		s.mesh.Scale = Vector3.new(1 + k, 1 - k, 1 + k)
		if s.rainbow then
			s.body.Color = Color3.fromHSV((t * 0.25 + s.phase) % 1, 0.75, 1)
		end
		-- 눈 깜빡임
		if t >= s.nextBlink then
			s.nextBlink = t + 2 + math.random() * 4
			for _, eye in s.eyes do
				eye.mesh.Scale = Vector3.new(eye.base.X, 0.12, eye.base.Z)
			end
			for _, shine in s.shines do
				shine.LocalTransparencyModifier = 1
			end
			task.delay(0.12, function()
				for _, eye in s.eyes do
					eye.mesh.Scale = eye.base
				end
				for _, shine in s.shines do
					shine.LocalTransparencyModifier = 0
				end
			end)
		end
		-- 가끔 콩 점프(가까울 때만)
		if dist < 90 and t >= s.nextHop then
			s.nextHop = t + 6 + math.random() * 8
			s.hopStart = t
		end
		if hopAge < 0.55 then
			local h = if hopAge < 0.1 then 0 else math.sin((hopAge - 0.1) / 0.45 * math.pi) * 1.3
			model:PivotTo(s.origin + Vector3.new(0, h, 0))
		elseif hopAge < 0.7 then
			model:PivotTo(s.origin)
		end
		-- 내 슬라임 수입 표시
		if s.mine and dist < 60 and t >= s.nextPopup and s.income > 0 then
			s.nextPopup = t + POPUP_EVERY
			incomePopup(s.body.Position + Vector3.new(0, 3, 0), s.income * mult * POPUP_EVERY)
		end
	end
end

---------------------------------------------------------------------------

function WorldFx.init()
	worldState = ReplicatedStorage:WaitForChild("WorldState")
	correction = Instance.new("ColorCorrectionEffect")
	correction.Name = "SlimeHeistCC"
	correction.Saturation = 0.12
	correction.Contrast = 0.08
	correction.TintColor = DEFAULT.tint
	correction.Parent = Lighting
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.24
	atmosphere.Haze = 0.5
	atmosphere.Glare = 0.2
	atmosphere.Color = DEFAULT.fog
	atmosphere.Decay = Color3.fromRGB(150, 170, 220)
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.7
	bloom.Size = 32
	bloom.Threshold = 1.5
	bloom.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.75
	rays.Parent = Lighting

	emitterPart = Instance.new("Part")
	emitterPart.Name = "WeatherEmitter"
	emitterPart.Anchored = true
	emitterPart.CanCollide = false
	emitterPart.CanQuery = false
	emitterPart.CanTouch = false
	emitterPart.Transparency = 1
	emitterPart.Size = Vector3.new(160, 1, 160)
	emitterPart.Parent = Workspace
	emitter = Instance.new("ParticleEmitter")
	emitter.EmissionDirection = Enum.NormalId.Bottom
	emitter.LightEmission = 0.8
	emitter.Enabled = false
	emitter.Parent = emitterPart

	popupFolder = Instance.new("Folder")
	popupFolder.Name = "IncomePopups"
	popupFolder.Parent = Workspace

	local overlay = Kit.new("ScreenGui", {
		Name = "FrenzyOverlay",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 1,
		Parent = player:WaitForChild("PlayerGui"),
	}) :: ScreenGui
	frenzyFrame = Kit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = overlay,
	}) :: Frame
	frenzyStroke = Kit.stroke(frenzyFrame, 12, Kit.colors.pink)
	frenzyStroke.Transparency = 0.2

	makeClouds()
	task.spawn(collectMapParts)
	CollectionService:GetInstanceAddedSignal("BaseSlime"):Connect(function(m)
		task.defer(track, m)
	end)
	for _, m in CollectionService:GetTagged("BaseSlime") do
		track(m)
	end

	local acc = 0
	local meteorAcc = 0
	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()
		-- 입자는 카메라를 따라다님
		emitterPart.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, 45, 0))

		-- 도로 화살표 흐름(행진 방향 +Z). 간격(12)만큼 움직였다 되돌아가서 끊김 없이 흐름
		local shift = (t * Economy.parade.speed) % 12
		for _, a in arrows do
			a.part.CFrame = a.base + Vector3.new(0, 0, shift)
			a.part.Transparency = if a.base.Position.Z + shift > roadEnd then 1 else 0.35
		end

		-- 포털: 고리 조명이 차례로 반짝, 양옆 구슬은 둥실
		for _, portal in portals do
			for i, ring in portal.rings do
				ring.Transparency = 0.05 + 0.45 * (0.5 + 0.5 * math.sin(t * 5 - i * 0.55))
			end
			for i, orb in portal.orbs do
				orb.CFrame = portal.orbBase[i] + Vector3.new(0, math.sin(t * 2 + i) * 0.6, 0)
			end
		end

		-- 구름
		for _, c in clouds do
			local pivot = c.model:GetPivot()
			local x = pivot.Position.X + c.speed * dt
			if x > 450 then
				c.model:PivotTo(pivot - Vector3.new(900, 0, 0))
			else
				c.model:PivotTo(pivot + Vector3.new(c.speed * dt, 0, 0))
			end
		end

		animateSlimes(t)
		animatePlots(t)

		-- 대폭주 테두리: 색이 돌고 두근거림
		if frenzyFrame.Visible then
			frenzyStroke.Color = Color3.fromHSV((t * 0.3) % 1, 0.7, 1)
			frenzyStroke.Transparency = 0.15 + 0.25 * (0.5 + 0.5 * math.sin(t * 5))
		end

		acc += dt
		if acc >= 0.25 then
			acc = 0
			local weather = worldState:GetAttribute("Weather")
			applyWeather(if type(weather) == "string" then weather else "")
			frenzyFrame.Visible = worldState:GetAttribute("Frenzy") == true and not Fx.reduced
			updateBarriers()
		end
		if currentWeather == "meteor" and not Fx.reduced then
			meteorAcc += dt
			if meteorAcc > 0.8 then
				meteorAcc = 0
				meteor()
			end
		end
	end)
end

return WorldFx
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">Lang</string>
            <string name="Source"><![CDATA[--!strict
-- 다국어: 플레이어 언어가 한국어면 ko, 아니면 en.
-- 서버 알림은 키 + 인자(id)로 오고, 여기서 슬라임·변이·날씨 이름으로 바꿔 보여줍니다.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Text = require(Shared.Config.Text)
local Slimes = require(Shared.Config.Slimes)
local Mutations = require(Shared.Config.Mutations)
local Rarities = require(Shared.Config.Rarities)
local Weather = require(Shared.Config.Weather)
local Rewards = require(Shared.Config.Rewards)
local Format = require(Shared.Util.Format)

local Lang = {}

Lang.code = "en"

function Lang.init()
	local locale = string.lower(Players.LocalPlayer.LocaleId or "")
	Lang.code = if string.sub(locale, 1, 2) == "ko" then "ko" else "en"
end

function Lang.pick(dict: { en: string, ko: string }): string
	return if Lang.code == "ko" then dict.ko else dict.en
end

function Lang.slime(id: string): string
	local s = Slimes.byId[id]
	return if s then Lang.pick(s.name) else id
end

function Lang.mut(id: string): string
	local m = Mutations.byId[id]
	return if m then Lang.pick(m.name) else id
end

function Lang.rarity(id: string): string
	local r = Rarities.byId[id]
	return if r then Lang.pick(r.name) else id
end

function Lang.weather(id: string): string
	local w = Weather.byId[id]
	return if w then Lang.pick(w.name) else id
end

function Lang.quest(id: string, goal: number): string
	local q = Rewards.questById[id]
	if not q then
		return id
	end
	return Format.fill(Lang.pick(q.text), { n = goal, t = Format.time(goal) })
end

-- 인자 중 id를 이름으로 변환
local function resolve(args: { [string]: any }?): { [string]: any }?
	if not args then
		return nil
	end
	local out = table.clone(args)
	if type(out.slime) == "string" then
		out.slime = Lang.slime(out.slime)
	end
	if type(out.mut) == "string" then
		out.mut = Lang.mut(out.mut)
	end
	if type(out.rarity) == "string" then
		out.rarity = Lang.rarity(out.rarity)
	end
	if type(out.weather) == "string" then
		out.weather = Lang.weather(out.weather)
	end
	if type(out.quest) == "string" then
		out.quest = Lang.quest(out.quest, 0)
	end
	return out
end

function Lang.t(key: string, args: { [string]: any }?): string
	local entry = Text[key]
	if not entry then
		return key
	end
	return Format.fill(Lang.pick(entry), resolve(args))
end

return Lang
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="64">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- 클라이언트 시작점.

local Players = game:GetService("Players")

local Client = script.Parent
local Lang = require(Client.Lang)
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Notify = require(Client.UI.Notify)
local Prompts = require(Client.UI.Prompts)
local Hud = require(Client.UI.Hud)
local Panels = Client.UI.Panels
local Shop = require(Panels.Shop)
local Index = require(Panels.Index)
local Rebirth = require(Panels.Rebirth)
local Quests = require(Panels.Quests)
local Gifts = require(Panels.Gifts)
local Store = require(Panels.Store)
local Settings = require(Panels.Settings)
local Manage = require(Panels.Manage)
local Offline = require(Panels.Offline)
local Controllers = Client.Controllers
local Sound = require(Controllers.Sound)
local Music = require(Controllers.Music)
local Fx = require(Controllers.Fx)
local Parade = require(Controllers.Parade)
local BaseSlimes = require(Controllers.BaseSlimes)
local WorldFx = require(Controllers.WorldFx)
local Tutorial = require(Controllers.Tutorial)
local Input = require(Controllers.Input)

Lang.init()
Sound.init()
Kit.setClickSound(function(name: string)
	Sound.play(name)
end)
State.init()
Notify.init()
Prompts.init()
Hud.init()
for _, panel in { Shop, Index, Rebirth, Quests, Gifts, Store, Settings, Manage, Offline } :: { { init: () -> () } } do
	panel.init()
end
Fx.init()
Parade.init()
BaseSlimes.init()
WorldFx.init()
Tutorial.init()
Input.init()
Music.init()

-- 저장된 설정(음악·효과음·화면 효과) 적용, 첫 상태를 받으면 로딩 화면 닫기
local player = Players.LocalPlayer
State.changed:Connect(function()
	Settings.apply()
	if player:GetAttribute("ClientReady") ~= true then
		player:SetAttribute("ClientReady", true)
	end
end)
if State.view then
	Settings.apply()
	player:SetAttribute("ClientReady", true)
end

-- 서버가 입장 때 보낸 상태를 놓쳤을 수도 있으니 한 번 더 요청
task.spawn(function()
	State.action("GetState")
end)

print("[SlimeHeist] client ready for " .. player.Name)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">SlimeLabel</string>
            <string name="Source"><![CDATA[--!strict
-- 슬라임 머리 위 이름표(클라이언트에서 각자 언어로 생성).
--  [✨ 황금 x2]      ← 변이 배지(있을 때)
--  드래곤 ★★         ← 이름 + 노란 별
--  [ 전설 ]          ← 등급 배지(비밀은 무지개)
--  $4K/s  또는 $360K ← 수입(기지) / 가격(행진)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Slimes = require(Shared.Config.Slimes)
local Rarities = require(Shared.Config.Rarities)
local Mutations = require(Shared.Config.Mutations)
local Calc = require(Shared.Logic.Calc)
local Format = require(Shared.Util.Format)
local SlimeBuilder = require(Shared.SlimeBuilder)

local Client = script.Parent
local Lang = require(Client.Lang)
local Kit = require(Client.UI.Kit)

local SlimeLabel = {}

export type Info = { id: string, star: number, mut: string }

SlimeLabel.RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 70)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 255, 120)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(80, 160, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 90, 255)),
})

function SlimeLabel.stars(star: number): string
	return string.rep("★", star)
end

local function row(parent: Instance, order: number, height: number): Frame
	return Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, height),
		LayoutOrder = order,
		Parent = parent,
	}) :: Frame
end

local function badge(parent: Instance, text: string, color: Color3, width: number, rainbow: boolean?): TextLabel
	local b = Kit.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(width, 0.92),
		BackgroundColor3 = if rainbow then Color3.new(1, 1, 1) else color,
		BackgroundTransparency = 0.05,
		Text = text,
		stroke = 2,
		Parent = parent,
	})
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = b
	local st = Instance.new("UIStroke")
	st.Thickness = 2
	st.Color = Kit.darken(color, 0.55)
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Parent = b
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0.08, 0)
	pad.PaddingBottom = UDim.new(0.08, 0)
	pad.Parent = b
	if rainbow then
		local g = Instance.new("UIGradient")
		g.Color = SlimeLabel.RAINBOW
		g.Parent = b
	end
	return b
end

-- mode "base": 초당 수입 표시 / "parade": 가격 표시
function SlimeLabel.create(adornee: BasePart, info: Info, mode: string, price: number?): BillboardGui
	local species = Slimes.byId[info.id]
	local rarity = Rarities.byId[species.rarity]
	local mutation = Mutations.byId[info.mut] or Mutations.byId.none
	local height = SlimeBuilder.height(info.star)

	local gui = Kit.new("BillboardGui", {
		Name = "SlimeLabel",
		Adornee = adornee,
		Size = UDim2.fromScale(10, 4.4),
		StudsOffsetWorldSpace = Vector3.new(0, height / 2 + 2.9, 0),
		MaxDistance = if mode == "parade" then 120 else 75,
		LightInfluence = 0,
		AlwaysOnTop = false,
		ResetOnSpawn = false,
	}) :: BillboardGui
	local frame = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gui })
	local layout = Kit.list(frame, true, 0, Enum.HorizontalAlignment.Center)
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom

	if mutation.id ~= "none" then
		badge(row(frame, 1, 0.2), "✨ " .. string.upper(Lang.pick(mutation.name)) .. " " .. Format.mult(mutation.mult), mutation.label, 0.62, mutation.id == "rainbow")
	end
	local name = Kit.label({
		Size = UDim2.fromScale(1, 0.3),
		Text = Lang.pick(species.name) .. ' <font color="#FFD54A">' .. SlimeLabel.stars(info.star) .. "</font>",
		RichText = true,
		stroke = 2.5,
		LayoutOrder = 2,
		Parent = frame,
	})
	assert(name)
	badge(row(frame, 3, 0.2), Lang.pick(rarity.name), rarity.color, 0.42, rarity.id == "secret")
	local value = if mode == "parade"
		then Format.cash(price or species.price)
		else "💵 " .. Format.cash(Calc.slimeIncome(info)) .. "/s"
	local v = Kit.label({
		Name = if mode == "parade" then "Price" else "Income",
		Size = UDim2.fromScale(1, 0.26),
		Text = value,
		TextColor3 = if mode == "parade" then Kit.colors.yellow else Kit.colors.cash,
		stroke = 2.5,
		LayoutOrder = 4,
		Parent = frame,
	})
	assert(v)
	return gui
end

return SlimeLabel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
-- 클라이언트 쪽 상태 저장소. 서버가 보내는 StateView/Money를 받아 두고 변경을 알립니다.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Types = require(Shared.Types)

local State = {}

State.view = nil :: Types.StateView?
State.cash = 0
State.vault = 0
State.income = 0
State.receivedAt = os.clock() -- view.sessionSeconds를 받은 시각

State.changed = Signal.new() -- (view) 전체 상태
State.money = Signal.new() -- (cash, vault, income)

function State.sessionSeconds(): number
	local view = State.view
	if not view then
		return 0
	end
	return view.sessionSeconds + (os.clock() - State.receivedAt)
end

function State.data(): Types.PlayerData?
	local view = State.view
	return if view then view.data else nil
end

function State.hasPass(key: string): boolean
	local view = State.view
	return view ~= nil and view.passes[key] == true
end

function State.init()
	Net.event("State").OnClientEvent:Connect(function(view: Types.StateView)
		State.view = view
		State.receivedAt = os.clock()
		State.cash = view.data.cash
		State.vault = view.data.vault
		State.income = view.income
		State.changed:Fire(view)
		State.money:Fire(State.cash, State.vault, State.income)
	end)
	Net.event("Money").OnClientEvent:Connect(function(m: { cash: number, vault: number, income: number })
		State.cash = m.cash
		State.vault = m.vault
		State.income = m.income
		local view = State.view
		if view then
			view.data.cash = m.cash
			view.data.vault = m.vault
			view.income = m.income
		end
		State.money:Fire(m.cash, m.vault, m.income)
	end)
end

-- 서버 액션 호출. 결과 테이블(항상 ok 필드 있음)
function State.action(name: string, payload: any?): { [string]: any }
	local ok, result = pcall(function()
		return Net.func("Action"):InvokeServer(name, payload)
	end)
	if ok and type(result) == "table" then
		return result
	end
	return { ok = false, msg = "error" }
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="67">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- 화면 고정 UI
--  · 위: 돈(동전 아이콘 + 숫자 카운트업 + 증감 표시), 초당 수입·배수·금고 칩, 날씨/대폭주/행운/부스트 칩
--  · 왼쪽: 메뉴 7개(알림 배지가 톡 튐)
--  · 오른쪽 아래: 뿅망치(쿨타임 게이지)·잠금(남은 시간 표시)·집 찾기
--  · 아래: 튜토리얼 말풍선(단계 표시, 둥실둥실)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Util.Format)
local Progress = require(Shared.Logic.Progress)
local Weather = require(Shared.Config.Weather)

local Client = script.Parent.Parent
local Lang = require(Client.Lang)
local State = require(Client.State)
local Kit = require(script.Parent.Kit)
local Panel = require(script.Parent.Panel)

local Hud = {}

local gui: ScreenGui
local cashLabel: TextLabel
local coin: Frame
local incomeLabel: TextLabel
local multChip: TextLabel
local vaultChip: TextLabel
local weatherChip: TextLabel
local frenzyChip: TextLabel
local luckChip: TextLabel
local boostChip: TextLabel
local tutorialBubble: TextLabel
local tutorialStep: TextLabel
local bonkFill: Frame
local lockText: TextLabel
local menuBadges: { [string]: TextLabel } = {}
local badgeCounts: { [string]: number } = {}
local displayedCash = 0
local lastCash = 0
local lastIncome = 0

Hud.onBonk = nil :: (() -> ())?
Hud.onLock = nil :: (() -> ())?
Hud.onHome = nil :: (() -> ())?

local WEATHER_ICON: { [string]: string } = {
	golden = "☀️",
	crystal = "❄️",
	sugar = "🍬",
	volcano = "🌋",
	rainbow = "🌈",
	meteor = "☄️",
}

local function chip(parent: Instance, order: number, color: Color3): TextLabel
	local c = Kit.label({
		Size = UDim2.fromOffset(60, 30),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = color,
		BackgroundTransparency = 0,
		TextScaled = false,
		TextSize = 19,
		Text = "",
		LayoutOrder = order,
		Visible = false,
		Parent = parent,
	})
	Kit.corner(c, 15)
	Kit.gradient(c, Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 205))
	local st = Kit.stroke(c, 2.5)
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, 12)
	p.PaddingRight = UDim.new(0, 12)
	p.Parent = c
	return c
end

local MENU = {
	{ key = "Shop", icon = "🛒", label = "menuShop", color = Kit.colors.green },
	{ key = "Index", icon = "📖", label = "menuIndex", color = Kit.colors.blue },
	{ key = "Rebirth", icon = "♻️", label = "menuRebirth", color = Kit.colors.pink },
	{ key = "Quests", icon = "📜", label = "menuQuests", color = Kit.colors.orange },
	{ key = "Gifts", icon = "🎁", label = "menuGifts", color = Kit.colors.red },
	{ key = "Store", icon = "💎", label = "menuStore", color = Kit.colors.purple },
	{ key = "Settings", icon = "⚙️", label = "menuSettings", color = Kit.colors.gray },
}

function Hud.setBadge(key: string, count: number)
	local b = menuBadges[key]
	if not b then
		return
	end
	local before = badgeCounts[key] or 0
	badgeCounts[key] = count
	b.Visible = count > 0
	b.Text = if count > 9 then "9+" elseif count > 0 then tostring(count) else ""
	if count > before then
		Kit.pop(b, 1.3)
	end
end

function Hud.setTutorial(text: string?, step: number?)
	local was = tutorialBubble.Visible
	tutorialBubble.Visible = text ~= nil
	if text and tutorialBubble.Text ~= text then
		tutorialBubble.Text = text
		Kit.pop(tutorialBubble, 0.6)
	elseif not text then
		tutorialBubble.Text = ""
	end
	tutorialStep.Visible = step ~= nil and text ~= nil
	if step then
		tutorialStep.Text = step .. "/3"
	end
	if text and not was then
		Kit.pop(tutorialBubble)
	end
end

function Hud.bonkCooldown(seconds: number)
	bonkFill.Visible = true
	bonkFill.Size = UDim2.fromScale(1, 1)
	Kit.tween(bonkFill, seconds, { Size = UDim2.fromScale(1, 0) }, Enum.EasingStyle.Linear).Completed:Connect(function()
		bonkFill.Visible = false
	end)
end

-- 동전이 날아올 목표(화면 위 돈 아이콘)
function Hud.cashAnchor(): GuiObject
	return coin
end

-- 돈 아이콘에 동전이 도착했을 때
function Hud.coinArrived()
	Kit.bump(coin, 0.25)
end

-- 돈 옆에 떠오르는 +$ / -$ 글자
function Hud.flyText(text: string, color: Color3)
	local label = Kit.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 90, 0, 44),
		Size = UDim2.fromOffset(200, 30),
		Text = text,
		TextColor3 = color,
		stroke = 3,
		ZIndex = 20,
		Parent = gui,
	})
	Kit.pop(label, 0.8)
	Kit.tween(label, 1.1, { Position = UDim2.new(0.5, 110, 0, 8), TextTransparency = 1 }, Enum.EasingStyle.Quad)
	task.delay(1.15, function()
		label:Destroy()
	end)
end

local function refreshMoney(cash: number, vault: number, income: number)
	local delta = cash - lastCash
	lastCash = cash
	if delta > 0.5 then
		local from = displayedCash
		displayedCash = cash
		Kit.countTo(cashLabel, from, cash, Format.cash, if delta > income * 3 then 0.8 else 0.35)
		if delta > math.max(1, lastIncome * 1.5) then
			Hud.flyText("+" .. Format.cash(delta), Kit.colors.cash)
			Kit.bump(cashLabel, 0.14)
		end
	elseif delta < -0.5 then
		displayedCash = cash
		Kit.countTo(cashLabel, cash, cash, Format.cash, 0.01)
		Hud.flyText("-" .. Format.cash(-delta), Color3.fromRGB(255, 130, 130))
	end
	if income ~= lastIncome then
		incomeLabel.Text = "+" .. Format.cash(income) .. "/s"
		if income > lastIncome then
			Kit.bump(incomeLabel, 0.18)
		end
		lastIncome = income
	end
	local showVault = vault >= 1 and not State.hasPass("autoCollect")
	vaultChip.Visible = showVault
	vaultChip.Text = Lang.t("vaultChip", { cash = Format.cash(vault) })
	local view = State.view
	local mult = if view then view.multiplier else 1
	multChip.Visible = mult > 1.001
	multChip.Text = Format.mult(math.floor(mult * 100) / 100)
end

local function ownPlot(): Instance?
	local view = State.view
	if not view or view.plot == 0 then
		return nil
	end
	local map = Workspace:FindFirstChild("Map")
	local plots = map and map:FindFirstChild("Plots")
	return plots and plots:FindFirstChild("Plot" .. view.plot)
end

local pulse = 0
local function refreshChips()
	pulse += 1
	local world = ReplicatedStorage:FindFirstChild("WorldState")
	if not world then
		return
	end
	local now = Workspace:GetServerTimeNow()
	local weatherId = world:GetAttribute("Weather")
	if type(weatherId) == "string" and weatherId ~= "" and Weather.byId[weatherId] then
		local ends = world:GetAttribute("WeatherEnds")
		local left = if type(ends) == "number" then ends - now else 0
		if not weatherChip.Visible then
			Kit.pop(weatherChip)
		end
		weatherChip.Visible = true
		weatherChip.Text = (WEATHER_ICON[weatherId] or "🌦️") .. " " .. Lang.weather(weatherId) .. "  " .. Format.time(left)
	else
		weatherChip.Visible = false
	end

	local unix = os.time()
	if Progress.frenzyActive(unix) then
		frenzyChip.Text = Lang.t("frenzyNow", { t = Format.time(Progress.frenzyEndsAt(unix) - unix) })
		frenzyChip.BackgroundColor3 = Kit.colors.pink
		if pulse % 2 == 0 then
			Kit.bump(frenzyChip, 0.08)
		end
	else
		local wait = Progress.secondsUntilFrenzy(unix)
		frenzyChip.Text = Lang.t("frenzyIn", { t = Format.time(wait) })
		frenzyChip.BackgroundColor3 = if wait <= 60 then Kit.colors.orange else Kit.colors.bgLight
		if wait <= 60 and pulse % 2 == 0 then
			Kit.bump(frenzyChip, 0.1)
		end
	end
	frenzyChip.Visible = true

	local luck = world:GetAttribute("Luck")
	if type(luck) == "number" and luck > 1.01 then
		luckChip.Visible = true
		luckChip.Text = "🍀 " .. Lang.t("luckChip", { x = Format.mult(luck) })
	else
		luckChip.Visible = false
	end

	local data = State.data()
	local boost = data and data.boosts.cash2x
	if boost and boost > 0 then
		boostChip.Visible = true
		boostChip.Text = "💰x2 " .. Format.time(boost)
	else
		boostChip.Visible = false
	end

	-- 잠금 버튼에 남은 시간
	local plot = ownPlot()
	local lockEnds = plot and plot:GetAttribute("LockEnds")
	local cooldown = plot and plot:GetAttribute("LockCooldownEnds")
	if type(lockEnds) == "number" and lockEnds > now then
		lockText.Text = "🔒" .. math.ceil(lockEnds - now)
	elseif type(cooldown) == "number" and cooldown > now then
		lockText.Text = "⏳" .. math.ceil(cooldown - now)
	else
		lockText.Text = Lang.t("lockButton")
	end
	-- 금고 칩 반짝
	if vaultChip.Visible and pulse % 2 == 0 then
		Kit.bump(vaultChip, 0.07)
	end
end

local function roundButton(icon: string, text: string, color: Color3, size: number, pos: UDim2, onClick: () -> ()): (TextButton, TextLabel)
	local btn = Kit.button({
		Text = "",
		Color = color,
		Size = UDim2.fromOffset(size, size),
		AnchorPoint = Vector2.new(1, 1),
		Position = pos,
		Radius = size // 2,
		Parent = gui,
	}, onClick)
	Kit.label({ Size = UDim2.fromScale(1, 0.58), Text = icon, stroke = false, Parent = btn })
	local label = Kit.label({ Size = UDim2.fromScale(1, 0.32), Position = UDim2.fromScale(0, 0.6), Text = text, Parent = btn })
	return btn, label
end

function Hud.init()
	gui = Kit.new("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		DisplayOrder = 10,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	}) :: ScreenGui

	-- 돈 패널
	local top = Kit.new("Frame", {
		Name = "Top",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(300, 58),
		BackgroundColor3 = Kit.colors.bg,
		Parent = gui,
	}) :: Frame
	Kit.corner(top, 20)
	Kit.stroke(top, 4)
	Kit.gradient(top, Color3.fromRGB(255, 255, 255), Color3.fromRGB(180, 175, 205))
	coin = Kit.new("Frame", {
		Name = "Coin",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, 0),
		Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = Kit.colors.yellow,
		Parent = top,
	}) :: Frame
	Kit.corner(coin, 22)
	Kit.stroke(coin, 3, Color3.fromRGB(150, 95, 10))
	Kit.gradient(coin, Color3.fromRGB(255, 250, 200), Color3.fromRGB(255, 190, 40))
	Kit.label({ Text = "$", TextColor3 = Color3.fromRGB(255, 255, 255), stroke = 2.5, Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1), Parent = coin })
	cashLabel = Kit.label({
		Size = UDim2.new(1, -68, 1, -12),
		Position = UDim2.fromOffset(60, 6),
		Text = "$0",
		TextColor3 = Kit.colors.cash,
		TextXAlignment = Enum.TextXAlignment.Left,
		stroke = 3,
		Parent = top,
	})

	local row = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.fromOffset(520, 30),
		BackgroundTransparency = 1,
		Parent = gui,
	}) :: Frame
	Kit.list(row, false, 8, Enum.HorizontalAlignment.Center)
	incomeLabel = chip(row, 1, Kit.colors.green)
	incomeLabel.Visible = true
	incomeLabel.Text = "+$0/s"
	multChip = chip(row, 2, Kit.colors.purple)
	vaultChip = chip(row, 3, Kit.colors.orange)

	local chips = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 106),
		Size = UDim2.fromOffset(680, 30),
		BackgroundTransparency = 1,
		Parent = gui,
	}) :: Frame
	Kit.list(chips, false, 8, Enum.HorizontalAlignment.Center)
	weatherChip = chip(chips, 1, Kit.colors.blue)
	frenzyChip = chip(chips, 2, Kit.colors.bgLight)
	luckChip = chip(chips, 3, Kit.colors.green)
	boostChip = chip(chips, 4, Kit.colors.yellow)

	-- 왼쪽 메뉴(2열)
	local menu = Kit.new("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(142, 290),
		BackgroundTransparency = 1,
		Parent = gui,
	}) :: Frame
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(66, 66)
	grid.CellPadding = UDim2.fromOffset(8, 10)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = menu
	local menuScale = Instance.new("UIScale")
	menuScale.Parent = menu
	for i, m in MENU do
		local btn = Kit.button({ Text = "", Color = m.color, LayoutOrder = i, Radius = 18, Parent = menu }, function()
			Panel.toggle(m.key)
		end)
		Kit.label({ Size = UDim2.new(1, 0, 0.6, 0), Text = m.icon, stroke = false, Parent = btn })
		Kit.label({ Size = UDim2.new(1, 4, 0.34, 0), Position = UDim2.new(0, -2, 0.62, 0), Text = Lang.t(m.label), Parent = btn })
		menuBadges[m.key] = Kit.badge(btn)
	end

	-- 오른쪽 아래 버튼 묶음
	local bonkText = if UserInputService.KeyboardEnabled then "BONK [F]" else "BONK"
	local bonkBtn = roundButton("🔨", bonkText, Kit.colors.orange, 98, UDim2.new(1, -18, 1, -146), function()
		if Hud.onBonk then
			Hud.onBonk()
		end
	end)
	bonkFill = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 9),
		Size = UDim2.fromScale(1, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Visible = false,
		ZIndex = 5,
		Parent = bonkBtn,
	}) :: Frame
	Kit.corner(bonkFill, 49)
	local _, lockLabel = roundButton("🔒", Lang.t("lockButton"), Kit.colors.red, 72, UDim2.new(1, -128, 1, -152), function()
		if Hud.onLock then
			Hud.onLock()
		end
	end)
	lockText = lockLabel
	roundButton("🏠", Lang.t("homeButton"), Kit.colors.blue, 64, UDim2.new(1, -35, 1, -262), function()
		if Hud.onHome then
			Hud.onHome()
		end
	end)

	-- 튜토리얼 말풍선
	tutorialBubble = Kit.label({
		Name = "Tutorial",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -26),
		Size = UDim2.new(0.7, 0, 0, 58),
		BackgroundColor3 = Kit.colors.yellow,
		TextColor3 = Kit.colors.white,
		Text = "",
		Visible = false,
		stroke = 3,
		Parent = gui,
	})
	Kit.corner(tutorialBubble, 18)
	Kit.gradient(tutorialBubble, Color3.new(1, 1, 1), Color3.fromRGB(215, 215, 215))
	local tst = Kit.stroke(tutorialBubble, 4)
	tst.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	local tpad = Instance.new("UIPadding")
	tpad.PaddingLeft = UDim.new(0, 58)
	tpad.PaddingRight = UDim.new(0, 12)
	tpad.PaddingTop = UDim.new(0, 6)
	tpad.PaddingBottom = UDim.new(0, 6)
	tpad.Parent = tutorialBubble
	local tsc = Instance.new("UISizeConstraint")
	tsc.MaxSize = Vector2.new(600, 64)
	tsc.Parent = tutorialBubble
	tutorialStep = Kit.pill(tutorialBubble, "1/3", Kit.colors.orange, {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, -50, 0.5, 0),
		Size = UDim2.fromOffset(44, 30),
	})

	-- 작은 화면에서 메뉴 크기 조정
	local function rescale()
		local cam = Workspace.CurrentCamera
		if cam then
			menuScale.Scale = math.clamp(cam.ViewportSize.Y / 640, 0.7, 1.1)
		end
	end
	rescale()
	local cam = Workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end

	State.money:Connect(refreshMoney)
	State.changed:Connect(function(view)
		refreshMoney(view.data.cash, view.data.vault, view.income)
	end)
	local acc = 0
	local t = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		t += dt
		if acc >= 0.5 then
			acc = 0
			refreshChips()
		end
		-- 튜토리얼 말풍선 둥실둥실
		if tutorialBubble.Visible then
			tutorialBubble.Position = UDim2.new(0.5, 0, 1, -26 - math.abs(math.sin(t * 2.4)) * 6)
		end
	end)
end

function Hud.gui(): ScreenGui
	return gui
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--!strict
-- UI 부품 모음(디자인 시스템).
--  · 입체 버튼: 아래쪽 두께(립) + 윗부분 광택 + 선택적 빛 줄기(스윕), 호버/누름 애니메이션과 소리
--  · 카드, 알약 라벨, 애니메이션 진행 막대, 알림 배지
--  · 모션 도우미: pop(튀어나오기), shake(흔들기), countTo(숫자 올라가기)

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Kit = {}

Kit.font = Enum.Font.FredokaOne
Kit.fontBody = Enum.Font.GothamBold

Kit.colors = {
	bg = Color3.fromRGB(30, 21, 56),
	bgLight = Color3.fromRGB(58, 42, 100),
	card = Color3.fromRGB(70, 52, 120),
	cardLight = Color3.fromRGB(92, 70, 150),
	stroke = Color3.fromRGB(18, 10, 36),
	white = Color3.fromRGB(255, 255, 255),
	muted = Color3.fromRGB(196, 186, 226),
	purple = Color3.fromRGB(135, 90, 255),
	pink = Color3.fromRGB(255, 90, 170),
	green = Color3.fromRGB(64, 206, 104),
	yellow = Color3.fromRGB(255, 200, 50),
	red = Color3.fromRGB(255, 76, 88),
	blue = Color3.fromRGB(62, 156, 255),
	orange = Color3.fromRGB(255, 146, 46),
	gray = Color3.fromRGB(118, 112, 138),
	cash = Color3.fromRGB(120, 255, 140),
}

export type Props = { [string]: any }

function Kit.darken(c: Color3, amount: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), amount)
end

function Kit.lighten(c: Color3, amount: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), amount)
end

-- Instance.new + 속성 + 자식
function Kit.new(className: string, props: Props?, children: { Instance }?): Instance
	local inst = Instance.new(className)
	local parent: Instance? = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Kit.corner(parent: Instance, radius: number?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 12)
	c.Parent = parent
	return c
end

function Kit.stroke(parent: Instance, thickness: number?, color: Color3?): UIStroke
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 3
	s.Color = color or Kit.colors.stroke
	s.ApplyStrokeMode = if parent:IsA("TextLabel") or parent:IsA("TextButton")
		then Enum.ApplyStrokeMode.Contextual
		else Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

-- 글자 테두리(버튼·라벨의 텍스트에만)
function Kit.textStroke(parent: TextLabel | TextButton, thickness: number?)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 2
	s.Color = Kit.colors.stroke
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	s.Parent = parent
end

function Kit.gradient(parent: Instance, top: Color3, bottom: Color3): UIGradient
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(top, bottom)
	g.Rotation = 90
	g.Parent = parent
	return g
end

function Kit.padding(parent: Instance, px: number)
	local p = Instance.new("UIPadding")
	p.PaddingTop = UDim.new(0, px)
	p.PaddingBottom = UDim.new(0, px)
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.Parent = parent
end

function Kit.list(parent: Instance, vertical: boolean, gap: number, align: Enum.HorizontalAlignment?): UIListLayout
	local l = Instance.new("UIListLayout")
	l.FillDirection = if vertical then Enum.FillDirection.Vertical else Enum.FillDirection.Horizontal
	l.Padding = UDim.new(0, gap)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	if align then
		l.HorizontalAlignment = align
	end
	l.VerticalAlignment = Enum.VerticalAlignment.Center
	l.Parent = parent
	return l
end

function Kit.tween(
	inst: Instance,
	seconds: number,
	props: { [string]: any },
	style: Enum.EasingStyle?,
	dir: Enum.EasingDirection?
): Tween
	local t = TweenService:Create(
		inst,
		TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

-- 요소마다 UIScale 하나를 공유해서 애니메이션에 씀
function Kit.scaleOf(gui: GuiObject): UIScale
	local s = gui:FindFirstChild("KitScale")
	if s and s:IsA("UIScale") then
		return s
	end
	local created = Instance.new("UIScale")
	created.Name = "KitScale"
	created.Parent = gui
	return created
end

-- 톡 튀어나오기(작게 → 조금 크게 → 원래)
function Kit.pop(gui: GuiObject, strength: number?)
	local s = Kit.scaleOf(gui)
	local k = strength or 1
	s.Scale = 1 - 0.35 * k
	local t = Kit.tween(s, 0.14, { Scale = 1 + 0.12 * k }, Enum.EasingStyle.Quad)
	t.Completed:Connect(function()
		Kit.tween(s, 0.16, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
end

-- 살짝 커졌다가 돌아오기(값이 바뀔 때)
function Kit.bump(gui: GuiObject, amount: number?)
	local s = Kit.scaleOf(gui)
	s.Scale = 1 + (amount or 0.12)
	Kit.tween(s, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
end

-- 좌우로 흔들기(오류 등)
function Kit.shake(gui: GuiObject)
	local base = gui.Position
	task.spawn(function()
		for _, dx in { 8, -7, 6, -4, 2, 0 } do
			gui.Position = base + UDim2.fromOffset(dx, 0)
			task.wait(0.03)
		end
		gui.Position = base
	end)
end

-- 숫자가 올라가는 애니메이션. fmt로 표시 문자열을 만듭니다.
function Kit.countTo(label: TextLabel, from: number, to: number, fmt: (number) -> string, seconds: number?): () -> ()
	local prev = label:GetAttribute("CountToken")
	local token = (if type(prev) == "number" then prev else 0) + 1
	label:SetAttribute("CountToken", token)
	local duration = seconds or 0.45
	local started = os.clock()
	task.spawn(function()
		while label:GetAttribute("CountToken") == token do
			local a = math.min(1, (os.clock() - started) / duration)
			local eased = 1 - (1 - a) ^ 3
			label.Text = fmt(from + (to - from) * eased)
			if a >= 1 then
				break
			end
			task.wait()
		end
	end)
	return function()
		label:SetAttribute("CountToken", token + 1)
	end
end

function Kit.label(props: Props): TextLabel
	local label = Kit.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Kit.font,
		TextColor3 = Kit.colors.white,
		TextScaled = true,
		Size = UDim2.fromScale(1, 1),
	}) :: TextLabel
	for k, v in props do
		if k ~= "Parent" and k ~= "stroke" then
			(label :: any)[k] = v
		end
	end
	if props.stroke ~= false then
		Kit.textStroke(label, if type(props.stroke) == "number" then props.stroke else 2)
	end
	if props.Parent then
		label.Parent = props.Parent
	end
	return label
end

-- 둥근 배경이 있는 작은 라벨(등급·변이·가격 표시)
function Kit.pill(parent: Instance, text: string, color: Color3, props: Props?): TextLabel
	local p = Kit.label({
		Text = text,
		BackgroundColor3 = color,
		BackgroundTransparency = 0,
		Size = UDim2.fromOffset(90, 24),
		Parent = parent,
	})
	if props then
		for k, v in props do
			(p :: any)[k] = v
		end
	end
	Kit.corner(p, 12)
	local st = Instance.new("UIStroke")
	st.Thickness = 2
	st.Color = Kit.darken(color, 0.55)
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Parent = p
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 2)
	pad.PaddingBottom = UDim.new(0, 2)
	pad.Parent = p
	return p
end

-- 카드(패널 안 한 줄). 윗부분에 은은한 하이라이트
function Kit.card(parent: Instance, props: Props?): Frame
	local card = Kit.new("Frame", {
		BackgroundColor3 = Kit.colors.card,
		Size = UDim2.new(1, 0, 0, 78),
		Parent = parent,
	}) :: Frame
	if props then
		for k, v in props do
			(card :: any)[k] = v
		end
	end
	Kit.corner(card, 16)
	Kit.stroke(card, 3)
	Kit.gradient(card, Color3.fromRGB(255, 255, 255), Color3.fromRGB(205, 200, 225))
	return card
end

local soundFn: ((string) -> ())? = nil
function Kit.setClickSound(fn: (string) -> ())
	soundFn = fn
end
local function sfx(name: string)
	if soundFn then
		soundFn(name)
	end
end

-- 버튼에 빛 줄기(스윕)를 주기적으로 지나가게
function Kit.sweep(btn: GuiObject, radius: number?)
	local sweep = Kit.new("Frame", {
		Name = "Sweep",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = btn.ZIndex,
		Parent = btn,
	}) :: Frame
	Kit.corner(sweep, radius or 14)
	local g = Instance.new("UIGradient")
	g.Rotation = 20
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.42, 1),
		NumberSequenceKeypoint.new(0.5, 0.55),
		NumberSequenceKeypoint.new(0.58, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	g.Offset = Vector2.new(-1, 0)
	g.Parent = sweep
	task.spawn(function()
		while sweep.Parent do
			g.Offset = Vector2.new(-1, 0)
			Kit.tween(g, 0.8, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Sine)
			task.wait(2.6 + math.random() * 1.5)
		end
	end)
end

-- 입체 버튼. onClick은 누를 때 실행
function Kit.button(props: Props, onClick: (() -> ())?): TextButton
	local color: Color3 = props.Color or Kit.colors.purple
	local radius = props.Radius or 14
	local btn = Kit.new("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = color,
		Font = Kit.font,
		TextColor3 = Kit.colors.white,
		TextScaled = true,
		Text = props.Text or "",
		Size = props.Size or UDim2.fromOffset(160, 50),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
	}) :: TextButton
	Kit.corner(btn, radius)
	local stroke = Kit.stroke(btn, 3)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	Kit.textStroke(btn, 2)
	Kit.gradient(btn, Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 200))
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 9)
	pad.Parent = btn

	-- 아래쪽 두께(립)
	local lip = Kit.new("Frame", {
		Name = "Lip",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 9),
		Size = UDim2.new(1, 16, 0, 7),
		BackgroundColor3 = Kit.darken(color, 0.35),
		BorderSizePixel = 0,
		ZIndex = btn.ZIndex,
		Parent = btn,
	}) :: Frame
	Kit.corner(lip, radius)
	-- 윗부분 광택
	local gloss = Kit.new("Frame", {
		Name = "Gloss",
		Position = UDim2.new(0, -4, 0, -2),
		Size = UDim2.new(1, 8, 0.48, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = btn.ZIndex,
		Parent = btn,
	}) :: Frame
	Kit.corner(gloss, radius)
	local gg = Instance.new("UIGradient")
	gg.Rotation = 90
	gg.Transparency = NumberSequence.new(0.72, 1)
	gg.Parent = gloss
	if props.Shine then
		Kit.sweep(btn, radius)
	end

	local scale = Kit.scaleOf(btn)
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	btn.MouseEnter:Connect(function()
		Kit.tween(scale, 0.12, { Scale = 1.06 }, Enum.EasingStyle.Back)
		if not touch and btn:GetAttribute("Enabled") ~= false then
			sfx("hover")
		end
	end)
	btn.MouseLeave:Connect(function()
		Kit.tween(scale, 0.12, { Scale = 1 })
	end)
	btn.MouseButton1Down:Connect(function()
		Kit.tween(scale, 0.06, { Scale = 0.93 })
		lip.Size = UDim2.new(1, 16, 0, 3)
	end)
	btn.MouseButton1Up:Connect(function()
		Kit.tween(scale, 0.14, { Scale = 1 }, Enum.EasingStyle.Back)
		lip.Size = UDim2.new(1, 16, 0, 7)
	end)
	if onClick then
		btn.Activated:Connect(function()
			if btn:GetAttribute("Enabled") == false then
				sfx("error")
				Kit.shake(btn)
				return
			end
			sfx("click")
			onClick()
		end)
	end
	if props.Parent then
		btn.Parent = props.Parent
	end
	return btn
end

-- 버튼 활성/비활성 모양. 비활성 버튼을 누르면 흔들리며 막힘 소리
function Kit.setEnabled(btn: TextButton, enabled: boolean, color: Color3?)
	btn.Active = true
	btn.AutoButtonColor = false
	local c = if enabled then (color or btn.BackgroundColor3) else Kit.colors.gray
	btn.BackgroundColor3 = c
	btn.TextTransparency = if enabled then 0 else 0.25
	local lip = btn:FindFirstChild("Lip")
	if lip and lip:IsA("Frame") then
		lip.BackgroundColor3 = Kit.darken(c, 0.35)
	end
	btn:SetAttribute("Enabled", enabled)
end

-- 진행 막대. 반환된 함수로 값(0~1)을 바꾸면 부드럽게 채워집니다.
function Kit.progress(parent: Instance, color: Color3, props: Props?): (Frame, (number) -> ())
	local bar = Kit.new("Frame", {
		BackgroundColor3 = Kit.colors.stroke,
		Size = UDim2.new(1, 0, 0, 16),
		Parent = parent,
	}) :: Frame
	if props then
		for k, v in props do
			(bar :: any)[k] = v
		end
	end
	Kit.corner(bar, 8)
	local fill = Kit.new("Frame", {
		BackgroundColor3 = color,
		Size = UDim2.fromScale(0, 1),
		Parent = bar,
	}) :: Frame
	Kit.corner(fill, 8)
	Kit.gradient(fill, Kit.lighten(color, 0.35), color)
	local shine = Kit.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.7,
		Position = UDim2.fromOffset(4, 2),
		Size = UDim2.new(1, -8, 0.3, 0),
		BorderSizePixel = 0,
		Parent = fill,
	}) :: Frame
	Kit.corner(shine, 4)
	return bar, function(v: number)
		Kit.tween(fill, 0.35, { Size = UDim2.fromScale(math.clamp(v, 0, 1), 1) })
	end
end

-- 빨간 알림 점(숫자)
function Kit.badge(parent: GuiObject): TextLabel
	local b = Kit.new("TextLabel", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -6, 0, 6),
		Size = UDim2.fromOffset(24, 24),
		BackgroundColor3 = Kit.colors.red,
		Font = Kit.font,
		TextScaled = true,
		TextColor3 = Kit.colors.white,
		Text = "!",
		Visible = false,
		ZIndex = parent.ZIndex + 5,
		Parent = parent,
	}) :: TextLabel
	Kit.corner(b, 12)
	Kit.stroke(b, 2)
	return b
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">Notify</string>
              <string name="Source"><![CDATA[--!strict
-- 알림: 작은 토스트(위쪽 가운데, 아이콘·색 막대·남은 시간 막대)와
-- 큰 배너(희귀 등장·이벤트·대폭주 등, 빛 줄기가 지나감).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local Lang = require(Client.Lang)
local Kit = require(script.Parent.Kit)
local Sound = require(Client.Controllers.Sound)

local Notify = {}

-- 도난 경보 같은 화면 연출을 Fx가 연결
Notify.onAlarm = nil :: (() -> ())?

local gui: ScreenGui
local toasts: Frame
local banner: Frame
local bannerIcon: TextLabel
local bannerLabel: TextLabel
local bannerSub: TextLabel
local bannerToken = 0
local toastOrder = 0

local KIND_COLOR: { [string]: Color3 } = {
	info = Kit.colors.purple,
	success = Kit.colors.green,
	error = Kit.colors.red,
	steal = Kit.colors.red,
	announce = Kit.colors.pink,
	event = Kit.colors.blue,
	rare = Kit.colors.yellow,
}

local KIND_ICON: { [string]: string } = {
	info = "💬",
	success = "✅",
	error = "⛔",
	steal = "🚨",
	announce = "📣",
	event = "🌦️",
	rare = "✨",
}

local KIND_SOUND: { [string]: string } = {
	success = "success",
	error = "error",
	steal = "alarm",
	announce = "rare",
	event = "event",
	rare = "rare",
}

local TOAST_SECONDS = 3.4

function Notify.toast(text: string, kind: string?)
	local k = kind or "info"
	local color = KIND_COLOR[k] or Kit.colors.purple
	toastOrder -= 1
	local holder = Kit.new("Frame", {
		Name = "Toast",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 46),
		LayoutOrder = toastOrder,
		Parent = toasts,
	}) :: Frame
	local frame = Kit.new("Frame", {
		BackgroundColor3 = Kit.colors.bg,
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, -18),
		BackgroundTransparency = 1,
		Parent = holder,
	}) :: Frame
	Kit.corner(frame, 14)
	local stroke = Kit.stroke(frame, 3, color)
	stroke.Transparency = 1
	local accent = Kit.new("Frame", {
		BackgroundColor3 = color,
		Size = UDim2.new(0, 42, 1, 0),
		BorderSizePixel = 0,
		Parent = frame,
	}) :: Frame
	Kit.corner(accent, 14)
	local icon = Kit.label({
		Size = UDim2.new(0, 42, 1, -8),
		Position = UDim2.fromOffset(0, 4),
		Text = KIND_ICON[k] or "💬",
		stroke = false,
		Parent = frame,
	})
	local label = Kit.label({
		Size = UDim2.new(1, -60, 1, -12),
		Position = UDim2.fromOffset(52, 5),
		Text = text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTransparency = 1,
		Parent = frame,
	})
	local timer = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 46, 1, -3),
		Size = UDim2.new(1, -54, 0, 3),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = frame,
	}) :: Frame
	Kit.corner(timer, 2)

	-- 등장
	Kit.tween(frame, 0.25, { Position = UDim2.new(), BackgroundTransparency = 0.04 }, Enum.EasingStyle.Back)
	Kit.tween(stroke, 0.2, { Transparency = 0 })
	Kit.tween(label, 0.2, { TextTransparency = 0 })
	Kit.pop(icon, 0.8)
	Kit.tween(timer, TOAST_SECONDS, { Size = UDim2.new(0, 0, 0, 3) }, Enum.EasingStyle.Linear)

	-- 너무 많으면 가장 오래된 것부터 제거
	local list = {}
	for _, c in toasts:GetChildren() do
		if c:IsA("Frame") then
			table.insert(list, c)
		end
	end
	table.sort(list, function(a, b)
		return a.LayoutOrder > b.LayoutOrder
	end)
	for i = 5, #list do
		list[i]:Destroy()
	end

	local sound = KIND_SOUND[k]
	if sound then
		Sound.play(sound)
	end
	task.delay(TOAST_SECONDS, function()
		if not holder.Parent then
			return
		end
		Kit.tween(frame, 0.3, { Position = UDim2.fromOffset(40, 0), BackgroundTransparency = 1 })
		Kit.tween(stroke, 0.25, { Transparency = 1 })
		Kit.tween(label, 0.25, { TextTransparency = 1 })
		Kit.tween(icon, 0.25, { TextTransparency = 1 })
		Kit.tween(accent, 0.25, { BackgroundTransparency = 1 })
		task.wait(0.32)
		holder:Destroy()
	end)
end

function Notify.banner(text: string, sub: string?, color: Color3?, seconds: number?, icon: string?)
	bannerToken += 1
	local token = bannerToken
	bannerLabel.Text = text
	bannerSub.Text = sub or ""
	bannerIcon.Text = icon or "✨"
	local c = color or Kit.colors.pink
	banner.BackgroundColor3 = c
	local lip = banner:FindFirstChild("Lip")
	if lip and lip:IsA("Frame") then
		lip.BackgroundColor3 = Kit.darken(c, 0.4)
	end
	banner.Visible = true
	banner.Position = UDim2.new(0.5, 0, 0, -130)
	Kit.tween(banner, 0.45, { Position = UDim2.new(0.5, 0, 0, 100) }, Enum.EasingStyle.Back)
	Kit.pop(bannerIcon, 1.2)
	task.delay(seconds or 4, function()
		if bannerToken == token then
			Kit.tween(banner, 0.3, { Position = UDim2.new(0.5, 0, 0, -130) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.wait(0.32)
			if bannerToken == token then
				banner.Visible = false
			end
		end
	end)
end

local BANNER_ICON: { [string]: string } = {
	frenzyStart = "⚡",
	weatherStart = "🌦️",
	rareSpawn = "✨",
	serverLuck = "🍀",
	stormBought = "🌈",
	rebirthAnnounce = "♻️",
	stealAnnounce = "🥷",
}

-- 서버 알림 처리
local function onServer(msg: { kind: string, key: string, args: { [string]: any }? })
	local text = Lang.t(msg.key, msg.args)
	local kind = msg.kind
	if kind == "announce" or kind == "rare" or kind == "event" then
		local sub: string? = nil
		if msg.key == "weatherStart" and msg.args and type(msg.args.weather) == "string" then
			sub = Lang.t("weatherDesc_" .. msg.args.weather)
		end
		Notify.banner(text, sub, KIND_COLOR[kind], if kind == "rare" then 3.5 else 4.5, BANNER_ICON[msg.key])
		local sound = if msg.key == "frenzyStart" then "frenzy" else KIND_SOUND[kind]
		if sound then
			Sound.play(sound)
		end
	else
		Notify.toast(text, kind)
		if kind == "steal" and Notify.onAlarm then
			Notify.onAlarm()
		end
	end
end

-- 액션 실패 메시지(서버 msg 키)를 보여줌
function Notify.result(result: { [string]: any })
	if not result.ok and type(result.msg) == "string" and result.msg ~= "tooFast" then
		Notify.toast(Lang.t(result.msg), "error")
	end
end

function Notify.init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = Kit.new("ScreenGui", {
		Name = "Notify",
		ResetOnSpawn = false,
		DisplayOrder = 50,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	}) :: ScreenGui

	toasts = Kit.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 178),
		Size = UDim2.new(0.8, 0, 0, 250),
		BackgroundTransparency = 1,
		Parent = gui,
	}) :: Frame
	local sc = Instance.new("UISizeConstraint")
	sc.MaxSize = Vector2.new(480, 270)
	sc.Parent = toasts
	local layout = Kit.list(toasts, true, 6, Enum.HorizontalAlignment.Center)
	layout.VerticalAlignment = Enum.VerticalAlignment.Top

	banner = Kit.new("Frame", {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -130),
		Size = UDim2.new(0.9, 0, 0, 82),
		BackgroundColor3 = Kit.colors.pink,
		Visible = false,
		Parent = gui,
	}) :: Frame
	local bsc = Instance.new("UISizeConstraint")
	bsc.MaxSize = Vector2.new(660, 96)
	bsc.Parent = banner
	Kit.corner(banner, 20)
	Kit.stroke(banner, 4)
	Kit.gradient(banner, Color3.new(1, 1, 1), Color3.fromRGB(175, 175, 175))
	local lip = Kit.new("Frame", {
		Name = "Lip",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = Kit.darken(Kit.colors.pink, 0.4),
		BorderSizePixel = 0,
		Parent = banner,
	}) :: Frame
	Kit.corner(lip, 20)
	Kit.sweep(banner, 20)
	bannerIcon = Kit.label({
		Size = UDim2.new(0, 64, 1, -16),
		Position = UDim2.fromOffset(10, 6),
		Text = "✨",
		stroke = false,
		Parent = banner,
	})
	bannerLabel = Kit.label({
		Size = UDim2.new(1, -96, 0.58, 0),
		Position = UDim2.fromOffset(80, 6),
		Text = "",
		stroke = 3,
		Parent = banner,
	})
	bannerSub = Kit.label({
		Size = UDim2.new(1, -96, 0.28, 0),
		Position = UDim2.new(0, 80, 0.62, 0),
		Text = "",
		TextColor3 = Color3.fromRGB(255, 250, 220),
		Parent = banner,
	})

	Net.event("Notify").OnClientEvent:Connect(onServer)
end

return Notify
]]></string>
