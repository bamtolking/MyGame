	stealFailed_locked = { en = "🔒 The owner locked the base! You dropped the slime.", ko = "🔒 주인이 기지를 잠갔어요! 슬라임을 놓쳤어요." },
	revengeTitle = { en = "REVENGE!", ko = "복수의 시간!" },
	revengeSub = { en = "Chase the red thief and BONK them!", ko = "빨간 도둑을 쫓아가 뿅망치로 때리세요!" },
