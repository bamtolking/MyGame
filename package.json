{
  "name": "daebak-defense",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/singlefile.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "balance": "vitest run tests/balance.test.ts --reporter=verbose",
    "e2e": "node scripts/e2e.mjs",
    "abyss:dev": "vite --config abyss/vite.config.ts --host",
    "abyss:build": "tsc --noEmit -p abyss/tsconfig.json && vite build --config abyss/vite.config.ts && node abyss/scripts/singlefile.mjs",
    "abyss:test": "vitest run --config abyss/vite.config.ts tests/rules.test.ts tests/world.test.ts",
    "abyss:shots": "node abyss/scripts/shots.mjs",
    "abyss:balance": "vitest run --config abyss/vite.config.ts tests/balance.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "5.0.1"
  }
}
