{
  "name": "daebak-defense",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/singlefile.mjs && node scripts/singlefile-packblast.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:packblast": "vitest run tests/packblast",
    "test:daebak": "vitest run tests/rules.test.ts tests/smoke.test.ts tests/balance.test.ts",
    "balance": "vitest run tests/balance.test.ts --reporter=verbose",
    "balance:packblast": "vitest run tests/packblast/balance.test.ts --reporter=verbose",
    "e2e": "node scripts/e2e.mjs",
    "e2e:packblast": "node scripts/e2e-packblast.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "5.0.1"
  }
}
