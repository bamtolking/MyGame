{
  "name": "dayhunger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "데이헝거 — 벽짓살(벽 짓고 살아남기) 협동 생존 게임, 모바일 브라우저용",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "e2e": "node scripts/e2e.mjs",
    "build:www": "node scripts/build-www.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "android:sync": "npm run build:www && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
