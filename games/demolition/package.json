    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "matter-js": "0.20.0"
  },
  "devDependencies": {
    "@types/matter-js": "0.20.2",
    "@types/node": "22.20.3",
    "playwright-core": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "5.0.1"
  }
}
