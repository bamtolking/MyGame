{
  "name": "waruru-demolition-king",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "description": "와르르! 철거왕: 한 발의 기적 — 물리 퍼즐 웹 베타",
  "scripts": {
    "dev": "vite --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/singlefile.mjs",
