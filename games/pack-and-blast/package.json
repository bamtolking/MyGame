{
  "name": "pack-and-blast",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "description": "가방이 무기다: 팩 앤 블래스트 — 가방 배치 퍼즐 + 장비 조합 + 짧은 자동 전투 (모바일 웹 베타)",
  "scripts": {
    "dev": "vite --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/singlefile.mjs",
    "preview": "vite preview --host",
    "test": "vitest run --exclude tests/balance.test.ts",
    "test:all": "vitest run",
    "balance": "vitest run tests/balance.test.ts --reporter=verbose",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "5.0.1"
  }
}
